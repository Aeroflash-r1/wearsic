# Public port for the local server. Point Cloudflare Tunnel to this port.
PORT=8080
# SQLite file path. Defaults to wearsic.db in the server directory.
WEARSIC_DB_PATH=wearsic.db
# Optional shared key. Configure the same key in Wearsic Settings.
WEARSIC_API_KEY=
# Optional authenticated YouTube browser cookie string for bot-challenged server IPs.
# Never commit a real cookie. Example format: SID=...; HSID=...; SSID=...
WEARSIC_YOUTUBE_COOKIE=
# Self-healing engine updates (default on). When YouTube breaks the extraction
# engine, the server downloads the newest release ZIP, verifies it, stages it,
# and run-termux.sh applies it on restart. Set to 0 to update manually only.
WEARSIC_AUTO_UPDATE=1
# Directory for staged updates + update.json. Default: wearsic-state/ next to the DB.
#WEARSIC_STATE_DIR=
# ---------------------------------------------------------------------------
# Cloudflare front door (`wearsic cloudflare`) — a PERMANENT public URL.
#
# A Cloudflare Quick Tunnel alone gives a random https://<random>.trycloudflare.com
# that changes on every restart, so a watch can never remember it. The front
# door puts a Cloudflare Worker in front of the tunnel: the Worker lives at a
# fixed https://<worker>.<subdomain>.workers.dev address and is re-pointed at
# the new tunnel hostname whenever the tunnel changes. No domain, no cost.
#
# CLOUDFLARE_API_TOKEN   required — a Cloudflare API token with
#                        "Workers Scripts: Edit" and "Account Settings: Read"
#                        (Workers & Pages → API Tokens → Create Token).
#                        Never the Global API Key.
# CLOUDFLARE_ACCOUNT_ID  required — 32-char hex id from the dashboard's
#                        Workers & Pages overview, or the zone overview.
# CLOUDFLARE_SUBDOMAIN   optional — your workers.dev subdomain; created on
#                        first use if it does not exist yet.
# CLOUDFLARE_WORKER      optional — the Worker name, default "wearsic".
#                        It becomes a DNS label, so letters/digits/dashes only.
#
# A public URL REQUIRES WEARSIC_API_KEY above — without one the engine would
# be open to anyone who guesses the address.
#CLOUDFLARE_API_TOKEN=
#CLOUDFLARE_ACCOUNT_ID=
#CLOUDFLARE_SUBDOMAIN=
#CLOUDFLARE_WORKER=wearsic
