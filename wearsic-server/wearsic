  if [ -z "$(api_key)" ]; then
    die "Public exposure REQUIRES an API key — the server would otherwise be open to the internet. Set one first:  wearsic api-key <your-key>  (or run: wearsic cloudflare, which creates one if missing)"
  fi
  say "Public URL options (watch works on any network, no VPN app on the watch):"
  say ""
  say "1) Tailscale Funnel — STABLE url, no account needed, but slower:"
