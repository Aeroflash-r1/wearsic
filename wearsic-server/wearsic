#!/data/data/com.termux/files/usr/bin/bash
# ─────────────────────────────────────────────────────────────────────
# wearsic — the everyday command for the Wearsic server.
#
#   wearsic start             start the server (self-healing supervisor)
#   wearsic stop              stop the server
#   wearsic restart           stop, then start
#   wearsic status            running? healthy? which version? (exit 0/3/4)
#   wearsic logs              follow live logs (Ctrl+C to exit)
#   wearsic health [--json]   server snapshot (--json for scripts)
#   wearsic url               Server URL + API key for the watch
#   wearsic api-key [new]     show / change the API key
#   wearsic update            update to the latest release (verified + rollback)
#   wearsic sideload [tag]    install the release watch app onto the watch (adb)
#   wearsic pair [url]        send address + key to the watch (adb, no typing)
#   wearsic doctor            check the whole setup (exit 0 = READY)
#
# Also available: ready [--json], ip, version, cookies [str], funnel, public.
# The classic nested form keeps working: `wearsic server start` etc.
#
# Output follows the usual conventions: colour only on a terminal
# (WEARSIC_COLOR=always|never overrides, NO_COLOR disables), plain when
# piped, so `wearsic health --json | jq` and CI logs stay clean.
#
# Installed to $PREFIX/bin by install.sh. Finds the server in
# $WEARSIC_DIR, else ~/wearsic-server.
# ─────────────────────────────────────────────────────────────────────
set -u

DEST="${WEARSIC_DIR:-$HOME/wearsic-server}"
RUN="$DEST/run-termux.sh"
LOG="$DEST/wearsic-server.log"
ENV_FILE="$DEST/.env"

# Blueprint for every command: gradient wordmark, rounded full-width panels,
# a soft multi-tone palette, two-space indent. Colour follows the usual
# conventions:
#
#   WEARSIC_COLOR=auto|always|never    auto = colour only on a real terminal
#   NO_COLOR=1                         force plain output
#
# Piped output is plain, so `wearsic health | jq` and CI logs never carry
# escape codes.
color_on() {
  [ -n "${NO_COLOR:-}" ] && return 1
  case "${WEARSIC_COLOR:-auto}" in
    never) return 1 ;;
    always) return 0 ;;
    *) [ -t 1 ] ;;
  esac
}
if color_on; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
  # Soft 256-colour tones that read well on dark Termux themes:
  #   green = brand/commands · cyan = addresses · lavender = engine
  #   mint ok · amber warn · rose error (states also tint panel borders)
  C_BRAND=$'\033[38;5;114m'; C_ACC=$'\033[38;5;157m'
  C_CYA=$'\033[38;5;117m';   C_LAV=$'\033[38;5;146m'
  C_OK=$'\033[38;5;120m';    C_WARN=$'\033[38;5;179m'; C_ERR=$'\033[38;5;203m'
  C_BD=$'\033[2m\033[38;5;114m'
  C_BD_CYA=$'\033[2m\033[38;5;117m'
  C_BD_OK=$'\033[2m\033[38;5;120m'
  C_BD_WARN=$'\033[2m\033[38;5;179m'
  C_BD_ERR=$'\033[2m\033[38;5;203m'
  C_TLT=$'\033[1m\033[38;5;157m'
  C_TLT_CYA=$'\033[1m\033[38;5;117m'
  C_TLT_OK=$'\033[1m\033[38;5;120m'
  C_TLT_WARN=$'\033[1m\033[38;5;179m'
  C_TLT_ERR=$'\033[1m\033[38;5;203m'
else
  C_RESET=""; C_BOLD=""; C_DIM=""; C_BRAND=""; C_ACC=""; C_CYA=""; C_LAV=""
  C_OK=""; C_WARN=""; C_ERR=""; C_BD=""; C_BD_CYA=""; C_BD_OK=""; C_BD_WARN=""
  C_BD_ERR=""; C_TLT=""; C_TLT_CYA=""; C_TLT_OK=""; C_TLT_WARN=""; C_TLT_ERR=""
fi

# Animations need a terminal, independent of colour.
TTY_OUT=0; [ -t 1 ] && TTY_OUT=1

# Real terminal width. Bash only sets COLUMNS in interactive shells, so a
# `wearsic` run from a boot script could see it UNSET and assume 80 on a
# 45-column phone. Fall back to the terminal itself, then to 80.
term_cols() {
  local c="${COLUMNS:-}"
  case "$c" in
    ''|*[!0-9]*) if command -v tput >/dev/null 2>&1; then c="$(tput cols 2>/dev/null || true)"; fi ;;
  esac
  case "$c" in
    ''|*[!0-9]*) if command -v stty >/dev/null 2>&1; then c="$(stty size 2>/dev/null | awk '{print $2}')"; fi ;;
  esac
  case "$c" in ''|*[!0-9]*) c=80 ;; esac
  [ "$c" -lt 34 ] && c=34
  printf '%s' "$c"
}
COLS="$(term_cols)"
# Wrap long messages only when a human is looking: on a terminal, or when a
# width was handed to us. Piped/scripted output stays one line per message.
case "${COLUMNS:-}" in ''|*[!0-9]*) WRAP_OK="$TTY_OUT" ;; *) WRAP_OK=1 ;; esac
export COLUMNS="$COLS"

ESC="$(printf '\033')"

# Visible width of a string: colour codes stripped, then the CHARACTER count
# (bash counts multibyte characters, so ✓ ● … each take one column).
vis() { printf '%s' "$1" | sed "s/${ESC}\\[[0-9;]*m//g"; }

# Gradient wordmark, white → soft green (ASCII input: byte-safe anywhere).
grad_word() {
  local t="$1" l=${#1} i=0 ch sh out=""
  if ! color_on; then printf '%s' "$t"; return 0; fi
  while [ "$i" -lt "$l" ]; do
    ch="${t:$i:1}"
    if   [ "$l" -le 1 ]; then sh=114
    else sh=$(( 255 - (255 - 114) * i / (l - 1) )); fi
    if   [ "$sh" -gt 205 ]; then sh=255
    elif [ "$sh" -gt 170 ]; then sh=158
    elif [ "$sh" -gt 142 ]; then sh=120
    else sh=114; fi
    out="${out}${ESC}[38;5;${sh}m${ch}"
    i=$((i + 1))
  done
  printf '%s%s' "$out" "$C_RESET"
}

# Middle-elide: "downloading wears…v1.9.3.zip" — keeps both ends readable.
elide_mid() { # string maxwidth
  local s="$1" w="$2" keep h t
  if [ "$w" -lt 6 ] || [ ${#s} -le "$w" ]; then printf '%s' "$s"; return 0; fi
  keep=$(( w - 1 )); h=$(( keep * 2 / 3 )); t=$(( keep - h ))
  printf '%s…%s' "${s:0:h}" "${s:$(( ${#s} - t ))}"
}

# Head-elide paths: "…/wearsic-server".
elide_head() { # string maxwidth
  local s="$1" w="$2"
  if [ "$w" -lt 3 ] || [ ${#s} -le "$w" ]; then printf '%s' "$s"; return 0; fi
  printf '…%s' "${s:$(( ${#s} - (w - 1) ))}"
}

# Word-wrap PLAIN text to $2 columns; words longer than a whole line (paths,
# URLs) are hard-split. Every chunk is printed with $3 indent + $4 colour.
wrap_text() { # text width indent colour
  local text="$1" w="$2" ind="${3:-}" pre="${4:-}" line="" word rest
  [ "$w" -lt 4 ] && w=4
  for word in $text; do
    if [ ${#word} -gt "$w" ]; then
      if [ -n "$line" ]; then printf '%s%s%s%s\n' "$ind" "$pre" "$line" "$C_RESET"; line=""; fi
      rest="$word"
      while [ ${#rest} -gt "$w" ]; do
        printf '%s%s%s%s\n' "$ind" "$pre" "${rest:0:w}" "$C_RESET"
        rest="${rest:w}"
      done
      line="$rest"
      continue
    fi
    if [ -z "$line" ]; then line="$word"
    elif [ $(( ${#line} + 1 + ${#word} )) -le "$w" ]; then line="$line $word"
    else printf '%s%s%s%s\n' "$ind" "$pre" "$line" "$C_RESET"; line="$word"; fi
  done
  [ -n "$line" ] && printf '%s%s%s%s\n' "$ind" "$pre" "$line" "$C_RESET"
  return 0
}

# printf to stdout, or to stderr when the first argument is 1 (err/die).
msg_out() {
  local dest="$1"; shift
  if [ "$dest" = "1" ]; then printf "$@" >&2; else printf "$@"; fi
}

# One indented message line. On a terminal (or with a width handed in) long
# text wraps under itself instead of hitting the terminal edge raw.
msg_line() { # symbol text base-colour to-stderr
  local sym="$1" text="$2" lc="${3:-}" toerr="${4:-}" sp plain w first=1 line
  if [ "${WRAP_OK:-0}" != "1" ]; then
    msg_out "$toerr" '  %s%s%s%s\n' "$sym" "$lc" "$text" "$C_RESET"
    return 0
  fi
  sp="$(vis "$sym")"; plain="$(vis "$text")"
  w=$(( COLS - 4 - ${#sp} ))
  [ "$w" -lt 10 ] && w=10
  if [ ${#plain} -le "$w" ]; then
    msg_out "$toerr" '  %s%s%s%s\n' "$sym" "$lc" "$text" "$C_RESET"
    return 0
  fi
  while IFS= read -r line; do
    if [ "$first" = "1" ]; then
      msg_out "$toerr" '  %s%s%s%s\n' "$sym" "$lc" "$line" "$C_RESET"
      first=0
    else
      msg_out "$toerr" '  %*s%s%s%s\n' $(( ${#sp} )) '' "$lc" "$line" "$C_RESET"
    fi
  done < <(wrap_text "$plain" "$w" "" "")
  return 0
}

say()  { msg_line "" "$*" "" 0; }
note() { msg_line "" "$*" "" 0; }
dim()  { msg_line "" "$*" "$C_DIM" 0; }
ok()   { msg_line "${C_OK}✓${C_RESET} " "$*" "" 0; }
warn() { msg_line "${C_WARN}!${C_RESET} " "$*" "" 0; }
err()  { msg_line "${C_ERR}✗${C_RESET} " "$*" "" 1; }
die()  { err "$*"; exit 1; }

# One identity line per command, e.g. "  ♪ wearsic · status".
brand() {
  printf '\n  %s♪%s %s' "$C_ACC" "$C_RESET" "$(grad_word 'wearsic')"
  if [ -n "${1:-}" ]; then printf ' %s· %s%s' "$C_DIM" "$1" "$C_RESET"; fi
  printf '\n\n'
}

# Section header: a coloured side-bar glyph + bold name. $2 = green|cyan|
# lavender|amber — each group of commands gets its own hue.
section() {
  local hue="$C_ACC"
  case "${2:-}" in
    cyan) hue="$C_CYA" ;;
    lavender) hue="$C_LAV" ;;
    amber) hue="$C_WARN" ;;
  esac
  printf '\n  %s▍%s %s%s%s\n' "$hue" "$C_RESET" "$C_BOLD" "$1" "$C_RESET"
}

# Command list row (home / help). Wide terminals get the long description in
# a second column; narrow ones get the short one inline, or — when even that
# does not fit — the description drops to its own wrapped line. Never wraps
# mid-word (except a single word longer than the line).
item() { # cmd short-desc [long-desc]
  local cmd="$1" nd="$2" wd="${3:-$2}" desc clen room
  if [ "$COLS" -ge 78 ]; then
    desc="$wd"; clen=16; room=$(( COLS - 23 ))
    if [ ${#desc} -le "$room" ]; then
      printf '    %s%-16s%s %s%s%s\n' "$C_ACC" "$cmd" "$C_RESET" "$C_DIM" "$desc" "$C_RESET"
      return 0
    fi
  else
    desc="$nd"; clen="${ICOL:-9}"; [ ${#cmd} -gt "$clen" ] && clen=${#cmd}
    room=$(( COLS - 7 - clen ))
    if [ ${#desc} -le "$room" ]; then
      printf '    %s%-*s%s  %s%s%s\n' "$C_ACC" "$clen" "$cmd" "$C_RESET" "$C_DIM" "$desc" "$C_RESET"
      return 0
    fi
  fi
  printf '    %s%s%s\n' "$C_ACC" "$cmd" "$C_RESET"
  wrap_text "$desc" $(( COLS - 8 )) '      ' "$C_DIM"
}

# Aligned key/value row for status-style output. $3 = label column (default
# 12); values that do not fit wrap under their column instead of sticking out.
kv() {
  local lw="${3:-12}" plain vp
  plain="$(vis "$2")"
  if [ "${WRAP_OK:-0}" != "1" ] || [ $(( 4 + lw + 2 + ${#plain} )) -le "$COLS" ]; then
    printf '    %s%-*s%s  %s\n' "$C_DIM" "$lw" "$1" "$C_RESET" "$2"
    return 0
  fi
  vp=$(( 4 + lw + 2 ))
  wrap_text "$plain" $(( COLS - vp - 1 )) "$(printf '%*s' "$vp" '')" ""
}

# Coloured state dot: dot ok | warn | err | off
dot() {
  case "${1:-off}" in
    ok)   printf '%s●%s' "$C_OK" "$C_RESET" ;;
    warn) printf '%s●%s' "$C_WARN" "$C_RESET" ;;
    err)  printf '%s●%s' "$C_ERR" "$C_RESET" ;;
    *)    printf '%s●%s' "$C_DIM" "$C_RESET" ;;
  esac
}

# Spinner. Disabled when piped so scripted output stays line-clean.
SPIN_PID=""; SPIN_MSG=""
spinner_start() {
  SPIN_MSG="$1"
  if [ "$TTY_OUT" != "1" ]; then note "$1…"; return 0; fi
  printf '  '
  ( while :; do for f in $'\033[38;5;255m⠋' $'\033[38;5;158m⠙' $'\033[38;5;120m⠹' $'\033[38;5;114m⠸' $'\033[38;5;114m⠼' $'\033[38;5;120m⠴' $'\033[38;5;158m⠦' $'\033[38;5;255m⠧' $'\033[38;5;158m⠇' $'\033[38;5;120m⠏'; do printf '\b%s\033[0m' "$f"; sleep 0.09; done; done ) &
  SPIN_PID=$!
}
spinner_stop() {
  local msg="${2:-$SPIN_MSG}"
  if [ -n "$SPIN_PID" ]; then kill "$SPIN_PID" 2>/dev/null; wait "$SPIN_PID" 2>/dev/null; SPIN_PID=""; fi
  if [ "$TTY_OUT" = "1" ]; then printf '\b'; fi
  if [ "${1:-0}" = "0" ]; then ok "$msg"; else err "$msg"; fi
  SPIN_MSG=""
}

human_bytes() { # $1 = bytes -> 12.4M
  local b="${1:-0}"
  case "$b" in ''|*[!0-9]*) b=0 ;; esac
  if [ "$b" -ge 1048576 ]; then awk "BEGIN{printf \"%.1fM\", $b/1048576}";
  elif [ "$b" -ge 1024 ]; then awk "BEGIN{printf \"%.0fK\", $b/1024}";
  else printf '%sB' "$b"; fi
}

# Live progress bar. The fill runs through a green gradient; the label is NOT
# printed here (download_bar prints it once above) so the redrawn line fits
# any width. $1 = label (kept for call compatibility), $2 = pct, $3/$4 bytes.
draw_bar() {
  local pct="$2" have="$3" total="$4" i=0 bw sh fill bar="" track="" use_col=0 sizes=""
  local cols="${COLUMNS:-80}"
  case "$cols" in ''|*[!0-9]*) cols=80 ;; esac
  bw=$(( cols - 26 ))
  [ "$bw" -gt 24 ] && bw=24
  [ "$bw" -lt 10 ] && bw=10
  fill=$(( pct * bw / 100 ))
  command -v color_on >/dev/null 2>&1 && color_on && use_col=1
  while [ "$i" -lt "$bw" ]; do
    if [ "$i" -lt "$fill" ]; then
      if [ "$use_col" = "1" ]; then
        if [ "$bw" -gt 1 ]; then sh=$(( 114 + i * 43 / (bw - 1) )); else sh=157; fi
        bar="${bar}${ESC}[38;5;${sh}m█"
      else
        bar="${bar}█"
      fi
    else
      track="${track}░"
    fi
    i=$((i + 1))
  done
  sizes="$(human_bytes "$have") / $(human_bytes "$total")"
  printf '\r  %s%s%s%s  %s%3d%%%s  %s%-15s%s' \
    "$bar" "$C_RESET" "$C_DIM" "$track" "$C_ACC" "$pct" "$C_RESET" \
    "$C_DIM" "$sizes" "$C_RESET"
}

# Download with a live progress bar. The label is printed once, dim, above
# the redrawn bar; the bar itself is sized to the terminal, so narrow phones
# never see a wrapped mess. Spinner fallback when the server hides
# Content-Length (or output is piped). Returns curl's exit status.
download_bar() { # $1 = url, $2 = out file, $3 = label
  local url="$1" out="$2" label="${3:-download}"
  local total=""
  total="$(curl -fsSIL --max-time 15 "$url" 2>/dev/null | grep -i '^content-length:' | tail -1 | tr -d '\r' | awk '{print $2}')"
  case "$total" in ''|*[!0-9]*) total="" ;; esac
  if [ -z "$total" ] || [ "$TTY_OUT" != "1" ]; then
    spinner_start "$label"
    if curl -fL --retry 3 --retry-delay 2 -o "$out" "$url" >/dev/null 2>&1; then
      spinner_stop 0 "$label ($(du -h "$out" 2>/dev/null | cut -f1))"
    else
      spinner_stop 1 "$label"; return 1
    fi
    return 0
  fi
  printf '  %s%s%s\n' "$C_DIM" "$label" "$C_RESET"
  curl -fL --retry 3 --retry-delay 2 -o "$out" "$url" >/dev/null 2>&1 &
  local pid=$! have=0 pct=0
  while kill -0 "$pid" 2>/dev/null; do
    # curl creates $out only when its first bytes arrive: before that, an
    # unguarded `wc -c < "$out"` makes the SHELL's redirection print
    # "No such file or directory" (2>/dev/null on the command does not
    # silence a failed input redirection — it is applied after it).
    if [ -e "$out" ]; then
      have="$(wc -c < "$out" 2>/dev/null || echo 0)"
    else
      have=0
    fi
    case "$have" in ''|*[!0-9]*) have=0 ;; esac
    pct=$(( have * 100 / total ))
    [ "$pct" -gt 100 ] && pct=100
    draw_bar "$label" "$pct" "$have" "$total"
    sleep 0.2
  done
  wait "$pid" || { printf '\n'; return 1; }
  draw_bar "$label" 100 "$total" "$total"
  printf '\n  %s✓%s %sdownloaded (%s)%s\n' "$C_OK" "$C_RESET" "$C_DIM" "$(human_bytes "$total")" "$C_RESET"
  return 0
}

# Install a file ATOMICALLY: copy to a sibling temp, then rename into place.
# A plain `cp` over a file bash is CURRENTLY EXECUTING truncates that very
# inode, so the running shell's next buffered read lands mid-line in the new
# content and it dies with "syntax error near unexpected token" — exactly
# what corrupted `wearsic update` while it refreshed its own installed copy.
# A rename swaps the inode instead: the running shell keeps reading the old
# content, intact, and the new file is live for the next command.
replace_file() { # $1 = source file, $2 = destination file
  local src="$1" dst="$2" tmp
  tmp="$(mktemp "$(dirname "$dst")/.wearsic-new.XXXXXX")" || return 1
  if cp "$src" "$tmp" && mv -f "$tmp" "$dst"; then
    return 0
  fi
  rm -f "$tmp" 2>/dev/null
  return 1
}

# Rounded panel. The width is decided by the TERMINAL, not the content, so
# all panels line up with each other: full width minus 4 (capped at 76 so
# wide desktops still get a tidy column). Long content wraps (word-aware;
# paths and URLs hard-split) INSIDE the border. The optional second argument
# (ok|warn|err|cyan) tints border + title for verdict panels.
BOX_TITLE=""; BOX_BODY=""; BOX_N=0; BOX_HUE=""
box_begin() { BOX_TITLE="$1"; BOX_HUE="${2:-acc}"; BOX_BODY=""; BOX_N=0; }
box_line() {
  if [ "$BOX_N" = "0" ]; then BOX_BODY="$1"; else BOX_BODY="$BOX_BODY
$1"; fi
  BOX_N=$((BOX_N + 1))
}
# Dim label + value row inside a panel. $3 = label column (default 10).
box_kv() { box_line "   ${C_DIM}$(printf '%-*s' "${3:-10}" "$1")${C_RESET}  $2"; }
# Panel capability row: "✓ label" or "✗ label" ($2 = true|false).
box_check() {
  if [ "${2:-false}" = "true" ]; then
    box_line "   ${C_OK}✓${C_RESET} $1"
  else
    box_line "   ${C_ERR}✗${C_RESET} ${C_WARN}$1${C_RESET}"
  fi
}
box_end() {
  local tw pw bd tlt i n p line ind
  tw=$(( COLS - 4 )); [ "$tw" -gt 76 ] && tw=76
  pw=$(( tw - 4 ))
  case "$BOX_HUE" in
    ok)   bd="$C_BD_OK";   tlt="$C_TLT_OK" ;;
    warn) bd="$C_BD_WARN"; tlt="$C_TLT_WARN" ;;
    err)  bd="$C_BD_ERR";  tlt="$C_TLT_ERR" ;;
    cyan) bd="$C_BD_CYA";  tlt="$C_TLT_CYA" ;;
    *)    bd="$C_BD";      tlt="$C_TLT" ;;
  esac
  p="$(vis "$BOX_TITLE")"
  n=$(( tw - ${#p} - 5 )); [ "$n" -lt 2 ] && n=2
  printf '  %s╭─%s %s%s%s ' "$bd" "$C_RESET" "$tlt" "$BOX_TITLE" "$C_RESET"
  i=0; while [ "$i" -lt "$n" ]; do printf '%s─%s' "$bd" "$C_RESET"; i=$((i + 1)); done
  printf '%s╮%s\n' "$bd" "$C_RESET"
  while IFS= read -r line; do
    p="$(vis "$line")"
    if [ ${#p} -le "$pw" ]; then
      printf '  %s│%s %s' "$bd" "$C_RESET" "$line"
      i=$(( pw - ${#p} ))
      while [ "$i" -gt 0 ]; do printf ' '; i=$((i - 1)); done
      printf ' %s│%s\n' "$bd" "$C_RESET"
    else
      # Keep the content's own left margin: word wrapping splits on spaces,
      # so the leading indent is re-applied to every segment here.
      ind="$(printf '%s' "$p" | sed -n 's/^\( *\).*$/\1/p')"
      while IFS= read -r seg; do
        p="$(vis "$seg")"
        printf '  %s│%s %s' "$bd" "$C_RESET" "$seg"
        i=$(( pw - ${#p} ))
        while [ "$i" -gt 0 ]; do printf ' '; i=$((i - 1)); done
        printf ' %s│%s\n' "$bd" "$C_RESET"
      done < <(wrap_text "${p#"$ind"}" $(( pw - ${#ind} )) "$ind" "")
    fi
  done <<EOF
$BOX_BODY
EOF
  printf '  %s╰' "$bd"
  i=$(( tw - 2 )); while [ "$i" -gt 0 ]; do printf '─'; i=$((i - 1)); done
  printf '╯%s\n' "$C_RESET"
  BOX_TITLE=""; BOX_BODY=""; BOX_N=0; BOX_HUE=""
}

# Dim horizontal rule, terminal width (sets long guidance apart).
hr() {
  local i=$(( COLS - 4 ))
  printf '\n  %s' "$C_DIM"
  while [ "$i" -gt 0 ]; do printf '─'; i=$((i - 1)); done
  printf '%s\n' "$C_RESET"
}

# ── small data helpers for the status-style commands ────────────────────────
# HTTP GET that never fails the caller: body/code/milliseconds land in
# HTTP_BODY / HTTP_CODE / HTTP_MS and the caller decides how to render.
http_get() { # $1 = url, $2 = timeout seconds (default 5)
  local t="${2:-5}" out tsec
  HTTP_BODY=""; HTTP_CODE="000"; HTTP_MS=""
  out="$(curl -s -m "$t" -w $'\n%{http_code} %{time_total}' "$1" 2>/dev/null)" || true
  case "$out" in
    *$'\n'*)
      HTTP_BODY="${out%$'\n'*}"
      out="${out##*$'\n'}"
      HTTP_CODE="${out%% *}"
      tsec="${out#* }"
      case "$tsec" in
        ''|*[!0-9.]*) HTTP_MS="" ;;
        *) HTTP_MS="$(awk -v t="$tsec" 'BEGIN{printf "%.0f", t*1000}')" ;;
      esac ;;
  esac
}

# The /health and /ready schemas are fixed: first-occurrence readers.
# awk index() finds the FIRST match, so a top-level key wins over a nested
# one with the same name (e.g. top-level "status":"ok" vs update.status).
# Empty output = the field is missing (or null).
json_tail() { # text right after the first "key":
  printf '%s' "$1" | awk -v k="\"$2\":" '{ n = index($0, k); if (n > 0) print substr($0, n + length(k)) }'
}
jstr() {
  json_tail "$1" "$2" | awk '{
    if (substr($0, 1, 1) != "\"") next
    s = substr($0, 2); m = index(s, "\"")
    if (m > 0) print substr(s, 1, m - 1)
  }'
}
jnum() {
  json_tail "$1" "$2" | awk '{
    s = $0; sub(/^[ \t]*/, "", s)
    if (substr(s, 1, 1) !~ /[0-9]/) next
    sub(/[^0-9].*$/, "", s); print s
  }'
}
jbool() {
  json_tail "$1" "$2" | awk '{
    s = $0; sub(/^[ \t]*/, "", s)
    if (substr(s, 1, 4) == "true") print "true"
    else if (substr(s, 1, 5) == "false") print "false"
  }'
}
jobj() { # content between the braces of the first "key":{...}
  printf '%s' "$1" | awk -v k="\"$2\":{" '{
    n = index($0, k); if (n == 0) next
    s = substr($0, n + length(k)); m = index(s, "}")
    if (m > 0) print substr(s, 1, m - 1)
  }'
}

# "2d 4h" / "1h 07m" / "3m 04s" / "12s".
human_duration() {
  local s="${1:-0}" d h m
  d=$((s / 86400)); h=$(((s % 86400) / 3600)); m=$(((s % 3600) / 60))
  if [ "$d" -gt 0 ]; then printf '%dd %dh' "$d" "$h"
  elif [ "$h" -gt 0 ]; then printf '%dh %02dm' "$h" "$m"
  elif [ "$m" -gt 0 ]; then printf '%dm %02ds' "$m" "$((s % 60))"
  else printf '%ds' "$s"; fi
}

# Process uptime. Primary source /proc (no ps dependence); when the kernel
# hides /proc/uptime from apps, fall back to ps -o etime. Empty on failure.
proc_uptime() { # $1 = pid
  local pid="${1:-}" stat rest start hz up secs
  case "$pid" in ''|*[!0-9]*) return 0 ;; esac
  if [ -r "/proc/$pid/stat" ] && [ -r /proc/uptime ]; then
    stat="$(cat "/proc/$pid/stat" 2>/dev/null)" || stat=""
    rest="${stat##*\) }"                                 # strip "pid (comm) "
    start="$(printf '%s' "$rest" | awk '{print $20}')"   # starttime, in ticks
    case "$start" in
      ''|*[!0-9]*) ;;
      *)
        hz="$(getconf CLK_TCK 2>/dev/null || true)"
        case "$hz" in ''|*[!0-9]*) hz=100 ;; esac
        up="$(awk '{print $1}' /proc/uptime 2>/dev/null)"
        case "$up" in
          ''|*[!0-9.]*) ;;
          *) secs="$(awk -v u="$up" -v s="$start" -v h="$hz" 'BEGIN{d=u-s/h; if (d<0) d=0; printf "%d", d}')" ;;
        esac ;;
    esac
  fi
  if [ -z "${secs:-}" ]; then
    # Fallback: [[dd-]hh:]mm:ss from ps. procps (Termux) takes -p; BusyBox
    # ps has no -p, so ask for etime+pid and match the row ourselves.
    local et d h m s
    et="$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ')"
    if [ -z "$et" ]; then
      et="$(ps -o etime=,pid= 2>/dev/null | awk -v p="$pid" '$NF == p { print $1; exit }')"
    fi
    case "$et" in
      *-*:*:*) d="${et%%-*}"; rest="${et#*-}"; h="${rest%%:*}"; rest="${rest#*:}"
               m="${rest%%:*}"; s="${rest##*:}"; secs=$((10#$d * 86400 + 10#$h * 3600 + 10#$m * 60 + 10#$s)) ;;
      *:*:*)   h="${et%%:*}"; rest="${et#*:}"; m="${rest%%:*}"; s="${rest##*:}"
               secs=$((10#$h * 3600 + 10#$m * 60 + 10#$s)) ;;
      *:*)     m="${et%%:*}"; s="${et##*:}"; secs=$((10#$m * 60 + 10#$s)) ;;
      *)       secs="" ;;
    esac
  fi
  [ -n "${secs:-}" ] || return 0
  human_duration "$secs"
}

# Doctor row: state ok|warn|err|off, name, detail. The detail column starts
# at column 23; long detail text wraps with continuation lines aligned under
# it and a single overlong token (a path) is head-elided, never split.
doctor_row() {
  local sym name="$2" text="$3" plain w pfx first=1 seg
  case "$1" in
    ok)   sym="${C_OK}✓${C_RESET}" ;;
    warn) sym="${C_WARN}!${C_RESET}" ;;
    err)  sym="${C_ERR}✗${C_RESET}" ;;
    *)    sym="${C_DIM}—${C_RESET}" ;;
  esac
  printf '    %s %s%-16s%s ' "$sym" "$C_DIM" "$name" "$C_RESET"
  w=$(( COLS - 23 ))
  [ "$w" -lt 10 ] && w=10
  pfx="$(printf '%23s' '')"
  plain="$(vis "$text")"
  if [ "${WRAP_OK:-0}" != "1" ] || [ ${#plain} -le "$w" ]; then
    printf '%s\n' "$text"
    return 0
  fi
  case "$plain" in
    *" "*)
      while IFS= read -r seg; do
        if [ "$first" = "1" ]; then printf '%s\n' "$seg"; first=0
        else printf '%s%s\n' "$pfx" "$seg"; fi
      done < <(wrap_text "$plain" "$w" "" "")
      ;;
    *)
      printf '%s\n' "$(elide_head "$plain" "$w")"
      ;;
  esac
}

installed() { [ -f "$RUN" ] || die "Not installed (no $DEST). Run the one-line installer first."; }

# --- .env parsing (never `source` it — values may contain spaces) ----
env_value() {  # $1 = key name
  [ -f "$ENV_FILE" ] || return 0
  sed -n "s/^$1=//p" "$ENV_FILE" | tail -1 | tr -d '\r\n'
}

port() { local p; p="$(env_value PORT)"; [ -n "$p" ] || p="8080"; printf '%s' "$p"; }

# SHA-256 of a file (any platform: sha256sum or shasum).
file_hash() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" 2>/dev/null | awk '{print $1}'
  else
    shasum -a 256 "$1" 2>/dev/null | awk '{print $1}'
  fi
}
api_key() { env_value WEARSIC_API_KEY; }

# --- process helpers (pgrep when available, ps fallback) --------------
pids_for() {  # $1 = literal string to find in process command lines
  # Direct /proc scan — no pgrep/ps dependency, identical on Termux,
  # Alpine/busybox (whose pgrep -f misbehaves) and CI. Literal match
  # (not regex): dots in class names must not become wildcards.
  # Self-exclusion: $$ is the script PID; $BASHPID is a transient
  # command-substitution subshell sharing our cmdline. Both are filtered
  # so a supervisor never "finds itself" and refuses to start.
  local pat="$1" self="$$" sub="${BASHPID:-$$}" d pid cmdline
  for d in /proc/[0-9]*; do
    pid="${d#/proc/}"
    [ "$pid" = "$self" ] && continue
    [ "$pid" = "$sub" ] && continue
    cmdline="$( { tr '\0' ' ' < "$d/cmdline"; } 2>/dev/null )" || continue
    [ -z "$cmdline" ] && continue
    case "$cmdline" in
      *"$pat"*) printf '%s\n' "$pid" ;;
    esac
  done
}

supervisor_running() { [ -n "$(pids_for "$RUN")" ]; }

# THIS install's engine process(es). Matching only the main class was a
# landmine: with two wearsic installs on one device (e.g. a test copy),
# `wearsic stop` in one killed the other's server too. The JVM command
# line carries the install path (classpath + launcher script), so require
# the main class AND $DEST.
server_pids() {
  local self="$$" sub="${BASHPID:-$$}" d pid cmdline
  for d in /proc/[0-9]*; do
    pid="${d#/proc/}"
    [ "$pid" = "$self" ] && continue
    [ "$pid" = "$sub" ] && continue
    cmdline="$( { tr '\0' ' ' < "$d/cmdline"; } 2>/dev/null )" || continue
    case "$cmdline" in
      *"com.wearsic.server.ApplicationKt"*) ;;
      *) continue ;;
    esac
    case "$cmdline" in
      *"$DEST"*) printf '%s\n' "$pid" ;;
    esac
  done
}

# The launcher script exec()s into the JVM, so the process command line is
# the java main class, not the script path — match BOTH.
server_running() { [ -n "$(server_pids)" ]; }

health_ok() {
  curl -sf -m 5 "http://127.0.0.1:$(port)/health" >/dev/null 2>&1
}

# Best-effort LAN IP of this device — the address to enter on the watch.
# Termux ships neither iproute2 nor net-tools, and recent Android removed
# the old `dhcp.wlan0.ipaddress` property, so every probe we know is tried
# in order until one answers:
#   1. termux-wifi-connectioninfo (termux-api add-on; exact Wi-Fi address)
#   2. ip / iproute2             (Wi-Fi first, then the default-route NIC)
#   3. ifconfig / net-tools      (same order)
#   4. Android's own tools       (/system/bin/ip, /system/bin/ifconfig —
#      absolute paths because Termux's PATH never contains /system/bin)
#   5. getprop                   (older Androids expose dhcp.*.ipaddress)
#   6. /proc/net/fib_trie        (last resort, legacy domains only)
# Prints NOTHING when every probe fails: callers print guidance instead of
# a fake `http://<phone-IP>` placeholder (users typed it verbatim).

# Default-route interface from /proc (no tools needed). Empty when the file
# is unreadable (modern-target app domains cannot read it; Termux can).
default_iface() {
  awk '$2 == "00000000" && $1 != "lo" { print $1; exit }' \
    "${WEARSIC_PROC_NET:-/proc/net}/route" 2>/dev/null
}

lan_ip() {
  local ip="" iface sys
  iface="$(default_iface)"
  sys="${WEARSIC_SYS_BIN:-/system/bin}"

  # 1. Termux:API — exact Wi-Fi address, no parsing games.
  if command -v termux-wifi-connectioninfo >/dev/null 2>&1; then
    ip="$(termux-wifi-connectioninfo 2>/dev/null \
      | sed -n 's/.*"ip"[[:space:]]*:[[:space:]]*"\([0-9.]\{7,\}\)".*/\1/p' | head -1)"
  fi

  # 2. iproute2.
  if [ -z "$ip" ] && command -v ip >/dev/null 2>&1; then
    ip="$(ip -4 -o addr show wlan0 2>/dev/null | sed -n 's/.*inet \([0-9.]\+\).*/\1/p' | head -1)"
    if [ -z "$ip" ] && [ -n "$iface" ]; then
      ip="$(ip -4 -o addr show "$iface" 2>/dev/null | sed -n 's/.*inet \([0-9.]\+\).*/\1/p' | head -1)"
    fi
  fi

  # 3. net-tools ifconfig (present only when the user installed it).
  if [ -z "$ip" ] && command -v ifconfig >/dev/null 2>&1; then
    ip="$(ifconfig wlan0 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]\+\).*/\1/p; s/.*inet \([0-9.]\+\).*/\1/p' | head -1)"
    if [ -z "$ip" ] && [ -n "$iface" ]; then
      ip="$(ifconfig "$iface" 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]\+\).*/\1/p; s/.*inet \([0-9.]\+\).*/\1/p' | head -1)"
    fi
  fi

  # 4. Android's own tools, by absolute path.
  if [ -z "$ip" ] && [ -x "$sys/ip" ]; then
    ip="$("$sys/ip" -4 -o addr show wlan0 2>/dev/null | sed -n 's/.*inet \([0-9.]\+\).*/\1/p' | head -1)"
    if [ -z "$ip" ] && [ -n "$iface" ]; then
      ip="$("$sys/ip" -4 -o addr show "$iface" 2>/dev/null | sed -n 's/.*inet \([0-9.]\+\).*/\1/p' | head -1)"
    fi
  fi
  if [ -z "$ip" ] && [ -x "$sys/ifconfig" ]; then
    ip="$("$sys/ifconfig" wlan0 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]\+\).*/\1/p; s/.*inet \([0-9.]\+\).*/\1/p' | head -1)"
    if [ -z "$ip" ] && [ -n "$iface" ]; then
      ip="$("$sys/ifconfig" "$iface" 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]\+\).*/\1/p; s/.*inet \([0-9.]\+\).*/\1/p' | head -1)"
    fi
  fi

  # 5. Android properties (older devices; gone on many Android 10+ builds).
  local gp=""
  if command -v getprop >/dev/null 2>&1; then gp="getprop"
  elif [ -x "$sys/getprop" ]; then gp="$sys/getprop"; fi
  if [ -z "$ip" ] && [ -n "$gp" ]; then
    ip="$("$gp" dhcp.wlan0.ipaddress 2>/dev/null | tr -d '\r\n')"
    if [ -z "$ip" ]; then
      ip="$("$gp" 2>/dev/null \
        | sed -n 's/^\[[^]]*[Ww][Ll][Aa][Nn][^]]*\.ipaddress\]: \[\([0-9.]*\)\]$/\1/p' | head -1)"
    fi
  fi

  # 6. Pure /proc.
  if [ -z "$ip" ] && [ -n "$iface" ]; then
    ip="$(awk '/32 host/ { print f } { f = $2 }' "${WEARSIC_PROC_NET:-/proc/net}/fib_trie" 2>/dev/null \
      | grep -E '^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)' | head -1)"
  fi

  # Only a plain dotted quad leaves this function.
  if printf '%s' "$ip" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
    printf '%s' "$ip"
  fi
}

write_env_key() {  # $1 = key
  if grep -q '^WEARSIC_API_KEY=' "$ENV_FILE" 2>/dev/null; then
    sed -i "s|^WEARSIC_API_KEY=.*|WEARSIC_API_KEY=$1|" "$ENV_FILE"
  else
    printf '\n# Shared secret — enter the same value in the watch app (Settings → API Key)\nWEARSIC_API_KEY=%s\n' "$1" >> "$ENV_FILE"
  fi
}

write_env_value() {  # $1 = key, $2 = value (may contain spaces/;)
  if grep -q "^$1=" "$ENV_FILE" 2>/dev/null; then
    sed -i "s|^$1=.*|$1=$2|" "$ENV_FILE"
  else
    printf '%s=%s\n' "$1" "$2" >> "$ENV_FILE"
  fi
}

# http://<this-phone>:<port>, or EMPTY when no local IP can be found —
# callers show guidance instead of a fake `http://<phone-IP>` placeholder
# (a placeholder looks like a ready-to-type address, and users typed it).
server_url() {
  local ip; ip="$(lan_ip)"
  if [ -n "$ip" ]; then printf 'http://%s:%s' "$ip" "$(port)"; fi
}

show_pairing() {
  local key url; key="$(api_key)"; url="$(server_url)"
  box_begin "connect your watch" cyan
  box_line ""
  if [ -n "$url" ]; then
    box_line "   ${C_CYA}${url}${C_RESET}"
  else
    box_line "   ${C_WARN}couldn't detect this phone's IP${C_RESET}"
    box_line "   ${C_DIM}is Wi-Fi on? then rerun:${C_RESET} ${C_ACC}wearsic url${C_RESET}"
    box_line "   ${C_DIM}watch elsewhere? public URL:${C_RESET} ${C_ACC}wearsic funnel${C_RESET}"
  fi
  box_line ""
  if [ -n "$key" ]; then
    box_kv "key" "${C_ACC}${key}${C_RESET}" 4
  else
    box_kv "key" "${C_WARN}not set — anyone on your network can use this server${C_RESET}" 4
  fi
  box_line ""
  box_line "   ${C_DIM}Wearsic app > Settings > enter both values.${C_RESET}"
  box_line "   ${C_DIM}or send them over adb:${C_RESET} ${C_ACC}wearsic pair${C_RESET}"
  box_end
}

cmd_start() {
  installed
  brand "start"
  if health_ok; then
    ok "already running on port $(port)"
    printf '\n'
    show_pairing
    return 0
  fi
  if supervisor_running; then
    note "supervisor is running — waiting for the server…"
  else
    note "starting (keep WiFi on; unrestricted battery for Termux helps)…"
    # bash explicitly so the launcher starts on any system (its shebang
    # points at the Termux bash path); identical behavior on Termux.
    ( cd "$DEST" && nohup bash "$RUN" >/dev/null 2>&1 & )
  fi
  # Wait up to ~30s for /health (the supervisor installs ffmpeg on
  # first start, which can take a while).
  local i
  spinner_start "waiting for the server"
  for i in $(seq 1 30); do
    health_ok && break
    sleep 1
  done
  if health_ok; then
    spinner_stop 0 "server is up — the self-healing supervisor is watching it"
    printf '\n'
    show_pairing
  else
    spinner_stop 1 "server did not answer within 30s"
    dim "check the logs: wearsic logs"
    return 1
  fi
}

cmd_stop() {
  installed
  brand "stop"
  local pids pid i
  pids="$(pids_for "$RUN"; server_pids)"
  [ -n "$pids" ] || { note "server is not running."; return 0; }
  note "stopping…"
  # Stop the supervisor first: its trap kills the JVM — but the trap only
  # runs after its current (up to 30s) sleep ends. So poll for REAL exit and
  # escalate to kill -9, otherwise a "stopped" supervisor lingers and the
  # next start is refused by its singleton guard.
  for pid in $(pids_for "$RUN"); do kill "$pid" 2>/dev/null; done
  i=0
  while [ "$i" -lt 8 ] && [ -n "$(pids_for "$RUN")" ]; do
    sleep 1
    i=$((i + 1))
  done
  for pid in $(pids_for "$RUN"); do kill -9 "$pid" 2>/dev/null; done
  # Then the JVM itself (graceful, then force), in case the supervisor was
  # already dead and left it behind.
  pids="$(server_pids)"
  for pid in $pids; do kill "$pid" 2>/dev/null; done
  sleep 1
  pids="$(server_pids)"
  for pid in $pids; do kill -9 "$pid" 2>/dev/null; done
  # Wait until the port actually goes quiet: graceful shutdown drains
  # in-flight streams for seconds, during which /health still answers —
  # without this wait `status` right after `stop` wrongly reports healthy.
  spinner_start "waiting for the port to go quiet"
  i=0
  while [ "$i" -lt 20 ] && health_ok; do
    sleep 1
    i=$((i + 1))
  done
  spinner_stop 0 "stopped"
}

cmd_restart() { cmd_stop; cmd_start; }

# Exit codes (documented in usage + README):
#   0 = running and healthy   1 = error   3 = not running   4 = running but unhealthy
cmd_status() {
  installed
  brand "status"
  local P; P="$(port)"
  if health_ok; then
    local body ver ex pid up ok_n fail_n rate meta url
    http_get "http://127.0.0.1:$P/health"
    body="$HTTP_BODY"
    ver="$(jstr "$body" version)"
    ex="$(jobj "$body" extraction)"
    ok_n="$(jnum "$ex" successCount)"; fail_n="$(jnum "$ex" failureCount)"; rate="$(jnum "$ex" failureRatePercent)"
    pid="$(server_pids | head -1)"
    up=""; [ -n "$pid" ] && up="$(proc_uptime "$pid")"
    meta=""; [ -n "$up" ] && meta="up $up"
    [ -n "$pid" ] && meta="${meta:+$meta · }pid $pid"
    url="$(server_url)"
    box_begin "status" ok
    box_line ""
    box_line "   $(dot ok) ${C_OK}running and healthy${C_RESET}"
    [ -n "$meta" ] && box_line "     ${C_DIM}${meta}${C_RESET}"
    box_line ""
    if [ -n "$url" ]; then
      box_line "   ${C_CYA}${url}${C_RESET}"
    else
      box_line "   ${C_WARN}address not detected — wearsic url${C_RESET}"
    fi
    box_line ""
    box_kv "version" "v${ver:-unknown}"
    [ -n "$ok_n" ] && box_kv "engine" "${ok_n} ok · ${fail_n:-0} failed (${rate:-0}%)"
    if [ -n "$(api_key)" ]; then
      box_kv "watch key" "set"
    else
      box_kv "watch key" "${C_WARN}not set — the server is open on your network${C_RESET}"
    fi
    box_end
    return 0
  elif supervisor_running; then
    box_begin "status" warn
    box_line ""
    box_line "   $(dot warn) ${C_WARN}not healthy${C_RESET}"
    box_line "   ${C_DIM}the supervisor is up but the server is not answering${C_RESET}"
    box_line ""
    box_kv "check" "wearsic logs"
    box_end
    return 4
  else
    box_begin "status" err
    box_line ""
    box_line "   $(dot err) ${C_ERR}stopped${C_RESET}"
    box_line ""
    box_kv "start it" "wearsic start"
    box_end
    return 3
  fi
}

cmd_logs() {
  installed
  brand "logs"
  [ -f "$LOG" ] || die "No log yet ($LOG). Start the server first."
  dim "following $LOG — Ctrl+C to exit"
  printf '\n'
  tail -f "$LOG"
}

cmd_health() {
  installed
  local P; P="$(port)"
  if [ "${1:-}" = "--json" ]; then
    curl -sf -m 5 "http://127.0.0.1:$P/health" \
      || die "No response — is the server running? (wearsic start)"
    printf '\n'
    return 0
  fi
  brand "health"
  http_get "http://127.0.0.1:$P/health"
  [ "$HTTP_CODE" = "200" ] || die "No response — is the server running? (wearsic start)"
  local body st ver st_state ex ok_n fail_n rate cons last_err extra upd stg
  body="$HTTP_BODY"
  st="$(jstr "$body" status)"
  ver="$(jstr "$body" version)"
  if [ "$st" = "ok" ]; then
    st_state="$(dot ok) ${C_OK}ok${C_RESET}"
  else
    st_state="$(dot warn) ${C_WARN}${st:-unknown}${C_RESET}"
  fi
  ex="$(jobj "$body" extraction)"
  ok_n="$(jnum "$ex" successCount)"; fail_n="$(jnum "$ex" failureCount)"
  rate="$(jnum "$ex" failureRatePercent)"; cons="$(jnum "$ex" consecutiveFailures)"
  last_err="$(jstr "$ex" lastError)"
  extra=""
  if [ -n "$cons" ] && [ "$cons" -gt 0 ] 2>/dev/null; then extra=" · $cons in a row"; fi
  upd="$(jobj "$body" update)"
  stg="$(jstr "$upd" stagedVersion)"
  box_begin "health"
  box_line ""
  box_line "   ${st_state}   ${C_DIM}127.0.0.1:${P} · ${HTTP_MS:-?}ms${C_RESET}"
  box_line ""
  box_kv "version" "v${ver:-unknown} · $(jstr "$body" serverName)"
  if [ "$(jbool "$body" transcoderAvailable)" = "true" ]; then
    box_kv "transcoder" "available"
  else
    box_kv "transcoder" "${C_WARN}unavailable — pkg install ffmpeg${C_RESET}"
  fi
  box_kv "extraction" "${ok_n:-0} ok · ${fail_n:-0} failed (${rate:-0}%)$extra"
  [ -n "$last_err" ] && box_kv "last error" "$last_err"
  box_kv "update" "$(jstr "$upd" status)"
  [ -n "$stg" ] && box_kv "staged" "v$stg — applies on next restart"
  box_kv "crashes" "$(jnum "$body" crashCount)"
  box_kv "cdn" "$(jnum "$body" upstreamRefusals) refused"
  box_end
}

cmd_url() { installed; brand "url"; show_pairing; }

cmd_ip() {
  brand "ip"
  local ip; ip="$(lan_ip)"
  if [ -n "$ip" ]; then
    kv "WiFi IP" "${C_CYA}${ip}${C_RESET}" 10
    printf '\n'
    return 0
  fi
  die "no local IP found — is Wi-Fi on? (Termux: pkg install iproute2, or check Android Settings → Wi-Fi)"
}

