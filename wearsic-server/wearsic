# ── crash-safe update ─────────────────────────────────────────────────────
# Downloads the latest release, VERIFIES its published SHA-256, stages and
# validates it, swaps it in with a kept rollback copy, restarts and health-
# checks. On ANY failure the previous engine is restored — a failed update
# can never leave a broken server. Your database, .env (API key), downloads/
# and wearsic-state/ are never touched.
#
# Overrides (mainly for testing/mirrors): WEARSIC_ZIP_URL, WEARSIC_SHA_URL,
# WEARSIC_REPO, WEARSIC_UPDATE_TIMEOUT (health wait seconds, default 60).
# Echoes the newest release ZIP url from the release LIST, INCLUDING
# pre-releases. $1 = repo slug. Empty output = nothing installable.
#
# releases?per_page=10 is newest-first and includes pre-releases (and drafts,
# but a draft has no published assets). Rather than correlating
# tag_name/draft/assets across JSON objects with grep — which is exactly the
# class of bug the old funnel command had — this probes each tag's
# PREDICTABLE asset url and takes the first that actually exists. A draft, or
# a release shipping no server package, simply 404s and is skipped.
resolve_pre_zip_url() {
  local repo="$1" json t code u
  json="$(curl -fsSL --retry 2 "https://api.github.com/repos/${repo}/releases?per_page=10" 2>/dev/null || true)"
  [ -n "$json" ] || return 0
  for t in $(printf '%s' "$json" \
    | grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' \
    | sed -E 's/.*"([^"]*)"$/\1/'); do
    [ -n "$t" ] || continue
    u="https://github.com/${repo}/releases/download/${t}/wearsic-server-termux-${t}.zip"
    code="$(curl -sI -L -o /dev/null -m 20 -w '%{http_code}' "$u" 2>/dev/null || printf '000')"
    [ "$code" = "200" ] && { printf '%s' "$u"; return 0; }
  done
  return 0
}

cmd_update() {
  installed
  local repo work zip sha expected actual stage src

  # `wearsic update [--pre]`. GitHub's releases/latest endpoint EXCLUDES
  # pre-releases, so a beta build (e.g. v1.6.1) is invisible to a plain
  # `wearsic update` — it silently keeps serving v1.6.0. --pre is the
  # explicit opt-in that walks the release LIST instead, so ordinary users
  # stay on stable and testers can pull a beta on demand.
  local include_pre=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --pre|-p) include_pre=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) die "Unknown option for 'wearsic update': $1 (valid: --pre)" ;;
    esac
  done
  [ "$include_pre" = "1" ] && say "Including pre-releases (--pre)."

  repo="${WEARSIC_REPO:-Aeroflash-r1/wearsic}"
  work="$(mktemp -d)" || die "could not create a temp dir"
  # EXIT (not RETURN) so the temp dir is cleaned even when die() exits.
  trap 'rm -rf "$work"' EXIT

  say "Checking for the latest Wearsic server release…"
  local zip_url sha_url json tag
  zip_url="${WEARSIC_ZIP_URL:-}"
  sha_url="${WEARSIC_SHA_URL:-}"
  if [ -z "$zip_url" ] && [ "$include_pre" = "1" ]; then
    zip_url="$(resolve_pre_zip_url "$repo")"
    [ -n "$zip_url" ] || die "no release with a server package was found for ${repo} — check your internet connection"
    # Print the bare tag (e.g. "v1.6.2"), not the asset filename.
    local chosen="${zip_url##*/}"
    chosen="${chosen#wearsic-server-termux-}"; chosen="${chosen%.zip}"
    say "Newest release (incl. pre-releases): $chosen"
  fi
  if [ -z "$zip_url" ]; then
    json="$(curl -fsSL --retry 2 "https://api.github.com/repos/${repo}/releases/latest" 2>/dev/null || true)"
    zip_url="$(printf '%s' "$json" \
      | grep -o '"browser_download_url"[^"]*"[^"]*wearsic-server-termux[^"]*\.zip"' \
      | head -1 \
      | sed -E 's/.*"(https[^"]*)".*/\1/')"
    if [ -z "$zip_url" ]; then
      tag="$(printf '%s' "$json" | grep -o '"tag_name"[^"]*"[^"]*"' | head -1 | sed -E 's/.*"([^"]*)"$/\1/')"
      [ -n "$tag" ] && zip_url="https://github.com/${repo}/releases/latest/download/wearsic-server-termux-${tag}.zip"
    fi
    [ -n "$zip_url" ] || die "could not find a release for ${repo} — check your internet connection"
  fi
  [ -n "$sha_url" ] || sha_url="${zip_url}.sha256"

  zip="$work/update.zip"
  sha="$work/update.zip.sha256"
  download_bar "$zip_url" "$zip" "downloading $(basename "$zip_url")" \
    || die "download failed — nothing was changed"
  [ -s "$zip" ] || die "downloaded file is empty — nothing was changed"

  # Authenticity: refuse to install any release without a published checksum.
  spinner_start "fetching checksum"
  if ! curl -fsSL --retry 2 -o "$sha" "$sha_url" 2>/dev/null || [ ! -s "$sha" ]; then
    spinner_stop 1 "checksum"
    die "no SHA-256 checksum at $sha_url — refusing to install unverified code"
  fi
  spinner_stop 0 "checksum"
  expected="$(awk '{print $1; exit}' "$sha" | tr 'A-F' 'a-f')"
  spinner_start "verifying SHA-256"
  if command -v sha256sum >/dev/null 2>&1; then
    actual="$(sha256sum "$zip" | awk '{print $1}')"
  else
    actual="$(shasum -a 256 "$zip" | awk '{print $1}')"
  fi
  if [ "$expected" != "$actual" ]; then
    spinner_stop 1 "SHA-256"
    die "SHA-256 MISMATCH — the download is corrupt or tampered. Nothing was changed."
  fi
  spinner_stop 0 "SHA-256 verified"

  # Stage + validate BEFORE touching the active engine.
  stage="$work/stage"
  mkdir -p "$stage"
  spinner_start "extracting update"
  if ! unzip -t "$zip" >/dev/null 2>&1; then
    spinner_stop 1 "extracting update"
    die "the downloaded file is not a valid ZIP — nothing was changed"
  fi
  if ! unzip -oq "$zip" -d "$stage"; then
    spinner_stop 1 "extracting update"
    die "could not extract the update — nothing was changed"
  fi
  spinner_stop 0 "extracted"
  src="$stage/wearsic-server"
  [ -d "$src" ] || src="$stage"
  [ -f "$src/bin/wearsic-server" ] && [ -n "$(ls -A "$src/lib" 2>/dev/null)" ] && [ -f "$src/run-termux.sh" ] \
    || die "the update package is incomplete (bin/lib/run-termux.sh) — nothing was changed"
  ok "update package validated"

  # Was it running? Update should end with the server back up if it was.
  local was_running=0
  if server_running || supervisor_running; then was_running=1; fi
  [ "$was_running" = "1" ] && { say "Stopping the server for the swap…"; cmd_stop; }

  # Crash-safe swap: prepare COMPLETE copies first, keep the old engine as
  # bin.prev/lib.prev until the new one passes its health check.
  say "Installing the update…"
  rm -rf "$DEST/bin.new" "$DEST/lib.new"
  cp -r "$src/bin" "$DEST/bin.new" && cp -r "$src/lib" "$DEST/lib.new" \
    || { rm -rf "$DEST/bin.new" "$DEST/lib.new"; die "could not stage the new engine (disk full?) — the current engine is untouched"; }
  rm -rf "$DEST/bin.prev" "$DEST/lib.prev"
  if [ -d "$DEST/bin" ]; then
    mv "$DEST/bin" "$DEST/bin.prev" && mv "$DEST/lib" "$DEST/lib.prev" \
      || { rm -rf "$DEST/bin.new" "$DEST/lib.new"; die "swap failed — the current engine is untouched"; }
  fi
  if ! mv "$DEST/bin.new" "$DEST/bin" || ! mv "$DEST/lib.new" "$DEST/lib" || [ ! -f "$DEST/bin/wearsic-server" ]; then
    # Half-swapped: restore the previous known-good engine immediately.
    rm -rf "$DEST/bin" "$DEST/lib"
    [ -d "$DEST/bin.prev" ] && mv "$DEST/bin.prev" "$DEST/bin"
    [ -d "$DEST/lib.prev" ] && mv "$DEST/lib.prev" "$DEST/lib"
    die "the swap did not complete — the previous engine was restored"
  fi
  for f in run-termux.sh .env.example README.md; do
    [ -f "$src/$f" ] && cp "$src/$f" "$DEST/$f"
  done
  chmod +x "$DEST/run-termux.sh" "$DEST/bin/wearsic-server" 2>/dev/null || true
  # Fingerprint of the engine we just installed: after the restart we check
  # the ON-DISK engine still matches it, so an (auto)rollback by the
  # supervisor can never masquerade as a successful update.
  local new_hash
  new_hash="$(file_hash "$DEST/bin/wearsic-server")"

  # Refresh the CLI copy(s) — the code only, never config.
  local bindir
  for bindir in "${PREFIX:-/nonexistent}/bin" "$HOME/.local/bin" "$HOME/bin"; do
    if [ -f "$bindir/wearsic" ] && [ -f "$src/wearsic" ]; then
      cp "$src/wearsic" "$bindir/wearsic" && chmod +x "$bindir/wearsic"
    fi
  done
  [ -f "$src/wearsic" ] && cp "$src/wearsic" "$DEST/wearsic" && chmod +x "$DEST/wearsic" 2>/dev/null
  ok "update installed (previous engine kept for rollback)"

  # Bring it up and PROVE it is healthy; otherwise roll back.
  local timeout i
  timeout="${WEARSIC_UPDATE_TIMEOUT:-60}"
  if [ "$was_running" = "1" ]; then
    say "Starting the updated server…"
    cmd_start >/dev/null 2>&1 || true
  else
    say "Server was stopped — starting it briefly to validate the update…"
    cmd_start >/dev/null 2>&1 || true
  fi
  i=0
  while [ "$i" -lt "$timeout" ]; do
    health_ok && break
    i=$((i + 1))
    sleep 1
  done

  if health_ok && [ "$(file_hash "$DEST/bin/wearsic-server")" = "$new_hash" ]; then
    rm -rf "$DEST/bin.prev" "$DEST/lib.prev"
    ok "update complete — server healthy on port $(port)"
    [ "$was_running" = "1" ] || { cmd_stop >/dev/null 2>&1; say "Server stopped again (it was not running before the update)."; }
    return 0
  fi

  # Healthy but NOT the engine we installed: the supervisor's own
  # never-healthy rollback already restored the previous engine.
  if health_ok; then
    warn "the new engine failed to start — the previous engine was restored automatically"
    warn "update rolled back — the server is running the previous version"
    return 1
  fi

  # New engine never became healthy — roll back to the previous one.
  # NOTE: the supervisor may have already rolled back by itself (its own
  # never-healthy rollback consumes bin.prev). Check BEFORE deleting
  # anything, so a restored good engine can never be destroyed here.
  warn "the updated server did not become healthy — rolling back…"
  cmd_stop >/dev/null 2>&1 || true
  if [ -d "$DEST/bin.prev" ]; then
    rm -rf "$DEST/bin" "$DEST/lib"
    mv "$DEST/bin.prev" "$DEST/bin"
    mv "$DEST/lib.prev" "$DEST/lib"
    chmod +x "$DEST/bin/wearsic-server" 2>/dev/null
    ok "previous engine restored"
    cmd_start >/dev/null 2>&1 || true
    i=0
    while [ "$i" -lt "$timeout" ]; do
      health_ok && break
      i=$((i + 1))
      sleep 1
    done
    if health_ok; then
      warn "update rolled back — the server is running the previous version"
    else
      warn "rollback restored the files but the server is not healthy — see: wearsic logs"
    fi
  elif [ -f "$DEST/bin/wearsic-server" ]; then
    ok "the previous engine is already in place (supervisor rolled back)"
    cmd_start >/dev/null 2>&1 || true
  else
    warn "no rollback copy existed — run the installer again:"
    warn "  curl -fsSL https://raw.githubusercontent.com/Aeroflash-r1/wearsic/main/install.sh | bash"
  fi
  return 1
}

# Installed vs running engine version (from /health when available).
cmd_version() {
  installed
  brand "version"
  local ver
  http_get "http://127.0.0.1:$(port)/health" 3
  ver="$(jstr "$HTTP_BODY" version)"
  if [ -n "$ver" ]; then
    kv "engine" "v$ver ${C_DIM}(running)${C_RESET}"
  else
    kv "engine" "${C_WARN}not running — wearsic start${C_RESET}"
  fi
  printf '\n'
}

# /ready: can the server serve music RIGHT NOW?
cmd_ready() {
  installed
  local P; P="$(port)"
  if [ "${1:-}" = "--json" ]; then
    curl -sf -m 5 "http://127.0.0.1:$P/ready" \
      || die "No /ready response — is the server running? (wearsic start)"
    printf '\n'
    return 0
  fi
  brand "ready"
  http_get "http://127.0.0.1:$P/ready"
  [ "$HTTP_CODE" != "000" ] || die "No response — is the server running? (wearsic start)"
  local body rd db ex tc ver
  body="$HTTP_BODY"
  rd="$(jbool "$body" ready)"; db="$(jbool "$body" database)"
  ex="$(jbool "$body" extractor)"; tc="$(jbool "$body" transcoder)"
  ver="$(jstr "$body" engineVersion)"
  local rd_state rd_color rd_text
  if [ "$rd" = "true" ]; then rd_state=ok; rd_color="$C_OK"; rd_text="ready"
  else rd_state=warn; rd_color="$C_WARN"; rd_text="not ready"; fi
  printf '  %s %s%s%s   %shttp://127.0.0.1:%s · %sms%s\n' \
    "$(dot "$rd_state")" "$rd_color" "$rd_text" "$C_RESET" "$C_DIM" "$P" "${HTTP_MS:-?}" "$C_RESET"
  checkline "database" "$db"
  checkline "music engine" "$ex"
  checkline "audio conversion" "$tc"
  printf '\n'
  if [ "$rd" = "true" ]; then
    box_begin "ready - the watch can play music"
    box_line ""
    box_line "   engine v${ver:-unknown}"
    box_end
    return 0
  fi
  box_begin "NOT READY - playback will fail"
  box_line ""
  [ "$db" != "true" ] && box_line "   database: check free storage and permissions"
  [ "$ex" != "true" ] && box_line "   music engine: run wearsic update, then check the logs"
  [ "$tc" != "true" ] && box_line "   audio conversion: pkg install ffmpeg"
  box_end
  return 1
}

# End-to-end environment diagnostics. Prints only the PRESENCE of the API
# key, never its value; never prints cookies or other secrets.
# Exit codes: 0 = READY, 1 = problems found.
cmd_doctor() {
  local fails=0 warns=0
  brand "doctor"

  section "System"
  if command -v java >/dev/null 2>&1; then
    doctor_row "java" ok "$(java -version 2>&1 | head -1 | tr -d '"' | cut -c1-52)"
  else
    doctor_row "java" err "missing — pkg install -y openjdk-17"; fails=$((fails+1))
  fi

  if command -v ffmpeg >/dev/null 2>&1; then
    doctor_row "ffmpeg" ok "present"
  else
    doctor_row "ffmpeg" warn "missing — rare Opus/WebM songs will 503 (pkg install ffmpeg)"; warns=$((warns+1))
  fi

  local avail; avail="$(df -k "$DEST" 2>/dev/null | awk 'NR==2 {print $4}')"
  case "$avail" in
    ''|*[!0-9]*) doctor_row "storage" warn "free space unknown"; warns=$((warns+1)) ;;
    *) if [ "$avail" -lt 102400 ]; then
         doctor_row "storage" warn "only $((avail / 1024))MB free — clean up $DEST"; warns=$((warns+1))
       elif [ "$avail" -ge 1048576 ]; then
         doctor_row "storage" ok "$((avail / 1024 / 1024))GB free"
       else
         doctor_row "storage" ok "$((avail / 1024))MB free"
       fi ;;
  esac

  if [ -n "${PREFIX:-}" ] && [ -d "${PREFIX:-/nonexistent}/bin" ]; then
    doctor_row "termux" ok "$PREFIX"
  else
    doctor_row "termux" off "not Termux"; warns=$((warns+1))
  fi

  section "Server"
  if [ -x "$DEST/bin/wearsic-server" ] && [ -f "$DEST/run-termux.sh" ]; then
    doctor_row "install" ok "$DEST"
  else
    doctor_row "install" err "not installed in $DEST"; fails=$((fails+1))
  fi

  if supervisor_running; then
    doctor_row "supervisor" ok "running"
  else
    doctor_row "supervisor" err "not running — wearsic start"; fails=$((fails+1))
  fi

  local pid; pid="$(server_pids | head -1)"
  if [ -n "$pid" ]; then
    local up; up="$(proc_uptime "$pid")"
    doctor_row "process" ok "pid $pid${up:+ · up $up}"
  else
    doctor_row "process" err "not running"; fails=$((fails+1))
  fi

  local P health ready_body hms rms
  P="$(port)"
  http_get "http://127.0.0.1:$P/health"
  health="$HTTP_BODY"; hms="$HTTP_MS"
  if [ "$HTTP_CODE" = "200" ]; then
    local v; v="$(jstr "$health" version)"
    doctor_row "health" ok "200 OK · ${hms:-?}ms · v${v:-unknown}"
  else
    health=""
    doctor_row "health" err "no response — wearsic start"; fails=$((fails+1))
  fi

  http_get "http://127.0.0.1:$P/ready"
  ready_body="$HTTP_BODY"; rms="$HTTP_MS"
  if printf '%s' "$ready_body" | grep -q '"ready"[[:space:]]*:[[:space:]]*true'; then
    doctor_row "readiness" ok "ready · ${rms:-?}ms"
  elif [ -n "$ready_body" ]; then
    doctor_row "readiness" err "not ready"; fails=$((fails+1))
    if printf '%s' "$ready_body" | grep -q '"database"[[:space:]]*:[[:space:]]*false'; then
      doctor_row "database probe" err "check free storage and database permissions"
    fi
    if printf '%s' "$ready_body" | grep -q '"extractor"[[:space:]]*:[[:space:]]*false'; then
      doctor_row "music engine" err "run wearsic update; inspect wearsic logs for upstream challenges"
    fi
  elif [ -n "$health" ]; then
    doctor_row "readiness" off "no /ready (engine older than 1.4.0)"; warns=$((warns+1))
  else
    doctor_row "readiness" err "no response"; fails=$((fails+1))
  fi

  # API key: presence only — the value is never printed.
  if [ -n "$(api_key)" ]; then
    doctor_row "api key" ok "set"
  else
    doctor_row "api key" warn "NOT set — server is OPEN on your network (fine for LAN, never public)"; warns=$((warns+1))
  fi

  if [ -f "$DEST/wearsic.db" ]; then
    doctor_row "database" ok "wearsic.db"
  else
    doctor_row "database" off "not created yet (appears on first start)"; warns=$((warns+1))
  fi

  section "Engine"
  if [ -n "$health" ]; then
    local ver consec canary ex_obj ok_n fail_n rate
    ver="$(jstr "$health" version)"
    ex_obj="$(jobj "$health" extraction)"
    consec="$(jnum "$ex_obj" consecutiveFailures)"
    canary="$(jbool "$health" canaryHealthy)"
    doctor_row "version" ok "v${ver:-unknown}"

    ok_n="$(jnum "$ex_obj" successCount)"
    fail_n="$(jnum "$ex_obj" failureCount)"
    rate="$(jnum "$ex_obj" failureRatePercent)"
    doctor_row "extraction" ok "${ok_n:-0} ok · ${fail_n:-0} failed (${rate:-0}%)"

    if [ -n "$consec" ] && [ "$consec" -ge 6 ] 2>/dev/null; then
      doctor_row "extractor" err "$consec consecutive failures — engine broken? self-heal should be staging an update"; fails=$((fails+1))
    else
      doctor_row "extractor" ok "consecutive failures: ${consec:-0}"
    fi

    case "$canary" in
      true) doctor_row "canary" ok "healthy" ;;
      "")   doctor_row "canary" off "not reported" ;;
      *)    doctor_row "canary" off "$canary" ;;
    esac

    local upd; upd="$(jobj "$health" update)"
    case "$(jstr "$upd" status)" in
      staged) doctor_row "engine update" off "v$(jstr "$upd" stagedVersion) staged — applies on next restart" ;;
      "")     doctor_row "engine update" off "not reported" ;;
      *)      doctor_row "engine update" ok "$(jstr "$upd" status)" ;;
    esac

    if [ "$(jbool "$health" transcoderAvailable)" = "false" ]; then
      doctor_row "audio conversion" warn "unavailable — pkg install -y ffmpeg"; warns=$((warns+1))
    fi

    local crashes; crashes="$(jnum "$health" crashCount)"
    if [ -n "$crashes" ] && [ "$crashes" -gt 0 ] 2>/dev/null; then
      doctor_row "crashes" warn "$crashes recorded — see state/crashes + wearsic-server.log"; warns=$((warns+1))
    else
      doctor_row "crashes" ok "${crashes:-0}"
    fi

    local refusals; refusals="$(jnum "$health" upstreamRefusals)"
    if [ -n "$refusals" ] && [ "$refusals" -ge 10 ] 2>/dev/null; then
      doctor_row "cdn refusals" warn "$refusals refused ranges — throttled network, not a broken engine"; warns=$((warns+1))
    else
      doctor_row "cdn refusals" ok "${refusals:-0}"
    fi
  else
    doctor_row "engine" off "server not responding — wearsic start"
  fi

  section "Network"
  local ip; ip="$(lan_ip)"
  if [ -n "$ip" ]; then
    doctor_row "wifi" ok "$ip"
  else
    doctor_row "wifi" err "no WiFi IP — is WiFi on?"; fails=$((fails+1))
  fi

  # Tailscale / Funnel: only ever reported ACTIVE when confirmed, and the
  # reason is always spelled out — "not active" alone gave no way to tell a
  # dead daemon from a logged-out phone.
  if command -v tailscale >/dev/null 2>&1; then
    local ts_st; ts_st="$(ts_state)"
    case "$ts_st" in
      Running)    doctor_row "tailscale" ok "connected" ;;
      NeedsLogin) doctor_row "tailscale" warn "installed, not logged in — for a public URL run: tailscale up"; warns=$((warns+1)) ;;
      Stopped)    doctor_row "tailscale" warn "node stopped — for a public URL run: tailscale up"; warns=$((warns+1)) ;;
      Starting)   doctor_row "tailscale" off "starting up"; warns=$((warns+1)) ;;
      *)          doctor_row "tailscale" warn "daemon not responding — run: tailscaled-start"; warns=$((warns+1)) ;;
    esac
    # Tailscale is OPTIONAL: the server plays fine over LAN without it, so
    # all of the above stay warnings and never flip doctor's exit code.
    # Making a logged-out phone a hard failure would report "NOT READY" for
    # a server that is in fact serving music perfectly over WiFi.
    if tailscale funnel status 2>/dev/null | grep -qi 'https://'; then
      doctor_row "funnel" ok "active"
    elif [ "$ts_st" != "Running" ]; then
      # Funnel cannot work until the node is connected — say THAT instead of
      # reporting a separate, confusing Funnel failure.
      doctor_row "funnel" off "blocked: Tailscale not connected"
    else
      doctor_row "funnel" off "not active — start with: wearsic funnel"
    fi
  else
    doctor_row "tailscale" off "not installed"
    doctor_row "funnel" off "not installed"
  fi

  printf '\n'
  if [ "$fails" -eq 0 ]; then
    box_begin "READY"
    box_line ""
    if [ "$warns" -gt 0 ]; then
      box_line "   $warns warning(s) - nothing blocking playback."
    else
      box_line "   everything looks good."
    fi
    box_line ""
    box_line "   wearsic url     connect the watch"
    box_line "   wearsic logs    when playback misbehaves"
    box_end
    return 0
  fi
  box_begin "NOT READY"
  box_line ""
  box_line "   $fails problem(s), $warns warning(s)."
  box_line "   Fix the problem rows above, then run wearsic doctor again."
  box_end
  return 1
}

usage() {
  printf '\n  %s♪ wearsic%s %s· music for your watch%s\n\n' "$C_BRAND" "$C_RESET" "$C_DIM" "$C_RESET"
  printf '  %sServer%s\n' "$C_BOLD" "$C_RESET"
  printf '    %s%-20s%s %s\n' "$C_BRAND" "start" "$C_RESET" "start the server (self-healing supervisor)"
  printf '    %s%-20s%s %s\n' "$C_BRAND" "stop" "$C_RESET" "stop the server"
  printf '    %s%-20s%s %s\n' "$C_BRAND" "restart" "$C_RESET" "stop, then start"
  printf '    %s%-20s%s %s\n' "$C_BRAND" "status" "$C_RESET" "is it running? healthy? which version? (exit 0/3/4)"
  printf '    %s%-20s%s %s\n' "$C_BRAND" "logs" "$C_RESET" "follow live logs (Ctrl+C to exit)"
  printf '    %s%-20s%s %s\n' "$C_BRAND" "doctor" "$C_RESET" "full checkup — exit 0 means READY"
  printf '\n  %sWatch pairing%s\n' "$C_BOLD" "$C_RESET"
  printf '    %s%-20s%s %s\n' "$C_BRAND" "url" "$C_RESET" "server URL + key to enter on the watch"
  printf '    %s%-20s%s %s\n' "$C_BRAND" "ip" "$C_RESET" "this phone's WiFi IP"
  printf '    %s%-20s%s %s\n' "$C_BRAND" "api-key [new]" "$C_RESET" "show or set the API key"
  printf '\n  %sEngine%s\n' "$C_BOLD" "$C_RESET"
  printf '    %s%-20s%s %s\n' "$C_BRAND" "update [--pre]" "$C_RESET" "update to the latest release (verified, rollback-safe)"
  printf '    %s%-20s%s %s\n' "$C_BRAND" "version" "$C_RESET" "installed + running engine version"
  printf '    %s%-20s%s %s\n' "$C_BRAND" "health [--json]" "$C_RESET" "server snapshot (--json for scripts)"
  printf '    %s%-20s%s %s\n' "$C_BRAND" "ready [--json]" "$C_RESET" "can the server play music right now?"
  printf '\n  %sRemote access%s\n' "$C_BOLD" "$C_RESET"
  printf '    %s%-20s%s %s\n' "$C_BRAND" "funnel" "$C_RESET" "public HTTPS URL (Tailscale Funnel)"
  printf '    %s%-20s%s %s\n' "$C_BRAND" "public" "$C_RESET" "public URL recipes (Tailscale / Cloudflare)"
  printf '    %s%-20s%s %s\n' "$C_BRAND" "cookies [cookie]" "$C_RESET" "set the YouTube cookie (fixes bot-wall errors)"
  printf '\n  %sThe classic nested form works too: wearsic server start%s\n\n' "$C_DIM" "$C_RESET"
}

# --- dispatch ---------------------------------------------------------
# Both forms work: flat (`wearsic start`) and classic nested
# (`wearsic server start`).
case "${1:-}" in
  server)
    case "${2:-}" in
      start)   cmd_start ;;
      stop)    cmd_stop ;;
      restart) cmd_restart ;;
      status)  cmd_status ;;
      logs)    cmd_logs ;;
      health)  shift 2; cmd_health "$@" ;;
      ready)   shift 2; cmd_ready "$@" ;;
      url)     cmd_url ;;
      ip)      cmd_ip ;;
      version) cmd_version ;;
      update)  shift 2; cmd_update "$@" ;;
      doctor)  cmd_doctor ;;
      api)
        case "${3:-}" in
          key) shift 3; cmd_api_key "$@" ;;
          *) usage; exit 2 ;;
        esac ;;
      api-key) shift 2; cmd_api_key "$@" ;;
      cookies) shift 2; cmd_cookies "$@" ;;
      funnel)  cmd_funnel ;;
      public)  cmd_public ;;
      "") usage; exit 2 ;;
      *) die "Unknown command: wearsic server $2 — run 'wearsic' for the list" ;;
    esac ;;
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   cmd_restart ;;
  status)    cmd_status ;;
  logs)      cmd_logs ;;
  health)    shift; cmd_health "$@" ;;
  ready)     shift; cmd_ready "$@" ;;
  url)       cmd_url ;;
  ip)        cmd_ip ;;
  version)   cmd_version ;;
  update)    shift; cmd_update "$@" ;;
  doctor)    cmd_doctor ;;
  api-key|apikey) shift; cmd_api_key "$@" ;;
  cookies)   shift; cmd_cookies "$@" ;;
  funnel)    cmd_funnel ;;
  public)    cmd_public ;;
  ""|help|-h|--help) usage ;;
  *) die "Unknown command: wearsic $1 — run 'wearsic' for the list" ;;
esac
