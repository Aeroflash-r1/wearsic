#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────
# wearsic — the everyday command for the Wearsic server.
#
#   wearsic start             start the server (self-healing supervisor)
#   wearsic stop              stop the server
#   wearsic restart           stop, then start
#   wearsic status            running? healthy? which version? (exit 0/3/4)
#   wearsic logs              follow live logs (Ctrl+C to exit)
#   wearsic health [--json]   server snapshot (--json for scripts)
#   wearsic url               Server URL + API key for the watch
#   wearsic api-key [new]     show / change the API key
#   wearsic update            update to the latest release (verified + rollback)
#   wearsic sideload [tag]    install the release watch app onto the watch (adb)
#   wearsic pair [url]        send address + key to the watch (adb, no typing)
#   wearsic doctor            check the whole setup (exit 0 = READY)
#
# Also available: ready [--json], ip, version, cookies [str], funnel, public.
# The classic nested form keeps working: `wearsic server start` etc.
#
# Output follows the usual conventions: colour only on a terminal
# (WEARSIC_COLOR=always|never overrides, NO_COLOR disables), plain when
# piped, so `wearsic health --json | jq` and CI logs stay clean.
#
# Installed to $PREFIX/bin by install.sh. Finds the server in
# $WEARSIC_DIR, else ~/wearsic-server.
# ─────────────────────────────────────────────────────────────────────
set -u

# Where the engine lives. Resolution order:
#   1. $WEARSIC_DIR                       — explicit override, always wins
#   2. <repo>/build/install/wearsic-server — a Gradle build in this checkout
#   3. ~/wearsic-server                   — the packaged Termux install
# The repo layout comes first so `wearsic` works straight after
# `./gradlew :wearsic-server:installDist`, with no copy step.
detect_dest() {
    if [ -n "${WEARSIC_DIR:-}" ]; then
        echo "$WEARSIC_DIR"
        return
    fi
    local repo_build
    # The :wearsic-server Gradle project builds into wearsic-server/build/.
    repo_build="$CLI_DIR/build/install/wearsic-server"
    if [ -x "$repo_build/bin/wearsic-server" ]; then
        echo "$repo_build"
        return
    fi
    echo "$HOME/wearsic-server"
}

# The supervisor script ships in the packaged install; in a repo checkout it
# lives next to this CLI.
detect_run() {
    if [ -f "$DEST/run-termux.sh" ]; then
        echo "$DEST/run-termux.sh"
    elif [ -f "$CLI_DIR/run-termux.sh" ]; then
        echo "$CLI_DIR/run-termux.sh"
    else
        echo "$DEST/run-termux.sh"
    fi
}

CLI_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
DEST="$(detect_dest)"
RUN="$(detect_run)"
LOG="$DEST/wearsic-server.log"
ENV_FILE="$DEST/.env"

# Blueprint for every command: gradient wordmark, rounded full-width panels,
# a soft multi-tone palette, two-space indent. Colour follows the usual
# conventions:
#
#   WEARSIC_COLOR=auto|always|never    auto = colour only on a real terminal
#   NO_COLOR=1                         force plain output
#
# Piped output is plain, so `wearsic health | jq` and CI logs never carry
# escape codes.
color_on() {
  [ -n "${NO_COLOR:-}" ] && return 1
  case "${WEARSIC_COLOR:-auto}" in
    never) return 1 ;;
    always) return 0 ;;
    *) [ -t 1 ] ;;
  esac
}
if color_on; then
  C_RESET=$'\033[0m'; C_BOLD=$'\033[1m'; C_DIM=$'\033[2m'
  # Soft 256-colour tones that read well on dark Termux themes:
  #   green = brand/commands · cyan = addresses · lavender = engine
  #   mint ok · amber warn · rose error (states also tint panel borders)
  C_BRAND=$'\033[38;5;114m'; C_ACC=$'\033[38;5;157m'
  C_CYA=$'\033[38;5;117m';   C_LAV=$'\033[38;5;146m'
  C_OK=$'\033[38;5;120m';    C_WARN=$'\033[38;5;179m'; C_ERR=$'\033[38;5;203m'
  C_BD=$'\033[2m\033[38;5;114m'
  C_BD_CYA=$'\033[2m\033[38;5;117m'
  C_BD_OK=$'\033[2m\033[38;5;120m'
  C_BD_WARN=$'\033[2m\033[38;5;179m'
  C_BD_ERR=$'\033[2m\033[38;5;203m'
  # Chip backgrounds (48;5;N) power the status pills that read like app
  # badges: filled, rounded by their own padding, one per state.
  C_CHIP_OK_BG=22;   C_CHIP_OK_FG=120
  C_CHIP_WARN_BG=58; C_CHIP_WARN_FG=179
  C_CHIP_ERR_BG=52;  C_CHIP_ERR_FG=203
  C_CHIP_INFO_BG=23; C_CHIP_INFO_FG=117
  C_CHIP_OFF_BG=236; C_CHIP_OFF_FG=245
  C_TLT=$'\033[1m\033[38;5;157m'
  C_TLT_CYA=$'\033[1m\033[38;5;117m'
  C_TLT_OK=$'\033[1m\033[38;5;120m'
  C_TLT_WARN=$'\033[1m\033[38;5;179m'
  C_TLT_ERR=$'\033[1m\033[38;5;203m'
else
  C_RESET=""; C_BOLD=""; C_DIM=""; C_BRAND=""; C_ACC=""; C_CYA=""; C_LAV=""
  C_OK=""; C_WARN=""; C_ERR=""; C_BD=""; C_BD_CYA=""; C_BD_OK=""; C_BD_WARN=""
  C_BD_ERR=""; C_TLT=""; C_TLT_CYA=""; C_TLT_OK=""; C_TLT_WARN=""; C_TLT_ERR=""
  C_CHIP_OK_BG=0; C_CHIP_OK_FG=0; C_CHIP_WARN_BG=0; C_CHIP_WARN_FG=0
  C_CHIP_ERR_BG=0; C_CHIP_ERR_FG=0; C_CHIP_INFO_BG=0; C_CHIP_INFO_FG=0
  C_CHIP_OFF_BG=0; C_CHIP_OFF_FG=0
fi

# Animations need a terminal, independent of colour.
TTY_OUT=0; [ -t 1 ] && TTY_OUT=1

# Real terminal width. Bash only sets COLUMNS in interactive shells, so a
# `wearsic` run from a boot script could see it UNSET and assume 80 on a
# 45-column phone. Fall back to the terminal itself, then to 80.
term_cols() {
  local c="${COLUMNS:-}"
  case "$c" in
    ''|*[!0-9]*) if command -v tput >/dev/null 2>&1; then c="$(tput cols 2>/dev/null || true)"; fi ;;
  esac
  case "$c" in
    ''|*[!0-9]*) if command -v stty >/dev/null 2>&1; then c="$(stty size 2>/dev/null | awk '{print $2}')"; fi ;;
  esac
  case "$c" in ''|*[!0-9]*) c=80 ;; esac
  [ "$c" -lt 34 ] && c=34
  printf '%s' "$c"
}
COLS="$(term_cols)"
# Wrap long messages only when a human is looking: on a terminal, or when a
# width was handed to us. Piped/scripted output stays one line per message.
case "${COLUMNS:-}" in ''|*[!0-9]*) WRAP_OK="$TTY_OUT" ;; *) WRAP_OK=1 ;; esac
export COLUMNS="$COLS"

ESC="$(printf '\033')"

# Visible width of a string: colour codes stripped, then the CHARACTER count
# (bash counts multibyte characters, so ✓ ● … each take one column).
vis() { printf '%s' "$1" | sed "s/${ESC}\\[[0-9;]*m//g"; }

# Gradient wordmark, white → soft green (ASCII input: byte-safe anywhere).
grad_word() {
  local t="$1" l=${#1} i=0 ch sh out=""
  if ! color_on; then printf '%s' "$t"; return 0; fi
  while [ "$i" -lt "$l" ]; do
    ch="${t:$i:1}"
    if   [ "$l" -le 1 ]; then sh=114
    else sh=$(( 255 - (255 - 114) * i / (l - 1) )); fi
    if   [ "$sh" -gt 205 ]; then sh=255
    elif [ "$sh" -gt 170 ]; then sh=158
    elif [ "$sh" -gt 142 ]; then sh=120
    else sh=114; fi
    out="${out}${ESC}[38;5;${sh}m${ch}"
    i=$((i + 1))
  done
  printf '%s%s' "$out" "$C_RESET"
}

# Middle-elide: "downloading wears…v1.9.4.zip" — keeps both ends readable.
elide_mid() { # string maxwidth
  local s="$1" w="$2" keep h t
  if [ "$w" -lt 6 ] || [ ${#s} -le "$w" ]; then printf '%s' "$s"; return 0; fi
  keep=$(( w - 1 )); h=$(( keep * 2 / 3 )); t=$(( keep - h ))
  printf '%s…%s' "${s:0:h}" "${s:$(( ${#s} - t ))}"
}

# Head-elide paths: "…/wearsic-server".
elide_head() { # string maxwidth
  local s="$1" w="$2"
  if [ "$w" -lt 3 ] || [ ${#s} -le "$w" ]; then printf '%s' "$s"; return 0; fi
  printf '…%s' "${s:$(( ${#s} - (w - 1) ))}"
}

# Word-wrap PLAIN text to $2 columns; words longer than a whole line (paths,
# URLs) are hard-split. Every chunk is printed with $3 indent + $4 colour.
wrap_text() { # text width indent colour
  local text="$1" w="$2" ind="${3:-}" pre="${4:-}" line="" word rest
  [ "$w" -lt 4 ] && w=4
  for word in $text; do
    if [ ${#word} -gt "$w" ]; then
      if [ -n "$line" ]; then printf '%s%s%s%s\n' "$ind" "$pre" "$line" "$C_RESET"; line=""; fi
      rest="$word"
      while [ ${#rest} -gt "$w" ]; do
        printf '%s%s%s%s\n' "$ind" "$pre" "${rest:0:w}" "$C_RESET"
        rest="${rest:w}"
      done
      line="$rest"
      continue
    fi
    if [ -z "$line" ]; then line="$word"
    elif [ $(( ${#line} + 1 + ${#word} )) -le "$w" ]; then line="$line $word"
    else printf '%s%s%s%s\n' "$ind" "$pre" "$line" "$C_RESET"; line="$word"; fi
  done
  [ -n "$line" ] && printf '%s%s%s%s\n' "$ind" "$pre" "$line" "$C_RESET"
  return 0
}

# printf to stdout, or to stderr when the first argument is 1 (err/die).
msg_out() {
  local dest="$1"; shift
  if [ "$dest" = "1" ]; then printf "$@" >&2; else printf "$@"; fi
}

# One indented message line. On a terminal (or with a width handed in) long
# text wraps under itself instead of hitting the terminal edge raw.
msg_line() { # symbol text base-colour to-stderr
  local sym="$1" text="$2" lc="${3:-}" toerr="${4:-}" sp plain w first=1 line
  if [ "${WRAP_OK:-0}" != "1" ]; then
    msg_out "$toerr" '  %s%s%s%s\n' "$sym" "$lc" "$text" "$C_RESET"
    return 0
  fi
  sp="$(vis "$sym")"; plain="$(vis "$text")"
  w=$(( COLS - 4 - ${#sp} ))
  [ "$w" -lt 10 ] && w=10
  if [ ${#plain} -le "$w" ]; then
    msg_out "$toerr" '  %s%s%s%s\n' "$sym" "$lc" "$text" "$C_RESET"
    return 0
  fi
  while IFS= read -r line; do
    if [ "$first" = "1" ]; then
      msg_out "$toerr" '  %s%s%s%s\n' "$sym" "$lc" "$line" "$C_RESET"
      first=0
    else
      msg_out "$toerr" '  %*s%s%s%s\n' $(( ${#sp} )) '' "$lc" "$line" "$C_RESET"
    fi
  done < <(wrap_text "$plain" "$w" "" "")
  return 0
}

say()  { msg_line "" "$*" "" 0; }
note() { msg_line "" "$*" "" 0; }
dim()  { msg_line "" "$*" "$C_DIM" 0; }
ok()   { msg_line "${C_OK}✓${C_RESET} " "$*" "" 0; }
warn() { msg_line "${C_WARN}!${C_RESET} " "$*" "" 0; }
err()  { msg_line "${C_ERR}✗${C_RESET} " "$*" "" 1; }
die()  { shim_clear_live; shim_cursor_show; err "$*"; exit 1; }

# Chip/pill — a filled badge like a phone app's status chip. $1 = state
# (ok|warn|err|cyan|off), $2 = label (defaults to the state name). Plain
# "[label]" when colour is off, so piped output stays readable.
pill() { # state [label]
  local bg="$C_CHIP_OFF_BG" fg="$C_CHIP_OFF_FG"
  case "${1:-off}" in
    ok)   bg="$C_CHIP_OK_BG";   fg="$C_CHIP_OK_FG" ;;
    warn) bg="$C_CHIP_WARN_BG"; fg="$C_CHIP_WARN_FG" ;;
    err)  bg="$C_CHIP_ERR_BG";  fg="$C_CHIP_ERR_FG" ;;
    cyan) bg="$C_CHIP_INFO_BG"; fg="$C_CHIP_INFO_FG" ;;
  esac
  if color_on; then
    printf '%s[48;5;%sm%s[38;5;%sm %s %s' \
      "$ESC" "$bg" "$ESC" "$fg" "${2:-$1}" "$C_RESET"
  else
    printf '[%s]' "${2:-$1}"
  fi
}

# A hairline that fades from the brand green into dim: the rule under the
# app bar and inside panels. $1 = width, $2/$3 = shade range.
rule_line() { # width [from-shade] [to-shade]
  local w="${1:-40}" i=0 a="${2:-114}" b="${3:-240}" sh
  case "$w" in ''|*[!0-9]*) w=40 ;; esac
  if ! color_on; then
    while [ "$i" -lt "$w" ]; do printf '─'; i=$((i + 1)); done
    return 0
  fi
  while [ "$i" -lt "$w" ]; do
    if [ "$w" -le 1 ]; then sh="$a"; else sh=$(( a + (b - a) * i / (w - 1) )); fi
    printf '%s[38;5;%sm─' "$ESC" "$sh"
    i=$((i + 1))
  done
  printf '%s' "$C_RESET"
}

# One app-bar per command: "♪ wearsic · status" on the left, an optional
# state pill pushed to the right edge, and a fading hairline underneath at
# exactly the width of the panels below (so the whole screen shares one
# gutter). $1 = screen, $2 = state (ok|warn|err|off), $3 = pill label.
brand() {
  local tw lp rp gap left right
  tw="$(box_tw)"
  SECTION_FIRST=1
  left="$(printf '%s♪%s %s' "$C_ACC" "$C_RESET" "$(grad_word 'wearsic')")"
  if [ -n "${1:-}" ]; then
    left="$left$(printf ' %s·%s %s%s%s' "$C_DIM" "$C_RESET" "$C_BOLD" "$1" "$C_RESET")"
  fi
  right=""
  [ -n "${2:-}" ] && right="$(pill "$2" "${3:-$2}")"
  lp="$(vis "$left")"; rp="$(vis "$right")"
  printf '\n'
  if [ -n "$right" ] && [ $(( tw - ${#lp} - ${#rp} )) -ge 2 ]; then
    gap=$(( tw - ${#lp} - ${#rp} ))
    printf '  %s' "$left"
    while [ "$gap" -gt 0 ]; do printf ' '; gap=$((gap - 1)); done
    printf '%s\n' "$right"
  else
    printf '  %s\n' "$left"
    [ -n "$right" ] && printf '  %s\n' "$right"
  fi
  printf '  %s\n\n' "$(rule_line "$tw")"
}

# Group header for command lists and checkups: hue bar + bold name + a dim
# rule that runs to the same right edge as the panels. $2 = green|cyan|
# lavender|amber — each group of commands gets its own hue.
section() {
  local hue="$C_ACC" tw n i
  case "${2:-}" in
    cyan) hue="$C_CYA" ;;
    lavender) hue="$C_LAV" ;;
    amber) hue="$C_WARN" ;;
  esac
  # The app bar already leaves a blank line below its rule, so the first
  # group starts flush; later groups get one blank separator.
  if [ "${SECTION_FIRST:-1}" = "1" ]; then SECTION_FIRST=0; else printf '\n'; fi
  tw="$(box_tw)"
  n=$(( tw - 5 - ${#1} ))
  [ "$n" -lt 2 ] && n=2
  printf '  %s▍%s %s%s%s ' "$hue" "$C_RESET" "$C_BOLD" "$1" "$C_RESET"
  printf '%s' "$C_DIM"
  i=0; while [ "$i" -lt "$n" ]; do printf '─'; i=$((i + 1)); done
  printf '%s\n' "$C_RESET"
}

# Command list row (home / help). Wide terminals get the long description in
# a second column; narrow ones get the short one inline, or — when even that
# does not fit — the description drops to its own wrapped line. Never wraps
# mid-word (except a single word longer than the line).
item() { # cmd short-desc [long-desc]
  local cmd="$1" nd="$2" wd="${3:-$2}" desc clen room
  if [ "$COLS" -ge 78 ]; then
    desc="$wd"; clen=16; room=$(( COLS - 23 ))
    if [ ${#desc} -le "$room" ]; then
      printf '  %s›%s %s%-16s%s %s%s%s\n' "$C_DIM" "$C_RESET" "$C_ACC" "$cmd" "$C_RESET" "$C_DIM" "$desc" "$C_RESET"
      return 0
    fi
    # The long description did not fit — show the short one in the same
    # column instead of dropping an entire wrapped paragraph into the list.
    desc="$nd"
    if [ ${#desc} -le "$room" ]; then
      printf '  %s›%s %s%-16s%s %s%s%s\n' "$C_DIM" "$C_RESET" "$C_ACC" "$cmd" "$C_RESET" "$C_DIM" "$desc" "$C_RESET"
      return 0
    fi
  else
    desc="$nd"; clen="${ICOL:-9}"; [ ${#cmd} -gt "$clen" ] && clen=${#cmd}
    room=$(( COLS - 7 - clen ))
    if [ ${#desc} -le "$room" ]; then
      printf '  %s›%s %s%-*s%s  %s%s%s\n' "$C_DIM" "$C_RESET" "$C_ACC" "$clen" "$cmd" "$C_RESET" "$C_DIM" "$desc" "$C_RESET"
      return 0
    fi
  fi
  printf '  %s›%s %s%s%s\n' "$C_DIM" "$C_RESET" "$C_ACC" "$cmd" "$C_RESET"
  wrap_text "$desc" $(( COLS - 8 )) '      ' "$C_DIM"
}

# Aligned key/value row for status-style output. $3 = label column (default
# 12); values that do not fit wrap under their column instead of sticking out.
kv() {
  local lw="${3:-12}" plain vp
  plain="$(vis "$2")"
  if [ "${WRAP_OK:-0}" != "1" ] || [ $(( 4 + lw + 2 + ${#plain} )) -le "$COLS" ]; then
    printf '    %s%-*s%s  %s\n' "$C_DIM" "$lw" "$1" "$C_RESET" "$2"
    return 0
  fi
  vp=$(( 4 + lw + 2 ))
  wrap_text "$plain" $(( COLS - vp - 1 )) "$(printf '%*s' "$vp" '')" ""
}

# Coloured state dot: dot ok | warn | err | off
dot() {
  case "${1:-off}" in
    ok)   printf '%s●%s' "$C_OK" "$C_RESET" ;;
    warn) printf '%s●%s' "$C_WARN" "$C_RESET" ;;
    err)  printf '%s●%s' "$C_ERR" "$C_RESET" ;;
    *)    printf '%s●%s' "$C_DIM" "$C_RESET" ;;
  esac
}

# Spinner. Disabled when piped so scripted output stays line-clean.
SPIN_PID=""; SPIN_MSG=""
spinner_start() {
  SPIN_MSG="$1"
  if [ "$TTY_OUT" != "1" ]; then note "$1…"; return 0; fi
  printf '  '
  ( while :; do for f in $'\033[38;5;255m⠋' $'\033[38;5;158m⠙' $'\033[38;5;120m⠹' $'\033[38;5;114m⠸' $'\033[38;5;114m⠼' $'\033[38;5;120m⠴' $'\033[38;5;158m⠦' $'\033[38;5;255m⠧' $'\033[38;5;158m⠇' $'\033[38;5;120m⠏'; do printf '\b%s\033[0m' "$f"; sleep 0.09; done; done ) &
  SPIN_PID=$!
}
spinner_stop() {
  local msg="${2:-$SPIN_MSG}"
  if [ -n "$SPIN_PID" ]; then kill "$SPIN_PID" 2>/dev/null; wait "$SPIN_PID" 2>/dev/null; SPIN_PID=""; fi
  if [ "$TTY_OUT" = "1" ]; then printf '\b'; fi
  if [ "${1:-0}" = "0" ]; then ok "$msg"; else err "$msg"; fi
  SPIN_MSG=""
}


# The cursor and the temp status file are restored even when the script dies
# halfway through an animation (a failed download, Ctrl+C, an unexpected
# error). `wearsic update` sets its own EXIT trap later and repeats both.
trap 'shim_clear_live; shim_cursor_show; shim_cleanup; rm -rf "${UPDATE_WORK:-}"' EXIT
# Ctrl+C (and a polite TERM) must never leave a hidden cursor behind.
trap 'shim_clear_live; shim_cursor_show; shim_cleanup; exit 130' INT
trap 'shim_clear_live; shim_cursor_show; shim_cleanup; exit 143' TERM
# ── WSHIM-CORE-BEGIN ───────────────────────────────────────────────────────
# Shimmer: a soft highlight band travels left → right across the text.
#
# Every character is blended between the base gray and the highlight gray by
# its distance from the band, so the effect reads as a wave of light rather
# than a blinking highlight. The band leaves the text on the right and
# re-enters on the left, so the loop is seamless.
#
#   base      #8A8A85  (138, 138, 133)
#   highlight #C9C9C3  (201, 201, 195)
#
# One pass takes ~2.0s; every frame is redrawn in place every ~90ms. More
# frames per pass (22) and a wider band (40%) make the wave read as a smooth,
# continuous glide instead of a stepping/blinking highlight. On a 256-colour
# terminal the blend is approximated with the gray ramp (245 → 253).
# NO_COLOR, a non-TTY stdout and TERM=dumb turn it off, and the cursor is
# always restored (normal exit, error, or Ctrl+C).
#
# This block is byte-identical in `wearsic` and `install.sh`: the installer is
# a standalone bootstrap script that cannot source the CLI.
# tests/shimmer-test.sh fails when the two copies drift apart.
SHIM_BASE_R=138; SHIM_BASE_G=138; SHIM_BASE_B=133
SHIM_HI_R=201;   SHIM_HI_G=201;   SHIM_HI_B=195
SHIM_256_BASE=245; SHIM_256_HI=253
SHIM_FRAME_S=0.09
SHIM_LOOP_FRAMES=22
SHIM_BAND_PCT=40
SHIM_ESC="$(printf '\033')"
SHIM_DEPTH=0
SHIM_CURSOR_HIDDEN=0
SHIM_LIVE_ACTIVE=0
SHIM_PROGRESS_HOOK=""
SHIM_LIVE_TEXT=""
SHIM_LIVE_SHORT=""
SHIM_STATUS_FILE=""
SHIM_STAGE_NAME=""
SHIM_STAGE_DETAIL=""

# The shimmer palette is deliberately gray and self-contained: the file's own
# theme (green/cyan/lavender) stays out of the animated area so the wave
# reads as light, not as colour.
shim_palette() {
  SHIM_DIM="${SHIM_ESC}[2m"
  SHIM_OK="${SHIM_ESC}[38;5;120m"
  SHIM_WARN="${SHIM_ESC}[38;5;179m"
  SHIM_ERR="${SHIM_ESC}[38;5;203m"
  SHIM_RESET="${SHIM_ESC}[0m"
}

# 0 = off, 24 = truecolor, 256 = the gray ramp.
shim_depth() {
  [ "${TTY_OUT:-0}" = "1" ] || { printf '0'; return 0; }
  [ -z "${NO_COLOR:-}" ] || { printf '0'; return 0; }
  case "${WEARSIC_COLOR:-auto}" in never) printf '0'; return 0 ;; esac
  case "${TERM:-}" in dumb) printf '0'; return 0 ;; esac
  case "${WEARSIC_COLOR_DEPTH:-auto}" in
    0) printf '0'; return 0 ;;
    24) printf '24'; return 0 ;;
    256) printf '256'; return 0 ;;
  esac
  case "${COLORTERM:-}" in truecolor|24bit) printf '24'; return 0 ;; esac
  # Termux's terminal is a truecolor terminal even though TERM says 256.
  case "${PREFIX:-}" in */com.termux/*) printf '24'; return 0 ;; esac
  [ -n "${TERMUX_VERSION:-}" ] && { printf '24'; return 0; }
  case "${TERM:-}" in *truecolor*|*direct*) printf '24'; return 0 ;; esac
  case "${TERM:-}" in *256color*) printf '256'; return 0 ;; esac
  if command -v tput >/dev/null 2>&1; then
    local n
    n="$(tput colors 2>/dev/null || echo 0)"
    case "$n" in ''|*[!0-9]*) n=0 ;; esac
    [ "$n" -ge 256 ] && { printf '256'; return 0; }
  fi
  printf '0'
}

shim_init() {
  shim_palette
  SHIM_DEPTH="$(shim_depth)"
}

# Smooth falloff: 100 at the band centre → 0 at the band edge.
shim_intensity() { # $1 = distance, $2 = half-width (0..100 out)
  local d="$1" half="$2" x=0
  [ "$half" -le 0 ] && { printf '0'; return 0; }
  [ "$d" -ge "$half" ] && { printf '0'; return 0; }
  x=$(( (half - d) * 100 / half ))
  printf '%s' $(( x * x * (300 - 2 * x) / 10000 ))
}

# Blend 0..100 between the base gray and the highlight gray.
shim_blend_rgb() { # $1 = 0..100 → "r g b"
  local t="$1"
  printf '%s %s %s' \
    $(( SHIM_BASE_R + (SHIM_HI_R - SHIM_BASE_R) * t / 100 )) \
    $(( SHIM_BASE_G + (SHIM_HI_G - SHIM_BASE_G) * t / 100 )) \
    $(( SHIM_BASE_B + (SHIM_HI_B - SHIM_BASE_B) * t / 100 ))
}

# The same blend on the 256-colour gray ramp (245 ≈ #8A8A85, 253 ≈ #C9C9C3).
shim_blend_256() { # $1 = 0..100 → palette index
  printf '%s' $(( SHIM_256_BASE + (SHIM_256_HI - SHIM_256_BASE) * $1 / 100 ))
}

# Render $1 with the band centred at $2 (half-width $3). The blend maths is
# inlined here on purpose: a command substitution per character would fork
# ~60 processes per frame and the animation would stutter.
shim_render() { # $1 = text, $2 = centre, $3 = half-width
  local text="$1" centre="$2" half="$3" i=0 n=${#1} ch d t r g b out=""
  if [ "$SHIM_DEPTH" != "24" ] && [ "$SHIM_DEPTH" != "256" ]; then
    printf '%s' "$text"
    return 0
  fi
  while [ "$i" -lt "$n" ]; do
    ch="${text:$i:1}"
    d=$(( i - centre )); [ "$d" -lt 0 ] && d=$(( -d ))
    if [ "$d" -ge "$half" ]; then
      t=0
    else
      t=$(( (half - d) * 100 / half ))
      t=$(( t * t * (300 - 2 * t) / 10000 ))
    fi
    if [ "$SHIM_DEPTH" = "24" ]; then
      r=$(( SHIM_BASE_R + (SHIM_HI_R - SHIM_BASE_R) * t / 100 ))
      g=$(( SHIM_BASE_G + (SHIM_HI_G - SHIM_BASE_G) * t / 100 ))
      b=$(( SHIM_BASE_B + (SHIM_HI_B - SHIM_BASE_B) * t / 100 ))
      out="${out}${SHIM_ESC}[38;2;${r};${g};${b}m${ch}"
    else
      out="${out}${SHIM_ESC}[38;5;$(( SHIM_256_BASE + (SHIM_256_HI - SHIM_256_BASE) * t / 100 ))m${ch}"
    fi
    i=$(( i + 1 ))
  done
  printf '%s%s' "$out" "$SHIM_RESET"
}

shim_width() { # room for the live line
  local w="${COLS:-${COLUMNS:-80}}"
  case "$w" in ''|*[!0-9]*) w=80 ;; esac
  [ "$w" -lt 24 ] && w=24
  printf '%s' $(( w - 4 ))
}

# Draw the live line, replacing whatever is on the current line.
shim_draw_live() { # $1 = frame index
  local frame="$1" text="$SHIM_LIVE_TEXT" n half centre maxw
  [ "$SHIM_DEPTH" = "0" ] && return 0
  [ "$TTY_OUT" = "1" ] || return 0
  n=${#text}
  [ "$n" -le 0 ] && return 0
  maxw="$(shim_width)"
  # A label wider than the terminal WRAPS, and "\r" can only erase the last
  # wrapped line — the leftover fragments then pile up (the "Cloudflare
  # waiting for the tunnel + the Worker front…" repetition users saw on a
  # narrow Termux screen). Prefer the short label when there is one.
  if [ "$n" -gt "$maxw" ] && [ -n "${SHIM_LIVE_SHORT:-}" ]; then
    text="$SHIM_LIVE_SHORT"
    n=${#text}
  fi
  if [ "$n" -gt "$maxw" ]; then
    text="${text:0:$(( maxw - 1 ))}…"
    n=${#text}
  fi
  half=$(( n * SHIM_BAND_PCT / 100 / 2 ))
  [ "$half" -lt 3 ] && half=3
  centre=$(( -half + (n + 2 * half) * frame / SHIM_LOOP_FRAMES ))
  printf '\r%s[K' "$SHIM_ESC"
  shim_render "$text" "$centre" "$half"
  SHIM_LIVE_ACTIVE=1
}

# Erase the live line (only if one is on screen).
shim_clear_live() {
  [ "${SHIM_LIVE_ACTIVE:-0}" = "1" ] || return 0
  SHIM_LIVE_ACTIVE=0
  [ "$TTY_OUT" = "1" ] || return 0
  printf '\r%s[K' "$SHIM_ESC"
}

shim_cursor_hide() {
  [ "$TTY_OUT" = "1" ] || return 0
  [ "$SHIM_CURSOR_HIDDEN" = "1" ] && return 0
  printf '%s[?25l' "$SHIM_ESC"
  SHIM_CURSOR_HIDDEN=1
}

shim_cursor_show() {
  [ "$SHIM_CURSOR_HIDDEN" = "1" ] || return 0
  printf '%s[?25h' "$SHIM_ESC"
  SHIM_CURSOR_HIDDEN=0
}

# Update the live text from a file (the worker writes progress there).
shim_status_file() {
  if [ -z "$SHIM_STATUS_FILE" ]; then
    SHIM_STATUS_FILE="$(mktemp "${TMPDIR:-/tmp}/wearsic-shim-status.XXXXXX" 2>/dev/null)" || SHIM_STATUS_FILE=""
  fi
  printf '%s' "$SHIM_STATUS_FILE"
}

shim_status() { # $1 = text
  local f
  f="$(shim_status_file)"
  [ -n "$f" ] || return 0
  printf '%s\n' "$1" > "$f" 2>/dev/null || true
}

shim_cleanup() {
  [ -n "$SHIM_STATUS_FILE" ] && rm -f "$SHIM_STATUS_FILE" 2>/dev/null
  SHIM_STATUS_FILE=""
}

# 12.4M / 900K — small, quiet byte formatting for the live line.
shim_bytes() { # $1 = bytes
  local b="${1:-0}"
  case "$b" in ''|*[!0-9]*) b=0 ;; esac
  if [ "$b" -ge 1048576 ]; then awk "BEGIN{printf \"%.1fM\", $b/1048576}";
  elif [ "$b" -ge 1024 ]; then awk "BEGIN{printf \"%.0fK\", $b/1024}";
  else printf '%sB' "$b"; fi
}

# Fork-free byte/rate/time helpers for the BAR (the old path forked a
# subshell per frame — `wc` + two `awk`s at ~11 fps read as stutter on a
# phone; these do pure integer math and return through $SHIM_FMT / $SHIM_MS).
shim_fmt_bytes() { # $1 = bytes -> SHIM_FMT = "4.2M" / "900K" / "12B"
  local b="${1:-0}"
  case "$b" in ''|*[!0-9]*) b=0 ;; esac
  if [ "$b" -ge 1048576 ]; then
    local h=$(( b / 1048576 )) l=$(( (b % 1048576) * 10 / 1048576 ))
    SHIM_FMT="${h}.${l}M"
  elif [ "$b" -ge 1024 ]; then
    SHIM_FMT="$(( b / 1024 ))K"
  else
    SHIM_FMT="${b}B"
  fi
}

shim_fmt_rate() { # $1 = bytes/s -> SHIM_FMT = "5.2MB/s" / "480KB/s"
  local r="${1:-0}" w f
  case "$r" in ''|*[!0-9]*) r=0 ;; esac
  if [ "$r" -ge 1048576 ]; then
    w=$(( r / 1048576 )); f=$(( (r % 1048576) * 10 / 1048576 ))
    SHIM_FMT="${w}.${f}MB/s"
  elif [ "$r" -ge 1024 ]; then
    w=$(( r / 1024 )); f=$(( (r % 1024) * 10 / 1024 ))
    SHIM_FMT="${w}.${f}KB/s"
  else
    SHIM_FMT="${r}B/s"
  fi
}

shim_now_ms() { # SHIM_MS = milliseconds (bash 5's $EPOCHREALTIME; 0 if absent)
  local r="${EPOCHREALTIME:-}" sec sub
  if [ -z "$r" ]; then SHIM_MS=0; return 0; fi
  case "$r" in
    *.**) sec="${r%%.*}"; sub="${r#*.}" ;;
    *)    sec="$r";      sub="" ;;
  esac
  case "$sec" in ''|*[!0-9]*) sec=0 ;; esac
  case "$sub" in ''|*[!0-9]*) sub=0 ;; esac
  sub="${sub:0:6}"
  SHIM_MS=$(( sec * 1000 + 10#$sub / 1000 ))
}

# Animate until the job ($1) exits. A progress hook ($SHIM_PROGRESS_HOOK) is
# called before every frame, so a download can report its real percentage.
# A hook may paint its OWN frame (the download bar) and set SHIM_HOOK_DREW —
# the generic shimmer then sits out that tick instead of overpainting.
shim_animate() { # $1 = pid
  local pid="$1" frame=0 t=""
  shim_cursor_hide
  while kill -0 "$pid" 2>/dev/null; do
    if [ -n "$SHIM_PROGRESS_HOOK" ]; then
      SHIM_HOOK_DREW=0
      "$SHIM_PROGRESS_HOOK" 2>/dev/null || true
    else
      SHIM_HOOK_DREW=0
    fi
    if [ "${SHIM_HOOK_DREW:-0}" = "1" ]; then
      # The hook already put a line on screen; remember that a live line
      # exists so shim_clear_live erases it later.
      SHIM_LIVE_ACTIVE=1
    else
      if [ -n "$SHIM_STATUS_FILE" ] && [ -s "$SHIM_STATUS_FILE" ]; then
        t="$(cat "$SHIM_STATUS_FILE" 2>/dev/null || true)"
        [ -n "$t" ] && SHIM_LIVE_TEXT="$t"
      fi
      shim_draw_live "$frame"
    fi
    sleep "$SHIM_FRAME_S"
    frame=$(( (frame + 1) % SHIM_LOOP_FRAMES ))
  done
  shim_cursor_show
}

# Wait for a condition while the live line shimmers.
# $1 = label, $2 = timeout in seconds, $3 = shell test command
shim_wait() { # label limit test-command [short-label]
  local label="$1" limit="$2" test="$3" i=0 max step
  case "$limit" in ''|*[!0-9]*) limit=30 ;; esac
  if [ "$SHIM_DEPTH" = "0" ] || [ "$TTY_OUT" != "1" ]; then
    # No animation: poll once a second, exactly like the old spinner.
    max="$limit"; step=1
  else
    max=$(( limit * 10 )); step=0
  fi
  SHIM_LIVE_TEXT="$label"
  SHIM_LIVE_SHORT="${4:-}"
  shim_cursor_hide
  while [ "$i" -lt "$max" ]; do
    shim_draw_live $(( i % SHIM_LOOP_FRAMES ))
    if eval "$test" >/dev/null 2>&1; then
      shim_clear_live
      shim_cursor_show
      return 0
    fi
    if [ "$step" = "0" ]; then sleep "$SHIM_FRAME_S"; else sleep 1; fi
    i=$(( i + 1 ))
  done
  shim_clear_live
  shim_cursor_show
  return 1
}

# The tail of a captured log — used when a command fails, so a failure is
# never silently swallowed.
shim_log_tail() { # $1 = log file, $2 = number of lines
  local f="$1" n="${2:-10}"
  [ -s "$f" ] || return 0
  printf '  %s%s%s\n' "$SHIM_DIM" "last $n lines:" "$SHIM_RESET" >&2
  tail -n "$n" "$f" 2>/dev/null | sed 's/^/  /' >&2
}

# Run a command with the live line shimmering. The output is captured, not
# sprayed over the terminal; on failure the tail is surfaced.
# Usage: shim_run "<live text>" <cmd> [args...]
shim_run() { # $1 = live text, rest = command
  local text="$1"; shift
  local log rc=0
  log="$(mktemp "${TMPDIR:-/tmp}/wearsic-shim.XXXXXX" 2>/dev/null)" || log="/dev/null"
  SHIM_LIVE_TEXT="$text"
  if [ "$SHIM_DEPTH" != "0" ] && [ "$TTY_OUT" = "1" ]; then
    "$@" >"$log" 2>&1 &
    local pid=$!
    shim_animate "$pid"
    wait "$pid"; rc=$?
    shim_clear_live
  else
    "$@" >"$log" 2>&1
    rc=$?
  fi
  [ "$rc" = "0" ] || shim_log_tail "$log" 12
  [ "$log" = "/dev/null" ] || rm -f "$log" 2>/dev/null
  return "$rc"
}

# Download helpers: the caller starts the transfer, the animation loop asks
# for progress, and the caller waits for the result. The transfer itself is
# quiet — only the size is polled, so the terminal shows one clean line.
SHIM_FETCH_OUT=""; SHIM_FETCH_PREFIX=""; SHIM_FETCH_TOTAL=""; SHIM_FETCH_PID=""

shim_fetch_start() { # $1 = url, $2 = out file, $3 = live text prefix
  SHIM_FETCH_OUT="$2"; SHIM_FETCH_PREFIX="$3"
  SHIM_FETCH_TOTAL="$(curl -fsSIL --max-time 15 "$1" 2>/dev/null \
    | grep -i '^content-length:' | tail -1 | tr -d '\r' | awk '{print $2}')"
  case "$SHIM_FETCH_TOTAL" in ''|*[!0-9]*) SHIM_FETCH_TOTAL="" ;; esac
  # Fresh rate/paint state per download — a second fetch must not
  # inherit the previous one's sliding window or repaint guard.
  SHIM_F_PREV_MS=0; SHIM_F_PREV_B=0
  SHIM_F_RATE=0
  SHIM_F_PAINT_B=""; SHIM_F_PAINT_MS=0
  SHIM_F_START_MS=0; SHIM_F_START_B=0
  # No timeout on this curl = a stalled carrier connection wedges the
  # caller in `wait` forever (a live phone ran `wearsic update` for 20+
  # minutes with 0% CPU while the front door churned). A stall must make
  # curl EXIT: --speed-limit/--speed-time abort a transfer that stops
  # delivering data, --connect-timeout/--max-time cap the rest. 1800 s is
  # generous for a ~30 MB zip on a slow hotspot; healthy links finish in
  # a minute or two. shim_fetch_wait adds a shell-side ceiling too.
  curl -fL --retry 3 --retry-delay 2 \
    --connect-timeout 20 --max-time 1800 \
    --speed-limit 1024 --speed-time 30 \
    -o "$2" "$1" >/dev/null 2>&1 &
  SHIM_FETCH_PID=$!
}

# The animation hook: the download bar paints ITSELF here instead of pushing
# text into the generic shimmer. Why: the old path re-rendered gray letters
# character-by-character every frame with several forks, which on a phone
# read as blinking. This frame is a SINGLE atomic `\r\e[K` write with a green
# gradient fill, a partial-cell head (▏▎…▉) so the bar climbs smoothly, a
# fixed-width tail (no wobble), and a byte rate from $EPOCHREALTIME — zero
# forks per frame. Sets SHIM_HOOK_DREW=1 so shim_animate skips the shimmer
# for this tick (and remembers a live line is on screen for its cleanup).
shim_fetch_progress() {
  SHIM_HOOK_DREW=1
  [ "${TTY_OUT:-0}" = "1" ] || { SHIM_HOOK_DREW=0; return 0; }
  local have=0 cells=24 pct=0 filled=0 prog=0 frac=0 i=0
  local bar="" track="" tc="" fillcol pc
  local line pp havetxt tottext ratetxt label budget plain
  [ -n "$SHIM_FETCH_PID" ] || return 0
  if [ -e "$SHIM_FETCH_OUT" ]; then
    have="$(wc -c < "$SHIM_FETCH_OUT" 2>/dev/null)" || have=0
  fi
  case "$have" in ''|*[!0-9]*) have=0 ;; esac

  # Byte rate over a sliding ~2-frame window; the first frame just seeds it.
  shim_now_ms
  if [ "${SHIM_F_PREV_MS:-0}" = "0" ]; then
    SHIM_F_PREV_MS="$SHIM_MS"; SHIM_F_PREV_B="$have"
    SHIM_F_START_MS="$SHIM_MS"; SHIM_F_START_B=0
  elif [ "$SHIM_MS" -gt "${SHIM_F_PREV_MS:-0}" ] && [ "$have" != "${SHIM_F_PREV_B:-0}" ]; then
    SHIM_F_RATE=$(( ( have - SHIM_F_PREV_B ) * 1000 / ( SHIM_MS - SHIM_F_PREV_MS ) ))
    [ "${SHIM_F_RATE:-0}" -lt 0 ] && SHIM_F_RATE=0
    SHIM_F_PREV_MS="$SHIM_MS"; SHIM_F_PREV_B="$have"
  fi
  # Repaint only when the picture moved, or half a second passed (stalls
  # stay alive on screen without burning terminal I/O).
  if [ "$have" != "${SHIM_F_PAINT_B:-}" ] \
     || [ -z "${SHIM_F_PAINT_MS:-}" ] \
     || [ "$(( SHIM_MS - SHIM_F_PAINT_MS ))" -ge 500 ]; then
    SHIM_F_PAINT_B="$have"; SHIM_F_PAINT_MS="$SHIM_MS"
  else
    return 0
  fi

  shim_fmt_rate "${SHIM_F_RATE:-0}"; ratetxt="$SHIM_FMT"
  case "$SHIM_DEPTH" in
    24|256) tc="${SHIM_ESC}[38;5;240m"; pc="" ;;
    *)      tc=""; pc="" ;;
  esac

  if [ -n "$SHIM_FETCH_TOTAL" ] && [ "$SHIM_FETCH_TOTAL" -gt 0 ]; then
    pct=$(( have * 100 / SHIM_FETCH_TOTAL )); [ "$pct" -gt 100 ] && pct=100
    prog=$(( have * cells * 100 / SHIM_FETCH_TOTAL ))
    [ "$prog" -gt $(( cells * 100 )) ] && prog=$(( cells * 100 ))
    filled=$(( prog / 100 )); frac=$(( prog % 100 ))
    while [ "$i" -lt "$filled" ]; do
      case "$SHIM_DEPTH" in
        256) fillcol="${SHIM_ESC}[38;5;$(( 114 + i * 43 / (cells - 1) ))m" ;;
        24)  pc=$(( i * 100 / (cells - 1) ))
             fillcol="${SHIM_ESC}[38;2;$(( 104 + 86 * pc / 100 ));$(( 232 + 18 * pc / 100 ));$(( 150 + 55 * pc / 100 ))m" ;;
        *)   fillcol="" ;;
      esac
      bar="${bar}${fillcol}█"
      i=$(( i + 1 ))
    done
    if [ "$frac" -gt 0 ] && [ "$filled" -lt "$cells" ]; then
      hb=$(( (frac * 7 + 50) / 100 )); [ "$hb" -eq 0 ] && hb=1
      # Byte-safe partial-cell head: case mapping instead of substring
      # slicing — a C-locale bash counts BYTES in ${var:$n:1}, which would
      # slice a middle byte out of ▌ and corrupt the frame.
      case "$hb" in
        1) hc='▏' ;; 2) hc='▎' ;; 3) hc='▍' ;; 4) hc='▌' ;;
        5) hc='▋' ;; 6) hc='▊' ;; 7) hc='▉' ;; *) hc="" ;;
      esac
      case "$SHIM_DEPTH" in
        256) bar="${bar}${SHIM_ESC}[38;5;$(( 114 + filled * 43 / (cells - 1) ))m${hc}" ;;
        24)  pc=$(( filled * 100 / (cells - 1) ))
             bar="${bar}${SHIM_ESC}[38;2;$(( 104 + 86 * pc / 100 ));$(( 232 + 18 * pc / 100 ));$(( 150 + 55 * pc / 100 ))m${hc}" ;;
        *)   bar="${bar}${hc}" ;;
      esac
      i=$(( filled + 1 ))
    else
      i="$filled"
    fi
    while [ "$i" -lt "$cells" ]; do
      track="${track}${tc}░"
      i=$(( i + 1 ))
    done
    case "$pct" in [0-9]) pp="  $pct" ;; [0-9][0-9]) pp=" $pct" ;; *) pp="$pct" ;; esac
    shim_fmt_bytes "$have"; havetxt="$SHIM_FMT"
    shim_fmt_bytes "$SHIM_FETCH_TOTAL"; tottext="$SHIM_FMT"
    case "$SHIM_DEPTH" in
      24|256) bar="${bar}${tc}${track}${SHIM_ESC}[0m" ;;
      *)      bar="${bar}${track}" ;;
    esac
    line="${SHIM_FETCH_PREFIX}  [${bar}]${pp}%"
    core=$(( ${#SHIM_FETCH_PREFIX} + 31 ))
  else
    shim_fmt_bytes "$have"; havetxt="$SHIM_FMT"
    line="${SHIM_FETCH_PREFIX}  ${havetxt}"
    core=$(( ${#SHIM_FETCH_PREFIX} + 2 + ${#havetxt} ))
  fi

  # Phone-width safety (portrait Termux ≈ 55 cols): the prefix + bar + % are
  # sacred; the size pair survives next; the rate is the first to be shed;
  # the prefix itself is truncated only as a last resort. One line per frame
  # — a wrapped frame is what looked like blinking.
  budget="${COLUMNS:-80}"
  case "$budget" in ''|*[!0-9]*) budget=80 ;; esac
  [ "$budget" -lt 24 ] && budget=24
  local szkeep=0 rtkeep=0 cut nlen
  if [ -n "${tottext:-}" ]; then
    szlen="$(( 5 + ${#havetxt} + 3 + ${#tottext} ))"
    rtlen=$(( 5 + ${#ratetxt} ))
    if [ $(( core + szlen + rtlen )) -le "$budget" ]; then
      szkeep=1; rtkeep=1; core=$(( core + szlen + rtlen ))
    elif [ $(( core + szlen )) -le "$budget" ]; then
      szkeep=1; core=$(( core + szlen ))
    fi
    [ "$szkeep" = "1" ] && line="${line}  ·  ${havetxt} / ${tottext}"
    [ "$rtkeep" = "1" ] && line="${line}  ·  ${ratetxt}"
  else
    rtlen=$(( 5 + ${#ratetxt} ))
    if [ $(( core + rtlen )) -le "$budget" ]; then
      rtkeep=1; core=$(( core + rtlen ))
    fi
    [ "$rtkeep" = "1" ] && line="${line}  ·  ${ratetxt}"
  fi
  if [ "$core" -gt "$budget" ]; then
    cut=$(( core - budget + 1 ))
    nlen=${#SHIM_FETCH_PREFIX}
    [ "$cut" -gt $(( nlen - 1 )) ] && cut=$(( nlen - 1 ))
    [ "$cut" -lt 0 ] && cut=0
    line="…${line:$cut}"
  fi
  printf '\r%s[K%s' "$SHIM_ESC" "$line"
}

# The last frame: refill the bar at 100%, park a ✓ on it, then a newline so
# the stage's own summary lands on a fresh line. Failures clear the line
# instead — the stage machinery speaks there.
# The last frame: refill the bar at 100% and park a green ✓ on it, then a
# newline so the stage's own summary lands on a fresh line. The width budget
# sheds sizes, speed and seconds the same way the live bar does, so the
# finish never wraps on a narrow phone. Failures wipe the line instead —
# the stage machinery speaks there.
shim_fetch_done() {
  local have=0 rate=0 secs=0 i=0 fc f tc="" bar="" cells=24 line core cut nlen
  local havetxt tottext="" ratetxt budget shown=0 szlen
  [ "${TTY_OUT:-0}" = "1" ] || return 0
  [ -n "$SHIM_FETCH_OUT" ] || return 0
  if [ -e "$SHIM_FETCH_OUT" ]; then
    have="$(wc -c < "$SHIM_FETCH_OUT" 2>/dev/null)" || have=0
  fi
  case "$have" in ''|*[!0-9]*) have=0 ;; esac
  shim_now_ms
  if [ "${SHIM_F_START_MS:-0}" != "0" ] && [ "$SHIM_MS" -gt "$SHIM_F_START_MS" ]; then
    rate=$(( have * 1000 / ( SHIM_MS - SHIM_F_START_MS ) ))
    secs=$(( ( SHIM_MS - SHIM_F_START_MS + 500 ) / 1000 ))
  fi
  shim_fmt_rate "$rate"; ratetxt="$SHIM_FMT"
  shim_fmt_bytes "$have"; havetxt="$SHIM_FMT"
  budget="${COLUMNS:-80}"
  case "$budget" in ''|*[!0-9]*) budget=80 ;; esac
  [ "$budget" -lt 24 ] && budget=24
  if [ -n "$SHIM_FETCH_TOTAL" ] && [ "$SHIM_FETCH_TOTAL" -gt 0 ]; then
    shim_fmt_bytes "$SHIM_FETCH_TOTAL"; tottext="$SHIM_FMT"
    while [ "$i" -lt "$cells" ]; do
      case "$SHIM_DEPTH" in
        256) f="${SHIM_ESC}[38;5;$(( 114 + i * 43 / (cells - 1) ))m" ;;
        24)  fc=$(( i * 100 / (cells - 1) ))
             f="${SHIM_ESC}[38;2;$(( 104 + 86 * fc / 100 ));$(( 232 + 18 * fc / 100 ));$(( 150 + 55 * fc / 100 ))m" ;;
        *)   f="" ;;
      esac
      bar="${bar}${f}█"
      i=$(( i + 1 ))
    done
    case "$SHIM_DEPTH" in 24|256) bar="${bar}${SHIM_ESC}[0m" ;; esac
    line="${SHIM_FETCH_PREFIX}  [${bar}] 100%"
    core=$(( ${#SHIM_FETCH_PREFIX} + 2 + 26 + 5 ))
  else
    line="${SHIM_FETCH_PREFIX}  ${havetxt}"
    core=$(( ${#SHIM_FETCH_PREFIX} + 2 + ${#havetxt} ))
  fi
  # The ✓ is the payoff — always shown; the stats yield to the width.
  line="${line}  ${SHIM_OK:-}✓${SHIM_RESET:-}"
  core=$(( core + 3 ))
  if [ -n "$tottext" ]; then
    szlen=$(( 5 + ${#havetxt} + 3 + ${#tottext} ))
    if [ $(( core + szlen )) -le "$budget" ]; then
      line="${line}  ·  ${havetxt} / ${tottext}"
      core=$(( core + szlen ))
    fi
  fi
  if [ $(( core + 9 + ${#ratetxt} )) -le "$budget" ]; then
    line="${line}  ·  ${ratetxt} avg"
    core=$(( core + 9 + ${#ratetxt} ))
    shown=1
  fi
  if [ "$shown" = "1" ] && [ $(( core + 6 + ${#secs} )) -le "$budget" ]; then
    line="${line}  ·  ${secs}s"
    core=$(( core + 6 + ${#secs} ))
  fi
  if [ "$core" -gt "$budget" ]; then
    cut=$(( core - budget + 1 ))
    nlen=${#SHIM_FETCH_PREFIX}
    [ "$cut" -gt $(( nlen - 1 )) ] && cut=$(( nlen - 1 ))
    [ "$cut" -lt 0 ] && cut=0
    line="…${line:$cut}"
  fi
  printf '\r%s[K%s\n' "$SHIM_ESC" "$line"
}

shim_fetch_wait() {  # optional $1 = hard ceiling in seconds
  local rc=0 waited=0 limit="${1:-}"
  [ -n "$SHIM_FETCH_PID" ] || return 1
  # Never wait on a transfer FOREVER. curl now aborts stalled transfers
  # itself; this shell-side ceiling is the second belt (and the only one
  # if the pid somehow outlives the transfer). On overflow the transfer
  # is killed and the wait fails with 124 — `wearsic update` can then
  # report a stalled download instead of hanging.
  case "$limit" in
    ''|*[!0-9]*) limit=$(( ${SHIM_FETCH_MAX_WAIT:-1800} + 60 )) ;;
  esac
  while kill -0 "$SHIM_FETCH_PID" 2>/dev/null; do
    if [ "$waited" -ge "$limit" ]; then
      kill "$SHIM_FETCH_PID" 2>/dev/null || true
      sleep 1
      kill -9 "$SHIM_FETCH_PID" 2>/dev/null || true
      wait "$SHIM_FETCH_PID" 2>/dev/null || true
      SHIM_FETCH_PID=""
      # Wipe the mid-flight bar so the caller's error line starts clean.
      [ "${TTY_OUT:-0}" = "1" ] && { printf '\r%s[K\n' "$SHIM_ESC"; SHIM_LIVE_ACTIVE=0; }
      return 124
    fi
    sleep 1
    waited=$(( waited + 1 ))
  done
  wait "$SHIM_FETCH_PID"; rc=$?
  SHIM_FETCH_PID=""
  if [ "$rc" = "0" ]; then
    shim_fetch_done
  else
    # Wipe the mid-flight bar so the stage's own error line starts clean.
    [ "${TTY_OUT:-0}" = "1" ] && { printf '\r%s[K\n' "$SHIM_ESC"; SHIM_LIVE_ACTIVE=0; }
  fi
  return "$rc"
}

# ── stage machine ─────────────────────────────────────────────────────────
# One quiet line per stage. The ACTIVE stage shimmers in place; a finished
# stage collapses into a single line that is printed exactly once.
shim_stage_begin() { # $1 = stage name, $2 = detail (optional)
  SHIM_STAGE_NAME="$1"
  SHIM_STAGE_DETAIL="${2:-}"
  SHIM_LIVE_TEXT="$1"
  [ -n "$SHIM_STAGE_DETAIL" ] && SHIM_LIVE_TEXT="$1  $SHIM_STAGE_DETAIL"
  [ "$SHIM_DEPTH" = "0" ] && return 0
  shim_cursor_hide
  shim_draw_live 0
}

shim_stage_status() { # $1 = detail
  SHIM_STAGE_DETAIL="$1"
  SHIM_LIVE_TEXT="$SHIM_STAGE_NAME"
  [ -n "$SHIM_STAGE_DETAIL" ] && SHIM_LIVE_TEXT="$SHIM_STAGE_NAME  $SHIM_STAGE_DETAIL"
}

# The stage line without the wave — drawn between two animation segments so
# the line never blinks out of existence.
shim_stage_plain() {
  [ "$SHIM_DEPTH" = "0" ] && return 0
  [ "$TTY_OUT" = "1" ] || return 0
  printf '\r%s[K  %s%s%s' "$SHIM_ESC" "$SHIM_DIM" "$SHIM_LIVE_TEXT" "$SHIM_RESET"
  SHIM_LIVE_ACTIVE=1
}

shim_stage_end() { # $1 = ok|fail, $2 = detail (optional)
  local kind="$1" detail="${2:-$SHIM_STAGE_DETAIL}"
  if [ "$SHIM_DEPTH" != "0" ]; then
    shim_clear_live
    shim_cursor_show
  fi
  if [ "$kind" = "ok" ]; then
    printf '  %s✓%s %s%s%s' "$SHIM_OK" "$SHIM_RESET" "$SHIM_DIM" "$SHIM_STAGE_NAME" "$SHIM_RESET"
  else
    printf '  %s✗%s %s%s%s' "$SHIM_ERR" "$SHIM_RESET" "$SHIM_DIM" "$SHIM_STAGE_NAME" "$SHIM_RESET"
  fi
  if [ -n "$detail" ]; then
    printf '  %s%s%s' "$SHIM_DIM" "$detail" "$SHIM_RESET"
  fi
  printf '\n'
  SHIM_STAGE_NAME=""; SHIM_STAGE_DETAIL=""
}

# A whole stage in one call: shimmer the name while the command works, then
# print the single result line. The command's output is captured.
shim_stage_run() { # $1 = stage name, $2 = detail, rest = command
  local name="$1" detail="$2"; shift 2
  local log rc=0
  log="$(mktemp "${TMPDIR:-/tmp}/wearsic-shim.XXXXXX" 2>/dev/null)" || log="/dev/null"
  shim_stage_begin "$name" "$detail"
  if [ "$SHIM_DEPTH" != "0" ] && [ "$TTY_OUT" = "1" ]; then
    "$@" >"$log" 2>&1 &
    local pid=$!
    shim_animate "$pid"
    wait "$pid"; rc=$?
    shim_clear_live
  else
    "$@" >"$log" 2>&1
    rc=$?
  fi
  if [ "$rc" = "0" ]; then
    shim_stage_end ok "$detail"
  else
    shim_stage_end fail "$detail"
    shim_log_tail "$log" 12
  fi
  [ "$log" = "/dev/null" ] || rm -f "$log" 2>/dev/null
  return "$rc"
}

# The animation is opt-in per terminal: a real TTY with colour support gets
# the shimmer, everything else (pipes, CI logs, NO_COLOR) stays plain.
shim_init
# ── WSHIM-CORE-END ─────────────────────────────────────────────────────────
human_bytes() { # $1 = bytes -> 12.4M
  local b="${1:-0}"
  case "$b" in ''|*[!0-9]*) b=0 ;; esac
  if [ "$b" -ge 1048576 ]; then awk "BEGIN{printf \"%.1fM\", $b/1048576}";
  elif [ "$b" -ge 1024 ]; then awk "BEGIN{printf \"%.0fK\", $b/1024}";
  else printf '%sB' "$b"; fi
}

# Live progress bar. The fill runs through a green gradient; the label is NOT
# printed here (download_bar prints it once above) so the redrawn line fits
# any width. $1 = label (kept for call compatibility), $2 = pct, $3/$4 bytes.
draw_bar() {
  local pct="$2" have="$3" total="$4" i=0 bw sh fill bar="" track="" use_col=0 sizes=""
  local cols="${COLUMNS:-80}"
  case "$cols" in ''|*[!0-9]*) cols=80 ;; esac
  bw=$(( cols - 26 ))
  [ "$bw" -gt 24 ] && bw=24
  [ "$bw" -lt 10 ] && bw=10
  fill=$(( pct * bw / 100 ))
  command -v color_on >/dev/null 2>&1 && color_on && use_col=1
  while [ "$i" -lt "$bw" ]; do
    if [ "$i" -lt "$fill" ]; then
      if [ "$use_col" = "1" ]; then
        if [ "$bw" -gt 1 ]; then sh=$(( 114 + i * 43 / (bw - 1) )); else sh=157; fi
        bar="${bar}${ESC}[38;5;${sh}m█"
      else
        bar="${bar}█"
      fi
    else
      track="${track}░"
    fi
    i=$((i + 1))
  done
  sizes="$(human_bytes "$have") / $(human_bytes "$total")"
  printf '\r  %s%s%s%s  %s%3d%%%s  %s%-15s%s' \
    "$bar" "$C_RESET" "$C_DIM" "$track" "$C_ACC" "$pct" "$C_RESET" \
    "$C_DIM" "$sizes" "$C_RESET"
}

# Download with a live progress bar. The label is printed once, dim, above
# the redrawn bar; the bar itself is sized to the terminal, so narrow phones
# never see a wrapped mess. Spinner fallback when the server hides
# Content-Length (or output is piped). Returns curl's exit status.
download_bar() { # $1 = url, $2 = out file, $3 = label
  local url="$1" out="$2" label="${3:-download}"
  local total=""
  total="$(curl -fsSIL --max-time 15 "$url" 2>/dev/null | grep -i '^content-length:' | tail -1 | tr -d '\r' | awk '{print $2}')"
  case "$total" in ''|*[!0-9]*) total="" ;; esac
  if [ -z "$total" ] || [ "$TTY_OUT" != "1" ]; then
    spinner_start "$label"
    if curl -fL --retry 3 --retry-delay 2 -o "$out" "$url" >/dev/null 2>&1; then
      spinner_stop 0 "$label ($(du -h "$out" 2>/dev/null | cut -f1))"
    else
      spinner_stop 1 "$label"; return 1
    fi
    return 0
  fi
  printf '  %s%s%s\n' "$C_DIM" "$label" "$C_RESET"
  curl -fL --retry 3 --retry-delay 2 -o "$out" "$url" >/dev/null 2>&1 &
  local pid=$! have=0 pct=0
  while kill -0 "$pid" 2>/dev/null; do
    # curl creates $out only when its first bytes arrive: before that, an
    # unguarded `wc -c < "$out"` makes the SHELL's redirection print
    # "No such file or directory" (2>/dev/null on the command does not
    # silence a failed input redirection — it is applied after it).
    if [ -e "$out" ]; then
      have="$(wc -c < "$out" 2>/dev/null || echo 0)"
    else
      have=0
    fi
    case "$have" in ''|*[!0-9]*) have=0 ;; esac
    pct=$(( have * 100 / total ))
    [ "$pct" -gt 100 ] && pct=100
    draw_bar "$label" "$pct" "$have" "$total"
    sleep 0.2
  done
  wait "$pid" || { printf '\n'; return 1; }
  draw_bar "$label" 100 "$total" "$total"
  printf '\n  %s✓%s %sdownloaded (%s)%s\n' "$C_OK" "$C_RESET" "$C_DIM" "$(human_bytes "$total")" "$C_RESET"
  return 0
}

# Install a file ATOMICALLY: copy to a sibling temp, then rename into place.
# A plain `cp` over a file bash is CURRENTLY EXECUTING truncates that very
# inode, so the running shell's next buffered read lands mid-line in the new
# content and it dies with "syntax error near unexpected token" — exactly
# what corrupted `wearsic update` while it refreshed its own installed copy.
# A rename swaps the inode instead: the running shell keeps reading the old
# content, intact, and the new file is live for the next command.
replace_file() { # $1 = source file, $2 = destination file
  local src="$1" dst="$2" tmp
  tmp="$(mktemp "$(dirname "$dst")/.wearsic-new.XXXXXX")" || return 1
  if cp "$src" "$tmp" && mv -f "$tmp" "$dst"; then
    return 0
  fi
  rm -f "$tmp" 2>/dev/null
  return 1
}

# Rounded panel. The width is decided by the TERMINAL, not the content, so
# all panels line up with each other: full width minus 4 (capped at 76 so
# wide desktops still get a tidy column). Long content wraps (word-aware;
# paths and URLs hard-split) INSIDE the border. The optional second argument
# (ok|warn|err|cyan) tints border + title for verdict panels.
# Panel geometry, shared by the app bar, the group rules and every box so
# the whole screen lines up on ONE right edge: terminal width minus 4 (two
# spaces of gutter each side), capped at 76 so desktops get a tidy column.
box_tw() {
  local tw=$(( COLS - 4 ))
  [ "$tw" -gt 76 ] && tw=76
  [ "$tw" -lt 24 ] && tw=24
  printf '%s' "$tw"
}
box_pw() { printf '%s' $(( $(box_tw) - 4 )); }

BOX_TITLE=""; BOX_BODY=""; BOX_N=0; BOX_HUE=""
box_begin() { BOX_TITLE="$1"; BOX_HUE="${2:-acc}"; BOX_BODY=""; BOX_N=0; }
# Hairline inside a panel, drawn at render time when the width is known.
box_hr() { box_line "__WEARSIC_HR__"; }

# One cell of a two-column stat grid: dim label, bright value, padded to an
# exact visible width so the right border never goes ragged. Overlong values
# are elided in the middle (a path keeps both ends; a count never wraps).
cell() { # label value width
  local lab="$1" val="$2" w="${3:-20}" lw=10 vp pad plain out
  [ ${#lab} -gt "$lw" ] && lw=${#lab}
  case "$w" in ''|*[!0-9]*) w=20 ;; esac
  vp=$(( w - lw - 1 ))
  if [ "$vp" -lt 4 ]; then
    printf '%s' "$(elide_mid "$2" "$w")"
    return 0
  fi
  plain="$(vis "$val")"
  if [ ${#plain} -gt "$vp" ]; then
    val="$(elide_mid "$plain" "$vp")"; plain="$val"
  fi
  out="$(printf '%s%-*s%s %s' "$C_DIM" "$lw" "$lab" "$C_RESET" "$val")"
  pad=$(( w - lw - 1 - ${#plain} ))
  [ "$pad" -lt 0 ] && pad=0
  printf '%s%*s' "$out" "$pad" ''
}

# Two stats on one row — the dashboard row of `status` and `health`. Falls
# back to stacked rows on a narrow phone, where two columns would squeeze
# every value into an ellipsis.
box_kv2() { # label1 value1 label2 value2 [label-width]
  local pw lw="${5:-10}" inner w1 w2
  pw="$(box_pw)"
  # Two columns need real room: below ~62 columns the values would all be
  # middle-elided ("412 ok …iled"), which reads worse than stacked rows.
  if [ "$pw" -lt 62 ] || [ -z "${3:-}" ]; then
    box_kv "$1" "$2" "$lw"
    [ -n "${3:-}" ] && box_kv "$3" "$4" "$lw"
    return 0
  fi
  inner=$(( pw - 5 ))
  w1=$(( inner / 2 )); w2=$(( inner - w1 ))
  box_line "   $(cell "$1" "$2" "$w1")  $(cell "$3" "$4" "$w2")"
}
box_line() {
  if [ "$BOX_N" = "0" ]; then BOX_BODY="$1"; else BOX_BODY="$BOX_BODY
$1"; fi
  BOX_N=$((BOX_N + 1))
}
# Dim label + value row inside a panel. $3 = label column (default 10).
box_kv() { box_line "   ${C_DIM}$(printf '%-*s' "${3:-10}" "$1")${C_RESET}  $2"; }
# Panel capability row: "✓ label" or "✗ label" ($2 = true|false).
box_check() {
  if [ "${2:-false}" = "true" ]; then
    box_line "   ${C_OK}✓${C_RESET} $1"
  else
    box_line "   ${C_ERR}✗${C_RESET} ${C_WARN}$1${C_RESET}"
  fi
}
box_end() {
  local tw pw bd tlt i n p line ind
  tw=$(( COLS - 4 )); [ "$tw" -gt 76 ] && tw=76
  pw=$(( tw - 4 ))
  case "$BOX_HUE" in
    ok)   bd="$C_BD_OK";   tlt="$C_TLT_OK" ;;
    warn) bd="$C_BD_WARN"; tlt="$C_TLT_WARN" ;;
    err)  bd="$C_BD_ERR";  tlt="$C_TLT_ERR" ;;
    cyan) bd="$C_BD_CYA";  tlt="$C_TLT_CYA" ;;
    *)    bd="$C_BD";      tlt="$C_TLT" ;;
  esac
  p="$(vis "$BOX_TITLE")"
  n=$(( tw - ${#p} - 5 )); [ "$n" -lt 2 ] && n=2
  printf '  %s╭─%s %s%s%s ' "$bd" "$C_RESET" "$tlt" "$BOX_TITLE" "$C_RESET"
  i=0; while [ "$i" -lt "$n" ]; do printf '%s─%s' "$bd" "$C_RESET"; i=$((i + 1)); done
  printf '%s╮%s\n' "$bd" "$C_RESET"
  while IFS= read -r line; do
    if [ "$line" = "__WEARSIC_HR__" ]; then
      # 3-space margin each side, dim: a section break, not a second border.
      line="   $(rule_line $(( pw - 6 )) 240 238)   "
    fi
    p="$(vis "$line")"
    if [ ${#p} -le "$pw" ]; then
      printf '  %s│%s %s' "$bd" "$C_RESET" "$line"
      i=$(( pw - ${#p} ))
      while [ "$i" -gt 0 ]; do printf ' '; i=$((i - 1)); done
      printf ' %s│%s\n' "$bd" "$C_RESET"
    else
      # Keep the content's own left margin: word wrapping splits on spaces,
      # so the leading indent is re-applied to every segment here.
      ind="$(printf '%s' "$p" | sed -n 's/^\( *\).*$/\1/p')"
      while IFS= read -r seg; do
        p="$(vis "$seg")"
        printf '  %s│%s %s' "$bd" "$C_RESET" "$seg"
        i=$(( pw - ${#p} ))
        while [ "$i" -gt 0 ]; do printf ' '; i=$((i - 1)); done
        printf ' %s│%s\n' "$bd" "$C_RESET"
      done < <(wrap_text "${p#"$ind"}" $(( pw - ${#ind} )) "$ind" "")
    fi
  done <<EOF
$BOX_BODY
EOF
  printf '  %s╰' "$bd"
  i=$(( tw - 2 )); while [ "$i" -gt 0 ]; do printf '─'; i=$((i - 1)); done
  printf '╯%s\n' "$C_RESET"
  BOX_TITLE=""; BOX_BODY=""; BOX_N=0; BOX_HUE=""
}

# Dim horizontal rule, terminal width (sets long guidance apart).
hr() {
  local i=$(( COLS - 4 ))
  printf '\n  %s' "$C_DIM"
  while [ "$i" -gt 0 ]; do printf '─'; i=$((i - 1)); done
  printf '%s\n' "$C_RESET"
}

# ── small data helpers for the status-style commands ────────────────────────
# HTTP GET that never fails the caller: body/code/milliseconds land in
# HTTP_BODY / HTTP_CODE / HTTP_MS and the caller decides how to render.
http_get() { # $1 = url, $2 = timeout seconds (default 5)
  local t="${2:-5}" out tsec
  HTTP_BODY=""; HTTP_CODE="000"; HTTP_MS=""
  out="$(curl -s -m "$t" -w $'\n%{http_code} %{time_total}' "$1" 2>/dev/null)" || true
  case "$out" in
    *$'\n'*)
      HTTP_BODY="${out%$'\n'*}"
      out="${out##*$'\n'}"
      HTTP_CODE="${out%% *}"
      tsec="${out#* }"
      case "$tsec" in
        ''|*[!0-9.]*) HTTP_MS="" ;;
        *) HTTP_MS="$(awk -v t="$tsec" 'BEGIN{printf "%.0f", t*1000}')" ;;
      esac ;;
  esac
}

# The /health and /ready schemas are fixed: first-occurrence readers.
# awk index() finds the FIRST match, so a top-level key wins over a nested
# one with the same name (e.g. top-level "status":"ok" vs update.status).
# Empty output = the field is missing (or null).
json_tail() { # text right after the first "key": (compact or pretty JSON)
  printf '%s' "$1" | awk -v k="\"$2\"" '{
    n = index($0, k); if (n == 0) next
    rest = substr($0, n + length(k))
    # Cloudflare live API pretty-prints: "key": value. Health/state JSON
    # is compact: "key":value. Accept both, with or without spaces.
    sub(/^[ \t]*:[ \t]*/, "", rest)
    print rest
  }'
}
jstr() {
  json_tail "$1" "$2" | awk '{
    if (substr($0, 1, 1) != "\"") next
    s = substr($0, 2); m = index(s, "\"")
    if (m > 0) print substr(s, 1, m - 1)
  }'
}
jnum() {
  json_tail "$1" "$2" | awk '{
    s = $0; sub(/^[ \t]*/, "", s)
    if (substr(s, 1, 1) !~ /[0-9]/) next
    sub(/[^0-9].*$/, "", s); print s
  }'
}
jbool() {
  json_tail "$1" "$2" | awk '{
    s = $0; sub(/^[ \t]*/, "", s)
    if (substr(s, 1, 4) == "true") print "true"
    else if (substr(s, 1, 5) == "false") print "false"
  }'
}
jobj() { # content between the braces of the first "key":{...}
  printf '%s' "$1" | awk -v k="\"$2\":{" '{
    n = index($0, k); if (n == 0) next
    s = substr($0, n + length(k)); m = index(s, "}")
    if (m > 0) print substr(s, 1, m - 1)
  }'
}

# "2d 4h" / "1h 07m" / "3m 04s" / "12s".
human_duration() {
  local s="${1:-0}" d h m
  d=$((s / 86400)); h=$(((s % 86400) / 3600)); m=$(((s % 3600) / 60))
  if [ "$d" -gt 0 ]; then printf '%dd %dh' "$d" "$h"
  elif [ "$h" -gt 0 ]; then printf '%dh %02dm' "$h" "$m"
  elif [ "$m" -gt 0 ]; then printf '%dm %02ds' "$m" "$((s % 60))"
  else printf '%ds' "$s"; fi
}

# Process uptime. Primary source /proc (no ps dependence); when the kernel
# hides /proc/uptime from apps, fall back to ps -o etime. Empty on failure.
proc_uptime() { # $1 = pid
  local pid="${1:-}" stat rest start hz up secs
  case "$pid" in ''|*[!0-9]*) return 0 ;; esac
  if [ -r "/proc/$pid/stat" ] && [ -r /proc/uptime ]; then
    stat="$(cat "/proc/$pid/stat" 2>/dev/null)" || stat=""
    rest="${stat##*\) }"                                 # strip "pid (comm) "
    start="$(printf '%s' "$rest" | awk '{print $20}')"   # starttime, in ticks
    case "$start" in
      ''|*[!0-9]*) ;;
      *)
        hz="$(getconf CLK_TCK 2>/dev/null || true)"
        case "$hz" in ''|*[!0-9]*) hz=100 ;; esac
        up="$(awk '{print $1}' /proc/uptime 2>/dev/null)"
        case "$up" in
          ''|*[!0-9.]*) ;;
          *) secs="$(awk -v u="$up" -v s="$start" -v h="$hz" 'BEGIN{d=u-s/h; if (d<0) d=0; printf "%d", d}')" ;;
        esac ;;
    esac
  fi
  if [ -z "${secs:-}" ]; then
    # Fallback: [[dd-]hh:]mm:ss from ps. procps (Termux) takes -p; BusyBox
    # ps has no -p, so ask for etime+pid and match the row ourselves.
    local et d h m s
    et="$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ')"
    if [ -z "$et" ]; then
      et="$(ps -o etime=,pid= 2>/dev/null | awk -v p="$pid" '$NF == p { print $1; exit }')"
    fi
    case "$et" in
      *-*:*:*) d="${et%%-*}"; rest="${et#*-}"; h="${rest%%:*}"; rest="${rest#*:}"
               m="${rest%%:*}"; s="${rest##*:}"; secs=$((10#$d * 86400 + 10#$h * 3600 + 10#$m * 60 + 10#$s)) ;;
      *:*:*)   h="${et%%:*}"; rest="${et#*:}"; m="${rest%%:*}"; s="${rest##*:}"
               secs=$((10#$h * 3600 + 10#$m * 60 + 10#$s)) ;;
      *:*)     m="${et%%:*}"; s="${et##*:}"; secs=$((10#$m * 60 + 10#$s)) ;;
      *)       secs="" ;;
    esac
  fi
  [ -n "${secs:-}" ] || return 0
  human_duration "$secs"
}

# Doctor row: state ok|warn|err|off, name, detail. The detail column starts
# at column 23; long detail text wraps with continuation lines aligned under
# it and a single overlong token (a path) is head-elided, never split.
doctor_row() { # name state detail
  local name="$1" text="$3" sym plain w pfx first=1 seg
  case "$2" in
    ok)   sym="${C_OK}✓${C_RESET}" ;;
    warn) sym="${C_WARN}!${C_RESET}" ;;
    err)  sym="${C_ERR}✗${C_RESET}" ;;
    *)    sym="${C_DIM}·${C_RESET}" ;;
  esac
  printf '    %s %s%-16s%s ' "$sym" "$C_DIM" "$name" "$C_RESET"
  w=$(( COLS - 23 ))
  [ "$w" -lt 10 ] && w=10
  pfx="$(printf '%23s' '')"
  plain="$(vis "$text")"
  if [ "${WRAP_OK:-0}" != "1" ] || [ ${#plain} -le "$w" ]; then
    printf '%s\n' "$text"
    return 0
  fi
  case "$plain" in
    *" "*)
      while IFS= read -r seg; do
        if [ "$first" = "1" ]; then printf '%s\n' "$seg"; first=0
        else printf '%s%s\n' "$pfx" "$seg"; fi
      done < <(wrap_text "$plain" "$w" "" "")
      ;;
    *)
      printf '%s\n' "$(elide_head "$plain" "$w")"
      ;;
  esac
}

installed() {
  [ -x "$DEST/bin/wearsic-server" ] \
    || die "Not installed (no $DEST/bin/wearsic-server). Run the one-line installer, or: ./gradlew :wearsic-server:installDist"
  [ -f "$RUN" ] || die "Not installed (no supervisor script at $RUN)."
}

# --- .env parsing (never `source` it — values may contain spaces) ----
env_value() {  # $1 = key name
  [ -f "$ENV_FILE" ] || return 0
  sed -n "s/^$1=//p" "$ENV_FILE" | tail -1 | tr -d '\r\n'
}

port() { local p; p="$(env_value PORT)"; [ -n "$p" ] || p="8080"; printf '%s' "$p"; }

# SHA-256 of a file (any platform: sha256sum or shasum).
file_hash() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" 2>/dev/null | awk '{print $1}'
  else
    shasum -a 256 "$1" 2>/dev/null | awk '{print $1}'
  fi
}
api_key() { env_value WEARSIC_API_KEY; }

# --- process helpers (direct /proc scan; no pgrep/ps dependency) -------
canonical_path() {  # resolve symlinked parents (e.g. /data/user/0 -> /data/data)
  readlink -f "$1" 2>/dev/null || printf '%s' "$1"
}

pids_for() {  # $1 = literal string to find in process command lines
  # Direct /proc scan — no pgrep/ps dependency, identical on Termux,
  # Alpine/busybox (whose pgrep -f misbehaves) and CI. Literal match
  # (not regex): dots in class names must not become wildcards.
  # Self-exclusion: $$ is the script PID; $BASHPID is a transient
  # command-substitution subshell sharing our cmdline. Both are filtered
  # so a supervisor never "finds itself" and refuses to start.
  local pat="$1" self="$$" sub="${BASHPID:-$$}" d pid cmdline
  for d in /proc/[0-9]*; do
    pid="${d#/proc/}"
    [ "$pid" = "$self" ] && continue
    [ "$pid" = "$sub" ] && continue
    cmdline="$( { tr '\0' ' ' < "$d/cmdline"; } 2>/dev/null )" || continue
    [ -z "$cmdline" ] && continue
    case "$cmdline" in
      *"$pat"*) printf '%s\n' "$pid" ;;
    esac
  done
}

pids_for_script() {  # $1 = script path — pids whose argv[1] IS that script
  # Precise variant of pids_for: only a process EXECUTING the script counts
  # (bash /path/run-termux.sh). A recovery launcher whose argv merely
  # MENTIONS the path — bash -c "cd … && setsid nohup bash …/run-termux.sh"
  # — is not a supervisor. The substring match counted it, so the real
  # instance refused to start ("another supervisor is already running")
  # while no engine existed, and the engine guard "waited for a supervisor
  # that does not exist" instead of restarting a dead engine.
  # argv[1] either IS the path verbatim, or resolves (relative argv[1]
  # against the process's OWN cwd) to the same canonical file — this
  # covers ./run-termux.sh and the /data/user/0 vs /data/data spellings
  # WITHOUT cross-counting a different install's run-termux.sh basename.
  local pat="$1" base="${1##*/}" canon_pat self="$$" sub="${BASHPID:-$$}"
  local d pid a1 cwd cand canon
  canon_pat="$(canonical_path "$pat")"
  for d in /proc/[0-9]*; do
    pid="${d#/proc/}"
    [ "$pid" = "$self" ] && continue
    [ "$pid" = "$sub" ] && continue
    a1="$( { tr '\0' '\n' < "$d/cmdline"; } 2>/dev/null | sed -n 2p )" || continue
    [ -z "$a1" ] && continue
    case "$a1" in
      "$pat") printf '%s\n' "$pid"; continue ;;
    esac
    [ "${a1##*/}" = "$base" ] || continue
    cand="$a1"
    case "$a1" in
      /*) ;;
      *) cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null)"
         [ -n "$cwd" ] && cand="$cwd/$a1" ;;
    esac
    canon="$(canonical_path "$cand")"
    [ -n "$canon" ] && [ -n "$canon_pat" ] && [ "$canon" = "$canon_pat" ] && printf '%s\n' "$pid"
  done
}

# Both the launcher and the engine can be reached through a symlinked home
# on Android (`/data/user/0` -> `/data/data`). The JVM records the REAL path
# in its classpath, so matching only the un-resolved $DEST made `stop`,
# `status` and `doctor` blind to their own process. Try both spellings.
supervisor_pids() {
  # argv[1] precision (see pids_for_script): a process that merely mentions
  # the path in its argv is not the supervisor. The suffix match covers
  # both /data/data and /data/user/0 spellings of the home.
  pids_for_script "$RUN"
}
supervisor_running() { [ -n "$(supervisor_pids)" ]; }

# THIS install's engine process(es). Matching only the main class was a
# landmine: with two wearsic installs on one device (e.g. a test copy),
# `wearsic stop` in one killed the other's server too. The JVM command
# line carries the install path (classpath + launcher script), so require
# the main class AND $DEST.
server_pids() {
  local self="$$" sub="${BASHPID:-$$}" d pid cmdline dest_real
  dest_real="$(canonical_path "$DEST")"
  for d in /proc/[0-9]*; do
    pid="${d#/proc/}"
    [ "$pid" = "$self" ] && continue
    [ "$pid" = "$sub" ] && continue
    cmdline="$( { tr '\0' ' ' < "$d/cmdline"; } 2>/dev/null )" || continue
    case "$cmdline" in
      *"com.wearsic.server.ApplicationKt"*) ;;
      *) continue ;;
    esac
    case "$cmdline" in
      *"$DEST"*|*"$dest_real"*) printf '%s\n' "$pid" ;;
    esac
  done
}

# The launcher script exec()s into the JVM, so the process command line is
# the java main class, not the script path — match BOTH.
server_running() { [ -n "$(server_pids)" ]; }

health_ok() {
  curl -sf -m 5 "http://127.0.0.1:$(port)/health" >/dev/null 2>&1
}

# Best-effort LAN IP of this device — the address to enter on the watch.
# Termux ships neither iproute2 nor net-tools, and recent Android removed
# the old `dhcp.wlan0.ipaddress` property, so every probe we know is tried
# in order until one answers:
#   1. termux-wifi-connectioninfo (termux-api add-on; exact Wi-Fi address)
#   2. ip / iproute2             (Wi-Fi first, then the default-route NIC)
#   3. ifconfig / net-tools      (same order)
#   4. Android's own tools       (/system/bin/ip, /system/bin/ifconfig —
#      absolute paths because Termux's PATH never contains /system/bin)
#   5. getprop                   (older Androids expose dhcp.*.ipaddress)
#   6. /proc/net/fib_trie        (last resort, legacy domains only)
# Prints NOTHING when every probe fails: callers print guidance instead of
# a fake `http://<phone-IP>` placeholder (users typed it verbatim).

# Default-route interface from /proc (no tools needed). Empty when the file
# is unreadable (modern-target app domains cannot read it; Termux can).
default_iface() {
  awk '$2 == "00000000" && $1 != "lo" { print $1; exit }' \
    "${WEARSIC_PROC_NET:-/proc/net}/route" 2>/dev/null
}

# How suitable an interface is for the address the WATCH must reach. The
# watch lives on Wi-Fi or on the phone's hotspot; cellular and VPN links are
# never reachable from it, even when they carry the default route (Android
# often prefers mobile data while Wi-Fi is still connected). Lower is better;
# 99 means "never". Wi-Fi names vary: wlan0, wlan1, swlan0, wifi0...
lan_iface_score() {
  case "${1%%@*}" in
    wlan*|swlan*|wifi*) echo 0 ;;
    ap*|softap*) echo 1 ;;
    eth*|usb*|rndis*|en*) echo 2 ;;
    rmnet*|ccmni*|pdp*|wwan*|seth*|v4-*|clat*|tun*|tap*|wg*|tailscale*|ppp*|dummy*) echo 99 ;;
    *) echo 5 ;;
  esac
}

# stdin: "iface address" pairs. Print the best watch-reachable address, or
# nothing. Private (RFC1918) addresses break ties over public ones.
lan_ip_best() {
  local iface addr s best="" best_score=1000
  while read -r iface addr; do
    [ -n "$iface" ] || continue
    case "$addr" in ''|*[!0-9.]*) continue ;; esac
    s="$(lan_iface_score "$iface")"
    [ "$s" -ge 99 ] && continue
    case "$addr" in
      10.*|192.168.*|172.1[6-9].*|172.2[0-9].*|172.3[01].*) : ;;
      *) s=$((s + 10)) ;;
    esac
    if [ "$s" -lt "$best_score" ]; then best="$addr"; best_score="$s"; fi
  done
  printf '%s' "$best"
}

# stdin: `ip -4 -o addr show` -> "iface address" pairs.
lan_ip_pairs_ip() {
  awk '{ iface=$2; sub(/:$/,"",iface); sub(/@.*/,"",iface)
         for (i=3;i<=NF;i++) if ($i=="inet") {
           a=$(i+1); sub(/\/.*/,"",a); print iface, a } }'
}

# stdin: `ifconfig -a` -> "iface address" pairs (net-tools + busybox forms).
lan_ip_pairs_ifconfig() {
  awk '/^[^ \t]/ { iface=$1; sub(/:$/,"",iface); sub(/@.*/,"",iface) }
       { for (i=1;i<=NF;i++) if ($i=="inet") {
           a=$(i+1); sub(/^addr:/,"",a); sub(/\/.*/,"",a)
           if (a ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) print iface, a } }'
}

# Best-effort LAN IP of this device — the address to enter on the watch.
# Termux ships neither iproute2 nor net-tools, and recent Android removed
# the old `dhcp.wlan0.ipaddress` property, so every probe we know is tried
# in order until one answers:
#   1. termux-wifi-connectioninfo (termux-api add-on; exact Wi-Fi address)
#   2. ip / iproute2             (all interfaces, ranked — see below)
#   3. ifconfig / net-tools      (same ranking)
#   4. Android's own tools       (/system/bin/ip, /system/bin/ifconfig —
#      absolute paths because Termux's PATH never contains /system/bin)
#   5. getprop                   (older Androids expose dhcp.*.ipaddress)
#   6. /proc/net/fib_trie        (last resort, legacy domains only)
# The ranking is the part that matters on a phone: Wi-Fi (wlan*/wlan1/
# swlan*) beats the hotspot (ap*) which beats wired/tether (eth*/usb*);
# rmnet/ccmni/pdp (mobile data) and tun/wg/tailscale (VPN) are discarded.
# Picking the default-route NIC was wrong: Android keeps the mobile default
# route while Wi-Fi is connected, which handed users a 10.x carrier address.
# Prints NOTHING when every probe fails: callers print guidance instead of
# a fake `http://<phone-IP>` placeholder (users typed it verbatim).

lan_ip() {
  local ip="" sys route dev
  sys="${WEARSIC_SYS_BIN:-/system/bin}"

  # 0. Explicit override. Modern Android hides most interface information
  #    from apps (see the fib_trie note below), so the user must always be
  #    able to say the address instead of being told Wi-Fi is off:
  #      WEARSIC_LAN_IP=192.168.1.50 wearsic url
  #    or persist it in .env (wearsic ip <addr> does that for you).
  #    An invalid value falls through to the probes below.
  ip="${WEARSIC_LAN_IP:-}"
  if [ -z "$ip" ] && [ -n "${ENV_FILE:-}" ] && [ -f "${ENV_FILE:-}" ]; then
    ip="$(sed -n 's/^WEARSIC_LAN_IP=//p' "$ENV_FILE" 2>/dev/null | head -1 | tr -d '\r')"
  fi
  if [ -n "$ip" ] && ! printf '%s' "$ip" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
    ip=""
  fi

  # 1. Termux:API — exact Wi-Fi address, no parsing games.
  if [ -z "$ip" ] && command -v termux-wifi-connectioninfo >/dev/null 2>&1; then
    ip="$(termux-wifi-connectioninfo 2>/dev/null \
      | sed -n 's/.*"ip"[[:space:]]*:[[:space:]]*"\([0-9.]\{7,\}\)".*/\1/p' | head -1)"
    case "$ip" in 0.*) ip="" ;; esac
  fi

  # 2. iproute2: enumerate EVERY interface and rank it. This is what makes
  #    wlan1/swlan0 and a hotspot work, and what keeps rmnet_data0 out.
  if [ -z "$ip" ] && command -v ip >/dev/null 2>&1; then
    ip="$(ip -4 -o addr show 2>/dev/null | lan_ip_pairs_ip | lan_ip_best)"
    if [ -z "$ip" ]; then
      # Kernel source-address lookup, only when its interface is LAN-class.
      route="$(ip route get 1.1.1.1 2>/dev/null | head -1)"
      dev="$(printf '%s' "$route" | sed -n 's/.* dev \([^ ]*\).*/\1/p')"
      if [ -n "$dev" ] && [ "$(lan_iface_score "$dev")" -lt 99 ]; then
        ip="$(printf '%s' "$route" | sed -n 's/.* src \([0-9.]\+\).*/\1/p' | head -1)"
      fi
    fi
  fi

  # 3. net-tools ifconfig (present only when the user installed it).
  if [ -z "$ip" ] && command -v ifconfig >/dev/null 2>&1; then
    ip="$(ifconfig -a 2>/dev/null | lan_ip_pairs_ifconfig | lan_ip_best)"
  fi

  # 4. Android's own tools, by absolute path. Termux's linker environment
  #    can hide Android's libraries from a /system/bin binary ("CANNOT LINK
  #    EXECUTABLE"), which silently produced an empty probe — retry the
  #    identical command with the system library path when the first run
  #    yields nothing. Harmless where the direct run already works.
  if [ -z "$ip" ] && [ -x "$sys/ip" ]; then
    ip="$("$sys/ip" -4 -o addr show 2>/dev/null | lan_ip_pairs_ip | lan_ip_best)"
    if [ -z "$ip" ]; then
      ip="$(LD_LIBRARY_PATH=/system/lib64:/system/lib "$sys/ip" -4 -o addr show 2>/dev/null \
        | lan_ip_pairs_ip | lan_ip_best)"
    fi
  fi
  if [ -z "$ip" ] && [ -x "$sys/ifconfig" ]; then
    ip="$("$sys/ifconfig" -a 2>/dev/null | lan_ip_pairs_ifconfig | lan_ip_best)"
    if [ -z "$ip" ]; then
      ip="$(LD_LIBRARY_PATH=/system/lib64:/system/lib "$sys/ifconfig" -a 2>/dev/null \
        | lan_ip_pairs_ifconfig | lan_ip_best)"
    fi
  fi

  # 5. Android properties (older devices; gone on many Android 10+ builds).
  local gp=""
  if command -v getprop >/dev/null 2>&1; then gp="getprop"
  elif [ -x "$sys/getprop" ]; then gp="$sys/getprop"; fi
  if [ -z "$ip" ] && [ -n "$gp" ]; then
    ip="$("$gp" dhcp.wlan0.ipaddress 2>/dev/null | tr -d '\r\n')"
    case "$ip" in 0.*) ip="" ;; esac
    if [ -z "$ip" ]; then
      ip="$("$gp" 2>/dev/null \
        | sed -n 's/^\[[^]]*[Ww][Ll][Aa][Nn][^]]*\.ipaddress\]: \[\([0-9.]*\)\]$/\1/p' | head -1)"
    fi
  fi

  # 6. Pure /proc. NOT gated on the default interface: on modern Android
  #    /proc/net/route is often unreadable while /proc/net/fib_trie still is,
  #    and the old gate turned that exact combination into a permanent "no
  #    IP" (the reported "wearsic says Wi-Fi is off" bug).
  if [ -z "$ip" ]; then
    ip="$(awk '/32 host/ { print f } { f = $2 }' "${WEARSIC_PROC_NET:-/proc/net}/fib_trie" 2>/dev/null \
      | grep -E '^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.)' | head -1)"
  fi

  # Only a plain dotted quad leaves this function.
  if printf '%s' "$ip" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
    printf '%s' "$ip"
  fi
}

write_env_key() {  # $1 = key
  if grep -q '^WEARSIC_API_KEY=' "$ENV_FILE" 2>/dev/null; then
    sed -i "s|^WEARSIC_API_KEY=.*|WEARSIC_API_KEY=$1|" "$ENV_FILE"
  else
    printf '\n# Shared secret — enter the same value in the watch app (Settings → API Key)\nWEARSIC_API_KEY=%s\n' "$1" >> "$ENV_FILE"
  fi
}

write_env_value() {  # $1 = key, $2 = value (may contain spaces/;)
  if grep -q "^$1=" "$ENV_FILE" 2>/dev/null; then
    sed -i "s|^$1=.*|$1=$2|" "$ENV_FILE"
  else
    printf '%s=%s\n' "$1" "$2" >> "$ENV_FILE"
  fi
}

# http://<this-phone>:<port>, or EMPTY when no local IP can be found —
# callers show guidance instead of a fake `http://<phone-IP>` placeholder
# (a placeholder looks like a ready-to-type address, and users typed it).
server_url() {
  local ip; ip="$(lan_ip)"
  if [ -n "$ip" ]; then printf 'http://%s:%s' "$ip" "$(port)"; fi
}

show_pairing() {
  local key url; key="$(api_key)"; url="$(server_url)"
  box_begin "connect your watch" cyan
  box_line ""
  # Onboarding card: numbered steps, the value on its own line, a hairline
  # before the fine print. Reads like a setup screen, not a log dump.
  box_line "   ${C_ACC}1${C_RESET}  ${C_DIM}address${C_RESET}"
  if [ -n "$url" ]; then
    box_line "      ${C_CYA}${url}${C_RESET}"
  else
    box_line "      ${C_WARN}couldn't detect this phone's IP${C_RESET}"
    box_line "      ${C_DIM}Wi-Fi may still be on — Android hides the interface.${C_RESET}"
    box_line "      ${C_DIM}read it in Settings → Wi-Fi, then save it:${C_RESET}"
    box_line "      ${C_ACC}wearsic ip 192.168.x.y${C_RESET}"
  fi
  box_line ""
  box_line "   ${C_ACC}2${C_RESET}  ${C_DIM}key${C_RESET}"
  if [ -n "$key" ]; then
    box_line "      ${C_ACC}${key}${C_RESET}"
  else
    box_line "      ${C_WARN}not set — anyone on your network can use this server${C_RESET}"
  fi
  box_line ""
  box_hr
  box_line "   ${C_DIM}Wearsic app › Settings — enter both values.${C_RESET}"
  box_line "   ${C_DIM}or send them over adb:${C_RESET} ${C_ACC}wearsic pair${C_RESET}"
  box_end
}

cmd_start() {
  installed
  brand "start"
  if health_ok; then
    ok "already running on port $(port)"
    printf '\n'
    show_pairing
    return 0
  fi
  if supervisor_running; then
    note "supervisor is running — waiting for the server…"
  else
    dim "starting (keep Wi-Fi on; unrestricted battery for Termux helps)…"
    # bash explicitly so the launcher starts on any system (its shebang
    # points at the Termux bash path); identical behavior on Termux.
    # setsid detaches the supervisor into its own session, so it survives the
    # shell that started it — and the process-group kill that a terminal or
    # an app teardown sends. nohup alone only ignores SIGHUP.
    if command -v setsid >/dev/null 2>&1; then
      ( cd "$DEST" && setsid nohup bash "$RUN" >/dev/null 2>&1 < /dev/null & )
    else
      ( cd "$DEST" && nohup bash "$RUN" >/dev/null 2>&1 < /dev/null & )
    fi
  fi
  # Wait for /health while the live line shimmers (the supervisor installs
  # ffmpeg on the first start, which can take a while on a phone).
  if shim_wait "Start  waiting for the server" 90 "health_ok"; then
    ok "server is up — the self-healing supervisor is watching it"
    printf '\n'
    show_pairing
  else
    err "the server did not answer in time"
    dim "check the logs: wearsic logs"
    return 1
  fi
}

cmd_stop() {
  installed
  brand "stop"
  local pids pid i
  pids="$(supervisor_pids; server_pids)"
  [ -n "$pids" ] || { note "server is not running."; return 0; }
  note "stopping…"
  # Stop the supervisor first: its trap kills the JVM — but the trap only
  # runs after its current (up to 30s) sleep ends. So poll for REAL exit and
  # escalate to kill -9, otherwise a "stopped" supervisor lingers and the
  # next start is refused by its singleton guard.
  for pid in $(supervisor_pids); do kill "$pid" 2>/dev/null; done
  i=0
  while [ "$i" -lt 8 ] && [ -n "$(supervisor_pids)" ]; do
    sleep 1
    i=$((i + 1))
  done
  for pid in $(supervisor_pids); do kill -9 "$pid" 2>/dev/null; done
  # Then the JVM itself (graceful, then force), in case the supervisor was
  # already dead and left it behind.
  pids="$(server_pids)"
  for pid in $pids; do kill "$pid" 2>/dev/null; done
  sleep 1
  pids="$(server_pids)"
  for pid in $pids; do kill -9 "$pid" 2>/dev/null; done
  # Wait until the port actually goes quiet: graceful shutdown drains
  # in-flight streams for seconds, during which /health still answers —
  # without this wait `status` right after `stop` wrongly reports healthy.
  shim_wait "Stop  waiting for the port to go quiet" 20 "! health_ok" || true
  i=0
  while [ "$i" -lt 20 ] && health_ok; do
    sleep 1
    i=$((i + 1))
  done
  ok "stopped"
}

cmd_restart() { cmd_stop; cmd_start; }

# `wearsic port` prints the configured port; `wearsic port <n>` validates and
# persists a new port to .env (PORT=). The engine, the supervisor and every
# CLI health/URL/Cloudflare path read PORT dynamically, so a change applies on
# the next start/restart — the running server must be restarted to pick it up.
cmd_port() {
  installed
  if [ "$#" -eq 0 ]; then
    brand "port"
    printf '  %s\n' "current port: $(port)"
    printf '  %s\n' "set a new port: wearsic port 9000 (1024–65535; restart to apply)"
    return 0
  fi
  local candidate="$1"
  case "$candidate" in
    ''|*[!0-9]*) die "port must be a number (1024–65535)" ;;
  esac
  if [ "$candidate" -lt 1024 ] || [ "$candidate" -gt 65535 ]; then
    die "port must be between 1024 and 65535"
  fi
  if [ "$(port)" = "$candidate" ]; then
    ok "port is already $candidate"
    return 0
  fi
  write_env_value PORT "$candidate"
  ok "port set to $candidate (saved to $ENV_FILE)"
  note "restart the server to apply: wearsic restart"
  if health_ok; then
    dim "the running server is still on port $(port) until it restarts"
  fi
}

# Exit codes (documented in usage + README):
#   0 = running and healthy   1 = error   3 = not running   4 = running but unhealthy
cmd_status() {
  installed
  brand "status"
  local P; P="$(port)"
  if health_ok; then
    local body ver ex pid up ok_n fail_n rate meta url key_state
    http_get "http://127.0.0.1:$P/health"
    body="$HTTP_BODY"
    ver="$(jstr "$body" version)"
    ex="$(jobj "$body" extraction)"
    ok_n="$(jnum "$ex" successCount)"; fail_n="$(jnum "$ex" failureCount)"; rate="$(jnum "$ex" failureRatePercent)"
    pid="$(server_pids | head -1)"
    up=""; [ -n "$pid" ] && up="$(proc_uptime "$pid")"
    meta=""; [ -n "$up" ] && meta="up $up"
    [ -n "$pid" ] && meta="${meta:+$meta · }pid $pid"
    url="$(server_url)"
    box_begin "status" ok
    box_line ""
    box_line "   $(pill ok healthy)${meta:+  ${C_DIM}${meta}${C_RESET}}"
    box_line ""
    if [ -n "$url" ]; then
      box_line "   ${C_CYA}${url}${C_RESET}"
    else
      box_line "   ${C_WARN}address not detected — wearsic url${C_RESET}"
    fi
    box_hr
    if [ -n "$(api_key)" ]; then key_state="set"; else key_state="${C_WARN}not set${C_RESET}"; fi
    box_kv2 "version" "v${ver:-unknown}" "port" "$P"
    box_kv2 "engine" "${ok_n:-0} ok · ${fail_n:-0} failed" "watch key" "$key_state"
    box_line ""
    box_line "   ${C_ACC}wearsic url${C_RESET}  ${C_DIM}connect the watch${C_RESET}"
    box_end
    return 0
  elif supervisor_running; then
    box_begin "status" warn
    box_line ""
    box_line "   $(pill warn not healthy)"
    box_line "   ${C_DIM}the supervisor is up but the server is not answering${C_RESET}"
    box_hr
    box_line "   ${C_ACC}wearsic logs${C_RESET}  ${C_DIM}see what the engine is doing${C_RESET}"
    box_end
    return 4
  else
    box_begin "status" err
    box_line ""
    box_line "   $(pill err stopped)"
    box_hr
    box_line "   ${C_ACC}wearsic start${C_RESET}  ${C_DIM}bring it back up${C_RESET}"
    box_end
    return 3
  fi
}

cmd_logs() {
  installed
  brand "logs"
  [ -f "$LOG" ] || die "No log yet ($LOG). Start the server first."
  dim "following $LOG — Ctrl+C to exit"
  printf '\n'
  tail -f "$LOG"
}

cmd_health() {
  installed
  local P; P="$(port)"
  if [ "${1:-}" = "--json" ]; then
    curl -sf -m 5 "http://127.0.0.1:$P/health" \
      || die "No response — is the server running? (wearsic start)"
    printf '\n'
    return 0
  fi
  brand "health"
  http_get "http://127.0.0.1:$P/health"
  [ "$HTTP_CODE" = "200" ] || die "No response — is the server running? (wearsic start)"
  local body st ver st_kind ex ok_n fail_n rate cons last_err extra upd stg tc
  body="$HTTP_BODY"
  st="$(jstr "$body" status)"
  ver="$(jstr "$body" version)"
  st_kind="ok"; [ "$st" = "ok" ] || st_kind="warn"
  ex="$(jobj "$body" extraction)"
  ok_n="$(jnum "$ex" successCount)"; fail_n="$(jnum "$ex" failureCount)"
  rate="$(jnum "$ex" failureRatePercent)"; cons="$(jnum "$ex" consecutiveFailures)"
  last_err="$(jstr "$ex" lastError)"
  extra=""
  if [ -n "$cons" ] && [ "$cons" -gt 0 ] 2>/dev/null; then extra=" · $cons in a row"; fi
  upd="$(jobj "$body" update)"
  stg="$(jstr "$upd" stagedVersion)"
  tc="$(jbool "$body" transcoderAvailable)"; [ "$tc" = "true" ] || tc="false"
  local tc_state="available"
  [ "$tc" = "true" ] || tc_state="${C_WARN}missing${C_RESET}"
  box_begin "health"
  box_line ""
  box_line "   $(pill "$st_kind" "${st:-unknown}")  ${C_DIM}127.0.0.1:${P} · ${HTTP_MS:-?}ms${C_RESET}"
  box_hr
  box_kv2 "version" "v${ver:-unknown}" "transcoder" "$tc_state"
  box_kv2 "extraction" "${ok_n:-0} ok · ${fail_n:-0} failed (${rate:-0}%)$extra" \
    "crashes" "$(jnum "$body" crashCount)"
  box_kv2 "cdn" "$(jnum "$body" upstreamRefusals) refused" \
    "update" "$(jstr "$upd" status)"
  [ -n "$stg" ] && box_kv "staged" "v$stg — applies on next restart"
  if [ "$tc" != "true" ]; then
    box_line ""
    box_line "   ${C_WARN}audio conversion unavailable${C_RESET} ${C_DIM}install it: pkg install -y ffmpeg${C_RESET}"
  fi
  if [ -n "$last_err" ]; then
    box_hr
    box_line "   ${C_ERR}last error${C_RESET}  ${C_DIM}${last_err}${C_RESET}"
  fi
  box_end
}

cmd_url() { installed; brand "url"; show_pairing; }

# `wearsic ip`            show this phone's LAN address
# `wearsic ip 192.168.x.y`  remember it (writes WEARSIC_LAN_IP to .env) — the
#                           escape hatch for Android builds where every
#                           interface probe is hidden from apps.
cmd_ip() {
  brand "ip"
  installed
  if [ -n "${1:-}" ]; then
    if ! printf '%s' "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'; then
      die "not an IPv4 address: $1"
    fi
    write_env_value WEARSIC_LAN_IP "$1"
    ok "LAN address saved: ${C_CYA}$1${C_RESET}"
    note "wearsic url and wearsic doctor will use it from now on."
    return 0
  fi
  local ip; ip="$(lan_ip)"
  if [ -n "$ip" ]; then
    box_begin "network" cyan
    box_line ""
    box_line "   ${C_DIM}LAN address${C_RESET}"
    box_line "   ${C_CYA}${ip}${C_RESET}"
    box_kv "source" "detected" 8
    box_line ""
    box_line "   ${C_DIM}the watch must be on the same Wi-Fi${C_RESET}"
    box_end
    return 0
  fi
  local saved; saved="$(env_value WEARSIC_LAN_IP)"
  if [ -n "$saved" ]; then
    box_begin "network" cyan
    box_line ""
    box_line "   ${C_DIM}LAN address${C_RESET}"
    box_line "   ${C_CYA}${saved}${C_RESET}"
    box_kv "source" "saved in .env" 8
    box_line ""
    box_line "   ${C_DIM}change it:${C_RESET} ${C_ACC}wearsic ip 192.168.x.y${C_RESET}"
    box_end
    return 0
  fi
  err "couldn't auto-detect this phone's LAN address"
  say "  This does NOT mean Wi-Fi is off: Android 10+ hides the network"
  say "  interfaces from apps, and Termux alone may not have a probe left."
  say ""
  say "  Fix it once — read the address in Android Settings → Wi-Fi →"
  say "  your network, then save it here:"
  say ""
  say "    ${C_ACC}wearsic ip 192.168.x.y${C_RESET}"
  say ""
  say "  Or go public instead (works off-network): ${C_ACC}wearsic funnel${C_RESET}"
  exit 1
}

cmd_api_key() {
