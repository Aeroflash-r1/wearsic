#!/data/data/com.termux/files/usr/bin/bash
# ─────────────────────────────────────────────────────────────────────
# wearsic — the everyday command for the Wearsic server.
#
#   wearsic start             start the server (self-healing supervisor)
#   wearsic stop              stop the server
#   wearsic restart           stop, then start
#   wearsic status            running? healthy? which version?
#   wearsic logs              live logs (Ctrl+C to exit)
#   wearsic health            raw /health JSON
#   wearsic url               Server URL + API key for the watch
#   wearsic api-key [new]     show / change the API key
#   wearsic update            update to the latest release (verified + rollback)
#   wearsic doctor            check the whole setup (exit 0 = READY)
#
# Also available: ready, ip, version, cookies [str], funnel, public.
# The classic nested form keeps working: `wearsic server start` etc.
#
# Installed to $PREFIX/bin by install.sh. Finds the server in
# $WEARSIC_DIR, else ~/wearsic-server.
# ─────────────────────────────────────────────────────────────────────
set -u

DEST="${WEARSIC_DIR:-$HOME/wearsic-server}"
RUN="$DEST/run-termux.sh"
LOG="$DEST/wearsic-server.log"
ENV_FILE="$DEST/.env"

say()  { printf '\033[2m[wearsic]\033[0m %s\n' "$*"; }
ok()   { printf '\033[2m[wearsic]\033[0m   \033[1;32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[2m[wearsic]\033[0m   \033[1;33m!\033[0m %s\n' "$*"; }
die()  { printf '\033[2m[wearsic]\033[0m \033[1;31mERROR:\033[0m %s\n' "$*" >&2; exit 1; }

# Animated spinner (see install.sh for the full pretty-output set).
# Animations auto-disable when piped so logs stay clean.
TTY_OUT=0; [ -t 1 ] && TTY_OUT=1
SPIN_PID=""; SPIN_MSG=""
spinner_start() {
  SPIN_MSG="$1"
  if [ "$TTY_OUT" != "1" ]; then say "$1…"; return 0; fi
  printf '\033[2m[wearsic]\033[0m  %s ' "$1"
  ( while :; do for f in $'\033[38;5;255m⠋' $'\033[38;5;158m⠙' $'\033[38;5;120m⠹' $'\033[38;5;114m⠸' $'\033[38;5;114m⠼' $'\033[38;5;120m⠴' $'\033[38;5;158m⠦' $'\033[38;5;255m⠧' $'\033[38;5;158m⠇' $'\033[38;5;120m⠏'; do printf '\b%s\033[0m' "$f"; sleep 0.09; done; done ) &
  SPIN_PID=$!
}
spinner_stop() {
  local msg="${2:-$SPIN_MSG}"
  if [ -n "$SPIN_PID" ]; then kill "$SPIN_PID" 2>/dev/null; wait "$SPIN_PID" 2>/dev/null; SPIN_PID=""; fi
  if [ "$TTY_OUT" = "1" ]; then printf '\b'; fi
  if [ "${1:-0}" = "0" ]; then ok "$msg"; else printf '\033[2m[wearsic]\033[0m  \033[1;31m✗\033[0m %s\n' "$msg"; fi
  SPIN_MSG=""
}

human_bytes() { # $1 = bytes -> 12.4M
  local b="${1:-0}"
  case "$b" in ''|*[!0-9]*) b=0 ;; esac
  if [ "$b" -ge 1048576 ]; then awk "BEGIN{printf \"%.1fM\", $b/1048576}";
  elif [ "$b" -ge 1024 ]; then awk "BEGIN{printf \"%.0fK\", $b/1024}";
  else printf '%sB' "$b"; fi
}

draw_bar() { # $1 label $2 pct $3 have-bytes $4 total-bytes
  local label="$1" pct="$2" have="$3" total="$4" width=18 i bar=""
  local filled=$(( pct * width / 100 ))
  i=0; while [ "$i" -lt "$filled" ]; do bar="${bar}█"; i=$((i + 1)); done
  while [ "$i" -lt "$width" ]; do bar="${bar}░"; i=$((i + 1)); done
  printf "\r\033[1;35m[wearsic]\033[0m  %s \033[38;5;157m%s\033[0m %3d%%  \033[2m%s / %s\033[0m" \
    "$label" "$bar" "$pct" "$(human_bytes "$have")" "$(human_bytes "$total")"
}

# Download with a live █ progress bar (MB + %). Spinner fallback when the
# server hides Content-Length. Returns curl's exit status.
download_bar() { # $1 = url, $2 = out file, $3 = label
  local url="$1" out="$2" label="${3:-download}"
  local total=""
  total="$(curl -fsSIL --max-time 15 "$url" 2>/dev/null | grep -i '^content-length:' | tail -1 | tr -d '\r' | awk '{print $2}')"
  case "$total" in ''|*[!0-9]*) total="" ;; esac
  if [ -z "$total" ] || [ "$TTY_OUT" != "1" ]; then
    spinner_start "$label"
    if curl -fL --retry 3 --retry-delay 2 -o "$out" "$url" >/dev/null 2>&1; then
      spinner_stop 0 "$label ($(du -h "$out" 2>/dev/null | cut -f1))"
    else
      spinner_stop 1 "$label"; return 1
    fi
    return 0
  fi
  curl -fL --retry 3 --retry-delay 2 -o "$out" "$url" >/dev/null 2>&1 &
  local pid=$! have=0 pct=0
  while kill -0 "$pid" 2>/dev/null; do
    have="$(wc -c < "$out" 2>/dev/null || echo 0)"
    pct=$(( have * 100 / total ))
    [ "$pct" -gt 100 ] && pct=100
    draw_bar "$label" "$pct" "$have" "$total"
    sleep 0.2
  done
  wait "$pid" || { printf '\n'; return 1; }
  draw_bar "$label" 100 "$total" "$total"
  printf '\n'
  return 0
}

# Rounded box for pairing cards and verdicts.
box_top()    { printf '\033[38;5;114m╭─ %s %s\033[0m\n' "$1" "$(box_rule "$1")"; }
box_line()   { printf '\033[38;5;114m│\033[0m %s\n' "$1"; }
box_bottom() { printf '\033[38;5;114m╰%s╯\033[0m\n' "$(box_rule "")"; }
box_rule() {
  local n=$(( 50 - ${#1} )); [ "$n" -lt 4 ] && n=4
  local i=0 s=""; while [ "$i" -lt "$n" ]; do s="${s}─"; i=$((i + 1)); done
  printf '%s' "$s"
}

installed() { [ -f "$RUN" ] || die "Not installed (no $DEST). Run the one-line installer first."; }

# --- .env parsing (never `source` it — values may contain spaces) ----
env_value() {  # $1 = key name
  [ -f "$ENV_FILE" ] || return 0
  sed -n "s/^$1=//p" "$ENV_FILE" | tail -1 | tr -d '\r\n'
}

port() { local p; p="$(env_value PORT)"; [ -n "$p" ] || p="8080"; printf '%s' "$p"; }

# SHA-256 of a file (any platform: sha256sum or shasum).
file_hash() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" 2>/dev/null | awk '{print $1}'
  else
    shasum -a 256 "$1" 2>/dev/null | awk '{print $1}'
  fi
}
api_key() { env_value WEARSIC_API_KEY; }

# --- process helpers (pgrep when available, ps fallback) --------------
pids_for() {  # $1 = literal string to find in process command lines
  # Direct /proc scan — no pgrep/ps dependency, identical on Termux,
  # Alpine/busybox (whose pgrep -f misbehaves) and CI. Literal match
  # (not regex): dots in class names must not become wildcards.
  # Self-exclusion: $$ is the script PID; $BASHPID is a transient
  # command-substitution subshell sharing our cmdline. Both are filtered
  # so a supervisor never "finds itself" and refuses to start.
  local pat="$1" self="$$" sub="${BASHPID:-$$}" d pid cmdline
  for d in /proc/[0-9]*; do
    pid="${d#/proc/}"
    [ "$pid" = "$self" ] && continue
    [ "$pid" = "$sub" ] && continue
    cmdline="$(tr '\0' ' ' < "$d/cmdline" 2>/dev/null)" || continue
    [ -z "$cmdline" ] && continue
    case "$cmdline" in
      *"$pat"*) printf '%s\n' "$pid" ;;
    esac
  done
}

supervisor_running() { [ -n "$(pids_for "$RUN")" ]; }
# The launcher script exec()s into the JVM, so the process command line is
# the java main class, not the script path — match BOTH.
server_running() {
  [ -n "$(pids_for "com.wearsic.server.ApplicationKt")" ] \
    || [ -n "$(pids_for "$DEST/bin/wearsic-server")" ]
}

health_ok() {
  curl -sf -m 5 "http://127.0.0.1:$(port)/health" >/dev/null 2>&1
}

# Best-effort LAN IP of this device (wlan0 first, then any route).
lan_ip() {
  local ip=""
  if command -v ip >/dev/null 2>&1; then
    ip="$(ip -f inet addr show wlan0 2>/dev/null | sed -n 's/.*inet \([0-9.]\+\).*/\1/p' | head -1)"
  fi
  if [ -z "$ip" ] && command -v ifconfig >/dev/null 2>&1; then
    ip="$(ifconfig wlan0 2>/dev/null | sed -n 's/.*inet addr:\([0-9.]\+\).*/\1/p' | head -1)"
    [ -z "$ip" ] && ip="$(ifconfig wlan0 2>/dev/null | sed -n 's/.*inet \([0-9.]\+\).*/\1/p' | head -1)"
  fi
  if [ -z "$ip" ] && command -v hostname >/dev/null 2>&1; then
    ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  fi
  printf '%s' "$ip"
}

write_env_key() {  # $1 = key
  if grep -q '^WEARSIC_API_KEY=' "$ENV_FILE" 2>/dev/null; then
    sed -i "s|^WEARSIC_API_KEY=.*|WEARSIC_API_KEY=$1|" "$ENV_FILE"
  else
    printf '\n# Shared secret — enter the same value in the watch app (Settings → API Key)\nWEARSIC_API_KEY=%s\n' "$1" >> "$ENV_FILE"
  fi
}

write_env_value() {  # $1 = key, $2 = value (may contain spaces/;)
  if grep -q "^$1=" "$ENV_FILE" 2>/dev/null; then
    sed -i "s|^$1=.*|$1=$2|" "$ENV_FILE"
  else
    printf '%s=%s\n' "$1" "$2" >> "$ENV_FILE"
  fi
}

server_url() {
  local ip; ip="$(lan_ip)"
  if [ -n "$ip" ]; then printf 'http://%s:%s' "$ip" "$(port)"
  else printf 'http://<phone-IP>:%s   (find it: wearsic server ip)' "$(port)"; fi
}

show_pairing() {
  box_top "♪ Connect your watch"
  box_line ""
  box_line "   Server URL : $(server_url)"
  box_line "   API key    : $(api_key)"
  box_line ""
  box_line "   Watch → Wearsic → Settings → Server URL   (paste the URL)"
  box_line "                            → API Key        (paste the key)"
  box_bottom
}

cmd_start() {
  installed
  if health_ok; then
    say "Server is already running: $(server_url)"
    return 0
  fi
  if supervisor_running; then
    say "Supervisor is running — waiting for the server to come up…"
  else
    say "Starting the server (leave WiFi on; battery unrestricted for Termux)…"
    # bash explicitly so the launcher starts on any system (its shebang
    # points at the Termux bash path); identical behavior on Termux.
    ( cd "$DEST" && nohup bash "$RUN" >/dev/null 2>&1 & )
  fi
  # Wait up to ~30s for /health (the supervisor installs ffmpeg on
  # first start, which can take a while).
  local i
  spinner_start "waiting for the server"
  for i in $(seq 1 30); do
    health_ok && break
    sleep 1
  done
  if health_ok; then
    spinner_stop 0 "server is up — self-healing supervisor is watching it"
    show_pairing
  else
    spinner_stop 1 "server start"
    say "Not healthy yet — check the logs:  wearsic server logs"
    return 1
  fi
}

cmd_stop() {
  installed
  local pids pid i
  pids="$(pids_for "$RUN"; pids_for "com.wearsic.server.ApplicationKt"; pids_for "$DEST/bin/wearsic-server")"
  [ -n "$pids" ] || { say "Server is not running."; return 0; }
  say "Stopping server…"
  # Stop the supervisor first: its trap kills the JVM — but the trap only
  # runs after its current (up to 30s) sleep ends. So poll for REAL exit and
  # escalate to kill -9, otherwise a "stopped" supervisor lingers and the
  # next start is refused by its singleton guard.
  for pid in $(pids_for "$RUN"); do kill "$pid" 2>/dev/null; done
  i=0
  while [ "$i" -lt 8 ] && [ -n "$(pids_for "$RUN")" ]; do
    sleep 1
    i=$((i + 1))
  done
  for pid in $(pids_for "$RUN"); do kill -9 "$pid" 2>/dev/null; done
  # Then the JVM itself (graceful, then force), in case the supervisor was
  # already dead and left it behind.
  pids="$(pids_for "com.wearsic.server.ApplicationKt"; pids_for "$DEST/bin/wearsic-server")"
  for pid in $pids; do kill "$pid" 2>/dev/null; done
  sleep 1
  pids="$(pids_for "com.wearsic.server.ApplicationKt"; pids_for "$DEST/bin/wearsic-server")"
  for pid in $pids; do kill -9 "$pid" 2>/dev/null; done
  # Wait until the port actually goes quiet: graceful shutdown drains
  # in-flight streams for seconds, during which /health still answers —
  # without this wait `status` right after `stop` wrongly reports healthy.
  spinner_start "waiting for the port to go quiet"
  i=0
  while [ "$i" -lt 20 ] && health_ok; do
    sleep 1
    i=$((i + 1))
  done
  spinner_stop 0 "stopped."
}

cmd_restart() { cmd_stop; cmd_start; }

# Exit codes (documented in usage + README):
#   0 = running and healthy   1 = error   3 = not running   4 = running but unhealthy
cmd_status() {
  installed
  local P; P="$(port)"
  if health_ok; then
    say "running and healthy on port $P"
    curl -sf -m 5 "http://127.0.0.1:$P/health" \
      | sed 's/^{"status":"ok"//' 2>/dev/null || true
    say ""
    return 0
  elif supervisor_running; then
    say "supervisor running, server NOT healthy — try: wearsic server logs"
    return 4
  else
    say "not running — start with: wearsic server start"
    return 3
  fi
}

cmd_logs() {
  installed
  [ -f "$LOG" ] || die "No log yet ($LOG). Start the server first."
  say "Tailing $LOG (Ctrl+C to exit)…"
  tail -f "$LOG"
}

cmd_health() {
  installed
  curl -sf -m 5 "http://127.0.0.1:$(port)/health" \
    || die "No response — is the server running? (wearsic server start)"
  say ""
}

cmd_url() { installed; show_pairing; }

cmd_ip() {
  local ip; ip="$(lan_ip)"
  [ -n "$ip" ] && say "WiFi IP: $ip" || die "Could not find a WiFi IP — are you connected to WiFi?"
}

cmd_api_key() {
  installed
  if [ -n "${1:-}" ]; then
    write_env_key "$1"
    say "API key updated. Restart to apply:"
    say "  wearsic server restart"
    say "Then set the same key on the watch (Settings → API Key)."
  else
    local k; k="$(api_key)"
    [ -n "$k" ] || die "No API key set — the server is OPEN. Set one with: wearsic server api key <your-key>"
    say "API key: $k"
    say "Enter it on the watch: Settings → API Key"
    say "Set a new one with: wearsic server api key <new-key>"
  fi
}

cmd_cookies() {
  installed
  local cookie port_ key_
  cookie="${1:-}"
  if [ -z "$cookie" ]; then
    printf 'Paste the YouTube cookie string (SID=...; HSID=...): '
    # -s: never echo the credential to the terminal.
    read -rs cookie || return 1
    printf '\n'
  fi
  [ -n "$cookie" ] || die "Empty cookie."
  port_="$(port)"
  key_="$(api_key)"
  if health_ok; then
    # Live-update the running server (it persists the cookie itself).
    local body
    body="$(printf '{"cookie":"%s"}' "$cookie" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    if curl -sf -m 10 -X POST -H "X-Wearsic-Key: $key_" \
         -H "Content-Type: application/json" \
         -d "$body" "http://127.0.0.1:$port_/api/config/youtube-cookie" >/dev/null; then
      say "Cookie set on the running server (persisted)."
    else
      say "Could not set the cookie live — writing to .env instead."
      write_env_value WEARSIC_YOUTUBE_COOKIE "$cookie"
      say "Restart to apply: wearsic server restart"
    fi
  else
    write_env_value WEARSIC_YOUTUBE_COOKIE "$cookie"
    say "Cookie saved to $ENV_FILE"
    say "Start (or restart) the server to apply: wearsic server start"
  fi
  # Confirm what the server sees (never echoes the cookie itself).
  if health_ok; then
    local has
    has="$(curl -sf -m 5 -H "X-Wearsic-Key: $key_" "http://127.0.0.1:$port_/api/config/youtube-cookie" 2>/dev/null || true)"
    say "Server cookie status: $has"
  fi
}

# Tailscale's daemon state, read without needing jq.
#
#   NoState   — tailscaled is not answering (daemon problem)
#   NeedsLogin— daemon up, but this node is not authenticated
#   Stopped   — authenticated but the node is down
#   Starting  — coming up
#   Running   — connected
#
# WHY THIS EXISTS: the funnel flow used to probe `tailscale status` for BOTH
# "is the daemon up?" and "am I logged in?". But `tailscale status` FAILS in
# BOTH cases, so the two conditions were indistinguishable. A freshly
# installed but logged-OUT node was reported as "Tailscale daemon is not
# running", and the `tailscale up` branch below it was unreachable code that
# could never run. Reading the backend state separates them cleanly.
ts_state() {
  local s
  s="$(tailscale status --json 2>/dev/null \
        | sed -n 's/.*"BackendState"[[:space:]]*:[[:space:]]*"\([A-Za-z]*\)".*/\1/p' | head -1)"
  # Fall back to probing if this tailscale build has no --json flag.
  if [ -z "$s" ]; then
    if tailscale status >/dev/null 2>&1; then
      s="Running"
    elif tailscale status 2>&1 | grep -qi 'logged out\|not logged in'; then
      s="NeedsLogin"
    else
      s="NoState"
    fi
  fi
  printf '%s' "$s"
}

cmd_funnel() {
  installed
  # Funnel exposes the server to the whole internet — require a key.
  if [ -z "$(api_key)" ]; then
    die "Funnel exposes the server to the internet — set an API key first:  wearsic server api key <your-key>"
  fi
  # Never expose a dead or half-started server.
  if ! health_ok; then
    die "Server is not running/healthy — start it first: wearsic server start"
  fi
  say "Tailscale Funnel — a STABLE public HTTPS URL for the server."
  say "Runs the tailscaled daemon inside Termux (userspace networking:"
  say "no root, no /dev/net/tun). The official Android app cannot do this."
  say ""
  # 1. tailscaled present?
  if ! command -v tailscale >/dev/null 2>&1; then
    say "Installing the Termux tailscaled build (community project:"
    say "bropines/tailscale-termux-cli)…"
    say ""
    curl -fsSL https://raw.githubusercontent.com/bropines/tailscale-termux-cli/main/remote-install.sh | bash \
      || die "tailscaled install failed — see https://github.com/bropines/tailscale-termux-cli"
    # Fresh installs need a hash-table refresh before the new binaries resolve.
    hash -r 2>/dev/null || true
    command -v tailscale >/dev/null 2>&1 \
      || die "tailscaled installed but 'tailscale' is still not on PATH — restart Termux and retry"
  fi
  # 2. Ensure the Termux tailscaled daemon is actually running.
  #
  # The community package normally installs a termux-services service at
  # $PREFIX/var/service/tailscaled. Some Termux installs can report a
  # successful package install while that service directory is missing (for
  # example after a package-manager/service initialization race). Do not make
  # Funnel depend on runit in that case: tailscaled-start is the package's
  # supported direct-start helper and works without a service directory.
  local tailscale_started=0
  if command -v sv >/dev/null 2>&1 && [ -x "${PREFIX:-}/var/service/tailscaled/run" ]; then
    sv up tailscaled >/dev/null 2>&1 || true
  fi

  # If the service is unavailable, fall back to the package's own launcher.
  # This also handles a fresh install where termux-services has not yet
  # created/registered the service directory.
  if [ "$(ts_state)" = "NoState" ] && command -v tailscaled-start >/dev/null 2>&1; then
    say "Termux service is unavailable — starting tailscaled directly…"
    tailscaled-start >/dev/null 2>&1 || true
  fi

  # Wait for tailscaled to ANSWER AT ALL. Any state other than NoState proves
  # the daemon is alive; being authenticated is a separate question.
  # 30s: first boot generates keys on slow phone CPUs — 10s timed out there
  # and misreported a healthy-but-warming daemon as a daemon problem.
  local state="" attempt
  spinner_start "waiting for the tailscale daemon"
  for attempt in $(seq 1 30); do
    state="$(ts_state)"
    [ -n "$state" ] && [ "$state" != "NoState" ] && break
    sleep 1
  done
  if [ -z "$state" ] || [ "$state" = "NoState" ]; then
    spinner_stop 1 "tailscale daemon"
  else
    spinner_stop 0 "tailscale daemon ($state)"
  fi
  if [ -z "$state" ] || [ "$state" = "NoState" ]; then
    die "Tailscale daemon is not responding — nothing is listening. This is a DAEMON problem (not a login problem). Try: tailscaled-start"
  fi

  # 3. Authenticated? Now answerable, because the state is explicit.
  case "$state" in
    Running)
      say "Tailscale is connected."
      ;;
    NeedsLogin)
      say "Tailscale is installed but this phone is NOT logged in."
      say "Logging in — open the printed link in any browser on this device."
      say "Tip: with Termux:API installed, open it straight from here with:"
      say "  termux-open-url \"<the-login-url>\""
      say ""
      if tailscale up; then
        say "Logged in."
      else
        die "Tailscale login failed. Run it by hand to see the full output:  tailscale up"
      fi
      ;;
    Stopped|Starting)
      say "Tailscale state is '$state' — starting the node…"
      tailscale up >/dev/null 2>&1 || true
      ;;
    *)
      say "Tailscale state is '$state' — attempting Funnel anyway…"
      ;;
  esac

  # 4. expose the server
  local P; P="$(port)"
  say ""
  say "Enabling Funnel on port $P… (Ctrl+C to stop the public URL)"
  say ""

  # Tailscale's own error is the most useful thing on screen, so stream it
  # live — but also keep a copy so a FAILURE can be diagnosed rather than
  # dumping a bare message at the user with no way forward.
  local out; out="$(mktemp)"
  tailscale funnel "$P" 2>&1 | tee "$out"
  local rc=${PIPESTATUS[0]}

  if [ "$rc" -ne 0 ] && [ "$rc" -ne 130 ]; then
    say ""
    say "─────────────────────────────────────────────"
    say "Funnel did not start (tailscale exit $rc)."
    say "Most likely causes:"
    if grep -qi 'certificate\|https\|tls\|cert' "$out"; then
      say ""
      say "  ▸ HTTPS certificates are disabled for your tailnet."
      say "    Enable them: https://login.tailscale.com/admin/dns"
      say "    (DNS → HTTPS Certificates → Enable HTTPS)"
    fi
    if grep -qi 'policy\|acl\|denied\|not allowed\|not permitted\|permission\|unauthorized\|approval\|plan' "$out"; then
      say ""
      say "  ▸ Your tailnet policy does not allow Funnel on this node/port."
      say "    Check: https://login.tailscale.com/admin/acls"
    fi
    if grep -qi 'logged out\|not logged in\|needslogin' "$out"; then
      say ""
      say "  ▸ Not logged in. Run:  tailscale up"
    fi
    say ""
    say "  The full tailscale output is above. Still stuck? Try the"
    say "  no-account alternative (URL changes on every restart):"
    say "    pkg install -y cloudflared"
    say "    cloudflared tunnel --url http://localhost:$P"
  fi
  rm -f "$out"
}

cmd_public() {
  installed
  # Public exposure without authentication is refused outright — same rule
  # as `wearsic server funnel`. No key is ever invented or changed here.
  if [ -z "$(api_key)" ]; then
    die "Public exposure REQUIRES an API key — the server would otherwise be open to the internet. Set one first (you choose the value):  wearsic server api key <your-key>"
  fi
  say "Public URL options (watch works on any network, no VPN app on the watch):"
  say ""
  say "1) Tailscale Funnel — STABLE url, recommended:"
  say "     wearsic server funnel"
  say "   → https://<phone-name>.<tailnet>.ts.net (same address every time)"
  say ""
  say "2) Cloudflare Tunnel — no account, but the URL changes every restart:"
  say "     pkg install -y cloudflared"
  say "     cloudflared tunnel --url http://localhost:$(port)"
  say "   → https://<random>.trycloudflare.com"
  say ""
  say "A public URL MUST have an API key: wearsic server api key <your-key>"
}

# ── crash-safe update ─────────────────────────────────────────────────────
# Downloads the latest release, VERIFIES its published SHA-256, stages and
# validates it, swaps it in with a kept rollback copy, restarts and health-
# checks. On ANY failure the previous engine is restored — a failed update
# can never leave a broken server. Your database, .env (API key), downloads/
# and wearsic-state/ are never touched.
#
# Overrides (mainly for testing/mirrors): WEARSIC_ZIP_URL, WEARSIC_SHA_URL,
# WEARSIC_REPO, WEARSIC_UPDATE_TIMEOUT (health wait seconds, default 60).
# Echoes the newest release ZIP url from the release LIST, INCLUDING
# pre-releases. $1 = repo slug. Empty output = nothing installable.
#
# releases?per_page=10 is newest-first and includes pre-releases (and drafts,
# but a draft has no published assets). Rather than correlating
# tag_name/draft/assets across JSON objects with grep — which is exactly the
# class of bug the old funnel command had — this probes each tag's
# PREDICTABLE asset url and takes the first that actually exists. A draft, or
# a release shipping no server package, simply 404s and is skipped.
resolve_pre_zip_url() {
  local repo="$1" json t code u
  json="$(curl -fsSL --retry 2 "https://api.github.com/repos/${repo}/releases?per_page=10" 2>/dev/null || true)"
  [ -n "$json" ] || return 0
  for t in $(printf '%s' "$json" \
    | grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' \
    | sed -E 's/.*"([^"]*)"$/\1/'); do
    [ -n "$t" ] || continue
    u="https://github.com/${repo}/releases/download/${t}/wearsic-server-termux-${t}.zip"
    code="$(curl -sI -L -o /dev/null -m 20 -w '%{http_code}' "$u" 2>/dev/null || printf '000')"
    [ "$code" = "200" ] && { printf '%s' "$u"; return 0; }
  done
  return 0
}

cmd_update() {
  installed
  local repo work zip sha expected actual stage src

  # `wearsic update [--pre]`. GitHub's releases/latest endpoint EXCLUDES
  # pre-releases, so a beta build (e.g. v1.6.1) is invisible to a plain
  # `wearsic update` — it silently keeps serving v1.6.0. --pre is the
  # explicit opt-in that walks the release LIST instead, so ordinary users
  # stay on stable and testers can pull a beta on demand.
  local include_pre=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --pre|-p) include_pre=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) die "Unknown option for 'wearsic update': $1 (valid: --pre)" ;;
    esac
  done
  [ "$include_pre" = "1" ] && say "Including pre-releases (--pre)."

  repo="${WEARSIC_REPO:-Aeroflash-r1/wearsic}"
  work="$(mktemp -d)" || die "could not create a temp dir"
  # EXIT (not RETURN) so the temp dir is cleaned even when die() exits.
  trap 'rm -rf "$work"' EXIT

  say "Checking for the latest Wearsic server release…"
  local zip_url sha_url json tag
  zip_url="${WEARSIC_ZIP_URL:-}"
  sha_url="${WEARSIC_SHA_URL:-}"
  if [ -z "$zip_url" ] && [ "$include_pre" = "1" ]; then
    zip_url="$(resolve_pre_zip_url "$repo")"
    [ -n "$zip_url" ] || die "no release with a server package was found for ${repo} — check your internet connection"
    # Print the bare tag (e.g. "v1.6.2"), not the asset filename.
    local chosen="${zip_url##*/}"
    chosen="${chosen#wearsic-server-termux-}"; chosen="${chosen%.zip}"
    say "Newest release (incl. pre-releases): $chosen"
  fi
  if [ -z "$zip_url" ]; then
    json="$(curl -fsSL --retry 2 "https://api.github.com/repos/${repo}/releases/latest" 2>/dev/null || true)"
    zip_url="$(printf '%s' "$json" \
      | grep -o '"browser_download_url"[^"]*"[^"]*wearsic-server-termux[^"]*\.zip"' \
      | head -1 \
      | sed -E 's/.*"(https[^"]*)".*/\1/')"
    if [ -z "$zip_url" ]; then
      tag="$(printf '%s' "$json" | grep -o '"tag_name"[^"]*"[^"]*"' | head -1 | sed -E 's/.*"([^"]*)"$/\1/')"
      [ -n "$tag" ] && zip_url="https://github.com/${repo}/releases/latest/download/wearsic-server-termux-${tag}.zip"
    fi
    [ -n "$zip_url" ] || die "could not find a release for ${repo} — check your internet connection"
  fi
  [ -n "$sha_url" ] || sha_url="${zip_url}.sha256"

  zip="$work/update.zip"
  sha="$work/update.zip.sha256"
  download_bar "$zip_url" "$zip" "downloading $(basename "$zip_url")" \
    || die "download failed — nothing was changed"
  [ -s "$zip" ] || die "downloaded file is empty — nothing was changed"

  # Authenticity: refuse to install any release without a published checksum.
  spinner_start "fetching checksum"
  if ! curl -fsSL --retry 2 -o "$sha" "$sha_url" 2>/dev/null || [ ! -s "$sha" ]; then
    spinner_stop 1 "checksum"
    die "no SHA-256 checksum at $sha_url — refusing to install unverified code"
  fi
  spinner_stop 0 "checksum"
  expected="$(awk '{print $1; exit}' "$sha" | tr 'A-F' 'a-f')"
  spinner_start "verifying SHA-256"
  if command -v sha256sum >/dev/null 2>&1; then
    actual="$(sha256sum "$zip" | awk '{print $1}')"
  else
    actual="$(shasum -a 256 "$zip" | awk '{print $1}')"
  fi
  if [ "$expected" != "$actual" ]; then
    spinner_stop 1 "SHA-256"
    die "SHA-256 MISMATCH — the download is corrupt or tampered. Nothing was changed."
  fi
  spinner_stop 0 "SHA-256 verified"

  # Stage + validate BEFORE touching the active engine.
  stage="$work/stage"
  mkdir -p "$stage"
  spinner_start "extracting update"
  if ! unzip -t "$zip" >/dev/null 2>&1; then
    spinner_stop 1 "extracting update"
    die "the downloaded file is not a valid ZIP — nothing was changed"
  fi
  if ! unzip -oq "$zip" -d "$stage"; then
    spinner_stop 1 "extracting update"
    die "could not extract the update — nothing was changed"
  fi
  spinner_stop 0 "extracted"
  src="$stage/wearsic-server"
  [ -d "$src" ] || src="$stage"
  [ -f "$src/bin/wearsic-server" ] && [ -n "$(ls -A "$src/lib" 2>/dev/null)" ] && [ -f "$src/run-termux.sh" ] \
    || die "the update package is incomplete (bin/lib/run-termux.sh) — nothing was changed"
  ok "update package validated"

  # Was it running? Update should end with the server back up if it was.
  local was_running=0
  if server_running || supervisor_running; then was_running=1; fi
  [ "$was_running" = "1" ] && { say "Stopping the server for the swap…"; cmd_stop; }

  # Crash-safe swap: prepare COMPLETE copies first, keep the old engine as
  # bin.prev/lib.prev until the new one passes its health check.
  say "Installing the update…"
  rm -rf "$DEST/bin.new" "$DEST/lib.new"
  cp -r "$src/bin" "$DEST/bin.new" && cp -r "$src/lib" "$DEST/lib.new" \
    || { rm -rf "$DEST/bin.new" "$DEST/lib.new"; die "could not stage the new engine (disk full?) — the current engine is untouched"; }
  rm -rf "$DEST/bin.prev" "$DEST/lib.prev"
  if [ -d "$DEST/bin" ]; then
    mv "$DEST/bin" "$DEST/bin.prev" && mv "$DEST/lib" "$DEST/lib.prev" \
      || { rm -rf "$DEST/bin.new" "$DEST/lib.new"; die "swap failed — the current engine is untouched"; }
  fi
  if ! mv "$DEST/bin.new" "$DEST/bin" || ! mv "$DEST/lib.new" "$DEST/lib" || [ ! -f "$DEST/bin/wearsic-server" ]; then
    # Half-swapped: restore the previous known-good engine immediately.
    rm -rf "$DEST/bin" "$DEST/lib"
    [ -d "$DEST/bin.prev" ] && mv "$DEST/bin.prev" "$DEST/bin"
    [ -d "$DEST/lib.prev" ] && mv "$DEST/lib.prev" "$DEST/lib"
    die "the swap did not complete — the previous engine was restored"
  fi
  for f in run-termux.sh .env.example README.md; do
    [ -f "$src/$f" ] && cp "$src/$f" "$DEST/$f"
  done
  chmod +x "$DEST/run-termux.sh" "$DEST/bin/wearsic-server" 2>/dev/null || true
  # Fingerprint of the engine we just installed: after the restart we check
  # the ON-DISK engine still matches it, so an (auto)rollback by the
  # supervisor can never masquerade as a successful update.
  local new_hash
  new_hash="$(file_hash "$DEST/bin/wearsic-server")"

  # Refresh the CLI copy(s) — the code only, never config.
  local bindir
  for bindir in "${PREFIX:-/nonexistent}/bin" "$HOME/.local/bin" "$HOME/bin"; do
    if [ -f "$bindir/wearsic" ] && [ -f "$src/wearsic" ]; then
      cp "$src/wearsic" "$bindir/wearsic" && chmod +x "$bindir/wearsic"
    fi
  done
  [ -f "$src/wearsic" ] && cp "$src/wearsic" "$DEST/wearsic" && chmod +x "$DEST/wearsic" 2>/dev/null
  ok "update installed (previous engine kept for rollback)"

  # Bring it up and PROVE it is healthy; otherwise roll back.
  local timeout i
  timeout="${WEARSIC_UPDATE_TIMEOUT:-60}"
  if [ "$was_running" = "1" ]; then
    say "Starting the updated server…"
    cmd_start >/dev/null 2>&1 || true
  else
    say "Server was stopped — starting it briefly to validate the update…"
    cmd_start >/dev/null 2>&1 || true
  fi
  i=0
  while [ "$i" -lt "$timeout" ]; do
    health_ok && break
    i=$((i + 1))
    sleep 1
  done

  if health_ok && [ "$(file_hash "$DEST/bin/wearsic-server")" = "$new_hash" ]; then
    rm -rf "$DEST/bin.prev" "$DEST/lib.prev"
    ok "update complete — server healthy on port $(port)"
    [ "$was_running" = "1" ] || { cmd_stop >/dev/null 2>&1; say "Server stopped again (it was not running before the update)."; }
    return 0
  fi

  # Healthy but NOT the engine we installed: the supervisor's own
  # never-healthy rollback already restored the previous engine.
  if health_ok; then
    warn "the new engine failed to start — the previous engine was restored automatically"
    warn "update rolled back — the server is running the previous version"
    return 1
  fi

  # New engine never became healthy — roll back to the previous one.
  # NOTE: the supervisor may have already rolled back by itself (its own
  # never-healthy rollback consumes bin.prev). Check BEFORE deleting
  # anything, so a restored good engine can never be destroyed here.
  warn "the updated server did not become healthy — rolling back…"
  cmd_stop >/dev/null 2>&1 || true
  if [ -d "$DEST/bin.prev" ]; then
    rm -rf "$DEST/bin" "$DEST/lib"
    mv "$DEST/bin.prev" "$DEST/bin"
    mv "$DEST/lib.prev" "$DEST/lib"
    chmod +x "$DEST/bin/wearsic-server" 2>/dev/null
    ok "previous engine restored"
    cmd_start >/dev/null 2>&1 || true
    i=0
    while [ "$i" -lt "$timeout" ]; do
      health_ok && break
      i=$((i + 1))
      sleep 1
    done
    if health_ok; then
      warn "update rolled back — the server is running the previous version"
    else
      warn "rollback restored the files but the server is not healthy — see: wearsic logs"
    fi
  elif [ -f "$DEST/bin/wearsic-server" ]; then
    ok "the previous engine is already in place (supervisor rolled back)"
    cmd_start >/dev/null 2>&1 || true
  else
    warn "no rollback copy existed — run the installer again:"
    warn "  curl -fsSL https://raw.githubusercontent.com/Aeroflash-r1/wearsic/main/install.sh | bash"
  fi
  return 1
}

# Installed vs running engine version (from /health when available).
cmd_version() {
  installed
  local health ver
  health="$(curl -sf -m 5 "http://127.0.0.1:$(port)/health" 2>/dev/null || true)"
  ver="$(printf '%s' "$health" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p')"
  say "engine: ${ver:-unknown (server not running)}"
}

# /ready in one line: can the server serve music RIGHT NOW?
cmd_ready() {
  installed
  curl -sf -m 5 "http://127.0.0.1:$(port)/ready" \
    || die "No /ready response — is the server running and not an old engine? (wearsic server start)"
  say ""
}

# Helper: one doctor row (name, symbol, detail).
doctor_line() { printf '  %-16s %s %s\n' "$1" "$2" "${3:-}"; }

# End-to-end environment diagnostics. Prints only the PRESENCE of the API
# key, never its value; never prints cookies or other secrets.
# Exit codes: 0 = READY, 1 = problems found.
cmd_doctor() {
  local fails=0 warns=0
  say "Wearsic Doctor"
  say "────────────────────────"

  if command -v java >/dev/null 2>&1; then
    doctor_line "Java" "✓" "$(java -version 2>&1 | head -1 | tr -d '"' | cut -c1-40)"
  else
    doctor_line "Java" "✗" "missing — pkg install -y openjdk-17"; fails=$((fails+1))
  fi

  if command -v ffmpeg >/dev/null 2>&1; then
    doctor_line "ffmpeg" "✓" ""
  else
    doctor_line "ffmpeg" "✗" "missing — rare Opus/WebM songs will 503 (pkg install ffmpeg)"; warns=$((warns+1))
  fi

  if [ -x "$DEST/bin/wearsic-server" ] && [ -f "$DEST/run-termux.sh" ]; then
    doctor_line "Server install" "✓" "$DEST"
  else
    doctor_line "Server install" "✗" "not installed"; fails=$((fails+1))
  fi

  if supervisor_running; then
    doctor_line "Supervisor" "✓" ""
  else
    doctor_line "Supervisor" "✗" "not running — wearsic server start"; fails=$((fails+1))
  fi
  if server_running; then
    doctor_line "Server process" "✓" ""
  else
    doctor_line "Server process" "✗" "not running"; fails=$((fails+1))
  fi
  doctor_line "Port $(port)" "✓" ""

  if [ -f "$DEST/wearsic.db" ]; then
    doctor_line "Database" "✓" "wearsic.db"
  else
    doctor_line "Database" "—" "not created yet (appears on first start)"; warns=$((warns+1))
  fi

  # API key: presence only — the value is never printed.
  if [ -n "$(api_key)" ]; then
    doctor_line "API key" "✓" "set"
  else
    doctor_line "API key" "✗" "NOT set — server is OPEN (fine on LAN, never public)"; warns=$((warns+1))
  fi

  local P health ready_body
  P="$(port)"
  health="$(curl -sf -m 5 "http://127.0.0.1:$P/health" 2>/dev/null || true)"
  if [ -n "$health" ]; then
    doctor_line "Health" "✓" "ok"
  else
    doctor_line "Health" "✗" "no response"; fails=$((fails+1))
  fi

  ready_body="$(curl -sf -m 5 "http://127.0.0.1:$P/ready" 2>/dev/null || true)"
  if printf '%s' "$ready_body" | grep -q '"ready"[[:space:]]*:[[:space:]]*true'; then
    doctor_line "Readiness" "✓" "ready"
  elif [ -n "$ready_body" ]; then
    doctor_line "Readiness" "✗" "not ready"; fails=$((fails+1))
    if printf '%s' "$ready_body" | grep -q '"database"[[:space:]]*:[[:space:]]*false'; then
      doctor_line "Database probe" "✗" "check free storage and database permissions"
    fi
    if printf '%s' "$ready_body" | grep -q '"extractor"[[:space:]]*:[[:space:]]*false'; then
      doctor_line "Music engine" "✗" "run wearsic update; inspect wearsic logs for upstream challenges"
    fi
  elif [ -n "$health" ]; then
    doctor_line "Readiness" "—" "no /ready (engine older than 1.4.0)"; warns=$((warns+1))
  else
    doctor_line "Readiness" "✗" "no response"; fails=$((fails+1))
  fi

  if [ -n "$health" ]; then
    local ver consec canary
    ver="$(printf '%s' "$health" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p')"
    consec="$(printf '%s' "$health" | sed -n 's/.*"consecutiveFailures":\([0-9]*\).*/\1/p')"
    canary="$(printf '%s' "$health" | sed -n 's/.*"canaryHealthy":\(true\|false\|null\).*/\1/p')"
    doctor_line "Engine version" "✓" "v${ver:-unknown}"
    if printf '%s' "$health" | grep -q '"transcoderAvailable"[[:space:]]*:[[:space:]]*false'; then
      doctor_line "Audio conversion" "—" "unavailable — pkg install -y ffmpeg"; warns=$((warns+1))
    fi
    if printf '%s' "$health" | grep -q '"status"[[:space:]]*:[[:space:]]*"staged"'; then
      doctor_line "Engine update" "—" "staged — applies on next restart"
    fi
    if [ -n "$consec" ] && [ "$consec" -ge 6 ] 2>/dev/null; then
      doctor_line "Extractor" "✗" "$consec consecutive failures — engine broken? self-heal should be staging an update"; fails=$((fails+1))
    else
      doctor_line "Extractor" "✓" "consecutive failures: ${consec:-0}"
    fi
    if [ "$canary" = "true" ]; then
      doctor_line "Canary" "✓" "healthy"
    elif [ -n "$canary" ]; then
      doctor_line "Canary" "—" "$canary"
    fi
    local crashes
    crashes="$(printf '%s' "$health" | sed -n 's/.*"crashCount"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p')"
    if [ -n "$crashes" ] && [ "$crashes" -gt 0 ] 2>/dev/null; then
      doctor_line "Crashes" "!" "$crashes recorded — see state/crashes + wearsic-server.log"; warns=$((warns+1))
    fi
  fi

  local ip; ip="$(lan_ip)"
  if [ -n "$ip" ]; then
    doctor_line "LAN network" "✓" "$ip"
  else
    doctor_line "LAN network" "✗" "no WiFi IP"; fails=$((fails+1))
  fi

  local avail; avail="$(df -k "$DEST" 2>/dev/null | awk 'NR==2 {print $4}')"
  if [ -n "$avail" ] && [ "$avail" -lt 102400 ] 2>/dev/null; then
    doctor_line "Storage" "✗" "only ${avail}KB free"; warns=$((warns+1))
  else
    doctor_line "Storage" "✓" "$(( ${avail:-0} / 1024 ))MB free"
  fi

  if [ -n "${PREFIX:-}" ] && [ -d "${PREFIX:-/nonexistent}/bin" ]; then
    doctor_line "Termux" "✓" ""
  else
    doctor_line "Termux" "—" "not Termux"; warns=$((warns+1))
  fi

  # Tailscale / Funnel: only ever reported ACTIVE when confirmed, and the
  # reason is always spelled out — "not active" alone gave no way to tell a
  # dead daemon from a logged-out phone.
  if command -v tailscale >/dev/null 2>&1; then
    local ts_st; ts_st="$(ts_state)"
    case "$ts_st" in
      Running)   doctor_line "Tailscale" "✓" "connected" ;;
      NeedsLogin) doctor_line "Tailscale" "!" "installed, not logged in — for a public URL run: tailscale up"; warns=$((warns+1)) ;;
      Stopped)   doctor_line "Tailscale" "!" "node stopped — for a public URL run: tailscale up"; warns=$((warns+1)) ;;
      Starting)  doctor_line "Tailscale" "—" "starting up"; warns=$((warns+1)) ;;
      *)         doctor_line "Tailscale" "!" "daemon not responding — run: tailscaled-start"; warns=$((warns+1)) ;;
    esac
    # Tailscale is OPTIONAL: the server plays fine over LAN without it, so
    # all of the above stay warnings and never flip doctor's exit code.
    # Making a logged-out phone a hard failure would report "NOT READY" for
    # a server that is in fact serving music perfectly over WiFi.
    if tailscale funnel status 2>/dev/null | grep -qi 'https://'; then
      doctor_line "Funnel" "✓" "active"
    elif [ "$ts_st" != "Running" ]; then
      # Funnel cannot work until the node is connected — say THAT instead of
      # reporting a separate, confusing Funnel failure.
      doctor_line "Funnel" "—" "blocked: Tailscale not connected"
    else
      doctor_line "Funnel" "—" "not active — start with: wearsic funnel"
    fi
  else
    doctor_line "Tailscale" "—" "not installed"
    doctor_line "Funnel" "—" "not installed"
  fi

  say "────────────────────────"
  if [ "$fails" -eq 0 ]; then
    box_top "✓ READY ($warns warning(s))"
    box_line ""
    box_line "   Next: wearsic url — connect your watch; wearsic logs — playback issues"
    box_bottom
    return 0
  fi
  box_top "✗ NOT READY ($fails problem(s), $warns warning(s))"
  box_line ""
  box_line "   Next: resolve the ✗ items above, then run wearsic doctor again"
  box_bottom
  return 1
}

