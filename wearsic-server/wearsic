cmd_cookies() {
  installed
  local cookie port_ key_ line
  cookie="${1:-}"
  if [ -z "$cookie" ]; then
    say "Paste the YouTube cookie (all lines), then an EMPTY line (or Ctrl+D):"
    say "  Accepts plain pairs (SID=…; HSID=…) or Netscape exports."
    say "  DevTools → Application → Cookies → youtube.com → copy the values."
    local TAB; TAB="$(printf '\t')"
    cookie=""
    # -s: never echo the credential to the terminal.
    while IFS= read -rs line || [ -n "$line" ]; do
      # Trim; a blank line ends input.
      line="$(printf '%s' "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      [ -z "$line" ] && break
      # Netscape export? Tab-separated, name/value are fields 6 and 7
      # (".youtube.com  TRUE  /  FALSE  123  SID  abc…"). Lines starting
      # with #HttpOnly are DATA (HttpOnly cookies like SID live there) —
      # only other #-lines are comments.
      case "$line" in
        "#HttpOnly"*) line="${line#"#HttpOnly"}" ;;
        \#*) continue ;;
      esac
      case "$line" in *"$TAB"*"$TAB"*"$TAB"*"$TAB"*"$TAB"*"$TAB"*)
        line="$(printf '%s' "$line" | awk -F'\t' '{print $6"="$7}')"
        case "$line" in "="|*=) continue ;; esac
        ;;
      esac
      # Plain pairs, one per line ("SID=…") or one ;-separated line.
      if [ -z "$cookie" ]; then cookie="$line"; else cookie="$cookie; $line"; fi
    done
    printf '\n'
    # Collapse ";;" from lines that already ended in ";" — empty pairs are
    # ignored by servers, but stay tidy.
    cookie="$(printf '%s' "$cookie" | sed 's/;[[:space:]]*;/;/g')"
  fi
  [ -n "$cookie" ] || die "Empty cookie."
  port_="$(port)"
  key_="$(api_key)"
  if health_ok; then
    # Live-update the running server (it persists the cookie itself).
    local body
    body="$(printf '{"cookie":"%s"}' "$cookie" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    if curl -sf -m 10 -X POST -H "X-Wearsic-Key: $key_" \
         -H "Content-Type: application/json" \
         -d "$body" "http://127.0.0.1:$port_/api/config/youtube-cookie" >/dev/null; then
      say "Cookie set on the running server (persisted)."
    else
      say "Could not set the cookie live — writing to .env instead."
      write_env_value WEARSIC_YOUTUBE_COOKIE "$cookie"
      say "Restart to apply: wearsic server restart"
    fi
  else
    write_env_value WEARSIC_YOUTUBE_COOKIE "$cookie"
    say "Cookie saved to $ENV_FILE"
    say "Start (or restart) the server to apply: wearsic server start"
  fi
  # Confirm what the server sees (never echoes the cookie itself).
  if health_ok; then
    local has
    has="$(curl -sf -m 5 -H "X-Wearsic-Key: $key_" "http://127.0.0.1:$port_/api/config/youtube-cookie" 2>/dev/null || true)"
    say "Server cookie status: $has"
  fi
}

# Tailscale's daemon state, read without needing jq.
#
#   NoState   — tailscaled is not answering (daemon problem)
#   NeedsLogin— daemon up, but this node is not authenticated
#   Stopped   — authenticated but the node is down
#   Starting  — coming up
#   Running   — connected
#
# WHY THIS EXISTS: the funnel flow used to probe `tailscale status` for BOTH
# "is the daemon up?" and "am I logged in?". But `tailscale status` FAILS in
# BOTH cases, so the two conditions were indistinguishable. A freshly
# installed but logged-OUT node was reported as "Tailscale daemon is not
# running", and the `tailscale up` branch below it was unreachable code that
# could never run. Reading the backend state separates them cleanly.
ts_state() {
  local s
  s="$(tailscale status --json 2>/dev/null \
        | sed -n 's/.*"BackendState"[[:space:]]*:[[:space:]]*"\([A-Za-z]*\)".*/\1/p' | head -1)"
  # Fall back to probing if this tailscale build has no --json flag.
  if [ -z "$s" ]; then
    if tailscale status >/dev/null 2>&1; then
      s="Running"
    elif tailscale status 2>&1 | grep -qi 'logged out\|not logged in'; then
      s="NeedsLogin"
    else
      s="NoState"
    fi
  fi
  printf '%s' "$s"
}

cmd_funnel() {
  installed
  # Funnel exposes the server to the whole internet — require a key.
  if [ -z "$(api_key)" ]; then
    die "Funnel exposes the server to the internet — set an API key first:  wearsic server api key <your-key>"
  fi
  # Never expose a dead or half-started server.
  if ! health_ok; then
    die "Server is not running/healthy — start it first: wearsic server start"
  fi
  say "Tailscale Funnel — a STABLE public HTTPS URL for the server."
  say "Runs the tailscaled daemon inside Termux (userspace networking:"
  say "no root, no /dev/net/tun). The official Android app cannot do this."
  say ""
  # 1. tailscaled present?
  if ! command -v tailscale >/dev/null 2>&1; then
    say "Installing the Termux tailscaled build (community project:"
    say "bropines/tailscale-termux-cli)…"
    say ""
    curl -fsSL https://raw.githubusercontent.com/bropines/tailscale-termux-cli/main/remote-install.sh | bash \
      || die "tailscaled install failed — see https://github.com/bropines/tailscale-termux-cli"
    # Fresh installs need a hash-table refresh before the new binaries resolve.
    hash -r 2>/dev/null || true
    command -v tailscale >/dev/null 2>&1 \
      || die "tailscaled installed but 'tailscale' is still not on PATH — restart Termux and retry"
  fi
  # 2. Ensure the Termux tailscaled daemon is actually running.
  #
  # The community package normally installs a termux-services service at
  # $PREFIX/var/service/tailscaled. Some Termux installs can report a
  # successful package install while that service directory is missing (for
  # example after a package-manager/service initialization race). Do not make
  # Funnel depend on runit in that case: tailscaled-start is the package's
  # supported direct-start helper and works without a service directory.
  local tailscale_started=0
  if command -v sv >/dev/null 2>&1 && [ -x "${PREFIX:-}/var/service/tailscaled/run" ]; then
    sv up tailscaled >/dev/null 2>&1 || true
  fi

  # If the service is unavailable, fall back to the package's own launcher.
  # This also handles a fresh install where termux-services has not yet
  # created/registered the service directory.
  if [ "$(ts_state)" = "NoState" ] && command -v tailscaled-start >/dev/null 2>&1; then
    say "Termux service is unavailable — starting tailscaled directly…"
    tailscaled-start >/dev/null 2>&1 || true
  fi

  # Wait for tailscaled to ANSWER AT ALL. Any state other than NoState proves
  # the daemon is alive; being authenticated is a separate question.
  # 30s: first boot generates keys on slow phone CPUs — 10s timed out there
  # and misreported a healthy-but-warming daemon as a daemon problem.
  local state="" attempt
  spinner_start "waiting for the tailscale daemon"
  for attempt in $(seq 1 30); do
    state="$(ts_state)"
    [ -n "$state" ] && [ "$state" != "NoState" ] && break
    sleep 1
  done
  if [ -z "$state" ] || [ "$state" = "NoState" ]; then
    spinner_stop 1 "tailscale daemon"
  else
    spinner_stop 0 "tailscale daemon ($state)"
  fi
  if [ -z "$state" ] || [ "$state" = "NoState" ]; then
    die "Tailscale daemon is not responding — nothing is listening. This is a DAEMON problem (not a login problem). Try: tailscaled-start"
  fi

  # 3. Authenticated? Now answerable, because the state is explicit.
  case "$state" in
    Running)
      say "Tailscale is connected."
      ;;
    NeedsLogin)
      say "Tailscale is installed but this phone is NOT logged in."
      say "Logging in — open the printed link in any browser on this device."
      say "Tip: with Termux:API installed, open it straight from here with:"
      say "  termux-open-url \"<the-login-url>\""
      say ""
      if tailscale up; then
        say "Logged in."
      else
        die "Tailscale login failed. Run it by hand to see the full output:  tailscale up"
      fi
      ;;
    Stopped|Starting)
      say "Tailscale state is '$state' — starting the node…"
      tailscale up >/dev/null 2>&1 || true
      ;;
    *)
      say "Tailscale state is '$state' — attempting Funnel anyway…"
      ;;
  esac

  # 4. expose the server
  local P; P="$(port)"
  say ""
  say "Enabling Funnel on port $P… (Ctrl+C to stop the public URL)"
  say ""

  # Tailscale's own error is the most useful thing on screen, so stream it
  # live — but also keep a copy so a FAILURE can be diagnosed rather than
  # dumping a bare message at the user with no way forward.
  local out; out="$(mktemp)"
  tailscale funnel "$P" 2>&1 | tee "$out"
  local rc=${PIPESTATUS[0]}

  if [ "$rc" -ne 0 ] && [ "$rc" -ne 130 ]; then
    say ""
    say "─────────────────────────────────────────────"
    say "Funnel did not start (tailscale exit $rc)."
    say "Most likely causes:"
    if grep -qi 'certificate\|https\|tls\|cert' "$out"; then
      say ""
      say "  ▸ HTTPS certificates are disabled for your tailnet."
      say "    Enable them: https://login.tailscale.com/admin/dns"
      say "    (DNS → HTTPS Certificates → Enable HTTPS)"
    fi
    if grep -qi 'policy\|acl\|denied\|not allowed\|not permitted\|permission\|unauthorized\|approval\|plan' "$out"; then
      say ""
      say "  ▸ Your tailnet policy does not allow Funnel on this node/port."
      say "    Check: https://login.tailscale.com/admin/acls"
    fi
    if grep -qi 'logged out\|not logged in\|needslogin' "$out"; then
      say ""
      say "  ▸ Not logged in. Run:  tailscale up"
    fi
    say ""
    say "  The full tailscale output is above. Still stuck? Try the"
    say "  no-account alternative (URL changes on every restart):"
    say "    pkg install -y cloudflared"
    say "    cloudflared tunnel --url http://localhost:$P"
  fi
  rm -f "$out"
}

