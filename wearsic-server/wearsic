cmd_health() {
  installed
  local P; P="$(port)"
  if [ "${1:-}" = "--json" ]; then
    curl -sf -m 5 "http://127.0.0.1:$P/health" \
      || die "No response — is the server running? (wearsic start)"
    printf '\n'
    return 0
  fi
  brand "health"
  http_get "http://127.0.0.1:$P/health"
  [ "$HTTP_CODE" = "200" ] || die "No response — is the server running? (wearsic start)"
  local body st ver st_state
  body="$HTTP_BODY"
  st="$(jstr "$body" status)"
  ver="$(jstr "$body" version)"
  if [ "$st" = "ok" ]; then
    st_state="$(dot ok) ${C_OK}ok${C_RESET}"
  else
    st_state="$(dot warn) ${C_WARN}${st:-unknown}${C_RESET}"
  fi
  printf '  %s   %shttp://127.0.0.1:%s · %sms%s\n' "$st_state" "$C_DIM" "$P" "${HTTP_MS:-?}" "$C_RESET"
  kv "version" "v${ver:-unknown} · $(jstr "$body" serverName)"
  if [ "$(jbool "$body" transcoderAvailable)" = "true" ]; then
    kv "transcoder" "available"
  else
    kv "transcoder" "${C_WARN}unavailable — pkg install ffmpeg${C_RESET}"
  fi
  local ex ok_n fail_n rate cons last_err extra
  ex="$(jobj "$body" extraction)"
  ok_n="$(jnum "$ex" successCount)"; fail_n="$(jnum "$ex" failureCount)"
  rate="$(jnum "$ex" failureRatePercent)"; cons="$(jnum "$ex" consecutiveFailures)"
  last_err="$(jstr "$ex" lastError)"
  extra=""
  if [ -n "$cons" ] && [ "$cons" -gt 0 ] 2>/dev/null; then extra=" · $cons in a row"; fi
  kv "extraction" "${ok_n:-0} ok · ${fail_n:-0} failed (${rate:-0}%)$extra"
  [ -n "$last_err" ] && kv "last error" "$last_err"
  local upd; upd="$(jobj "$body" update)"
  kv "update" "$(jstr "$upd" status)"
  local stg; stg="$(jstr "$upd" stagedVersion)"
  [ -n "$stg" ] && kv "staged" "v$stg — applies on next restart"
  kv "crashes" "$(jnum "$body" crashCount)"
  kv "cdn refusals" "$(jnum "$body" upstreamRefusals)"
  printf '\n'
}

