  local G=$'\033[38;5;114m' D=$'\033[2m' R=$'\033[0m' B=$'\033[1m'
  printf '%s\n\n' "$(grad_line '♪ Wearsic server — music for your watch')"
  printf "${B}Server${R}\n"
  printf "  ${G}wearsic start${R}      start the server\n"
  printf "  ${G}wearsic stop${R}       stop the server\n"
  printf "  ${G}wearsic restart${R}    stop, then start\n"
  printf "  ${G}wearsic status${R}     running? healthy? (0 healthy, 3 stopped, 4 unhealthy)\n"
  printf "  ${G}wearsic logs${R}       live logs\n"
