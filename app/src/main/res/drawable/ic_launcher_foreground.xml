<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Wearsic mark: five vertical bars on ONE shared baseline (y=69),
         heights 10 / 20 / 30 / 20 / 10. The tops trace /\\ — two triangles
         joined along the tall centre bar, both standing on the same base.
         Round caps keep the silhouette friendly at launcher sizes. -->

    <!-- Far-left bar: shortest (10 units) -->
    <path
        android:pathData="M30,59 L30,69"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="30" android:startY="58"
                android:endX="30" android:endY="70"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFE0D2FF" />
                <item android:offset="1.0" android:color="#FF8A5CF6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left-middle bar: medium (20 units) -->
    <path
        android:pathData="M42,49 L42,69"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="42" android:startY="48"
                android:endX="42" android:endY="70"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFE8D9FF" />
                <item android:offset="1.0" android:color="#FF8A5CF6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Centre bar: tallest (30 units) — the peak both triangles share -->
    <path
        android:pathData="M54,39 L54,69"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="54" android:startY="38"
                android:endX="54" android:endY="70"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFF3EDFF" />
                <item android:offset="1.0" android:color="#FF8A5CF6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right-middle bar: mirror of the left-middle -->
    <path
        android:pathData="M66,49 L66,69"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="66" android:startY="48"
                android:endX="66" android:endY="70"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFE8D9FF" />
                <item android:offset="1.0" android:color="#FF8A5CF6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Far-right bar: mirror of the far-left dot -->
    <path
        android:pathData="M78,59 L78,69"
        android:strokeWidth="5"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="78" android:startY="58"
                android:endX="78" android:endY="70"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFE0D2FF" />
                <item android:offset="1.0" android:color="#FF8A5CF6" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
