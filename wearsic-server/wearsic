cmd_cookies() {
  installed
  local cookie port_ key_ line
  cookie="${1:-}"
  if [ -z "$cookie" ]; then
    say "Paste the YouTube cookie (all lines), then an EMPTY line (or Ctrl+D):"
    say "  Accepts plain pairs (SID=…; HSID=…) or Netscape exports."
    say "  DevTools → Application → Cookies → youtube.com → copy the values."
    local TAB; TAB="$(printf '\t')"
    cookie=""
    # -s: never echo the credential to the terminal.
    while IFS= read -rs line || [ -n "$line" ]; do
      # Trim; a blank line ends input.
      line="$(printf '%s' "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
      [ -z "$line" ] && break
      # Netscape export? Tab-separated, name/value are fields 6 and 7
      # (".youtube.com  TRUE  /  FALSE  123  SID  abc…"). Lines starting
      # with #HttpOnly are DATA (HttpOnly cookies like SID live there) —
      # only other #-lines are comments.
      case "$line" in
        "#HttpOnly"*) line="${line#"#HttpOnly"}" ;;
        \#*) continue ;;
      esac
      case "$line" in *"$TAB"*"$TAB"*"$TAB"*"$TAB"*"$TAB"*"$TAB"*)
        line="$(printf '%s' "$line" | awk -F'\t' '{print $6"="$7}')"
        case "$line" in "="|*=) continue ;; esac
        ;;
      esac
      # Plain pairs, one per line ("SID=…") or one ;-separated line.
      if [ -z "$cookie" ]; then cookie="$line"; else cookie="$cookie; $line"; fi
    done
    printf '\n'
    # Collapse ";;" from lines that already ended in ";" — empty pairs are
    # ignored by servers, but stay tidy.
    cookie="$(printf '%s' "$cookie" | sed 's/;[[:space:]]*;/;/g')"
  fi
  [ -n "$cookie" ] || die "Empty cookie."
  port_="$(port)"
  key_="$(api_key)"
  if health_ok; then
    # Live-update the running server (it persists the cookie itself).
    local body
    body="$(printf '{"cookie":"%s"}' "$cookie" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    if curl -sf -m 10 -X POST -H "X-Wearsic-Key: $key_" \
         -H "Content-Type: application/json" \
         -d "$body" "http://127.0.0.1:$port_/api/config/youtube-cookie" >/dev/null; then
      say "Cookie set on the running server (persisted)."
    else
      say "Could not set the cookie live — writing to .env instead."
      write_env_value WEARSIC_YOUTUBE_COOKIE "$cookie"
      say "Restart to apply: wearsic server restart"
    fi
  else
    write_env_value WEARSIC_YOUTUBE_COOKIE "$cookie"
    say "Cookie saved to $ENV_FILE"
    say "Start (or restart) the server to apply: wearsic server start"
  fi
  # Confirm what the server sees (never echoes the cookie itself).
  if health_ok; then
    local has
    has="$(curl -sf -m 5 -H "X-Wearsic-Key: $key_" "http://127.0.0.1:$port_/api/config/youtube-cookie" 2>/dev/null || true)"
    say "Server cookie status: $has"
  fi
}

# Tailscale's daemon state, read without needing jq.
#
#   NoState   — tailscaled is not answering (daemon problem)
#   NeedsLogin— daemon up, but this node is not authenticated
#   Stopped   — authenticated but the node is down
#   Starting  — coming up
#   Running   — connected
#
# WHY THIS EXISTS: the funnel flow used to probe `tailscale status` for BOTH
# "is the daemon up?" and "am I logged in?". But `tailscale status` FAILS in
# BOTH cases, so the two conditions were indistinguishable. A freshly
# installed but logged-OUT node was reported as "Tailscale daemon is not
# running", and the `tailscale up` branch below it was unreachable code that
# could never run. Reading the backend state separates them cleanly.
ts_state() {
  local s
  s="$(tailscale status --json 2>/dev/null \
        | sed -n 's/.*"BackendState"[[:space:]]*:[[:space:]]*"\([A-Za-z]*\)".*/\1/p' | head -1)"
  # Fall back to probing if this tailscale build has no --json flag.
  if [ -z "$s" ]; then
    if tailscale status >/dev/null 2>&1; then
      s="Running"
    elif tailscale status 2>&1 | grep -qi 'logged out\|not logged in'; then
      s="NeedsLogin"
    else
      s="NoState"
    fi
  fi
  printf '%s' "$s"
}

# Public funnel URL from the tailscale node name — https://<node>.<tailnet>.ts.net.
# Funnel serves the local port on 443 (no port suffix). The FIRST "DNSName"
# in `tailscale status --json` is the node's own name (Self precedes Peer),
# which the existing first-occurrence JSON reader gives us without jq.
# Prints nothing when tailscale is absent or the node has no name yet
# (fresh install, not logged in).
funnel_url() {
  command -v tailscale >/dev/null 2>&1 || return 0
  local js dns
  js="$(tailscale status --json 2>/dev/null)"
  dns="$(jstr "$js" DNSName)"
  dns="${dns%.}"
  [ -n "$dns" ] && printf 'https://%s' "$dns"
}

cmd_funnel() {
  installed
  # Funnel exposes the server to the whole internet — require a key.
  if [ -z "$(api_key)" ]; then
    die "Funnel exposes the server to the internet — set an API key first:  wearsic server api key <your-key>"
  fi
  # Never expose a dead or half-started server.
  if ! health_ok; then
    die "Server is not running/healthy — start it first: wearsic server start"
  fi
  say "Tailscale Funnel — a STABLE public HTTPS URL for the server."
  say "Runs the tailscaled daemon inside Termux (userspace networking:"
  say "no root, no /dev/net/tun). The official Android app cannot do this."
  say ""
  # 1. tailscaled present?
  if ! command -v tailscale >/dev/null 2>&1; then
    say "Installing the Termux tailscaled build (community project:"
    say "bropines/tailscale-termux-cli)…"
    say ""
    curl -fsSL https://raw.githubusercontent.com/bropines/tailscale-termux-cli/main/remote-install.sh | bash \
      || die "tailscaled install failed — see https://github.com/bropines/tailscale-termux-cli"
    # Fresh installs need a hash-table refresh before the new binaries resolve.
    hash -r 2>/dev/null || true
    command -v tailscale >/dev/null 2>&1 \
      || die "tailscaled installed but 'tailscale' is still not on PATH — restart Termux and retry"
  fi
  # 2. Ensure the Termux tailscaled daemon is actually running.
  #
  # The community package normally installs a termux-services service at
  # $PREFIX/var/service/tailscaled. Some Termux installs can report a
  # successful package install while that service directory is missing (for
  # example after a package-manager/service initialization race). Do not make
  # Funnel depend on runit in that case: tailscaled-start is the package's
  # supported direct-start helper and works without a service directory.
  local tailscale_started=0
  if command -v sv >/dev/null 2>&1 && [ -x "${PREFIX:-}/var/service/tailscaled/run" ]; then
    sv up tailscaled >/dev/null 2>&1 || true
  fi

  # If the service is unavailable, fall back to the package's own launcher.
  # This also handles a fresh install where termux-services has not yet
  # created/registered the service directory.
  if [ "$(ts_state)" = "NoState" ] && command -v tailscaled-start >/dev/null 2>&1; then
    say "Termux service is unavailable — starting tailscaled directly…"
    tailscaled-start >/dev/null 2>&1 || true
  fi

  # Wait for tailscaled to ANSWER AT ALL. Any state other than NoState proves
  # the daemon is alive; being authenticated is a separate question.
  # 30s: first boot generates keys on slow phone CPUs — 10s timed out there
  # and misreported a healthy-but-warming daemon as a daemon problem.
  local state="" attempt
  spinner_start "waiting for the tailscale daemon"
  for attempt in $(seq 1 30); do
    state="$(ts_state)"
    [ -n "$state" ] && [ "$state" != "NoState" ] && break
    sleep 1
  done
  if [ -z "$state" ] || [ "$state" = "NoState" ]; then
    spinner_stop 1 "tailscale daemon"
  else
    spinner_stop 0 "tailscale daemon ($state)"
  fi
  if [ -z "$state" ] || [ "$state" = "NoState" ]; then
    die "Tailscale daemon is not responding — nothing is listening. This is a DAEMON problem (not a login problem). Try: tailscaled-start"
  fi

  # 3. Authenticated? Now answerable, because the state is explicit.
  case "$state" in
    Running)
      say "Tailscale is connected."
      ;;
    NeedsLogin)
      say "Tailscale is installed but this phone is NOT logged in."
      say "Logging in — open the printed link in any browser on this device."
      say "Tip: with Termux:API installed, open it straight from here with:"
      say "  termux-open-url \"<the-login-url>\""
      say ""
      if tailscale up; then
        say "Logged in."
      else
        die "Tailscale login failed. Run it by hand to see the full output:  tailscale up"
      fi
      ;;
    Stopped|Starting)
      say "Tailscale state is '$state' — starting the node…"
      tailscale up >/dev/null 2>&1 || true
      ;;
    *)
      say "Tailscale state is '$state' — attempting Funnel anyway…"
      ;;
  esac

  # 4. expose the server
  local P; P="$(port)"
  say ""
  say "Enabling Funnel on port $P… (Ctrl+C to stop the public URL)"
  say ""

  # Tailscale's own error is the most useful thing on screen, so stream it
  # live — but also keep a copy so a FAILURE can be diagnosed rather than
  # dumping a bare message at the user with no way forward.
  local out; out="$(mktemp)"
  tailscale funnel "$P" 2>&1 | tee "$out"
  local rc=${PIPESTATUS[0]}

  if [ "$rc" -ne 0 ] && [ "$rc" -ne 130 ]; then
    say ""
    hr
    say "Funnel did not start (tailscale exit $rc)."
    say "Most likely causes:"
    if grep -qi 'certificate\|https\|tls\|cert' "$out"; then
      say ""
      say "  ▸ HTTPS certificates are disabled for your tailnet."
      say "    Enable them: https://login.tailscale.com/admin/dns"
      say "    (DNS → HTTPS Certificates → Enable HTTPS)"
    fi
    if grep -qi 'policy\|acl\|denied\|not allowed\|not permitted\|permission\|unauthorized\|approval\|plan' "$out"; then
      say ""
      say "  ▸ Your tailnet policy does not allow Funnel on this node/port."
      say "    Check: https://login.tailscale.com/admin/acls"
    fi
    if grep -qi 'logged out\|not logged in\|needslogin' "$out"; then
      say ""
      say "  ▸ Not logged in. Run:  tailscale up"
    fi
    say ""
    say "  The full tailscale output is above. Still stuck? Try the"
    say "  no-account alternative (URL changes on every restart):"
    say "    pkg install -y cloudflared"
    say "    cloudflared tunnel --url http://localhost:$P"
  fi
  rm -f "$out"
}

# ── Cloudflare: a PERMANENT public URL, free, without a domain ─────────────
#
# THE PROBLEM THIS SOLVES
# -----------------------
# `wearsic funnel` (Tailscale Funnel) gives a stable URL, but the watch is
# not on your tailnet, so every request is relayed through Tailscale's DERP
# infrastructure — measurably slower than Cloudflare's own edge, and it
# depends on a VPN app being reachable.
#
# A Cloudflare Quick Tunnel (cloudflared) is the opposite trade: it is the
# fastest option available (the watch talks to Cloudflare's edge, period) and
# it needs no account, no domain and no money. Its one flaw is that the
# hostname is RANDOM and changes every time the tunnel restarts, so the
# watch cannot remember it.
#
# THE FIX
# -------
# Put a Cloudflare Worker in front of the tunnel:
#
#     watch  ──▶  https://wearsic.<sub>.workers.dev   (PERMANENT)
#                       │  Worker proxies to
#                       ▼
#             https://<random>.trycloudflare.com  (changes on restart)
#                       │
#                       ▼
#                cloudflared ──▶ the engine on this phone
#
# The Worker is re-uploaded with the new tunnel hostname whenever the tunnel
# changes, so the permanent address never breaks. The watch only ever knows
# the permanent address.
#
# The Worker source lives next to this script (wearsic-cloudflare-worker.js)
# so it can be reviewed, and it is uploaded verbatim — nothing is generated
# at runtime that you cannot read first. There is NO "Hello World" fallback:
# if the real Worker source is missing, setup stops.
#
# AUTHORIZATION
# -------------
# Cloudflare credentials are resolved in this order:
#   1. CLOUDFLARE_API_TOKEN in the environment or .env (static override)
#   2. this CLI's own OAuth session (`wearsic cloudflare login`): the access
#      token is short-lived by design, but the refresh token stored in
#      .wearsic-state/cloudflare-auth.json (mode 0600) renews it
#      automatically, so the session does not go stale
#   3. the official `wrangler login` OAuth session (if wrangler is installed)
#   4. a manually pasted scoped API token (login --token-stdin), saved to
#      .env with mode 0600
# No credential is ever printed, embedded in a URL, or committed.
#
# Optional credentials:
#   CLOUDFLARE_ACCOUNT_ID     (auto-detected when the token can list accounts)
#   CLOUDFLARE_ACCOUNT_NAME   (pick by name when the token sees several)
#   CLOUDFLARE_SUBDOMAIN      (workers.dev subdomain; created on first use)
#   CLOUDFLARE_WORKER         (worker name, default "wearsic")
#   CLOUDFLARED_PATH          (use a specific cloudflared binary)
#
# Like every other public-exposure path here, an API key is REQUIRED: the
# permanent URL is world-readable, and without a key the engine would be
# open to anyone who guesses the address.

CF_WORKER_SRC_NAME="wearsic-cloudflare-worker.js"
CF_COMPAT_DATE="2025-08-06"
CF_API_BASE="https://api.cloudflare.com/client/v4"
CF_QT_API="https://api.trycloudflare.com/tunnel"
CF_RETRY_BASE="${WEARSIC_CF_RETRY_BASE:-2}"
CF_RETRY_CAP="${WEARSIC_CF_RETRY_CAP:-60}"
CF_RETRY_MAX="${WEARSIC_CF_RETRY_MAX:-6}"
CF_PROBE_PATH="/api/frontdoor/probe"
CF_PROBE_SIZE=65536

# Wrangler-compatible OAuth, implemented natively (no node/npm needed on the
# device). Endpoints, client id and flow semantics mirror Cloudflare's own
# first-party wrangler OAuth app (cloudflare/workers-sdk,
# packages/workers-auth): the default login uses the RFC 8628 device flow and
# `login --browser` uses PKCE S256 against the same authorization server.
CF_OAUTH_AUTH_DOMAIN="dash.cloudflare.com"
CF_OAUTH_DEVICE_URL="https://$CF_OAUTH_AUTH_DOMAIN/oauth2/device/auth"
CF_OAUTH_TOKEN_URL="https://$CF_OAUTH_AUTH_DOMAIN/oauth2/token"
CF_OAUTH_REVOKE_URL="https://$CF_OAUTH_AUTH_DOMAIN/oauth2/revoke"
CF_OAUTH_AUTHZ_URL="https://$CF_OAUTH_AUTH_DOMAIN/oauth2/auth"
CF_OAUTH_CLIENT_ID="54d11594-84e4-41aa-b438-e81b8fa78ee7"
# Exactly the permissions this CLI needs; `offline_access` is what makes the
# session refreshable instead of stale (RFC 6749 §6 refresh tokens).
CF_OAUTH_SCOPES="account:read user:read workers_scripts:write offline_access"
CF_OAUTH_CALLBACK="http://localhost:8976/oauth/callback"
CF_OAUTH_POLL_FLOOR=1     # seconds; wrangler's minimum polling interval
CF_OAUTH_MAX_WAIT=300     # hard cap on the approval window (wrangler parity)
CF_UA="wearsic-cli (OAuth device flow; +https://github.com/Aeroflash-r1/wearsic)"

cf_state_dir()   { printf '%s/wearsic-state' "$DEST"; }
cf_state_file()  { printf '%s/cloudflare.json' "$(cf_state_dir)"; }
cf_log_file()    { printf '%s/cloudflare.log' "$(cf_state_dir)"; }
cf_tunnel_log()  { printf '%s/cloudflare-tunnel.log' "$(cf_state_dir)"; }
cf_lock_dir()    { printf '%s/cloudflare.lock' "$(cf_state_dir)"; }

cf_log() {
  local f; f="$(cf_log_file)"
  mkdir -p "$(dirname "$f")" 2>/dev/null
  # Self-cap: the supervisor log used to grow without bound for the whole
  # lifetime of a running supervisor (~140 KB/day in a failure loop). One
  # generation at 512 KB is plenty for post-mortem.
  if [ -f "$f" ] && [ "$(wc -c < "$f" 2>/dev/null || echo 0)" -gt 524288 ]; then
    mv -f "$f" "$f.old" 2>/dev/null || true
  fi
  printf '[wearsic %s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$f"
}

# Compact JSON string escaping: state and logs must always parse.
cf_json_escape() {
  printf '%s' "${1:-}" | tr '\n\r\t' '   ' | sed 's/\\/\\\\/g; s/"/\\"/g'
}

cf_state_get() {  # $1 = field (string values)
  local f; f="$(cf_state_file)"
  [ -f "$f" ] || return 1
  jstr "$(cat "$f")" "$1" | head -1
}

cf_state_get_num() {  # $1 = field (numeric values)
  local f; f="$(cf_state_file)"
  [ -f "$f" ] || return 1
  jnum "$(cat "$f")" "$1" | head -1
}

# Write the state atomically. `origin` is the hostname the tunnel handed out;
# `deployed_origin` is the LAST origin Cloudflare actually accepted. Keeping
# them separate is what lets `status` tell "the tunnel moved, the Worker has
# not caught up yet" apart from "the Worker is live".
cf_state_write() {  # status subdomain url origin deployed_origin last_error [account]
  local st="$1" sub="$2" url="$3" origin="$4" deployed="$5" err="$6" acc="${7:-}"
  local f tmp now prev_origin prev_at
  f="$(cf_state_file)"
  mkdir -p "$(dirname "$f")"
  now="$(date +%s)"
  prev_origin="$(cf_state_get deployed_origin 2>/dev/null || true)"
  prev_at="$(cf_state_get_num deployed_at 2>/dev/null || true)"
  case "$prev_at" in ''|*[!0-9]*) prev_at=0 ;; esac
  if [ -n "$deployed" ] && [ "$deployed" != "$prev_origin" ]; then
    prev_at="$now"
  fi
  tmp="$f.tmp.$$"
  printf '{"status":"%s","worker":"%s","subdomain":"%s","url":"%s","origin":"%s","deployed_origin":"%s","port":"%s","account":"%s","updated_at":%s,"deployed_at":%s,"last_error":"%s"}\n' \
    "$(cf_json_escape "$st")" \
    "$(cf_worker_name 2>/dev/null || printf '')" \
    "$(cf_json_escape "$sub")" \
    "$(cf_json_escape "$url")" \
    "$(cf_json_escape "$origin")" \
    "$(cf_json_escape "$deployed")" \
    "$(port)" \
    "$(cf_json_escape "$acc")" \
    "$now" "$prev_at" \
    "$(cf_json_escape "$err")" > "$tmp" || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$f"
  chmod 600 "$f" 2>/dev/null || true
}

cf_state_clear() { rm -f "$(cf_state_file)" 2>/dev/null || true; }

# The supervisor is done when it reached a final state: "live" (the tunnel
# answers and Cloudflare accepted the Worker) or "error" (it gave up and
# recorded why). Anything else is still in progress.
cf_state_settled() {
  case "$(cf_state_get status 2>/dev/null || true)" in
    live|error) return 0 ;;
  esac
  return 1
}

# Rewrite only the status/error of an existing state file (used by `stop`).
cf_state_set_status() {  # status [last_error]
  local st="$1" err="${2:-}" sub url origin deployed acc
  sub="$(cf_state_get subdomain || true)"
  url="$(cf_state_get url || true)"
  origin="$(cf_state_get origin || true)"
  deployed="$(cf_state_get deployed_origin || true)"
  acc="$(cf_state_get account || true)"
  [ -n "$url" ] || return 0
  cf_state_write "$st" "$sub" "$url" "$origin" "$deployed" "$err" "$acc"
}

# --- .env writing (secrets are never put in argv) ---------------------------
cf_env_set() {  # key value
  local key="$1" value="$2" f="$ENV_FILE" tmp vf
  case "$key" in *[!A-Z0-9_]*) err "Internal error: invalid .env key"; return 1 ;; esac
  case "$value" in *$'\n'*|*$'\r'*) err "Refusing a multi-line value for $key"; return 1 ;; esac
  mkdir -p "$(dirname "$f")"
  [ -f "$f" ] || : > "$f"
  chmod 600 "$f" 2>/dev/null || true
  vf="$(mktemp "${f}.value.XXXXXX")" || return 1
  printf '%s\n' "$value" > "$vf"
  chmod 600 "$vf" 2>/dev/null || true
  tmp="$(mktemp "${f}.tmp.XXXXXX")" || { rm -f "$vf"; return 1; }
  awk -v k="$key" -v vf="$vf" '
    BEGIN { getline v < vf; close(vf); done = 0 }
    $0 ~ "^" k "=" { print k "=" v; done = 1; next }
    { print }
    END { if (!done) print k "=" v }
  ' "$f" > "$tmp" || { rm -f "$tmp" "$vf"; return 1; }
  rm -f "$vf"
  mv -f "$tmp" "$f"
  chmod 600 "$f" 2>/dev/null || true
}

cf_env_unset() {  # key
  local key="$1" f="$ENV_FILE" tmp
  [ -f "$f" ] || return 0
  tmp="$(mktemp "${f}.tmp.XXXXXX")" || return 1
  awk -v k="$key" '$0 !~ "^" k "="' "$f" > "$tmp" || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$f"
  chmod 600 "$f" 2>/dev/null || true
}

# --- Credentials ------------------------------------------------------------
# A credential from the process environment, else from .env.
cf_credential() {  # $1 = key name
  local v
  v="$(printenv "$1" 2>/dev/null || true)"
  [ -n "$v" ] && { printf '%s' "$v"; return 0; }
  env_value "$1"
}

cf_token_from_env() { cf_credential CLOUDFLARE_API_TOKEN; }

# Configuration (which account, which workers.dev subdomain, which Worker)
# comes from the INSTALL's .env, not from a stale value exported in some old
# shell: an exported CLOUDFLARE_ACCOUNT_ID pointed the front door at a
# different Cloudflare account than the one the phone actually serves, so
# the tunnel was deployed where nobody was watching. The file wins; a
# disagreeing export is reported instead of silently winning. The API
# TOKEN deliberately keeps env-first precedence (a token passed on the
# command line must not be overridden by a stale file).
cf_config() {  # $1 = key -> value
  local v
  v="$(env_value "$1")"
  [ -n "$v" ] && { printf '%s' "$v"; return 0; }
  cf_credential "$1"
}

cf_config_conflict() {  # $1 = key -> prints a warning if env and .env disagree
  local key="$1" file_v env_v
  file_v="$(env_value "$key")"
  env_v="$(printenv "$key" 2>/dev/null || true)"
  if [ -n "$file_v" ] && [ -n "$env_v" ] && [ "$file_v" != "$env_v" ]; then
    printf 'the shell exports %s=%s but %s pins %s — using the installed configuration' \
      "$key" "$env_v" "$(basename "${ENV_FILE:-.env}")" "$file_v"
  fi
}

cf_account_env()   { cf_config CLOUDFLARE_ACCOUNT_ID; }

cf_wrangler_available() { command -v wrangler >/dev/null 2>&1; }

# Run a command with a wall-clock bound when `timeout` exists (Termux has it).
cf_run_timeout() {
  local t="$1"; shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$t" "$@"
  else
    "$@"
  fi
}

# wrangler owns the refresh of its own OAuth token; asking it every time is
# deliberate so a long-running supervisor never holds an expired token.
cf_token_from_wrangler() {
  cf_wrangler_available || return 1
  local out t
  out="$(cf_run_timeout 30 wrangler auth token --json 2>/dev/null)" || return 1
  t="$(printf '%s' "$out" | sed -n 's/.*"token"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
  if [ -z "$t" ]; then
    # Older wrangler versions print the raw token.
    t="$(printf '%s' "$out" | tr -d '\r\n')"
  fi
  case "$t" in
    ''|*' '*) return 1 ;;
    *'"'*) return 1 ;;
  esac
  printf '%s' "$t"
}

cf_token() {
  local t
  t="$(cf_token_from_env)"
  [ -n "$t" ] && { printf '%s' "$t"; return 0; }
  t="$(cf_oauth_token 2>/dev/null || true)"
  [ -n "$t" ] && { printf '%s' "$t"; return 0; }
  t="$(cf_token_from_wrangler 2>/dev/null || true)"
  [ -n "$t" ] && { printf '%s' "$t"; return 0; }
  return 1
}

cf_token_source() {
  if [ -n "$(cf_token_from_env)" ]; then
    printf 'API token (.env or environment)'
  elif [ -s "$(cf_auth_file 2>/dev/null)" ]; then
    printf 'OAuth session (wearsic login, auto-refreshing)'
  elif [ -n "$(cf_token_from_wrangler 2>/dev/null || true)" ]; then
    printf 'wrangler OAuth session'
  else
    printf 'none'
  fi
}

# --- Native OAuth session (device + browser flows) ---------------------------
# The session file holds the long-lived refresh token plus the current access
# token and its expiry. Access tokens are short-lived BY DESIGN; everything
# here re-mints them from the refresh token, which is what keeps a login from
# going stale the way a saved static token does.
cf_auth_file() { printf '%s/cloudflare-auth.json' "$(cf_state_dir)"; }

cf_auth_field() {  # $1 = field name (string values)
  local f
  f="$(cf_auth_file)"
  [ -s "$f" ] || return 1
  jstr "$(cat "$f")" "$1" | head -1
}

cf_auth_field_num() {  # $1 = field name (numeric values)
  local f
  f="$(cf_auth_file)"
  [ -s "$f" ] || return 1
  jnum "$(cat "$f")" "$1" | head -1
}

# Atomic write, mode 600. When $3 (refresh token) is empty the previous one
# is kept — RFC 6749 §6 lets a refresh response omit refresh_token.
cf_auth_write() {  # access_token expires_at refresh_token scope
  local f tmp rt
  f="$(cf_auth_file)"
  mkdir -p "$(dirname "$f")" 2>/dev/null
  rt="$3"
  [ -n "$rt" ] || rt="$(cf_auth_field refresh_token 2>/dev/null || true)"
  tmp="$f.tmp.$$"
  if ! printf '{"source":"wearsic-oauth","access_token":"%s","expires_at":%s,"refresh_token":"%s","scope":"%s","updated_at":%s}\n' \
      "$(cf_json_escape "$1")" \
      "$(printf '%s' "$2" | tr -dc '0-9')" \
      "$(cf_json_escape "$rt")" \
      "$(cf_json_escape "${4:-$CF_OAUTH_SCOPES}")" \
      "$(date +%s)" > "$tmp"; then
    rm -f "$tmp" 2>/dev/null
    return 1
  fi
  mv -f "$tmp" "$f"
  chmod 600 "$f" 2>/dev/null || true
}

cf_auth_clear() { rm -f "$(cf_auth_file)" 2>/dev/null; }

# --- A tiny crash-safe lock --------------------------------------------------
# mkdir(2) is atomic on every filesystem this CLI runs on, so a lock
# directory is the portable choice (flock is missing on macOS and on some
# busybox installs). The current owner records its PID; if the owner dies
# the stale lock is taken over immediately, so a killed supervisor cannot
# wedge the session file forever.
#
# Why a lock here is not ceremony: every refresh ROTATES Cloudflare's
# refresh token. Two processes refreshing in parallel means the loser gets
# "invalid_grant" for a token that was already consumed — and the loser's
# cleanup then deletes the session the winner just wrote. A phone can
# easily have two supervisors alive (the engine's watchdog and a manual
# run), and users hit exactly that: login at night, session gone by morning.
cf_lock_try() {  # $1 = name (creates "<name>.lock")
  local d="$1.lock" pid
  if mkdir "$d" 2>/dev/null; then
    printf '%s\n' "$$" > "$d/owner" 2>/dev/null
    return 0
  fi
  # Distinguish a live owner from a crashed one.
  pid="$(sed -n '1p' "$d/owner" 2>/dev/null | tr -dc '0-9')"
  if [ -n "$pid" ] && [ "$pid" != "$$" ] && kill -0 "$pid" 2>/dev/null; then
    return 1
  fi
  # Dead or unreadable owner: take over. Two takers race on the rmdir+mkdir
  # pair and only one mkdir wins.
  rmdir "$d" 2>/dev/null || rm -rf "$d"
  mkdir "$d" 2>/dev/null || return 1
  printf '%s\n' "$$" > "$d/owner" 2>/dev/null
  return 0
}

cf_lock_wait() {  # $1 = name [tries] — acquires the lock or gives up
  local tries="${2:-10}" i
  for i in $(seq 1 "$tries"); do
    cf_lock_try "$1" && return 0
    sleep 1
  done
  return 1
}

cf_unlock() {  # $1 = name
  local d="$1.lock" p
  p="$(sed -n '1p' "$d/owner" 2>/dev/null | tr -dc '0-9')"
  [ "$p" = "$$" ] && { rm -rf "$d"; return 0; }
  return 1
}

# Verification URLs come from Cloudflare's JSON and are shown to the user and
# handed to the OS opener, so they are validated strictly. The authority
# segment (everything after https:// up to the first /) must be exactly the
# Cloudflare auth domain, with no userinfo — the browser-trick URL
# "https://dash.cloudflare.com@evil.com/" fails here because of the '@'.
cf_assert_trusted_url() {  # $1 = URL
  local u="$1" authority
  case "$u" in
    https://*/*) authority="${u#https://}"; authority="${authority%%/*}" ;;
    https://*)   authority="${u#https://}" ;;
    *) return 1 ;;
  esac
  case "$authority" in
    *@*) return 1 ;;
  esac
  [ "$authority" = "$CF_OAUTH_AUTH_DOMAIN" ]
}

cf_oauth_refresh() {
  local out status body at ei exp_at rt lock
  lock="$(cf_auth_file)"
  # Serialize: refreshes rotate the refresh token, and the loser of a race
  # would get invalid_grant for a token that was already consumed.
  if ! cf_lock_wait "$lock" 10; then
    return 1
  fi
  # Another process may have refreshed while we waited: if the access token
  # is now valid, hand it out instead of burning another rotation.
  at="$(cf_auth_field access_token 2>/dev/null || true)"
  exp_at="$(cf_auth_field_num expires_at 2>/dev/null || true)"
  if [ -n "$at" ] && [ -n "$exp_at" ] && [ "$exp_at" -gt $(( $(date +%s) + 60 )) ]; then
    cf_unlock "$lock"
    return 0
  fi
  rt="$(cf_auth_field refresh_token)" || { cf_unlock "$lock"; return 1; }
  if [ -z "$rt" ]; then
    cf_unlock "$lock"
    return 1
  fi
  out="$(curl -sS --max-time 30 -A "$CF_UA" -X POST "$CF_OAUTH_TOKEN_URL" \
      --data-urlencode 'grant_type=refresh_token' \
      --data-urlencode "refresh_token=$rt" \
      --data-urlencode "client_id=$CF_OAUTH_CLIENT_ID" \
      -w $'\n%{http_code}' 2>/dev/null)" || { cf_unlock "$lock"; return 1; }
  status="${out##*$'\n'}"
  body="${out%$'\n'*}"
  cf_unlock "$lock"
  case "$status" in
    2??) ;;
    4??)
      # Permanent (an expired or revoked refresh token): drop the session so
      # the next login starts clean instead of quietly hiding the failure.
      cf_auth_clear
      return 1
      ;;
    *) return 1 ;;   # transient (network/5xx): keep the session, try again later
  esac
  at="$(jstr "$body" access_token | head -1)"
  [ -n "$at" ] || return 1
  ei="$(jnum "$body" expires_in | head -1)"
  case "$ei" in ''|*[!0-9]*|0) ei=900 ;; esac
  cf_auth_write "$at" "$(( $(date +%s) + ei - 60 ))" "$(jstr "$body" refresh_token | head -1)" "$(jstr "$body" scope | head -1)"
}

cf_oauth_token() {
  local tok exp now
  [ -s "$(cf_auth_file 2>/dev/null)" ] || return 1
  tok="$(cf_auth_field access_token)" || return 1
  [ -n "$tok" ] || return 1
  exp="$(cf_auth_field_num expires_at 2>/dev/null || true)"
  case "$exp" in ''|*[!0-9]*) exp="" ;; esac
  now="$(date +%s)"
  if [ -n "$exp" ] && [ "$exp" -gt $(( now + 60 )) ]; then
    printf '%s' "$tok"
    return 0
  fi
  # Expired (or expiry unknown): refresh once and hand out the fresh token.
  cf_oauth_refresh || return 1
  tok="$(cf_auth_field access_token)" || return 1
  [ -n "$tok" ] && { printf '%s' "$tok"; return 0; }
  return 1
}

# Shared tail for both OAuth flows: persist the session, drop any stale
# static token that would keep shadowing it in cf_token(), and verify the
# permissions that matter.
cf_oauth_finish() {  # $1 = token endpoint JSON response
  local at ei nrt scope exp_at
  at="$(jstr "$1" access_token | head -1)"
  [ -n "$at" ] || { err "Cloudflare's token response was unusable."; return 1; }
  ei="$(jnum "$1" expires_in | head -1)"
  case "$ei" in ''|*[!0-9]*|0) ei=900 ;; esac
  exp_at=$(( $(date +%s) + ei - 60 ))
  nrt="$(jstr "$1" refresh_token | head -1)"
  scope="$(jstr "$1" scope | head -1)"
  cf_auth_write "$at" "$exp_at" "$nrt" "$scope" || { err "Could not save the session file."; return 1; }
  if [ -n "$(cf_token_from_env)" ]; then
    cf_env_unset CLOUDFLARE_API_TOKEN
    unset CLOUDFLARE_API_TOKEN 2>/dev/null || true
    say "Removed the older static API token from $ENV_FILE — the refreshable session is used now."
  fi
  if cf_auth_check; then
    ok "Cloudflare authorization complete (the token renews itself; it cannot go stale)."
    cf_login_summary
    return 0
  fi
  warn "Authorized, but the permission check above failed — the session is saved anyway."
  return 1
}

# Default login: RFC 8628 device flow — the same UX wrangler gives with
# --device. The user opens a link, approves once, and the CLI polls until the
# grant succeeds. Only the user's browser touches the dashboard; this CLI
# talks to /oauth2/token which is reachable from every network tested.
cf_login_device_flow() {
  local out status body tries=0
  local device_code user_code verif_uri verif_complete expires interval
  say "Starting browser authorization (no token copy-paste needed)…"
  while :; do
    out="$(curl -sS --max-time 30 -A "$CF_UA" -X POST "$CF_OAUTH_DEVICE_URL" \
        --data-urlencode "client_id=$CF_OAUTH_CLIENT_ID" \
        --data-urlencode "scope=$CF_OAUTH_SCOPES" \
        -w $'\n%{http_code}' 2>/dev/null)" || {
      err "Could not reach dash.cloudflare.com (DNS or network). Check the connection and try again."
      return 1
    }
    status="${out##*$'\n'}"
    body="${out%$'\n'*}"
    case "$status" in
      2??) break ;;
    esac
    # Cloudflare's edge sometimes answers the device-code request with a
    # bot-challenge page instead of JSON (low-reputation networks, e.g. some
    # mobile ISPs). One retry, then a clear explanation with a working path.
    if printf '%s' "$body" | head -c 2000 | grep -q '<!DOCTYPE html'; then
      tries=$(( tries + 1 ))
      if [ "$tries" -lt 2 ]; then sleep 3; continue; fi
      err "Cloudflare's bot protection blocked this login from your network."
      say "  Two ways around it:"
      say "   1. wearsic cloudflare login --browser   (browser-based; works everywhere)"
      say "   2. run the same command while on another network (e.g. Wi-Fi)"
      return 2
    fi
    err "Cloudflare rejected the device-code request: $(cf_api_message "$body" | head -1)"
    say "  Try: wearsic cloudflare login --browser"
    return 1
  done
  device_code="$(jstr "$body" device_code | head -1)"
  user_code="$(jstr "$body" user_code | head -1)"
  verif_uri="$(jstr "$body" verification_uri | head -1)"
  verif_complete="$(jstr "$body" verification_uri_complete | head -1)"
  expires="$(jnum "$body" expires_in | head -1)"
  interval="$(jnum "$body" interval | head -1)"
  { [ -n "$device_code" ] && [ -n "$user_code" ] && [ -n "$verif_uri" ]; } || {
    err "Cloudflare's device-code response was unusable."
    return 1
  }
  cf_assert_trusted_url "$verif_uri" || { err "Untrusted verification URL from Cloudflare — refusing."; return 1; }
  if [ -n "$verif_complete" ]; then
    cf_assert_trusted_url "$verif_complete" || verif_complete=""
  fi
  say ""
  say "Open this link in any browser and approve the request:"
  say ""
  say "  $verif_uri"
  say ""
  say "Then enter the code when asked:  $user_code"
  say ""
  if cf_open_url "${verif_complete:-$verif_uri?user_code=$user_code}"; then
    dim "  (opened in your browser — the code is pre-filled)"
  else
    dim "  (open the link above on any device, then enter the code)"
  fi
  case "$expires" in ''|*[!0-9]*|0) expires="$CF_OAUTH_MAX_WAIT" ;; esac
  dim "  (the code is valid for $(( expires / 60 )) minutes)"
  say ""
  # Poll semantics mirror wrangler: first poll immediately, honor the
  # server's interval with a 1s floor, slow_down adds +5s, and the same hard
  # cap on the overall wait keeps login finite (RFC 8628 §3.5 anti-phishing).
  case "$interval" in ''|*[!0-9]*|0) interval="$CF_OAUTH_POLL_FLOOR" ;; esac
  [ "$interval" -ge "$CF_OAUTH_POLL_FLOOR" ] || interval="$CF_OAUTH_POLL_FLOOR"
  local max_wait="$CF_OAUTH_MAX_WAIT" started elapsed poll_err
  [ "$expires" -lt "$max_wait" ] && max_wait="$expires"
  started="$(date +%s)"
  say "Waiting for the approval in your browser…"
  while :; do
    elapsed=$(( $(date +%s) - started ))
    if [ "$elapsed" -ge "$max_wait" ]; then
      err "Timed out waiting for approval — run 'wearsic cloudflare login' again."
      return 1
    fi
    out="$(curl -sS --max-time 30 -A "$CF_UA" -X POST "$CF_OAUTH_TOKEN_URL" \
        --data-urlencode 'grant_type=urn:ietf:params:oauth:grant-type:device_code' \
        --data-urlencode "device_code=$device_code" \
        --data-urlencode "client_id=$CF_OAUTH_CLIENT_ID" \
        -w $'\n%{http_code}' 2>/dev/null)" || { sleep "$interval"; continue; }
    status="${out##*$'\n'}"
    body="${out%$'\n'*}"
    poll_err="$(jstr "$body" error | head -1)"
    if [ -n "$poll_err" ]; then
      case "$poll_err" in
        authorization_pending) sleep "$interval"; continue ;;
        slow_down) interval=$(( interval + 5 )); sleep "$interval"; continue ;;
        access_denied) err "Authorization was denied in the browser."; return 1 ;;
        expired_token) err "The code expired before approval — run 'wearsic cloudflare login' again."; return 1 ;;
        *) err "Authorization failed: $poll_err."; say "  Try: wearsic cloudflare login --browser"; return 1 ;;
      esac
    fi
    case "$status" in
      2??)
        cf_oauth_finish "$body"
        return $?
        ;;
    esac
    sleep "$interval"
  done
}

# Browser login (wrangler's default flow): PKCE S256 authorization code.
# Works on networks where the device-code request is bot-challenged, because
# only the user's browser touches the challenge-protected pages — this CLI
# only calls /oauth2/token. After approval the browser lands on a localhost
# address that cannot load (nothing listens on :8976 here); the user pastes
# that address back and the code inside it is exchanged. The code is
# single-use and PKCE-bound to this verifier, so pasting it around is safe.
cf_login_browser_flow() {
  local verifier challenge state pasted code pasted_state
  local out status body h esc scope_enc auth_url
  say "Browser authorization (Cloudflare OAuth, wrangler-compatible)…"
  verifier="$(head -c 32 /dev/urandom 2>/dev/null | od -An -tx1 | tr -d ' \n')"
  [ -n "$verifier" ] || { err "Cannot generate a PKCE nonce on this device."; return 1; }
  state="$(head -c 16 /dev/urandom 2>/dev/null | od -An -tx1 | tr -d ' \n')"
  if command -v openssl >/dev/null 2>&1; then
    challenge="$(printf '%s' "$verifier" | openssl dgst -sha256 -binary | openssl base64 -A | tr '+/' '-_' | tr -d '=')"
  else
    # No openssl: sha256sum is hex; turn it into binary via printf escapes.
    h="$(printf '%s' "$verifier" | sha256sum | awk '{print $1}')"
    esc="$(printf '%s' "$h" | sed 's/../\\x&/g')"
    challenge="$(printf '%b' "$esc" | base64 | tr -d '\n' | tr '+/' '-_' | tr -d '=')"
  fi
  { [ -n "$challenge" ] && [ -n "$state" ]; } || { err "Cannot start the PKCE flow on this device."; return 1; }
  scope_enc="$(printf '%s' "$CF_OAUTH_SCOPES" | sed 's/:/%3A/g; s/ /%20/g')"
  auth_url="$CF_OAUTH_AUTHZ_URL?client_id=$CF_OAUTH_CLIENT_ID&redirect_uri=$(printf '%s' "$CF_OAUTH_CALLBACK" | sed 's/:/%3A/g; s@/@%2F@g')&scope=$scope_enc&state=$state&code_challenge=$challenge&code_challenge_method=S256&response_type=code"
  say ""
  say "1. Open this link in any browser, log in, and click Allow:"
  say ""
  say "  $auth_url"
  say ""
  say "2. After Allow the browser tries to load localhost — that will fail."
  say "   Expected. Copy the FULL address from the browser's URL bar and paste it here."
  if cf_open_url "$auth_url"; then
    dim "  (opened in your browser)"
  else
    dim "  (open the link above on any device)"
  fi
  printf '\nPaste the redirected URL (empty cancels): '
  IFS= read -r pasted || return 1
  pasted="$(printf '%s' "$pasted" | tr -d '"')"
  [ -n "$pasted" ] || { say "Login cancelled."; return 1; }
  case "$pasted" in
    http://localhost:8976/*|http://127.0.0.1:8976/*) ;;
    https://$CF_OAUTH_AUTH_DOMAIN/*)
      err "That is the dashboard address, not the redirect back to this machine."
      return 1 ;;
    *)
      err "Expected a URL starting with http://localhost:8976/?code=…"
      return 1 ;;
  esac
  code="$(printf '%s' "$pasted" | sed -n 's/.*[?&]code=\([^&]*\).*/\1/p')"
  pasted_state="$(printf '%s' "$pasted" | sed -n 's/.*[?&]state=\([^&]*\).*/\1/p')"
  [ -n "$code" ] || { err 'No "code=" found in the pasted URL.'; return 1; }
  if [ -n "$pasted_state" ] && [ "$pasted_state" != "$state" ]; then
    err "The pasted URL's state does not match this login (possible tampering)."
    return 1
  fi
  say "Exchanging the code for a session…"
  out="$(curl -sS --max-time 30 -A "$CF_UA" -X POST "$CF_OAUTH_TOKEN_URL" \
      --data-urlencode 'grant_type=authorization_code' \
      --data-urlencode "code=$code" \
      --data-urlencode "redirect_uri=$CF_OAUTH_CALLBACK" \
      --data-urlencode "client_id=$CF_OAUTH_CLIENT_ID" \
      --data-urlencode "code_verifier=$verifier" \
      -w $'\n%{http_code}' 2>/dev/null)" || {
    err "Could not reach Cloudflare's token endpoint."
    return 1
  }
  status="${out##*$'\n'}"
  body="${out%$'\n'*}"
  if ! [ "$status" -ge 200 ] 2>/dev/null || ! [ "$status" -lt 300 ] 2>/dev/null; then
    err "Cloudflare rejected the code ($(cf_http_status_text)): $(jstr "$body" error_description | head -1)"
    say "  Codes are single-use and expire within minutes — run the command again for a fresh one."
    return 1
  fi
  cf_oauth_finish "$body"
}

cf_account() {
  local a
  a="$(cf_account_env)"
  [ -n "$a" ] || a="$(cf_state_get account 2>/dev/null || true)"
  printf '%s' "$a"
}

# --- Cloudflare API ---------------------------------------------------------
# Every call goes through here so error bodies are never discarded (the old
# `curl -f` threw away Cloudflare's message and left the user guessing).
# Sets: CF_HTTP_STATUS, CF_API_BODY.
cf_api() {  # $1 = method, $2 = /client/v4-relative path, $3 = optional JSON body
  local method="$1" path="$2" body="${3:-}"
  CF_HTTP_STATUS=0
  CF_API_BODY='{"success":false,"errors":[{"code":0,"message":"No Cloudflare authorization. Run: wearsic cloudflare login"}]}'
  local attempt tok status out args
  for attempt in 1 2; do
    tok="$(cf_token)"
    [ -n "$tok" ] || return 1
    args=(-sS --max-time 30 -X "$method"
          -H "Authorization: Bearer $tok"
          -H "Accept: application/json")
    [ -n "$body" ] && args+=(-H "Content-Type: application/json" --data-binary "$body")
    out="$(curl "${args[@]}" -w $'\n%{http_code}' "$CF_API_BASE$path" 2>&1)" || {
      CF_API_BODY="$out"
      CF_HTTP_STATUS=0
      return 1
    }
    status="${out##*$'\n'}"
    CF_API_BODY="${out%$'\n'*}"
    case "$status" in
      ''|*[!0-9]*) CF_HTTP_STATUS=0; return 1 ;;
    esac
    CF_HTTP_STATUS="$status"
    # An OAuth access token refreshed at the 60-second-early margin can be a
    # hair behind the server's clock: refresh once and retry rather than
    # surfacing a spurious 401. Also heals the case where an OAuth session
    # exists and the (rejected) static token was resolved first.
    if [ "$status" = 401 ] && [ "$attempt" -eq 1 ] && cf_oauth_refresh 2>/dev/null; then
      continue
    fi
    break
  done
  [ "$status" -ge 200 ] && [ "$status" -lt 300 ]
}

cf_api_ok() {
  [ "${CF_HTTP_STATUS:-0}" -ge 200 ] 2>/dev/null \
    && [ "${CF_HTTP_STATUS:-0}" -lt 300 ] 2>/dev/null \
    && printf '%s' "${CF_API_BODY:-}" \
       | grep -Eq '"success"[[:space:]]*:[[:space:]]*true'
}

cf_api_message() {
  printf '%s' "${1:-}" | sed -n 's/.*"message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1
}

cf_api_code() {
  printf '%s' "${1:-}" | sed -n 's/.*"code"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | head -1
}

# Explain a failed call in terms a user can act on. Never prints the token.
cf_api_explain() {  # $1 = what was being attempted
  local ctx="$1" msg code
  msg="$(cf_api_message "$CF_API_BODY")"
  code="$(cf_api_code "$CF_API_BODY")"
  err "$ctx${msg:+: $msg}${code:+ (Cloudflare error $code)}"
  case "${CF_HTTP_STATUS:-0}" in
    401)
      err "The Cloudflare credential is invalid or expired. Re-authorize: wearsic cloudflare login"
      ;;
    403)
      err "The credential is missing a permission. It needs Workers Scripts:Edit and Account Settings:Read."
      err "If you logged in with the browser, run 'wearsic cloudflare login' again to re-grant."
      ;;
    404)
      err "Cloudflare could not find that account or Worker. Check CLOUDFLARE_ACCOUNT_ID."
      ;;
    429)
      err "Cloudflare rate-limited the request; it will be retried with backoff."
      ;;
    0)
      # When no credential was available the status-0 default body already
      # told the user to re-authorize; only blame the network when a token
      # was resolved and the request still failed.
      if [ -n "$(cf_token 2>/dev/null)" ]; then
        err "Could not reach api.cloudflare.com (DNS or network). Check the connection and try again."
      fi
      ;;
  esac
  case "$code" in
    10000|10001|9109)
      err "Cloudflare rejected the credential itself (authentication error)."
      err "Re-authorize: wearsic cloudflare login"
      ;;
    10007)
      # 10007 is "this account has no workers.dev subdomain yet" — an account
      # state, never a permission problem. wearsic creates one on the next
      # deploy; visiting the Workers & Pages dashboard once also creates it.
      err "This account has no workers.dev subdomain yet; wearsic creates one on the next deploy."
      ;;
  esac
  return 1
}

cf_api_call() {  # method path [body] [context]
  local ctx="${4:-Cloudflare API request failed}"
  cf_api "$1" "$2" "${3:-}"
  cf_api_ok && return 0
  cf_api_explain "$ctx"
  return 1
}

# --- Accounts ---------------------------------------------------------------
cf_parse_accounts() {  # JSON on stdin -> "id|name" lines
  tr '{' '\n' | sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([0-9a-f]\{32\}\)".*"name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1|\2/p'
}

cf_api_accounts() {
  cf_api GET "/accounts?per_page=50" || return 1
  cf_api_ok || return 1
  printf '%s' "$CF_API_BODY" | cf_parse_accounts
}

cf_wrangler_accounts() {
  cf_wrangler_available || return 1
  local out
  out="$(cf_run_timeout 30 wrangler whoami --json 2>/dev/null)" || return 1
  printf '%s' "$out" | cf_parse_accounts
}

cf_ensure_account() {
  local acc list n want choice
  acc="$(cf_account_env)"
  if [ -n "$acc" ]; then
    case "$acc" in
      *[!0-9a-f]*)
        err "CLOUDFLARE_ACCOUNT_ID must be 32 hexadecimal characters"
        return 1
        ;;
    esac
    [ "${#acc}" -eq 32 ] || { err "CLOUDFLARE_ACCOUNT_ID must be 32 hexadecimal characters"; return 1; }
    printf '%s' "$acc"
    return 0
  fi

  list="$(cf_api_accounts 2>/dev/null || true)"
  [ -n "$list" ] || list="$(cf_wrangler_accounts 2>/dev/null || true)"
  if [ -z "$list" ]; then
    cf_api_explain "Could not list Cloudflare accounts"
    err "Set CLOUDFLARE_ACCOUNT_ID (32-char hex) or give the token Account Settings:Read."
    return 1
  fi
  n="$(printf '%s\n' "$list" | wc -l | tr -d ' ')"
  if [ "$n" -eq 1 ]; then
    acc="${list%%|*}"
  else
    want="$(cf_credential CLOUDFLARE_ACCOUNT_NAME)"
    if [ -n "$want" ]; then
      acc="$(printf '%s\n' "$list" | awk -F'|' -v n="$want" '$2 == n { print $1; exit }')"
    fi
    if [ -z "$acc" ] && [ -t 0 ] && [ -t 1 ]; then
      say "This token can see $n Cloudflare accounts:"
      printf '%s\n' "$list" | awk -F'|' '{ printf "  %d) %s (%s)\n", NR, $2, $1 }'
      printf 'Choose account [1-%s]: ' "$n"
      read -r choice
      case "$choice" in
        ''|*[!0-9]*) return 1 ;;
      esac
      if [ "$choice" -ge 1 ] && [ "$choice" -le "$n" ]; then
        acc="$(printf '%s\n' "$list" | sed -n "${choice}p" | cut -d'|' -f1)"
      fi
    fi
    if [ -z "$acc" ]; then
      err "Multiple Cloudflare accounts. Set CLOUDFLARE_ACCOUNT_ID to one of:"
      printf '%s\n' "$list" | sed 's/^/  /' >&2
      return 1
    fi
  fi
  cf_env_set CLOUDFLARE_ACCOUNT_ID "$acc"
  printf '%s' "$acc"
}

# --- workers.dev subdomain --------------------------------------------------
cf_subdomain() {  # $1 = account id
  cf_api GET "/accounts/$1/workers/subdomain" || return 1
  cf_api_ok || return 1
  jstr "$CF_API_BODY" subdomain | head -1
}

cf_rand4() {
  local s
  s="$(LC_ALL=C tr -dc 'a-z0-9' </dev/urandom 2>/dev/null | dd bs=1 count=4 2>/dev/null)"
  [ -n "$s" ] || s="$(printf '%04x' "$((RANDOM % 65536))" | cut -c1-4)"
  printf '%s' "$s"
}

# Read the account's subdomain; create it only when the account has none.
# Idempotent: a rerun never overwrites an existing subdomain.
#
# The saved value is a fallback, not the source of truth: if the API read
# fails (a transient network error, or a token that lost Account Settings
# read permission), keep using the URL that worked before instead of
# trying to create a new subdomain or failing setup. A GET that succeeds and
# returns no subdomain still takes the create path.
cf_ensure_subdomain() {  # $1 = account id
  local acc="$1" want sub cand candidates
  want="$(cf_config CLOUDFLARE_SUBDOMAIN)"
  if [ -n "$want" ]; then
    case "$want" in
      *[!a-z0-9-]*) err "CLOUDFLARE_SUBDOMAIN must be lowercase letters, digits or dashes"; return 1 ;;
    esac
    case "$want" in
      -*|*-) err "CLOUDFLARE_SUBDOMAIN must not start or end with a dash"; return 1 ;;
    esac
    [ "${#want}" -le 63 ] || { err "CLOUDFLARE_SUBDOMAIN must be 63 characters or fewer"; return 1; }
  fi

  cf_api GET "/accounts/$acc/workers/subdomain"
  sub="$(jstr "$CF_API_BODY" subdomain | head -1)"
  if [ -n "$sub" ]; then
    # Persist the authoritative value too, so a later run can keep the
    # URL stable even if the token loses the Account Settings permission.
    cf_env_set CLOUDFLARE_SUBDOMAIN "$sub"
    printf '%s' "$sub"
    return 0
  fi
  # No usable answer from Cloudflare. If the lookup failed for any reason
  # OTHER than "this account has no workers.dev subdomain yet" (Cloudflare
  # error 10007), reuse a saved name when there is one — that keeps the URL
  # stable even if the token lost the read permission. A plain 10007 means
  # the subdomain genuinely does not exist, so a saved name could not be
  # live either: fall through and create one.
  if [ -n "$want" ] \
      && [ "$(cf_api_code "$CF_API_BODY")" != "10007" ] \
      && [ "${CF_HTTP_STATUS:-0}" != "200" ]; then
    cf_log "workers.dev lookup failed; reusing saved subdomain '$want'"
    printf '%s' "$want"
    return 0
  fi

  # The account has no workers.dev subdomain (or Cloudflare could not say
  # so): create one. The PUT uses the same Workers Scripts write permission
  # the Worker upload itself uses.
  candidates="${want:-wearsic wearsic-$(cf_rand4)}"
  for cand in $candidates; do
    say "No workers.dev subdomain yet — creating '$cand'…" >&2
    cf_api PUT "/accounts/$acc/workers/subdomain" "{\"subdomain\":\"$cand\"}"
    if cf_api_ok; then
      # The PUT names the subdomain, so it is usable even if the follow-up
      # GET fails. Prefer Cloudflare's returned value when it is available.
      sub="$(cf_subdomain "$acc" 2>/dev/null || true)"
      [ -n "$sub" ] || sub="$cand"
      cf_env_set CLOUDFLARE_SUBDOMAIN "$sub"
      printf '%s' "$sub"
      return 0
    fi
    local fresh_hint=0
    case "${CF_HTTP_STATUS:-0}" in
      401|403)
        cf_api_explain "Could not create the workers.dev subdomain"
        fresh_hint=1
        ;;
    esac
    cf_api_explain "Could not create the workers.dev subdomain '$cand'"
    fresh_hint=1
  done
  # A BRAND-NEW Cloudflare account has no workers.dev subdomain until the
  # Workers page has been opened once in the dashboard; the create API is
  # rejected until then. This is the #1 fresh-account failure — say
  # exactly what to click instead of dumping a cryptic API error.
  if [ "$fresh_hint" = "1" ]; then
    err "Cloudflare has not provisioned workers.dev for this account yet."
    err "Open this link ONCE in the browser that logged into Cloudflare:"
    say "    ${C_ACC}https://dash.cloudflare.com/$acc/workers${C_RESET}"
    say "    (or: https://dash.cloudflare.com/?to=/:account/workers/workers-and-pages)"
    err "It provisions the subdomain automatically. Then run 'wearsic cloudflare' again."
  fi
  err "Choose a different name:  CLOUDFLARE_SUBDOMAIN=<name> wearsic cloudflare"
  return 1
}

# --- Worker identity and source --------------------------------------------
cf_worker_name() {
  local w
  w="$(cf_config CLOUDFLARE_WORKER)"
  [ -n "$w" ] || w="wearsic"
  # The workers.dev hostname IS the worker name, so it must be a valid DNS
  # label: letters, digits and dashes, no leading/trailing dash, <=63 chars.
  case "$w" in
    *[!a-zA-Z0-9-]*) CF_LAST_ERROR="CLOUDFLARE_WORKER must be letters, digits or dashes only (it becomes a DNS label)"; return 1 ;;
  esac
  [ "${#w}" -le 63 ] || { CF_LAST_ERROR="CLOUDFLARE_WORKER must be 63 characters or fewer"; return 1; }
  case "$w" in
    -*|*-) CF_LAST_ERROR="CLOUDFLARE_WORKER must not start or end with a dash"; return 1 ;;
  esac
  printf '%s' "$w"
}

cf_worker_src() {
  local c
  c="$(cf_config CLOUDFLARE_WORKER_SRC)"
  if [ -n "$c" ]; then
    [ -f "$c" ] && { printf '%s' "$c"; return 0; }
    return 1
  fi
  for c in "$DEST/$CF_WORKER_SRC_NAME" "$CLI_DIR/$CF_WORKER_SRC_NAME"; do
    [ -f "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}

cf_permanent_url() {  # $1 = subdomain
  local w
  w="$(cf_worker_name)" || return 1
  printf 'https://%s.%s.workers.dev' "$w" "$1"
}

cf_origin_valid() {
  printf '%s' "$1" | grep -Eq '^https://[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.trycloudflare\.com$'
}

# A Worker uploaded through the API is private by default: its workers.dev
# route exists but is disabled, so the permanent URL returns Cloudflare 404 /
# error 1042 even though the script deployed. Turn the route on explicitly.
# POST is idempotent; preview URLs are not needed (and are not the permanent
# address), so keep them off.
cf_enable_workers_dev() {  # $1 = account id, $2 = worker name
  local acc="$1" worker="$2"
  cf_api POST "/accounts/$acc/workers/scripts/$worker/subdomain" \
    '{"enabled":true,"previews_enabled":false}' || return 1
  cf_api_ok || return 1
  printf '%s' "${CF_API_BODY:-}" \
    | grep -Eq '"enabled"[[:space:]]*:[[:space:]]*true'
}

# --- Worker deployment with bounded exponential backoff + jitter ------------
# Returns: 0 success, 1 retryable failure, 2 permanent failure.
cf_deploy_worker() {  # $1 = origin url
  local origin="$1"
  CF_DEPLOY_RETRYABLE=1
  CF_DEPLOY_ERROR=""
  if ! cf_origin_valid "$origin"; then
    CF_DEPLOY_RETRYABLE=0
    CF_DEPLOY_ERROR="Refusing to deploy: '$origin' is not a trycloudflare.com origin"
    err "$CF_DEPLOY_ERROR"
    return 2
  fi
  local acc worker src
  acc="$(cf_account)"
  if [ -z "$acc" ]; then
    CF_DEPLOY_RETRYABLE=0
    CF_DEPLOY_ERROR="CLOUDFLARE_ACCOUNT_ID is not known"
    err "$CF_DEPLOY_ERROR"
    return 2
  fi
  worker="$(cf_worker_name)" || {
    CF_DEPLOY_RETRYABLE=0
    CF_DEPLOY_ERROR="${CF_LAST_ERROR:-invalid CLOUDFLARE_WORKER}"
    err "$CF_DEPLOY_ERROR"
    return 2
  }
  src="$(cf_worker_src)" || {
    CF_DEPLOY_RETRYABLE=0
    CF_DEPLOY_ERROR="Worker source not found ($CF_WORKER_SRC_NAME) — reinstall with install.sh"
    err "$CF_DEPLOY_ERROR"
    return 2
  }

  local meta out status
  meta="$(printf '{"main_module":"%s","compatibility_date":"%s","bindings":[{"type":"plain_text","name":"ORIGIN","text":"%s"}]}' \
        "$CF_WORKER_SRC_NAME" "$CF_COMPAT_DATE" "$origin")"

  out="$(curl -sS --max-time 120 -X PUT \
      -H "Authorization: Bearer $(cf_token)" \
      -F "metadata=$meta;type=application/json" \
      -F "$CF_WORKER_SRC_NAME=@$src;filename=$CF_WORKER_SRC_NAME;type=application/javascript+module" \
      -w $'\n%{http_code}' \
      "$CF_API_BASE/accounts/$acc/workers/scripts/$worker" 2>&1)" || {
    CF_HTTP_STATUS=0
    CF_API_BODY="$out"
    CF_DEPLOY_ERROR="Worker upload failed (network)"
    cf_api_explain "Worker upload failed"
    return 1
  }
  status="${out##*$'\n'}"
  CF_API_BODY="${out%$'\n'*}"
  case "$status" in
    ''|*[!0-9]*) CF_HTTP_STATUS=0; CF_DEPLOY_ERROR="Worker upload failed (no HTTP status)"; cf_api_explain "Worker upload failed"; return 1 ;;
  esac
  CF_HTTP_STATUS="$status"
  if [ "$status" -ge 200 ] && [ "$status" -lt 300 ] \
      && printf '%s' "$CF_API_BODY" \
         | grep -Eq '"success"[[:space:]]*:[[:space:]]*true'; then
    if cf_enable_workers_dev "$acc" "$worker"; then
      return 0
    fi
    # The script uploaded, but its public route is still off. A 401/403 is
    # permanent; a 404 can be propagation right after the first upload, so
    # let the bounded retry loop handle it.
    case "${CF_HTTP_STATUS:-0}" in
      400|401|403) CF_DEPLOY_RETRYABLE=0 ;;
      *)           CF_DEPLOY_RETRYABLE=1 ;;
    esac
    CF_DEPLOY_ERROR="$(cf_api_message "$CF_API_BODY")"
    [ -n "$CF_DEPLOY_ERROR" ] \
      || CF_DEPLOY_ERROR="Could not enable the workers.dev URL (HTTP ${CF_HTTP_STATUS:-?})"
    cf_api_explain "Could not enable the workers.dev URL"
    return 1
  fi
  # A 4xx (except 429) means retrying cannot help: bad token, missing
  # permission, bad Worker name. Say so and let the supervisor stop instead
  # of looping forever.
  case "$status" in
    429) CF_DEPLOY_RETRYABLE=1 ;;
    4??) CF_DEPLOY_RETRYABLE=0 ;;
    *)   CF_DEPLOY_RETRYABLE=1 ;;
  esac
  CF_DEPLOY_ERROR="$(cf_api_message "$CF_API_BODY")"
  [ -n "$CF_DEPLOY_ERROR" ] || CF_DEPLOY_ERROR="Worker upload failed (HTTP $status)"
  cf_api_explain "Worker upload failed"
  return 1
}

# Bounded exponential backoff with jitter. Attempt N waits at most
# base*2^(N-1), capped at CF_RETRY_CAP; the random half-range prevents two
# phones from retrying in lockstep after a Cloudflare outage.
cf_retry_delay() {  # $1 = attempt number (1-based) -> seconds
  local attempt="$1" base="$CF_RETRY_BASE" cap="$CF_RETRY_CAP" d
  case "$base" in ''|*[!0-9]*) base=2 ;; esac
  case "$cap" in ''|*[!0-9]*) cap=60 ;; esac
  case "$attempt" in ''|*[!0-9]*) attempt=1 ;; esac
  d=$(( base * (1 << (attempt - 1)) ))
  [ "$d" -gt "$cap" ] && d="$cap"
  [ "$d" -lt 1 ] && { printf '0'; return 0; }
  printf '%s' "$(( d / 2 + RANDOM % (d / 2 + 1) ))"
}

cf_deploy_worker_retry() {  # $1 = origin, $2 = max attempts
  local origin="$1" max="${2:-$CF_RETRY_MAX}" attempt=1 delay rc
  case "$max" in ''|*[!0-9]*) max=6 ;; esac
  while :; do
    cf_deploy_worker "$origin"
    rc=$?
    [ "$rc" -eq 0 ] && return 0
    [ "${CF_DEPLOY_RETRYABLE:-1}" = "0" ] && return 2
    [ "$attempt" -ge "$max" ] && return 1
    delay="$(cf_retry_delay "$attempt")"
    cf_log "Worker deploy attempt $attempt/$max failed; retrying in ${delay}s"
    printf '  deploy attempt %s/%s failed; retrying in %ss\n' "$attempt" "$max" "$delay" >&2
    sleep "$delay"
    attempt=$(( attempt + 1 ))
  done
}

# --- Tunnel hostname capture ------------------------------------------------
# cloudflared announces the random hostname on stderr AND exposes it in its
# Prometheus metrics. The log is tried first (it is authoritative and needs
# no extra port); the metrics endpoint is the fallback for builds that log
# it differently.
#
# The two sources differ in shape: the log prints a full URL, while the
# metrics endpoint carries the bare hostname in a label. Both are accepted
# and normalised to an https:// origin here, so callers never have to care.
#
# The LAST match wins, not the first: cloudflared re-announces after a
# reconnect, and a tunnel that reconnects with a NEW hostname appends it at
# the end. Taking the first match would pin the supervisor to a dead
# hostname forever. The supervisor also truncates the per-tunnel log before
# every start, so a hostname from a PREVIOUS tunnel can never be mistaken
# for the current one.
cf_hostname_from_text() {  # $1 = text
  local h
  # api.trycloudflare.com is the tunnel-REQUEST endpoint, not an assigned
  # hostname. cloudflared's failure lines quote it in full
  # ("...: Post \"https://api.trycloudflare.com/tunnel\": dial tcp: ..."),
  # and matching that would pin the Worker to a dead origin. Assigned
  # quick-tunnel names are random words; "api" is reserved for the API.
  h="$(printf '%s' "$1" \
      | sed -n 's|.*\(https\{0,1\}://[a-z0-9-]\{1,63\}\.trycloudflare\.com\).*|\1|p' \
      | grep -Ev '^(https://|http://)?api\.trycloudflare\.com$' \
      | tail -1)"
  if [ -z "$h" ]; then
    # Bare hostname (the Prometheus label form, e.g. hostname="abc.trycloudflare.com").
    # The leading [^a-z0-9-] anchors the label start: without it, sed's greedy
    # `.*` would backtrack to the SHORTEST possible label and return
    # "s.trycloudflare.com" instead of "abc.trycloudflare.com".
    h="$(printf '%s' "$1" \
        | sed -n 's|.*[^a-z0-9-]\([a-z0-9-]\{1,63\}\.trycloudflare\.com\).*|\1|p' \
        | grep -Ev '^api\.trycloudflare\.com$' \
        | tail -1)"
  fi
  [ -n "$h" ] || return 0
  case "$h" in
    http://*|https://*) printf '%s' "$h" | sed 's|/*$||' ;;
    *) printf 'https://%s' "$h" ;;
  esac
}

cf_hostname_from_log() {  # $1 = log file
  [ -f "$1" ] || return 0
  cf_hostname_from_text "$(cat "$1" 2>/dev/null)"
}

cf_hostname_from_metrics() {  # $1 = metrics port
  local body
  body="$(curl -fsS --max-time 5 "http://127.0.0.1:$1/metrics" 2>/dev/null)" || return 0
  cf_hostname_from_text "$body"
}

# Normalise a bare hostname to https://, and a full URL to its origin.
cf_normalize_origin() {  # $1 = hostname or url
  case "$1" in
    http://*|https://*) printf '%s' "$1" | sed 's|/*$||' ;;
    "") : ;;
    *) printf 'https://%s' "$1" ;;
  esac
}

# --- cloudflared ------------------------------------------------------------
cf_cloudflared_bin() {
  # A binary that EXISTS but cannot be EXECUTED on this device (a glibc
  # build on bionic Termux, a wrong-arch download, a stripped mode) used to
  # be picked silently, and every tunnel then died in seconds with a bare
  # "tunnel process exited". Verify each candidate actually runs — cloudflared
  # --version costs milliseconds and is cached for the process lifetime —
  # and say so when a candidate is skipped. Order: explicit CLOUDFLARED_PATH,
  # PATH, then this install's bin/.
  local c
  for c in "${CLOUDFLARED_PATH:-}" "$(command -v cloudflared 2>/dev/null || true)" \
           "$DEST/bin/cloudflared"; do
    [ -n "$c" ] || continue
    [ -x "$c" ] || continue
    case " ${CF_BIN_VERIFIED:-} " in *" $c "*) printf '%s' "$c"; return 0 ;; esac
    if "$c" --version >/dev/null 2>&1; then
      CF_BIN_VERIFIED="${CF_BIN_VERIFIED:+$CF_BIN_VERIFIED }$c"
      printf '%s' "$c"
      return 0
    fi
    err "cloudflared at $c cannot run on this device (wrong build or libc?) — skipping it"
  done
  return 1
}

cf_ensure_cloudflared() {
  local bin
  bin="$(cf_cloudflared_bin)" && { printf '%s' "$bin"; return 0; }
  # A binary that exists but cannot be EXECUTED by this user (installed by
  # another uid, or with the mode stripped) makes every tunnel die in
  # seconds with a bare "tunnel process exited". Repair the mode first;
  # if that is not ours to fix, say exactly what is wrong instead of
  # failing later inside the supervisor.
  local existing="$DEST/bin/cloudflared"
  if [ -f "$existing" ] && [ ! -x "$existing" ]; then
    if chmod 0755 "$existing" 2>/dev/null && [ -x "$existing" ]; then
      printf '%s' "$existing"; return 0
    fi
    err "The tunnel binary $existing is not executable by this user"
    err "  fix it with: chmod 755 $existing   (or re-run the installer as this user)"
    return 1
  fi
  # The automatic download is the Linux/Android release. On other hosts the
  # user must provide a native cloudflared (or install it in PATH).
  case "$(uname -s 2>/dev/null || printf '')" in
    Linux|Android) ;;
    *) err "Automatic cloudflared installation supports Linux/Termux only — install cloudflared and set CLOUDFLARED_PATH"; return 1 ;;
  esac
  # Native Termux: prefer the Termux package (bionic-compatible) over the
  # GitHub glibc build, which cannot start on Termux's libc. The package
  # manager route is one command and is the reliable path there.
  if [ -n "${TERMUX_PREFIX:-}" ] && [ -x "$TERMUX_PREFIX/bin/pkg" ] \
      && ! cf_cloudflared_bin >/dev/null 2>&1; then
    {
      shim_stage_begin "Cloudflare" "installing cloudflared from the Termux repository"
      "$TERMUX_PREFIX/bin/pkg" install -y cloudflared >/dev/null 2>&1
      shim_stage_end ok "cloudflared (Termux package)"
    } >&2
    if cf_cloudflared_bin >/dev/null 2>&1; then
      printf '%s' "$(cf_cloudflared_bin)"
      return 0
    fi
    err "Could not install cloudflared from the Termux repository — trying the generic Linux build"
  fi
  local arch
  case "$(uname -m)" in
    aarch64|arm64)  arch="arm64" ;;
    x86_64|amd64)   arch="amd64" ;;
    armv7l|armv8l|arm) arch="arm" ;;
    i386|i686)      arch="386" ;;
    *) err "No cloudflared build for $(uname -m) — install it manually or set CLOUDFLARED_PATH"; return 1 ;;
  esac
  bin="$DEST/bin/cloudflared"
  mkdir -p "$DEST/bin"
  local tmp="$bin.tmp.$$"
  # The whole block prints to stderr: this function's stdout is the binary
  # path the caller captures.
  {
    shim_stage_begin "Cloudflare" "installing cloudflared ($arch)"
    shim_fetch_start \
      "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-$arch" \
      "$tmp" "Cloudflare  installing cloudflared"
    SHIM_PROGRESS_HOOK=shim_fetch_progress
    shim_animate "$SHIM_FETCH_PID"
    local fetch_rc=0
    shim_fetch_wait || fetch_rc=$?
    if [ "$fetch_rc" != "0" ]; then
      SHIM_PROGRESS_HOOK=""
      if [ "$fetch_rc" = "124" ]; then
        shim_stage_end fail "the download stalled"
        rm -f "$tmp"
        err "cloudflared download stalled (the connection stopped delivering data) — retry when the network is steadier, or install it manually"
        return 1
      fi
      shim_stage_end fail "the cloudflared download failed"
      rm -f "$tmp"
      err "cloudflared download failed — check the connection or install it manually"
      return 1
    fi
    SHIM_PROGRESS_HOOK=""
    shim_stage_end ok "cloudflared ($arch)"
  } >&2
  local magic
  magic="$(head -c 4 "$tmp" 2>/dev/null | od -An -tx1 | tr -d ' \n')"
  if [ "$magic" != "7f454c46" ]; then
    rm -f "$tmp"
    err "cloudflared download is not a Linux executable (got '$magic') — nothing was installed"
    return 1
  fi
  chmod 0755 "$tmp"
  # A binary for the right CPU can still be unusable on Android if it is not
  # compatible with the device's libc. Fail here with an actionable message
  # instead of starting a supervisor that can never read a tunnel hostname.
  if ! "$tmp" --version >/dev/null 2>&1; then
    rm -f "$tmp"
    err "cloudflared downloaded but cannot run on this device — install a compatible build and set CLOUDFLARED_PATH"
    return 1
  fi
  sha256sum "$tmp" > "$(cf_state_dir)/cloudflared.sha256" 2>/dev/null || true
  mv -f "$tmp" "$bin"
  printf '%s' "$bin"
}

# --- Backoff helpers --------------------------------------------------------
cf_sleep_backoff() {  # seconds reason
  local d="$1" why="${2:-retry}" jitter
  case "$d" in ''|*[!0-9]*) d=1 ;; esac
  [ "$d" -lt 1 ] && d=1
  jitter=$(( d / 2 + RANDOM % ( d / 2 + 1 ) ))
  cf_log "$why: waiting ${jitter}s before retrying"
  sleep "$jitter"
}

# --- Single-instance lock ---------------------------------------------------
cf_lock_acquire() {
  local d pid
  d="$(cf_lock_dir)"
  mkdir -p "$(dirname "$d")"
  if mkdir "$d" 2>/dev/null; then
    printf '%s\n' "$$" > "$d/pid"
    return 0
  fi
  pid="$(cat "$d/pid" 2>/dev/null || true)"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
    return 1
  fi
  rm -rf "$d"
  mkdir "$d" 2>/dev/null || return 1
  printf '%s\n' "$$" > "$d/pid"
  return 0
}

cf_lock_release() {
  local d pid
  d="$(cf_lock_dir)"
  pid="$(cat "$d/pid" 2>/dev/null || true)"
  [ "$pid" = "$$" ] && rm -rf "$d" 2>/dev/null || true
}

cf_pids() {  # pids of THIS install's cloudflare supervisor
  # Match BOTH the dispatch keyword and the install directory, so two
  # independent wearsic installs on one machine (or a leftover from a
  # previous run) never shadow each other.
  local self="${BASHPID:-$$}" d pid cmdline
  for d in /proc/[0-9]*; do
    pid="${d#/proc/}"
    [ "$pid" = "$$" ] && continue
    [ "$pid" = "$self" ] && continue
    cmdline="$( { tr '\0' ' ' < "$d/cmdline"; } 2>/dev/null )" || continue
    case "$cmdline" in
      *"__cf_supervise"*"$DEST"*) printf '%s\n' "$pid" ;;
    esac
  done
}

# Seconds since the Cloudflare state file or one of its logs was last
# touched — how RECENTLY ACTIVE a running supervisor is. The supervisor
# rewrites the state on every retry cycle and appends to its log while it
# works, so a small number means "mid-retry, leave it alone". 999999 when
# nothing is readable.
cf_supervisor_idle() {
  local now f t idle=999999 m
  now="$(date +%s)"
  for f in "$(cf_state_file)" "$(cf_log_file)" "$(cf_tunnel_log)"; do
    [ -f "$f" ] || continue
    t="$(stat -c %Y "$f" 2>/dev/null || echo 0)"
    case "$t" in ''|*[!0-9]*) t=0 ;; esac
    m=$(( now - t ))
    [ "$m" -lt "$idle" ] && idle="$m"
  done
  printf '%s' "$idle"
}

# --- Reachability probes ----------------------------------------------------
cf_http_code() {  # url [timeout]
  curl -sS -o /dev/null -w '%{http_code}' --max-time "${2:-15}" "$1" 2>/dev/null || true
}

# /health must answer 200 AND carry the engine's own `{"status":"ok"}` body.
# A bare 200 is not enough: when cloudflared fails before assigning a tunnel,
# its failure text can still point at a trycloudflare host (the request
# endpoint api.trycloudflare.com in particular), and whatever answers there
# must never read as "our engine is reachable".
CF_HEALTH_LAST="no answer"  # observed result of the last probe, for error texts
cf_health_ok() {  # url [timeout]
  local tf code found=1
  # Every exit path must set CF_HEALTH_LAST: a caller that breaks on the
  # return code but reads a STALE "HTTP 200 ok" from an earlier probe would
  # deploy to a tunnel that never answered.
  tf="$(mktemp "${TMPDIR:-/tmp}/wearsic-h.XXXXXX")" || { CF_HEALTH_LAST="probe error (no temp file)"; return 1; }
  code="$(curl -sS -o "$tf" -w '%{http_code}' --max-time "${2:-15}" "$1" 2>/dev/null)" || true
  case "$code" in
    200)
      if grep -q '"status":"ok"' "$tf" 2>/dev/null; then
        found=0; CF_HEALTH_LAST="HTTP 200 ok"
      else
        CF_HEALTH_LAST="HTTP 200 with unexpected body"
      fi
      ;;
    ''|0) CF_HEALTH_LAST="no answer (timeout)" ;;
    *)    CF_HEALTH_LAST="HTTP $code" ;;
  esac
  rm -f "$tf"
  return "$found"
}

# --- The engine BEHIND the tunnel -------------------------------------------
# A dead engine looks exactly like a broken tunnel from the public side: the
# front door answers 502/530 while cloudflared itself is perfectly healthy.
# Replacing tunnels cannot fix that — it only spends the quick-tunnel rate
# limit and changes the hostname. A real phone lost its engine at 20:46 and
# the supervisor spent four tunnels before noticing the origin was the
# casualty. So: probe the LOCAL origin first, and bring the engine back.
cf_local_origin_ok() {  # $1 = engine port -> rc 0 if the local engine answers
  cf_health_ok "http://127.0.0.1:${1:-8080}/health" 6
}

cf_engine_guard() {  # $1 = engine port — restart the engine side, not the tunnel
  local port="${1:-8080}" run="${RUN:-$DEST/run-termux.sh}" sup_pids
  # Confirm before touching anything: a single failed probe is often a
  # transient stall — observed firing while the engine was ACTIVELY
  # STREAMING (a 3.8 MB track), which killed a healthy engine and set off
  # a restart cascade. Two failures ~5 s apart is the bar.
  sleep 5
  if cf_local_origin_ok "$port"; then
    cf_log "the engine answered a second probe — the first failure was a transient stall"
    CF_ENGINE_RETRIES=0
    return 0
  fi
  CF_ENGINE_RETRIES=$(( ${CF_ENGINE_RETRIES:-0} + 1 ))
  if [ -f "$run" ]; then
    sup_pids="$(pids_for_script "$run" 2>/dev/null)"
  else
    sup_pids=""
  fi
  if [ -n "$sup_pids" ]; then
    if [ "$CF_ENGINE_RETRIES" -lt 4 ]; then
      # The auto-heal supervisor watches /health itself and restarts a dead
      # engine within its own cycle — waiting is the correct action.
      cf_log "the engine's auto-heal supervisor is running — waiting for it to bring the engine back (attempt $CF_ENGINE_RETRIES)"
      return 0
    fi
    # It is there, but the engine has stayed down for minutes: that
    # supervisor is stuck (a live instance refused to start the engine for
    # thirteen minutes on a real phone, while the front door burned tunnels).
    # Replace the stuck supervisor — never the tunnel.
    cf_log "the auto-heal supervisor is not restoring the engine — restarting it"
    printf '%s\n' "$sup_pids" | while read -r sp; do
      [ -n "$sp" ] && kill "$sp" 2>/dev/null || true
    done
    sleep 2
  fi
  if [ ! -f "$run" ]; then
    cf_log "ERROR: engine launcher $run not found — cannot restart the engine"
    return 1
  fi
  # Launch detached, exactly like `wearsic cloudflare start` does: the
  # auto-heal supervisor owns the wake lock, the restart backoff and the
  # log rotation for the engine process.
  if command -v setsid >/dev/null 2>&1; then
    ( cd "$DEST" && setsid nohup bash "$run" >/dev/null 2>&1 </dev/null & )
  else
    ( cd "$DEST" && nohup bash "$run" >/dev/null 2>&1 </dev/null & )
  fi
  CF_ENGINE_RETRIES=0
  cf_log "engine is not answering on port $port — started the auto-heal supervisor ($run)"
  return 0
}

# A Quick Tunnel can hand out a hostname before its edge route is serving
# ("may take some time to be reachable" — observed 1–2+ minutes on real
# phones). Deploying then would "succeed" while every request 502s, so the
# budget is wall-clock seconds instead of a try count: the original fixed
# ~35 s window killed healthy tunnels in the middle of their warm-up on a
# live phone. $3 (optional) = the tunnel pid: a dead tunnel must fail fast
# because a restart makes more sense than polling a corpse. CF_READY_LAST
# records what the last probe saw so the failure text can say what actually
# happened.
CF_READY_LAST="no answer"
# The last meaningful cloudflared log line(s) when a tunnel dies, so the
# error text says WHY it exited instead of a bare "tunnel process exited".
cf_tunnel_exit_hint() {
  local f hint
  f="$(cf_tunnel_log)"
  [ -f "$f" ] || return 0
  hint="$(tail -n 30 "$f" 2>/dev/null \
    | grep -E 'ERR|ERROR|error|panic|FATAL|fatal|unable|failed|denied|refused' \
    | tail -1 | tr -d '\r' | cut -c1-180)"
  [ -n "$hint" ] && printf '%s' "$hint"
}

cf_origin_ready() {  # origin [budget_s] [tunnel_pid]
  local origin="$1" budget="${2:-180}" pid="${3:-}" deadline hint
  case "$budget" in ''|*[!0-9]*) budget=180 ;; esac
  deadline=$(( $(date +%s) + budget ))
  while :; do
    if cf_health_ok "$origin/health" 8; then
      CF_READY_LAST=""
      return 0
    fi
    case "$CF_HEALTH_LAST" in ?*) CF_READY_LAST="$CF_HEALTH_LAST" ;; esac
    if [ -n "$pid" ] && ! cf_tunnel_alive "$pid"; then
      hint="$(cf_tunnel_exit_hint)"
      CF_READY_LAST="tunnel process exited${hint:+ ($hint)}"
      return 1
    fi
    [ "$(date +%s)" -ge "$deadline" ] && return 1
    sleep 2
  done
}

cf_permanent_health() {  # permanent url
  cf_health_ok "$1/health" 15
}

# The watch talks to the PERMANENT URL, not to the tunnel. A successful
# Worker upload is not enough: a freshly uploaded Worker's workers.dev route
# can take tens of seconds to activate at the edge, and reporting "live"
# before that made the CLI promise a URL that answered 530 for the next
# minute. Only call the front door LIVE once the permanent URL itself
# serves the engine's {"status":"ok"} — through the edge, end to end.
cf_permanent_live() {  # $1 = permanent url, $2 = budget_s, $3 = tunnel_pid
  local deadline
  deadline=$(( $(date +%s) + ${2:-120} ))
  case "${2:-}" in ''|*[!0-9]*) deadline=$(( $(date +%s) + 120 )) ;; esac
  while :; do
    if cf_permanent_health "$1"; then return 0; fi
    if [ -n "${3:-}" ] && ! cf_tunnel_alive "$3"; then return 1; fi
    [ "$(date +%s)" -ge "$deadline" ] && return 1
    sleep 5
  done
}

# Minting a quick tunnel WITHOUT cloudflared's own client. On real carriers
# cloudflared's Go POST to api.trycloudflare.com can stall for minutes
# ("context deadline exceeded") while curl answers in seconds to the very
# same endpoint from the same uid. The POST that CREATES the tunnel is
# therefore made with curl; the response already carries everything a
# tunnel token needs:
#   {"success":true,"result":{"id":"…","hostname":"…random",
#    "account_tag":"…","secret":"…"}}
# base64({"a":account_tag,"t":id,"s":secret}) IS a valid TUNNEL_TOKEN, so
# cloudflared can run that tunnel without ever asking the API:
#   TUNNEL_TOKEN=<token> cloudflared tunnel --url http://127.0.0.1:8080
# The token is kept in the CF_QT_TOKEN global (never logged — logs only
# show its length) and the URL in CF_QT_ORIGIN; both are set in the
# CALLER'S shell (rc 0 = minted), because a command-substitution caller
# would run this function in a subshell and lose the assignments.
cf_quick_setup() {  # [tries] -> rc 0 if minted; sets CF_QT_ORIGIN + CF_QT_TOKEN
  local tries="${1:-5}" i out code body j host acct tid sec tok
  case "$tries" in ''|*[!0-9]*) tries=5 ;; esac
  CF_QT_TOKEN=""
  CF_QT_LAST=""
  for i in $(seq 1 "$tries"); do
    out="$(curl -sS --max-time 20 -X POST -w '\nQT_CODE %{http_code}\n' \
      "$CF_QT_API" 2>/dev/null)" || out=""
    code="$(printf '%s' "$out" | sed -n 's/^QT_CODE //p' | head -1)"
    body="$(printf '%s' "$out" | sed '$d')"
    case "$code" in
      ""|*[!0-9]*) CF_QT_LAST="no answer from $CF_QT_API"; sleep 4; continue ;;
      # Cloudflare rate-limits the quick-tunnel API per IP ("error code:
      # 1015"). Minting one tunnel after another burns that budget, so stop
      # at the FIRST 429 and let the supervisor back off — hammering the
      # limiter only extends it.
      429) CF_QT_LAST="HTTP 429 — the tunnel API is rate-limiting this network"; return 1 ;;
      200|201) : ;;
      *) CF_QT_LAST="HTTP $code from $CF_QT_API"; sleep 4; continue ;;
    esac
    acct="$(printf '%s' "$body" | sed -n 's/.*"account_tag"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    tid="$(printf '%s' "$body" | sed -n 's/.*"id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    host="$(printf '%s' "$body" | sed -n 's/.*"hostname"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    sec="$(printf '%s' "$body" | sed -n 's/.*"secret"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)"
    if [ -z "$host" ] || [ -z "$acct" ] || [ -z "$tid" ] || [ -z "$sec" ]; then
      sleep 4; continue
    fi
    case "$host" in
      *.trycloudflare.com) : ;;
      *) sleep 4; continue ;;
    esac
    j="$(printf '{"a":"%s","t":"%s","s":"%s"}' "$acct" "$tid" "$sec")"
    tok="$(printf '%s' "$j" | base64 -w 0 2>/dev/null | tr -d '\n')"
    [ -n "$tok" ] || tok="$(printf '%s' "$j" | openssl base64 -A 2>/dev/null | tr -d '\n')"
    [ -n "$tok" ] || { sleep 1; continue; }
    CF_QT_TOKEN="$tok"
    CF_QT_ORIGIN="https://$host"
    return 0
  done
  return 1
}

# Is the tunnel still there? The LAUNCHER pid is not a reliable witness: the
# Go runtime of cloudflared breaks away from proot's ptrace session, so the
# launcher exits while cloudflared keeps running (and keeps reconnecting to
# the edge). Trusting only the launcher made the supervisor kill a perfectly
# healthy tunnel, mint a new one and change the hostname every few seconds
# — exactly the "the URL keeps changing" symptom. So a tunnel is alive when
# the launcher is alive OR a cloudflared process of THIS install (matching
# the tunnel token when we know it) is running.
cf_tunnel_pid() {  # -> pid of the live cloudflared of this install (empty if none)
  local dir pid cmdline envline
  for dir in /proc/[0-9]*; do
    pid="${dir#/proc/}"
    [ "$pid" = "$$" ] && continue
    cmdline="$( { tr '\0' ' ' < "$dir/cmdline"; } 2>/dev/null )" || continue
    case "$cmdline" in
      *"$DEST/bin/cloudflared tunnel"*) : ;;
      *) continue ;;
    esac
    if [ -n "${CF_QT_TOKEN:-}" ]; then
      envline="$( { tr '\0' '\n' < "$dir/environ"; } 2>/dev/null )" || envline=""
      case "$envline" in
        *"TUNNEL_TOKEN=$CF_QT_TOKEN"*) printf '%s' "$pid"; return 0 ;;
        *) continue ;;
      esac
    fi
    printf '%s' "$pid"; return 0
  done
  return 1
}

cf_tunnel_alive() {  # $1 = launcher pid -> rc 0 if the tunnel is still running
  local pid="${1:-}"
  if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then return 0; fi
  cf_tunnel_pid >/dev/null 2>&1
}

# Stop the tunnel for good: the launcher's tree AND the cloudflared process
# itself (the launcher may already be gone — that is how orphans survived
# and kept appending to the shared tunnel log).
cf_tunnel_stop() {  # $1 = launcher pid
  local pid="${1:-}" real
  cf_kill_tree_all "$pid"
  real="$(cf_tunnel_pid 2>/dev/null || true)"
  if [ -n "$real" ]; then
    cf_kill_tree_k "$real"
  fi
}

# --- Tunnel teardown ----------------------------------------------------------
# Killing the tunnel is not one kill: the launcher (proot) was observed to
# survive a plain TERM while its cloudflared child kept serving, which both
# orphaned engine instances and hung the supervisor in wait() ("ERROR … did
# not serve /health" with no restart afterwards). Take the whole tree down:
# descendants first, TERM, then KILL whatever is still standing.
cf_list_kids() {  # pid -> child pids, one per line (read from /proc)
  local dir st
  for dir in /proc/[0-9]*; do
    st="$(awk '/^PPid:/{print $2}' "$dir/status" 2>/dev/null)" || continue
    [ "$st" = "$1" ] && printf '%s\n' "${dir#/proc/}"
  done
}

cf_kill_tree() {  # pid — TERM the process and its descendants, kids first
  local pid="${1:-}" kid
  [ -n "$pid" ] || return 0
  for kid in $(cf_list_kids "$pid"); do
    cf_kill_tree "$kid"
  done
  kill -TERM "$pid" 2>/dev/null || true
}

cf_kill_tree_k() {  # pid — KILL the process and its descendants, kids first
  local pid="${1:-}" kid
  [ -n "$pid" ] || return 0
  for kid in $(cf_list_kids "$pid"); do
    cf_kill_tree_k "$kid"
  done
  kill -KILL "$pid" 2>/dev/null || true
}

cf_kill_tree_all() {  # pid — TERM the tree, KILL survivors, reap the shell child
  local pid="${1:-}" i
  [ -n "$pid" ] || return 0
  cf_kill_tree "$pid"
  for i in 1 2 3 4 5; do
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
  done
  if kill -0 "$pid" 2>/dev/null; then
    cf_kill_tree_k "$pid"
  fi
  wait "$pid" 2>/dev/null || true
}

# --- The supervisor ---------------------------------------------------------
# Starts one cloudflared quick tunnel in the background. Two things used to
# break this single line on real phones, both now handled here:
#
# 1. DNS. cloudflared is a static Go binary; on Android there is no readable
#    /etc/resolv.conf for it, so its resolver silently falls back to the
#    loopback nameservers (127.0.0.1:53 / [::1]:53), which answer "connection
#    refused", so every tunnel request died with
#      "lookup api.trycloudflare.com on [::1]:53: read: connection refused".
# 2. Trust. The same /etc invisibility removed the CA bundle: cloudflared
#    verifies TLS against /etc/ssl/certs/ca-certificates.crt, which does not
#    exist on Android, so every TLS request failed with
#      "x509: certificate signed by unknown authority".
#    proot (already part of the Termux install) bind-mounts the app's own
#    resolv.conf and CA bundle over those /etc paths for the tunnel process
#    only. WEARSIC_CF_DNS=bare opts out (for probe environments that fake a
#    proper /etc).
# 3. Transport. Without --protocol, cloudflared prefers QUIC; mobile
#    networks that block UDP then kill the tunnel in a restart loop. http2
#    rides ordinary TCP and works on every carrier, at no practical cost
#    for the requests this engine serves.
cf_tunnel_launch() {  # $1 = engine port, $2 = tunnel log path
  local p="$1" tlog="$2" prefix resolv tls_pem bindings=() proot="" resolver=""
  prefix="${TERMUX_PREFIX:-/data/data/com.termux/files/usr}"
  resolv="$prefix/etc/resolv.conf"

  # DNS for the tunnel process. cloudflared is a static Go binary: its pure
  # resolver reads /etc/resolv.conf — and NOTHING else. There is no
  # "CLOUDFLARED_DNS" variable; an older build exported one and it silently
  # fixed nothing. On Android that file usually does not exist, so the
  # resolver falls back to the loopback nameservers and the tunnel dies at
  # once with:
  #   "lookup _v2-origintunneld._tcp.argotunnel.com on [::1]:53: read:
  #    connection refused"
  # Resolver strategy, in order:
  #   0. /etc/resolv.conf is already readable with nameservers → launch as-is.
  #   1. proot bind of a resolv.conf that actually has nameservers (Termux's
  #      own file when it has them, otherwise one WE generate under DEST —
  #      Android has no /etc/resolv.conf at all, so depending on Termux's
  #      file alone is not enough). Plus the CA bundle, because Go reads
  #      exactly /etc/ssl/certs/ca-certificates.crt.
  #   2. Native Termux without proot: INSTALL proot from the Termux repo
  #      (a small bionic package), then fall through to (1). TERMUX_PREFIX
  #      is often unset outside login shells, so find pkg by name too.
  #      Re-attempt at most every 10 minutes.
  #   3. Anything else: refuse to launch a tunnel that can only die at its
  #      first DNS lookup, and say exactly what is missing.
  if [ "${WEARSIC_CF_DNS:-}" != "bare" ] \
      && ! grep -qi 'nameserver' /etc/resolv.conf 2>/dev/null; then
    # Pick the resolver file to hand cloudflared. Prefer Termux's own file
    # when it has nameservers; otherwise write one of our own.
    if grep -qi 'nameserver' "$resolv" 2>/dev/null; then
      resolver="$resolv"
    else
      resolver="${DEST:-$HOME}/.resolv.conf"
      if [ ! -f "$resolver" ] || ! grep -qi 'nameserver' "$resolver" 2>/dev/null; then
        printf 'nameserver 8.8.8.8\nnameserver 1.1.1.1\n' > "$resolver" 2>/dev/null || {
          cf_log "ERROR: cannot write a resolv.conf at $resolver"
          return 1
        }
        cf_log "wrote $resolver (nameserver 8.8.8.8 / 1.1.1.1) for cloudflared"
      fi
    fi
    # proot: present, installable via pkg, or nothing.
    if [ -x "$prefix/bin/proot" ]; then
      proot="$prefix/bin/proot"
    else
      local pkg_bin=""
      if [ -n "${TERMUX_PREFIX:-}" ] && [ -x "$TERMUX_PREFIX/bin/pkg" ]; then
        pkg_bin="$TERMUX_PREFIX/bin/pkg"
      elif command -v pkg >/dev/null 2>&1; then
        pkg_bin="$(command -v pkg)"
      fi
      if [ -n "$pkg_bin" ]; then
        local _now
        _now="$(date +%s)"
        case "${CF_PROOT_TRIED:-}" in
          ''|*[!0-9]*) CF_PROOT_TRIED=0 ;;
        esac
        if [ $(( _now - CF_PROOT_TRIED )) -ge 600 ]; then
          CF_PROOT_TRIED="$_now"
          {
            shim_stage_begin "Cloudflare" "installing proot (gives cloudflared a resolver)"
            "$pkg_bin" install -y proot >/dev/null 2>&1
            shim_stage_end ok "proot"
          } >&2
          [ -x "$prefix/bin/proot" ] && proot="$prefix/bin/proot"
        fi
      fi
    fi
    if [ -n "$proot" ]; then
      bindings=("-b" "$resolver:/etc/resolv.conf")
      # The CA bundle: Termux ships it as ssl/cert.pem (older layout) or
      # tls/cert.pem (newer). Bind whichever exists.
      tls_pem=""
      for cand in "$prefix/etc/ssl/cert.pem" "$prefix/etc/tls/cert.pem"; do
        if [ -f "$cand" ]; then tls_pem="$cand"; break; fi
      done
      if [ -n "$tls_pem" ]; then
        bindings+=("-b" "$tls_pem:/etc/ssl/certs/ca-certificates.crt")
      fi
    else
      cf_log "ERROR: no DNS resolver available for cloudflared (no readable /etc/resolv.conf, no proot, no pkg to install it)"
      return 1
    fi
  fi
  # proot is only set when the bind path applies. Keep it optional: on a
  # normal host (CI, desktop) an empty "$proot" becomes an empty command and
  # cloudflared never starts, which hung `cloudflare start` until the e2e
  # test timed out.
  local launch=()
  if [ -n "$proot" ]; then launch=("$proot" "${bindings[@]}"); fi
  launch+=("$cfbin")
  # A curl-minted token (CF_QT_TOKEN) turns the launch into TUNNEL_TOKEN
  # mode: cloudflared only CONNECTS to the edge and never visits the
  # flaky api.trycloudflare.com. Measured on the live phone: `tunnel`
  # WITHOUT the `run` subcommand ignores TUNNEL_TOKEN and falls back to
  # the flaky one-shot quick-tunnel POST, and `run` rejects the parent
  # flags (--protocol/--no-autoupdate) — those ride env vars instead
  # (TUNNEL_TRANSPORT_PROTOCOL, NO_AUTOUPDATE). The env-assignment
  # prefix does not disturb argv order (proot first, binds, binary last).
  if [ -n "${CF_QT_TOKEN:-}" ]; then
    TUNNEL_TOKEN="$CF_QT_TOKEN" TUNNEL_TRANSPORT_PROTOCOL=http2 NO_AUTOUPDATE=true \
      "${launch[@]}" tunnel run \
      --url "http://127.0.0.1:$p" >> "$tlog" 2>&1 &
  else
    "${launch[@]}" tunnel --no-autoupdate --protocol http2 \
      --url "http://127.0.0.1:$p" >> "$tlog" 2>&1 &
  fi
  return 0
}

# Early-death check right after a tunnel launch: if the process dies in the
# first seconds (wrong libc build, missing DNS/CA bind, bad token), fail fast
# with the REAL cloudflared error instead of minting new hostnames forever
# (which also burns the quick-tunnel rate limit). Assumes the caller's loop
# variables (sub/perm/deployed/acc/restart_delay) exist.
cf_tunnel_early_death() {  # $1 = tunnel pid
  local pid="$1" hint
  sleep 4
  cf_tunnel_alive "$pid" && return 0
  hint="$(cf_tunnel_exit_hint)"
  cf_log "ERROR: tunnel died immediately after start${hint:+ ($hint)}"
  cf_state_write degraded "$sub" "$perm" "${origin:-}" "$deployed" \
    "The tunnel process exited immediately (${hint:-see the tunnel log})" "${acc:-}"
  wait "$pid" 2>/dev/null || true
  cf_sleep_backoff "$restart_delay" "tunnel start"
  restart_delay=$(( restart_delay * 2 )); [ "$restart_delay" -gt 60 ] && restart_delay=60
  return 1
}

# Runs the tunnel, points the Worker at it, and re-points the Worker every
# time the tunnel hands out a new random hostname. Restarts the tunnel if it
# dies. Runs detached; the CLI starts it and reads the state file.
#
# The tunnel is minted with curl (api.trycloudflare.com's Go client can
# stall for minutes on real carriers while curl answers in seconds);
# cloudflared then only RUNS it via TUNNEL_TOKEN and never visits the
# flaky endpoint. curl-less (fallback) the daemon's own announce path is
# used. The response hostname / announce log are authoritative.
#
# Recovery rules:
#   · a per-tunnel log is truncated before each start, so a stale hostname
#     from the previous tunnel is never deployed;
#   · the origin must answer /health through the tunnel BEFORE deployment;
#   · deploy retries use bounded exponential backoff with jitter;
#   · a fatal 4xx (bad token/permission) stops the supervisor instead of
#     looping forever, and the state file records the reason;
#   · while healthy, the permanent URL is probed every minute; a failure
#     re-deploys the Worker to the same origin (recovers from an edge/DNS
#     blip or a Worker script that was overwritten).
cf_supervise() {  # $1 = engine port, $2 = install directory
  local p="${1:-$(port)}"
  if [ -n "${2:-}" ]; then
    DEST="$2"
    ENV_FILE="$DEST/.env"
    LOG="$DEST/wearsic-server.log"
  fi
  local log tlog
  log="$(cf_log_file)"
  tlog="$(cf_tunnel_log)"
  mkdir -p "$(dirname "$log")"
  chmod 700 "$(dirname "$log")" 2>/dev/null || true
  : > "$log"
  : > "$tlog"

  if ! cf_lock_acquire; then
    cf_log "another supervisor already holds the lock; exiting"
    return 0
  fi

  # The lock is the single source of truth — enforce it. A second
  # supervisor that slipped past the start-time check (a /proc visibility
  # race, a path-spelling mismatch) runs WITHOUT the lock and creates
  # split-brain: one supervisor owns the tunnel while the other pokes the
  # engine and overwrites the state file. Observed live on a real phone:
  # two supervisors, one freshly restarted engine, a "degraded" state
  # neither side agreed on. Anything matching this install's supervisor
  # pattern that is not THIS process is by definition a lockless orphan.
  cf_kill_lockless_supervisors() {
    local dir pid cmdline
    for dir in /proc/[0-9]*; do
      pid="${dir#/proc/}"
      [ "$pid" = "$$" ] && continue
      cmdline="$( { tr '\0' ' ' < "$dir/cmdline"; } 2>/dev/null )" || continue
      case "$cmdline" in
        *"__cf_supervise"*"$DEST"*) cf_kill_tree_k "$pid" && printf '%s ' "$pid" ;;
      esac
    done
  }
  local dup
  dup="$(cf_kill_lockless_supervisors)"
  case "$dup" in ?*) cf_log "reaped lockless duplicate supervisor(s): $dup" ;; esac

  # Reap tunnels left over from an earlier supervisor generation, before
  # the first launch. A previous supervisor was killed or hung while its
  # (proot+cloudflared) tunnel survived; that orphan keeps its announce
  # fd APPENDED to this same per-attempt log, so the fresh supervisor's
  # hostname read would pick up the OLD tunnel's URL and deploy to a
  # tunnel no supervisor actually watches (observed live: two generations
  # of "worker -> <same old hostname>" seconds after each restart).
  # Only tunnels of THIS install are touched: the match needs both
  # "bin/cloudflared tunnel" and this install's DEST in the cmdline.
  cf_kill_all_tunnels() {
    local dir pid cmdline
    for dir in /proc/[0-9]*; do
      pid="${dir#/proc/}"
      [ "$pid" = "$$" ] && continue
      cmdline="$( { tr '\0' ' ' < "$dir/cmdline"; } 2>/dev/null )" || continue
      case "$cmdline" in
        *"$DEST"*"bin/cloudflared tunnel"*) cf_kill_tree_k "$pid" && printf '%s ' "$pid" ;;
      esac
    done
  }
  local reaped
  reaped="$(cf_kill_all_tunnels)"
  case "$reaped" in ?*) cf_log "reaped orphan tunnel(s) from an earlier supervisor: $reaped" ;; esac

  local tunnel_pid="" origin="" deployed="" sub="" perm="" acc="" cfbin=""
  local restart_delay=1 started_at=0 rc=0

  cf_supervise_cleanup() {
    if [ -n "${tunnel_pid:-}" ]; then
      cf_tunnel_stop "$tunnel_pid"
    fi
    cf_lock_release
  }
  trap 'cf_supervise_cleanup' EXIT
  # INT/TERM must actually END the supervisor. Running only the cleanup
  # handler would return to the loop and start a fresh tunnel seconds later.
  trap 'cf_supervise_cleanup; exit 0' INT TERM HUP

  if ! cf_worker_name >/dev/null; then
    cf_log "ERROR: ${CF_LAST_ERROR:-invalid CLOUDFLARE_WORKER}"
    cf_state_write error "" "" "" "" "${CF_LAST_ERROR:-invalid CLOUDFLARE_WORKER}"
    return 1
  fi
  if ! cf_worker_src >/dev/null; then
    cf_log "ERROR: Worker source $CF_WORKER_SRC_NAME not found"
    cf_state_write error "" "" "" "" "Worker source not found ($CF_WORKER_SRC_NAME) — reinstall with install.sh"
    return 1
  fi
  if ! cfbin="$(cf_ensure_cloudflared)"; then
    cf_log "ERROR: cloudflared is not available"
    cf_state_write error "" "" "" "" "cloudflared is not installed and could not be downloaded"
    return 1
  fi
  if ! acc="$(cf_ensure_account)"; then
    local why="${CF_LAST_ERROR:-Could not determine the Cloudflare account}"
    cf_log "ERROR: $why"
    cf_state_write error "" "" "" "" "$why"
    return 1
  fi
  if ! sub="$(cf_ensure_subdomain "$acc")"; then
    cf_log "ERROR: no workers.dev subdomain"
    cf_state_write error "" "" "" "" "Could not provision a workers.dev subdomain (see log)"
    return 1
  fi
  if ! perm="$(cf_permanent_url "$sub")"; then
    cf_log "ERROR: invalid Worker name"
    cf_state_write error "$sub" "" "" "" "${CF_LAST_ERROR:-invalid CLOUDFLARE_WORKER}"
    return 1
  fi
  cf_log "worker=$perm account=$acc subdomain=$sub"

  while :; do
    started_at="$(date +%s)"
    origin=""
    # 0. ADOPT a tunnel that is already running for this install. Minting a
    #    fresh tunnel for every hiccup is what changed the hostname every
    #    few seconds AND burned the quick-tunnel rate limit (HTTP 429 /
    #    "error code: 1015" — the API allows only a handful of tunnels per
    #    IP per minute). If this install's tunnel is still alive, keep it
    #    and keep serving from it.
    local live_pid live_origin
    live_pid="$(cf_tunnel_pid 2>/dev/null || true)"
    if [ -n "$live_pid" ]; then
      # The running tunnel's own announcement wins (when it makes one);
      # otherwise the origin remembered in the state file is the authority.
      live_origin="$(cf_hostname_from_log "$tlog")"
      [ -z "$live_origin" ] && live_origin="$(cf_state_get origin 2>/dev/null || true)"
      live_origin="$(cf_normalize_origin "$live_origin")"
      if [ -n "$live_origin" ]; then
        cf_log "adopting the tunnel that is already running (pid $live_pid): $live_origin"
        origin="$live_origin"
        tunnel_pid="$live_pid"
        cf_state_write starting "$sub" "$perm" "$origin" "$deployed" "checking the running tunnel" "$acc"
      fi
    fi
    if [ -z "$origin" ]; then
      # 0b. The tunnel BINARY can vanish under us: every engine update
      #     replaces bin/ wholesale and the release ships no cloudflared,
      #     so after `wearsic update` each launch dies in seconds while
      #     the supervisor keeps minting hostnames for a binary that is
      #     not there (live outage 2026-10-22: an update deleted the
      #     37 MB binary and the front door burned four tunnels).
      #     Ask the SAME resolver the launcher uses (CLOUDFLARED_PATH,
      #     PATH, then $DEST/bin/cloudflared) — a custom binary location
      #     must not be mistaken for a missing one. Restore BEFORE
      #     spending a mint on a doomed launch.
      if ! cf_cloudflared_bin >/dev/null 2>&1; then
        cf_log "the tunnel binary is missing (an engine update replaced bin/) — restoring it"
        cf_state_write degraded "$sub" "$perm" "" "$deployed" \
          "The tunnel binary was removed by an engine update — restoring it" "$acc"
        if [ -x "$DEST/bin.prev/cloudflared" ]; then
          # The rollback copy still has it — no network needed.
          cp -f "$DEST/bin.prev/cloudflared" "$DEST/bin/cloudflared" 2>/dev/null || true
          chmod 0755 "$DEST/bin/cloudflared" 2>/dev/null || true
        fi
        if ! cfbin="$(cf_ensure_cloudflared)"; then
          cf_log "ERROR: ${CF_LAST_ERROR:-cloudflared is missing and could not be re-downloaded}"
          cf_state_write degraded "$sub" "$perm" "" "$deployed" \
            "The tunnel binary is missing and could not be re-downloaded" "$acc"
          cf_sleep_backoff "$restart_delay" "tunnel binary restore"
          restart_delay=$(( restart_delay * 2 )); [ "$restart_delay" -gt 300 ] && restart_delay=300
          continue
        fi
        cf_log "tunnel binary restored: $cfbin"
      fi
      : > "$tlog"
      # The tunnel is MINTED with curl, not by cloudflared's own client: on
      # real carriers the Go client's POST to api.trycloudflare.com stalls
      # for minutes while curl answers in seconds from the same uid. The
      # response carries id, hostname and secret — everything a
      # TUNNEL_TOKEN needs — so cloudflared only ever RUNS the tunnel and
      # never visits the flaky endpoint. The classic announce path (the
      # daemon asking for the hostname itself) stays as the fallback.
      if cf_quick_setup "${CF_QT_SETUP_TRIES:-5}"; then
        origin="$CF_QT_ORIGIN"
        cf_log "tunnel available at $origin (provisioned by curl)"
        cf_state_write starting "$sub" "$perm" "$origin" "$deployed" "waiting for the tunnel to connect" "$acc"
        if ! cf_tunnel_launch "$p" "$tlog"; then
          cf_state_write degraded "$sub" "$perm" "" "$deployed" \
            "cloudflared has no DNS resolver on this device — install it with: pkg install proot" "$acc"
          cf_sleep_backoff "$restart_delay" "tunnel launch"
          restart_delay=$(( restart_delay * 2 )); [ "$restart_delay" -gt 60 ] && restart_delay=60
          continue
        fi
        tunnel_pid=$!
        cf_log "tunnel started (pid $tunnel_pid)"
        if ! cf_tunnel_early_death "$tunnel_pid"; then continue; fi
      elif [ "${CF_QT_LAST:-}" = "HTTP 429 — the tunnel API is rate-limiting this network" ]; then
        # Rate-limited: wait it out. Minting again immediately would only
        # extend the limit, and the classic fallback would stall for
        # minutes on the very endpoint that is throttling us.
        cf_log "ERROR: ${CF_QT_LAST} — waiting before trying again"
        cf_state_write degraded "$sub" "$perm" "" "$deployed" \
          "The tunnel API is rate-limiting this network (HTTP 429) — waiting for it to clear" "$acc"
        cf_sleep_backoff "$restart_delay" "tunnel mint"
        restart_delay=$(( restart_delay * 2 )); [ "$restart_delay" -gt 300 ] && restart_delay=300
        continue
      else
        cf_log "curl did not provision a tunnel (${CF_QT_LAST:-no answer}); using cloudflared's own announce path"
        if ! cf_tunnel_launch "$p" "$tlog"; then
          cf_state_write degraded "$sub" "$perm" "" "$deployed" \
            "cloudflared has no DNS resolver on this device — install it with: pkg install proot" "$acc"
          cf_sleep_backoff "$restart_delay" "tunnel launch"
          restart_delay=$(( restart_delay * 2 )); [ "$restart_delay" -gt 60 ] && restart_delay=60
          continue
        fi
        tunnel_pid=$!
        cf_log "tunnel started (pid $tunnel_pid)"
        if ! cf_tunnel_early_death "$tunnel_pid"; then continue; fi
        cf_state_write starting "$sub" "$perm" "" "$deployed" "waiting for the tunnel hostname" "$acc"

        # 1. Wait for the random hostname. The log is authoritative; the
        #    metrics endpoint is the fallback for builds that log differently.
        local i mport
      for i in $(seq 1 90); do
        origin="$(cf_hostname_from_log "$tlog")"
        if [ -z "$origin" ]; then
          for mport in 20241 20242 20243 20244 20245; do
            origin="$(cf_hostname_from_metrics "$mport")"
            [ -n "$origin" ] && break
          done
        fi
        [ -n "$origin" ] && break
        cf_tunnel_alive "$tunnel_pid" || break
        sleep 1
      done

      if [ -z "$origin" ]; then
        cf_log "ERROR: could not read the tunnel hostname"
        cf_state_write error "$sub" "$perm" "" "$deployed" "Could not read the tunnel hostname from cloudflared" "$acc"
        cf_tunnel_stop "$tunnel_pid"
        cf_sleep_backoff "$restart_delay" "tunnel start"
        restart_delay=$(( restart_delay * 2 )); [ "$restart_delay" -gt 60 ] && restart_delay=60
        continue
      fi
      fi
    fi
    origin="$(cf_normalize_origin "$origin")"
    cf_log "tunnel hostname: $origin"

    # 2. Do not deploy a hostname that is not serving yet. Quick tunnels
    #    routinely take a minute or two before the edge answers ("may take
    #    some time to be reachable") — wait up to three minutes, and never
    #    kill an announced-but-slowing tunnel: it may answer any second, and
    #    restarting throws away the hostname while leaving the engine
    #    running behind the old one (a real phone ended up with a supervisor
    #    hung in wait() while /health finally answered through the
    #    "killed" tunnel). Bail out quickly only when the tunnel process is
    #    genuinely gone.
    if ! cf_origin_ready "$origin" 180 "$tunnel_pid"; then
      cf_log "ERROR: tunnel $origin did not serve /health (${CF_READY_LAST:-no answer})"
      cf_state_write degraded "$sub" "$perm" "$origin" "$deployed" \
        "The tunnel is up but the engine did not answer through it (${CF_READY_LAST:-no answer})" "$acc"
      if ! cf_tunnel_alive "$tunnel_pid"; then
        wait "$tunnel_pid" 2>/dev/null || true
        cf_sleep_backoff "$restart_delay" "tunnel readiness"
        restart_delay=$(( restart_delay * 2 )); [ "$restart_delay" -gt 60 ] && restart_delay=60
        continue
      fi
      # The tunnel is alive. Keep watching it on a slow cadence and deploy
      # the instant /health answers; log progress once a minute.
      # The wait is BOUNDED. A tunnel whose edge route never serves must be
      # replaced, not watched forever: the Worker would otherwise stay
      # pointed at a dead origin with no escalation (a real phone sat in
      # exactly that state, front door dead, supervisor "waiting" patiently).
      # 300s on top of the 180s readiness budget — warm-up routinely takes
      # 1-3 minutes, and quick-tunnel mint pressure stays one attempt per
      # restart cycle.
      local wpoll=0 wait_deadline=$(( $(date +%s) + 300 )) tun_last
      while :; do
        sleep 10
        # Break on the RETURN CODE, not on the shared string global: a
        # probe failure that skips the assignment would otherwise leave the
        # previous value ("HTTP 200 ok" from the local-engine probe!) and
        # deploy to an unverified tunnel.
        if cf_health_ok "$origin/health" 8; then
          cf_log "tunnel $origin started serving /health after $(( $(date +%s) - started_at ))s"
          break
        fi
        # Capture the TUNNEL probe result now: the local-engine probe below
        # overwrites CF_HEALTH_LAST, which made the old log line claim
        # "still not serving /health (last: HTTP 200 ok)" — the 200 was the
        # engine's, the tunnel had actually timed out.
        tun_last="$CF_HEALTH_LAST"
        if ! cf_tunnel_alive "$tunnel_pid"; then
          wait "$tunnel_pid" 2>/dev/null || true
          cf_log "tunnel exited before serving; restarting"
          cf_state_write degraded "$sub" "$perm" "$origin" "$deployed" "tunnel not serving and exited; restarting" "$acc"
          cf_sleep_backoff "$restart_delay" "tunnel restart"
          restart_delay=$(( restart_delay * 2 )); [ "$restart_delay" -gt 60 ] && restart_delay=60
          continue 2
        fi
        if [ "$(date +%s)" -ge "$wait_deadline" ]; then
          cf_log "tunnel $origin never served /health within 300s (${tun_last:-no answer}) — replacing the tunnel"
          cf_state_write degraded "$sub" "$perm" "$origin" "$deployed" \
            "The tunnel came up but never served /health — replacing it" "$acc"
          cf_tunnel_stop "$tunnel_pid"
          cf_sleep_backoff "$restart_delay" "tunnel readiness"
          restart_delay=$(( restart_delay * 2 )); [ "$restart_delay" -gt 60 ] && restart_delay=60
          continue 2
        fi
        wpoll=$(( wpoll + 1 ))
        if [ $(( wpoll % 6 )) -eq 0 ]; then
          # While the tunnel waits for the edge, make sure it is not waiting
          # for a dead ENGINE: probe the local origin, and restart it if it
          # is the thing that stopped answering.
          if ! cf_local_origin_ok "$p"; then
            cf_engine_guard "$p"
            cf_state_write degraded "$sub" "$perm" "$origin" "$deployed" \
              "The engine behind the tunnel is not answering — bringing it back" "$acc"
            sleep 45
          fi
          cf_log "tunnel $origin still not serving /health (last: ${tun_last:-no answer}) — keeping the tunnel and waiting"
        fi
      done
    fi

    # 3. Point the Worker at it, with retries — and do not call the front
    #    door live until the PERMANENT URL serves end to end. The upload
    #    being accepted is not the same as the workers.dev route answering;
    #    reporting live in between is the "✓ ready → ✗ 530" users saw.
    if cf_deploy_worker_retry "$origin"; then
      deployed="$origin"
      if cf_permanent_live "$perm" 180 "$tunnel_pid"; then
        cf_state_write live "$sub" "$perm" "$origin" "$deployed" "" "$acc"
        cf_log "worker -> $origin; permanent URL serving end-to-end"
      else
        cf_state_write starting "$sub" "$perm" "$origin" "$deployed" \
          "Worker deployed — waiting for the permanent URL to go live at the edge" "$acc"
        cf_log "worker -> $origin, but the permanent URL is not serving yet — staying non-live"
      fi
    else
      rc=$?
      cf_state_write degraded "$sub" "$perm" "$origin" "$deployed" "${CF_DEPLOY_ERROR:-Worker deployment failed (see log)}" "$acc"
      cf_log "ERROR: worker upload failed (rc=$rc): ${CF_DEPLOY_ERROR:-unknown}"
      if [ "$rc" -eq 2 ]; then
        cf_log "deployment failed permanently; supervisor exiting"
        cf_state_write error "$sub" "$perm" "$origin" "$deployed" "${CF_DEPLOY_ERROR:-Worker deployment was rejected}" "$acc"
        cf_tunnel_stop "$tunnel_pid"
        return 1
      fi
    fi

    # 4. Watch for a new hostname, and for the permanent URL going dead.
    #    Start the clock now: a just-deployed Worker needs a moment to
    #    propagate, and a health check at second 5 would re-deploy in vain.
    local last_check cf_stale=0 CF_ENGINE_RETRIES=0
    last_check="$(date +%s)"
    while cf_tunnel_alive "$tunnel_pid"; do
      sleep 5
      local new
      new="$(cf_hostname_from_log "$tlog")"
      new="$(cf_normalize_origin "$new")"
      if [ -n "$new" ] && [ "$new" != "$origin" ]; then
        cf_log "tunnel changed: $origin -> $new"
        origin="$new"
        if cf_origin_ready "$origin" 10; then
          if cf_deploy_worker_retry "$origin"; then
            deployed="$origin"
            if cf_permanent_live "$perm" 45 "$tunnel_pid"; then
              cf_state_write live "$sub" "$perm" "$origin" "$deployed" "" "$acc"
              cf_log "worker re-pointed -> $origin"
            else
              cf_state_write starting "$sub" "$perm" "$origin" "$deployed" \
                "Worker re-pointed — waiting for the permanent URL to serve" "$acc"
              cf_log "re-pointed to $origin, but the permanent URL is not serving yet"
            fi
          else
            rc=$?
            cf_state_write degraded "$sub" "$perm" "$origin" "$deployed" "${CF_DEPLOY_ERROR:-re-point failed}" "$acc"
            cf_log "ERROR: re-point failed: ${CF_DEPLOY_ERROR:-unknown}"
            if [ "$rc" -eq 2 ]; then
              cf_log "re-point failed permanently; supervisor exiting"
              cf_state_write error "$sub" "$perm" "$origin" "$deployed" "${CF_DEPLOY_ERROR:-Worker deployment was rejected}" "$acc"
              cf_tunnel_stop "$tunnel_pid"
              return 1
            fi
          fi
        else
          cf_state_write degraded "$sub" "$perm" "$origin" "$deployed" "The new tunnel hostname is not serving yet" "$acc"
          cf_log "ERROR: new tunnel $origin is not serving"
        fi
        last_check=0
      fi
      local now
      now="$(date +%s)"
      if [ $(( now - last_check )) -ge 60 ]; then
        last_check="$now"
        if [ -z "$deployed" ] || [ "$deployed" != "$origin" ]; then
          # The earlier deploy exhausted its retries (or the tunnel moved
          # while it was down). Never leave the state degraded forever:
          # keep retrying on the same bounded backoff. Re-check readiness:
          # a hostname that is not serving must not be reported as live.
          if ! cf_origin_ready "$origin" 10; then
            cf_state_write degraded "$sub" "$perm" "$origin" "$deployed" "The tunnel hostname is not serving yet" "$acc"
            cf_log "retry skipped: $origin is not serving /health"
          else
            cf_log "retrying Worker deployment to $origin"
            if cf_deploy_worker_retry "$origin"; then
              deployed="$origin"
              if cf_permanent_live "$perm" 45 "$tunnel_pid"; then
                cf_state_write live "$sub" "$perm" "$origin" "$deployed" "" "$acc"
                cf_log "worker -> $origin (recovered)"
              else
                cf_state_write starting "$sub" "$perm" "$origin" "$deployed" \
                  "Worker deployed — waiting for the permanent URL to serve" "$acc"
                cf_log "deployed to $origin, but the permanent URL is not serving yet"
              fi
            else
              rc=$?
              cf_state_write degraded "$sub" "$perm" "$origin" "$deployed" "${CF_DEPLOY_ERROR:-Worker deployment failed (see log)}" "$acc"
              if [ "$rc" -eq 2 ]; then
                cf_log "deployment failed permanently; supervisor exiting"
                cf_state_write error "$sub" "$perm" "$origin" "$deployed" "${CF_DEPLOY_ERROR:-Worker deployment was rejected}" "$acc"
                cf_tunnel_stop "$tunnel_pid"
                return 1
              fi
            fi
          fi
        elif ! cf_permanent_health "$perm"; then
          # First ask WHERE the failure is: if the engine behind the tunnel
          # is dead, the tunnel is innocent and must not be replaced (that
          # spends the rate limit and changes the hostname for nothing).
          if ! cf_local_origin_ok "$p"; then
            cf_engine_guard "$p"
            cf_state_write degraded "$sub" "$perm" "$origin" "$deployed" \
              "The engine behind the tunnel is not answering — bringing it back" "$acc"
            sleep 45
            continue
          fi
          # The permanent URL is not answering. A re-deploy of the same
          # Worker fixes a broken Worker, but NOT a tunnel whose edge
          # connection is half-dead (the process is there, the traffic is
          # not). Count consecutive failures: after a few minutes of them
          # the tunnel itself is replaced — the hostname changes once,
          # deliberately, instead of serving a dead front door forever.
          cf_stale=$(( cf_stale + 1 ))
          cf_log "permanent URL check failed (${cf_stale} in a row) — re-deploying the Worker"
          if cf_deploy_worker_retry "$origin"; then
            if cf_permanent_live "$perm" 45 "$tunnel_pid"; then
              cf_state_write live "$sub" "$perm" "$origin" "$deployed" "" "$acc"
              cf_log "worker re-deployed after a failed health check"
            else
              cf_state_write degraded "$sub" "$perm" "$origin" "$deployed" \
                "The Worker is deployed but the permanent URL is not serving yet" "$acc"
              cf_log "re-deployed, but the permanent URL still is not serving"
            fi
          else
            rc=$?
            cf_state_write degraded "$sub" "$perm" "$origin" "$deployed" "${CF_DEPLOY_ERROR:-health check failed}" "$acc"
            if [ "$rc" -eq 2 ]; then
              cf_log "re-deploy after health check failed permanently; supervisor exiting"
              cf_state_write error "$sub" "$perm" "$origin" "$deployed" "${CF_DEPLOY_ERROR:-Worker deployment was rejected}" "$acc"
              cf_tunnel_stop "$tunnel_pid"
              return 1
            fi
          fi
          if [ "$cf_stale" -ge 3 ]; then
            cf_log "the front door stayed down for 3 checks — replacing the tunnel"
            cf_state_write degraded "$sub" "$perm" "$origin" "$deployed" \
              "The tunnel was not serving through the edge — replacing it" "$acc"
            cf_tunnel_stop "$tunnel_pid"
            cf_sleep_backoff "$restart_delay" "tunnel replacement"
            restart_delay=$(( restart_delay * 2 )); [ "$restart_delay" -gt 60 ] && restart_delay=60
            continue
          fi
        else
          cf_stale=0
          CF_ENGINE_RETRIES=0
        fi
      fi
    done

    cf_log "tunnel exited — restarting"
    wait "$tunnel_pid" 2>/dev/null || true
    cf_state_write starting "$sub" "$perm" "$origin" "$deployed" "tunnel exited; restarting" "$acc"
    if [ $(( $(date +%s) - started_at )) -ge 60 ]; then
      restart_delay=1
    fi
    cf_sleep_backoff "$restart_delay" "tunnel restart"
    restart_delay=$(( restart_delay * 2 )); [ "$restart_delay" -gt 60 ] && restart_delay=60
  done
}

# --- Verification -----------------------------------------------------------
cf_verify() {  # $1 = permanent url, $2 = optional video id for a playback probe
  local url="$1" playback="${2:-${WEARSIC_CF_PLAYBACK_ID:-}}" key rc=0
  key="$(api_key)"
  if [ -z "$key" ]; then
    err "An API key is required to verify the public URL: wearsic api-key <your-key>"
    return 1
  fi
  local tmp
  tmp="$(mktemp -d)" || { err "Could not create a temporary directory"; return 1; }

  say "Verifying through the permanent URL…"

  # 1. The public liveness endpoint: Worker + tunnel + engine.
  local code
  code="$(curl -sS -o "$tmp/health" -w '%{http_code}' --max-time 20 "$url/health" 2>/dev/null || true)"
  if [ "$code" = "200" ] && grep -q '"status":"ok"' "$tmp/health" 2>/dev/null; then
    ok "health       200 OK through $url"
  else
    err "health       expected 200 + {\"status\":\"ok\"} from $url/health, got ${code:-no response}"
    if [ "$code" = "200" ]; then
      err "                (200 with a different body: the tunnel was down at check time — the supervisor retries)"
    elif [ "$code" = "405" ] || [ "$code" = "530" ]; then
      err "                (this answer came from the edge, not the engine — the origin was unreachable)"
    fi
    rc=1
  fi

  # 2. Authentication must survive the proxy. Without a key the engine must
  #    answer 401; with the key it must answer 200.
  if [ -n "$key" ]; then
    code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 20 "$url$CF_PROBE_PATH" 2>/dev/null || true)"
    if [ "$code" = "401" ]; then
      ok "auth         the engine rejects requests without the API key (401)"
    else
      err "auth         expected 401 without a key, got ${code:-no response}"
      if [ "$code" = "405" ]; then
        err "                (the answer is not from the engine — the tunnel origin was unreachable)"
      fi
      rc=1
    fi
  fi

  # 3. Range + 206 + body integrity. This is the audio-critical path.
  if [ -n "$key" ]; then
    code="$(curl -sS --max-time 30 \
        -H "X-Wearsic-Key: $key" \
        -H "Range: bytes=10-19" \
        -D "$tmp/range.hdr" -o "$tmp/range.body" \
        -w '%{http_code}' "$url$CF_PROBE_PATH" 2>/dev/null || true)"
    local crange len b0 b9
    crange="$(grep -i '^content-range:' "$tmp/range.hdr" 2>/dev/null | head -1 | tr -d '\r')"
    len="$(wc -c < "$tmp/range.body" 2>/dev/null | tr -d ' ')"
    b0="$(od -An -tu1 -j0 -N1 "$tmp/range.body" 2>/dev/null | tr -d ' ')"
    b9="$(od -An -tu1 -j9 -N1 "$tmp/range.body" 2>/dev/null | tr -d ' ')"
    # Probe bytes are (i*31+7) & 0xff: 61 at i=10, 84 at i=19.
    if [ "$code" = "206" ] \
        && printf '%s' "$crange" | grep -qi "content-range: bytes 10-19/$CF_PROBE_SIZE" \
        && [ "$len" = "10" ] && [ "$b0" = "61" ] && [ "$b9" = "84" ]; then
      ok "streaming    206 Partial Content, Content-Range preserved, 10 bytes intact"
    else
      err "streaming    expected 206 bytes 10-19/$CF_PROBE_SIZE and 10 intact bytes"
      err "             got HTTP ${code:-none} '${crange}' length=${len:-?}"
      rc=1
    fi
  fi

  # 4. Optional real playback probe. Kept opt-in: extracting a YouTube track
  #    depends on the extractor and the network, so it is not a setup check.
  if [ -n "$playback" ] && [ -n "$key" ]; then
    code="$(curl -sS --max-time 60 \
        -H "X-Wearsic-Key: $key" \
        -H "Range: bytes=0-1023" \
        -D "$tmp/play.hdr" -o "$tmp/play.body" \
        -w '%{http_code}' "$url/api/stream/$playback" 2>/dev/null || true)"
    local ct plen
    ct="$(grep -i '^content-type:' "$tmp/play.hdr" 2>/dev/null | head -1 | tr -d '\r')"
    plen="$(wc -c < "$tmp/play.body" 2>/dev/null | tr -d ' ')"
    if { [ "$code" = "206" ] || [ "$code" = "200" ]; } && [ "${plen:-0}" -gt 0 ]; then
      ok "playback     track $playback returned HTTP $code, $plen bytes${ct:+ ($ct)}"
    else
      err "playback     track $playback failed (HTTP ${code:-none}, ${plen:-0} bytes)${ct:+ — $ct}"
      rc=1
    fi
  elif [ -z "$playback" ]; then
    dim "playback     skipped — set WEARSIC_CF_PLAYBACK_ID=<videoId> to probe a real track"
  fi

  rm -rf "$tmp"
  return "$rc"
}

# --- Authorization ----------------------------------------------------------
cf_open_url() {
  local u="$1"
  if command -v termux-open-url >/dev/null 2>&1 && termux-open-url "$u" >/dev/null 2>&1; then return 0; fi
  if command -v xdg-open >/dev/null 2>&1 && xdg-open "$u" >/dev/null 2>&1; then return 0; fi
  if command -v open >/dev/null 2>&1 && open "$u" >/dev/null 2>&1; then return 0; fi
  return 1
}

cf_http_status_text() { printf 'HTTP %s' "${CF_HTTP_STATUS:-0}"; }

cf_auth_check() {  # [$1 = account id]
  local acc="${1:-$(cf_account)}"
  [ -n "$(cf_token)" ] || { err "No Cloudflare credential found"; return 1; }
  if [ -n "$acc" ]; then
    cf_api GET "/accounts/$acc/workers/subdomain"
    case "${CF_HTTP_STATUS:-0}" in
      2??) return 0 ;;
      401|403) cf_api_explain "Cloudflare rejected the credential"; return 1 ;;
      *) cf_api_explain "Cloudflare API check failed"; return 1 ;;
    esac
  fi
  cf_api GET "/accounts?per_page=50"
  case "${CF_HTTP_STATUS:-0}" in
    2??) return 0 ;;
    *) cf_api_explain "Cloudflare rejected the credential"; return 1 ;;
  esac
}

cf_auth_check_with_token() {  # token (used before saving it)
  local tok="$1" old="${CLOUDFLARE_API_TOKEN:-}" had=0 rc
  [ -n "$old" ] && had=1
  export CLOUDFLARE_API_TOKEN="$tok"
  cf_auth_check
  rc=$?
  if [ "$had" -eq 1 ]; then export CLOUDFLARE_API_TOKEN="$old"; else unset CLOUDFLARE_API_TOKEN; fi
  return "$rc"
}

cf_prompt_token() {
  [ -t 0 ] || {
    err "No terminal for the token prompt. Use: CLOUDFLARE_API_TOKEN=... wearsic cloudflare"
    return 1
  }
  say ""
  say "Create a scoped Cloudflare API token (free account):"
  say "  https://dash.cloudflare.com/profile/api-tokens"
  say "  Template: Edit Cloudflare Workers"
  say "  Needs: Workers Scripts:Edit and Account Settings:Read"
  if cf_open_url "https://dash.cloudflare.com/profile/api-tokens"; then
    dim "  (opened in your browser)"
  else
    dim "  (open the URL above on any device, then paste the token here)"
  fi
  local tries=0 tok
  while [ "$tries" -lt 3 ]; do
    tries=$(( tries + 1 ))
    printf 'Paste the API token (hidden): '
    IFS= read -rs tok || { printf '\n'; return 1; }
    printf '\n'
    tok="$(printf '%s' "$tok" | tr -d '[:space:]')"
    if [ -z "$tok" ]; then warn "No token entered."; continue; fi
    if cf_auth_check_with_token "$tok"; then
      cf_env_set CLOUDFLARE_API_TOKEN "$tok"
      ok "Token verified and saved to $ENV_FILE (mode 600)"
      return 0
    fi
    warn "That token was not accepted ($(cf_http_status_text)). Try again."
  done
  err "Could not authorize Cloudflare after 3 attempts."
  return 1
}

cf_login_summary() {
  local acc sub
  say "Credential     $(cf_token_source)"
  acc="$(cf_account_env)"
  if [ -n "$acc" ]; then
    say "Account        $acc"
  else
    say "Account        detected on start (or set CLOUDFLARE_ACCOUNT_ID)"
  fi
  sub="$(cf_credential CLOUDFLARE_SUBDOMAIN)"
  [ -n "$sub" ] && say "workers.dev     $sub"
  return 0
}

cf_login() {
  local mode="${1:-auto}" tok=""
  installed
  case "$mode" in
    auto|"") mode="auto" ;;
    --device|device) mode="device" ;;
    --browser|browser) mode="browser" ;;
    --wrangler|wrangler) mode="wrangler" ;;
    --token-stdin|token-stdin) mode="stdin" ;;
    *) die "Unknown login option: $mode (try --browser, --wrangler or --token-stdin)" ;;
  esac

  # 1) A static token still wins until it proves broken, so an existing
  #    setup keeps working across this change.
  if [ "$mode" = "auto" ] && [ -n "$(cf_token_from_env)" ]; then
    if cf_auth_check; then
      ok "Already authorized"
      cf_login_summary
      return 0
    fi
    warn "The saved Cloudflare token was rejected — authorizing again."
  fi

  # 2) The refreshable OAuth session from a previous login.
  if [ "$mode" = "auto" ] && [ -s "$(cf_auth_file 2>/dev/null)" ]; then
    if cf_oauth_token >/dev/null 2>&1 && cf_auth_check; then
      ok "Already authorized (the session refreshes itself)"
      cf_login_summary
      return 0
    fi
    say "The saved session could not be refreshed — authorizing again."
  fi

  # 3) Native browser/device OAuth: nothing to install, just a browser.
  if [ "$mode" = "device" ] || [ "$mode" = "auto" ]; then
    cf_login_device_flow
    local rc=$?
    [ "$rc" -eq 0 ] && return 0
    # rc=2: Cloudflare's edge bot-challenged this network's device-code
    # request (some mobile ISPs and hotspots). The browser flow goes through
    # the user's actual browser and still works here, so chain into it.
    if [ "$rc" -eq 2 ] && [ "$mode" = "auto" ] && [ -t 0 ]; then
      warn "The device flow is blocked on this network — falling back to the browser flow."
      cf_login_browser_flow
      return $?
    fi
    return "$rc"
  fi

  if [ "$mode" = "browser" ]; then
    cf_login_browser_flow
    return $?
  fi

  if [ "$mode" = "wrangler" ]; then
    if ! cf_wrangler_available; then
      err "wrangler is not installed. Install it with: npm install -g wrangler"
      return 1
    fi
    say "Opening Cloudflare's official OAuth login (wrangler)…"
    local ok=0
    if cf_run_timeout 10 wrangler login --help 2>/dev/null | grep -q -- '--device'; then
      cf_run_timeout 600 wrangler login --device && ok=1
    else
      cf_run_timeout 900 wrangler login && ok=1
    fi
    if [ "$ok" -eq 1 ] && tok="$(cf_token_from_wrangler)" && [ -n "$tok" ]; then
      if cf_auth_check_with_token "$tok"; then
        # A stale CLOUDFLARE_API_TOKEN takes precedence over wrangler in
        # cf_token(), which would silently keep using the rejected token.
        local env_token
        env_token="$(printenv CLOUDFLARE_API_TOKEN 2>/dev/null || true)"
        if [ -n "$(cf_token_from_env)" ]; then
          cf_env_unset CLOUDFLARE_API_TOKEN
          unset CLOUDFLARE_API_TOKEN
          say "Using the wrangler session; removed the saved API token from $ENV_FILE."
        fi
        if [ -n "$env_token" ]; then
          warn "CLOUDFLARE_API_TOKEN is exported in this shell; unset it there too so wrangler is used next time."
        fi
        ok "Authorized through wrangler (its OAuth token refreshes itself)."
        cf_login_summary
        return 0
      fi
    fi
    err "wrangler login did not produce a usable credential."
    return 1
  fi

  # 4) Manual fallback: hidden-input prompt for an API token.
  cf_prompt_token || return 1
  return 0
}

cf_ensure_auth() {
  local tok
  tok="$(cf_token)"
  if [ -n "$tok" ] && cf_auth_check; then return 0; fi
  say ""
  say "Cloudflare authorization is required (free account, no domain)."
  say "Run 'wearsic cloudflare login' — it opens the browser, you approve once, done."
  say "  Alternatives: login --wrangler, or login --token-stdin to paste an"
  say "  API token from https://dash.cloudflare.com/profile/api-tokens"
  if [ -t 0 ] && [ -t 1 ]; then
    say "  I'll start the browser login now."
    say ""
    cf_login || return 1
    return 0
  fi
  # Non-interactive context (Termux:Boot, scripts, remote shells): the
  # device flow needs no terminal input — it prints a link + code and
  # polls. Never hard-fail here; that is what left normal users with no
  # URL. Only if Cloudflare's bot protection blocks the device-code
  # endpoint do we fall back to instructions for a terminal.
  say "  No interactive terminal detected — starting the device login (a link"
  say "  and code will be printed above; approve it in any browser)."
  say ""
  cf_login --device
  local rc=$?
  if [ "$rc" -eq 0 ]; then
    return 0
  fi
  say "  If the device flow was blocked by Cloudflare's bot protection, run"
  say "  this in a terminal:  wearsic cloudflare login --browser"
  say "  (or save a scoped token:  wearsic cloudflare login --token-stdin)"
  say ""
  err "Cloudflare authorization did not complete."
  return 1
}

cf_logout() {
  installed
  if [ -s "$(cf_auth_file 2>/dev/null)" ]; then
    local rt
    rt="$(cf_auth_field refresh_token 2>/dev/null || true)"
    if [ -n "$rt" ]; then
      # Revoke the refresh token at Cloudflare. Best effort — a failed call
      # must never block the local cleanup.
      curl -sS --max-time 15 -A "$CF_UA" -X POST "$CF_OAUTH_REVOKE_URL" \
        --data-urlencode "token=$rt" -o /dev/null 2>/dev/null || true
    fi
    cf_auth_clear
    ok "Removed the refreshable OAuth session (refresh token revoked at Cloudflare)."
  else
    say "No OAuth session is stored"
  fi
  if [ -n "$(env_value CLOUDFLARE_API_TOKEN)" ]; then
    cf_env_unset CLOUDFLARE_API_TOKEN
    ok "Removed CLOUDFLARE_API_TOKEN from $ENV_FILE"
    say "Revoke it now: https://dash.cloudflare.com/profile/api-tokens"
  else
    say "No API token is stored in $ENV_FILE"
  fi
  if [ -n "$(printenv CLOUDFLARE_API_TOKEN 2>/dev/null || true)" ]; then
    warn "CLOUDFLARE_API_TOKEN is exported in this shell and is still active; unset it to log out completely."
  fi
  if cf_wrangler_available; then
    say "If you authorized with wrangler, revoke that session with: wrangler logout"
  fi
  say "The Worker and its permanent URL are left deployed; delete it in the dashboard if you want it gone."
  return 0
}

# --- Beginner-friendly preflight -------------------------------------------
# A public URL is useless without a key, but making the user stop and run
# another command is exactly the kind of setup friction that loses people.
# Generate a strong key ONLY when there is no saved key, and tell the user
# where to find it at the end. An existing key is never replaced.
cf_generate_api_key() {
  local k=""
  if command -v openssl >/dev/null 2>&1; then
    k="$(openssl rand -hex 24 2>/dev/null || true)"
  fi
  if [ -z "$k" ]; then
    k="$(LC_ALL=C tr -dc 'a-f0-9' < /dev/urandom 2>/dev/null \
      | dd bs=1 count=48 2>/dev/null)"
  fi
  case "$k" in
    ''|*[!a-f0-9]*) return 1 ;;
  esac
  [ "${#k}" -eq 48 ] || return 1
  printf '%s' "$k"
}

ensure_api_key() {
  local k
  k="$(api_key)"
  [ -n "$k" ] && return 0
  k="$(cf_generate_api_key)" || {
    die "No API key is set and one could not be generated. Set one: wearsic api-key <your-key>"
  }
  if ! write_env_key "$k"; then
    die "Could not save the new API key to $ENV_FILE"
  fi
  chmod 600 "$ENV_FILE" 2>/dev/null || true
  CF_API_KEY_CREATED=1
  ok "Created a private API key for the watch"
  dim "It will be shown when the URL is ready."
}

# Start the engine when needed instead of making "start the server first" a
# prerequisite. This is deliberately a small version of cmd_start: no
# pairing dump here; the Cloudflare setup ends with the URL + key together.
ensure_engine() {
  local i

  if health_ok && [ "${CF_API_KEY_CREATED:-0}" != "1" ]; then
    ok "Wearsic server is running"
    return 0
  fi

  if health_ok && [ "${CF_API_KEY_CREATED:-0}" = "1" ]; then
    say "Restarting Wearsic to apply the new API key…"
    cmd_stop >/dev/null 2>&1 || true
    # Do not start a second engine or claim the key is active while the old
    # process is still winding down. A successful setup must use the new key.
    for i in $(seq 1 15); do
      { health_ok || supervisor_running; } || break
      sleep 1
    done
    if health_ok || supervisor_running; then
      err "Wearsic did not stop cleanly while applying the new API key."
      say "Restart it, then retry: wearsic restart && wearsic cloudflare"
      return 1
    fi
  fi

  if ! health_ok; then
    if supervisor_running; then
      say "Waiting for the Wearsic server to finish starting…"
    else
      say "Starting the Wearsic server…"
      if command -v setsid >/dev/null 2>&1; then
        ( cd "$DEST" && setsid nohup bash "$RUN" >/dev/null 2>&1 </dev/null & )
      else
        ( cd "$DEST" && nohup bash "$RUN" >/dev/null 2>&1 </dev/null & )
      fi
    fi
    for i in $(seq 1 60); do
      health_ok && break
      sleep 1
    done
  fi

  if ! health_ok; then
    err "The Wearsic server did not start."
    say "Check its log: wearsic logs"
    return 1
  fi
  ok "Wearsic server is running"
}

# The final card is the whole point: both values the watch needs, together,
# on a screen that looks like onboarding instead of a server log.
cf_watch_box() {  # $1 = permanent URL
  local url="$1" key
  key="$(api_key)"
  # The exact URL first, as a plain line — copyable, never wrapped inside a
  # colored box on narrow screens.
  say ""
  say "  ${C_DIM}Your PERMANENT URL (exact):${C_RESET}"
  say "  ${C_ACC}${url}${C_RESET}"
  say "  ${C_DIM}Enter exactly this URL + the API key in Wearsic app → Settings.${C_RESET}"
  box_begin "ready for your watch" ok
  box_line ""
  box_line "   ${C_DIM}Server URL${C_RESET}"
  box_line "   ${C_ACC}${url}${C_RESET}"
  box_line ""
  box_line "   ${C_DIM}API key${C_RESET}"
  if [ -n "$key" ]; then
    box_line "   ${C_ACC}${key}${C_RESET}"
  else
    box_line "   ${C_WARN}not set — run: wearsic api-key <your-key>${C_RESET}"
  fi
  box_line ""
  box_hr
  box_line "   ${C_DIM}Wearsic app › Settings — enter both values.${C_RESET}"
  box_line "   ${C_DIM}The URL stays the same when the tunnel restarts.${C_RESET}"
  box_end
}

# --- Commands ---------------------------------------------------------------
cf_start() {
  local no_verify=0
  case "${1:-}" in
    "") : ;;
    --no-verify) no_verify=1 ;;
    *) die "Unknown option for 'wearsic cloudflare start': $1 (try --no-verify)" ;;
  esac

  installed
  if ! cf_worker_name >/dev/null; then
    die "${CF_LAST_ERROR:-invalid CLOUDFLARE_WORKER}"
  fi
  local src
  if ! src="$(cf_worker_src)"; then
    die "Worker source not found ($CF_WORKER_SRC_NAME) — reinstall the server with install.sh (or set CLOUDFLARE_WORKER_SRC)"
  fi

  # The permanent URL is public. Make the one-command path work even on a
  # fresh install: create a key only if none exists and start the engine if
  # it is not already running. Never overwrite an existing key.
  CF_API_KEY_CREATED=0
  ensure_api_key || return 1
  ensure_engine || return 1

  cf_ensure_auth || return 1
  local acc sub perm cfbin
  # A stale exported account/subdomain used to point the front door at a
  # different Cloudflare account than the install is configured for. Say it
  # out loud once, then use the installed configuration.
  local conflict
  conflict="$(cf_config_conflict CLOUDFLARE_ACCOUNT_ID)"
  [ -n "$conflict" ] && warn "$conflict"
  conflict="$(cf_config_conflict CLOUDFLARE_SUBDOMAIN)"
  [ -n "$conflict" ] && warn "$conflict"
  acc="$(cf_ensure_account)" || return 1
  sub="$(cf_ensure_subdomain "$acc")" || return 1
  perm="$(cf_permanent_url "$sub")" || die "${CF_LAST_ERROR:-invalid permanent URL}"
  cfbin="$(cf_ensure_cloudflared)" || return 1
  export PATH="$(dirname "$cfbin"):$PATH"

  # Two independent "already running" channels: the /proc scan AND the
  # lock. The scan alone once let a second `wearsic cloudflare` past it
  # (split-brain: two supervisors, one tunnel, one engine). The lock's
  # recorded pid is authoritative — if its holder is alive, someone owns
  # this install's front door no matter what /proc visibility says.
  local _lock_dir _lock_pid
  _lock_dir="$(cf_lock_dir)"
  _lock_pid="$(cat "$_lock_dir/pid" 2>/dev/null || true)"
  if [ -n "$(cf_pids)" ] || { [ -n "$_lock_pid" ] && kill -0 "$_lock_pid" 2>/dev/null; }; then
    say "Already running — permanent URL:"
    say "  $perm"
    if [ "$no_verify" -eq 1 ]; then
      cf_watch_box "$perm"
      return 0
    fi
    if cf_verify "$perm"; then
      say ""
      cf_watch_box "$perm"
      return 0
    fi
    # A failing verify is not always a dead tunnel (a bad
    # WEARSIC_CF_PLAYBACK_ID, for example). Probe the front door once more:
    # only an unreachable /health warrants intervention.
    if cf_health_ok "$perm/health" 20; then
      return 1
    fi
    # The supervisor is alive but the front door is down. Before tearing it
    # down, ask whether it is still WORKING: every fresh generation mints a
    # NEW quick tunnel, and repeated mints are exactly what trips Cloudflare's
    # rate limit (HTTP 429, "error code: 1015") — after which no tunnel can
    # be created at all for a while. The state file is rewritten on every
    # retry cycle, so a recently-touched state/log means the supervisor is
    # mid-retry: wait WITH it instead of restarting it.
    local _idle
    _idle="$(cf_supervisor_idle)"
    case "$_idle" in ''|*[!0-9]*) _idle=999999 ;; esac
    if [ "$_idle" -le 600 ]; then
      say "The tunnel supervisor is already retrying on its own — waiting with it…"
      shim_wait "Cloudflare  waiting for the tunnel (the supervisor is retrying)…" 900 \
        cf_state_settled "Cloudflare  waiting for the tunnel…"
      local _st _err
      _st="$(cf_state_get status || true)"
      case "$_st" in
        live)
          say ""
          if cf_verify "$perm"; then
            say ""
            cf_watch_box "$perm"
            return 0
          fi
          return 1
          ;;
        error)
          _err="$(cf_state_get last_error || true)"
          say ""
          say "The tunnel supervisor stopped with an error:"
          [ -n "$_err" ] && say "  $_err"
          tail -20 "$(cf_log_file)" 2>/dev/null | sed 's/^/  /'
          return 1
          ;;
        *)
          _err="$(cf_state_get last_error || true)"
          say ""
          say "Still down — the supervisor keeps retrying in the background."
          [ -n "$_err" ] && say "  $_err"
          say "Check progress:  wearsic cloudflare status"
          say "Rerunning 'wearsic cloudflare' will not speed it up: it waits with the"
          say "running supervisor instead of restarting it, so the rate limit recovers."
          return 1
          ;;
      esac
    fi
    # The supervisor has gone quiet (no state or log activity for 10+
    # minutes) while the front door is down: it is wedged, not retrying. A
    # tunnel that survived a CLI upgrade (or a network change) keeps its old
    # socket/DNS state, which only a fresh generation can fix. Stop it and
    # fall through to a clean start.
    warn "The supervisor is running, but the public URL is unreachable and it has gone quiet — restarting the tunnel…"
    cf_cloudflare_stop >/dev/null 2>&1 || true
  fi

  cf_state_clear
  cf_state_write starting "$sub" "$perm" "" "" "starting" "$acc"

  say "Starting the Cloudflare tunnel + the permanent Worker front door…"
  local cli="$CLI_DIR/wearsic"
  local child_env=(env "WEARSIC_DIR=$DEST")
  if command -v setsid >/dev/null 2>&1; then
    ( cd "$DEST" && "${child_env[@]}" setsid nohup bash "$cli" __cf_supervise "$(port)" "$DEST" >/dev/null 2>&1 </dev/null & )
  else
    ( cd "$DEST" && "${child_env[@]}" nohup bash "$cli" __cf_supervise "$(port)" "$DEST" >/dev/null 2>&1 </dev/null & )
  fi

  # Wait for a REAL "live" state: the state file is written only after the
  # tunnel answers /health and Cloudflare accepts the Worker upload. A stale
  # URL from a previous run can therefore never be reported as success.
  local st err
  shim_wait "Cloudflare  waiting for the tunnel + the Worker front door" 240 cf_state_settled "Cloudflare  waiting for the tunnel…"
  st="$(cf_state_get status || true)"
  if [ "$st" != "live" ]; then
    err="$(cf_state_get last_error || true)"
    say ""
    say "The front door did not come up yet."
    [ -n "$err" ] && say "  $err"
    case "$err" in
      *"429"*|*rate-limit*)
        say ""
        say "Cloudflare rate-limits quick-tunnel creation per network. The supervisor"
        say "keeps retrying on its own (backoff grows to ~5 minutes between attempts)"
        say "and will bring the URL up when the limit clears — no action needed."
        say "Check progress:  wearsic cloudflare status"
        say "Rerunning 'wearsic cloudflare' will NOT speed it up: it waits with the"
        say "running supervisor instead of restarting it, so the limit can recover."
        return 1
        ;;
      *)
        tail -20 "$(cf_log_file)" 2>/dev/null | sed 's/^/  /'
        die "Cloudflare setup failed (the supervisor may still be retrying — check: wearsic cloudflare status)"
        ;;
    esac
  fi

  say ""
  say "  PERMANENT URL   $perm"
  say "  current tunnel  $(cf_state_get origin || echo '?')"

  if [ "$no_verify" -eq 1 ]; then
    say ""
    cf_watch_box "$perm"
    return 0
  fi
  say ""
  if cf_verify "$perm"; then
    say ""
    cf_watch_box "$perm"
    return 0
  fi
  say ""
  say "The URL is deployed, but end-to-end verification failed."
  say "The supervisor keeps retrying; check: wearsic cloudflare status"
  return 1
}

cf_cloudflare_status() {
  local u status origin deployed err health_code auth_code
  u="$(cf_state_get url || true)"
  if [ -z "$u" ]; then
    say "Not running — start it:  wearsic cloudflare"
    return 1
  fi
  status="$(cf_state_get status || true)"
  origin="$(cf_state_get origin || true)"
  deployed="$(cf_state_get deployed_origin || true)"
  err="$(cf_state_get last_error || true)"

  say "Permanent URL  $u"
  say "Status         ${status:-unknown}"
  [ -n "$origin" ] && say "Tunnel origin  $origin"
  [ -n "$deployed" ] && say "Deployed to    $deployed"
  if [ -n "$origin" ] && [ -n "$deployed" ] && [ "$origin" != "$deployed" ]; then
    warn "The Worker still points at the previous tunnel; the supervisor is retrying."
  fi
  [ -n "$err" ] && say "Last error     $err"
  if [ -n "$(cf_pids)" ]; then
    say "Supervisor     running"
  else
    say "Supervisor     NOT running"
    case "$status" in
      stopped) : ;;
      *) say "               the URL is dead until: wearsic cloudflare" ;;
    esac
  fi

  health_code="$(cf_http_code "$u/health" 15)"
  if [ "$health_code" = "200" ]; then
    say "Health         200 OK through the permanent URL"
  else
    say "Health         no response (${health_code:-none}) through the permanent URL"
  fi

  auth_code=""
  if [ -n "$(api_key)" ]; then
    auth_code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 20 \
        -H "X-Wearsic-Key: $(api_key)" "$u$CF_PROBE_PATH" 2>/dev/null || true)"
    case "$auth_code" in
      200) say "Auth           API key accepted through the permanent URL" ;;
      401) say "Auth           API key REJECTED through the permanent URL" ;;
      *)   say "Auth           no answer (${auth_code:-none}) through the permanent URL" ;;
    esac
  else
    say "Auth           not configured — a public URL requires an API key"
  fi

  # Exit 0 only for a genuinely healthy front door: live state, the
  # supervisor still watching it, and successful auth. A stale state file or
  # an orphaned tunnel must never look like success.
  [ "$status" = "live" ] && [ "$health_code" = "200" ] && [ -n "$(cf_pids)" ] || return 1
  [ -n "$auth_code" ] && [ "$auth_code" = "200" ] || return 1
  return 0
}

cf_show_logs() {
  installed
  local f; f="$(cf_log_file)"
  [ -f "$f" ] || { say "No log yet — start it: wearsic cloudflare"; return 1; }
  case "${1:-}" in
    -f|--follow) tail -n 40 -f "$f" ;;
    *) tail -n 40 "$f" ;;
  esac | sed -E 's/(Bearer )[A-Za-z0-9._-]+/\1<redacted>/g; s/(CLOUDFLARE_API_TOKEN=)[^[:space:]]+/\1<redacted>/g; s/(X-Wearsic-Key: )[^[:space:]]+/\1<redacted>/g'
}

cf_cloudflare_stop() {
  local pids; pids="$(cf_pids)"
  if [ -z "$pids" ]; then
    cf_state_set_status stopped
    say "Not running."
    return 0
  fi
  say "Stopping…"
  local pid i
  for pid in $pids; do
    # The supervisor's EXIT trap kills its own cloudflared. Signal the
    # supervisor first so an unrelated cloudflared tunnel is never touched.
    kill -TERM "$pid" 2>/dev/null || true
  done
  for i in $(seq 1 15); do
    [ -z "$(cf_pids)" ] && break
    sleep 1
  done
  for pid in $pids; do
    cf_kill_tree_all "$pid"
  done
  cf_lock_release
  cf_state_set_status stopped
  say "Stopped. The Worker and its permanent URL remain deployed on Cloudflare."
}

cmd_cloudflare() {
  local sub_cmd="start"
  case "${1:-}" in
    start|status|stop|url|login|logout|logs|verify) sub_cmd="$1"; shift ;;
    "") : ;;
    -h|--help) sub_cmd="help" ;;
    *) die "Unknown option for 'wearsic cloudflare': $1 (try: wearsic cloudflare [start|status|verify|url|logs|login|logout|stop])" ;;
  esac

  case "$sub_cmd" in
    help)
      say "wearsic cloudflare — a PERMANENT public URL, free, no domain needed."
      say ""
      say "  start      one-command setup (default): start the engine, create a"
      say "             key only if needed, authorize, deploy, verify, show the"
      say "             permanent URL + API key together"
      say "  status     permanent URL, supervisor state, live health + auth check"
      say "  verify     prove auth + Range/206 streaming through the permanent URL"
      say "  url        print just the permanent URL (for scripting)"
      say "  logs [-f]  recent supervisor activity (secrets redacted)"
      say "  login      authorize Cloudflare in your browser: one approval, no"
      say "             token copy-paste; the session refreshes itself and never"
      say "             goes stale. Flags: --browser (PKCE flow), --device,"
      say "             --wrangler, --token-stdin (paste an API token)"
      say "  logout     remove the saved credentials (Worker stays deployed)"
      say "  stop       stop the tunnel and supervisor (Worker stays deployed)"
      say ""
      say "Needs a free Cloudflare account. Start:  wearsic cloudflare"
      return 0
      ;;
  esac

  installed

  case "$sub_cmd" in
    status) cf_cloudflare_status; return $? ;;
    verify)
      local u pid
      u="$(cf_state_get url || true)"
      [ -n "$u" ] || die "No permanent URL yet — start it: wearsic cloudflare"
      pid="${1:-}"
      case "$pid" in --playback) pid="${2:-}" ;; esac
      cf_verify "$u" "$pid"
      return $?
      ;;
    url)
      local u; u="$(cf_state_get url || true)"
      [ -n "$u" ] || die "No permanent URL yet — start it: wearsic cloudflare"
      printf '%s\n' "$u"
      return 0
      ;;
    logs) cf_show_logs "${1:-}"; return $? ;;
    login) cf_login "${1:-auto}"; return $? ;;
    logout) cf_logout; return 0 ;;
    stop) cf_cloudflare_stop; return 0 ;;
    start) cf_start "${1:-}"; return $? ;;
  esac
}

cmd_public() {
  installed
  # Public exposure without authentication is refused outright — same rule
  # as `wearsic server funnel`. This menu never invents or changes a key;
