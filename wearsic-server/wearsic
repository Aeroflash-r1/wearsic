# ── crash-safe update ─────────────────────────────────────────────────────
# Downloads the latest release, VERIFIES its published SHA-256, stages and
# validates it, swaps it in with a kept rollback copy, restarts and health-
# checks. On ANY failure the previous engine is restored — a failed update
# can never leave a broken server. Your database, .env (API key), downloads/
# and wearsic-state/ are never touched.
#
# Overrides (mainly for testing/mirrors): WEARSIC_ZIP_URL, WEARSIC_SHA_URL,
# WEARSIC_REPO, WEARSIC_UPDATE_TIMEOUT (health wait seconds, default 60).
# Echoes the newest release ZIP url from the release LIST, INCLUDING
# pre-releases. $1 = repo slug. Empty output = nothing installable.
#
# releases?per_page=10 is newest-first and includes pre-releases (and drafts,
# but a draft has no published assets). Rather than correlating
# tag_name/draft/assets across JSON objects with grep — which is exactly the
# class of bug the old funnel command had — this probes each tag's
# PREDICTABLE asset url and takes the first that actually exists. A draft, or
# a release shipping no server package, simply 404s and is skipped.
resolve_pre_zip_url() {
  local repo="$1" json t code u
  json="$(curl -fsSL --retry 2 "https://api.github.com/repos/${repo}/releases?per_page=10" 2>/dev/null || true)"
  [ -n "$json" ] || return 0
  for t in $(printf '%s' "$json" \
    | grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' \
    | sed -E 's/.*"([^"]*)"$/\1/'); do
    [ -n "$t" ] || continue
    u="https://github.com/${repo}/releases/download/${t}/wearsic-server-termux-${t}.zip"
    code="$(curl -sI -L -o /dev/null -m 20 -w '%{http_code}' "$u" 2>/dev/null || printf '000')"
    [ "$code" = "200" ] && { printf '%s' "$u"; return 0; }
  done
  return 0
}

cmd_update() {
  installed
  local repo work zip sha expected actual stage src ztag=""

  # `wearsic update [--pre]`. GitHub's releases/latest endpoint EXCLUDES
  # pre-releases, so a beta build (e.g. v1.6.1) is invisible to a plain
  # `wearsic update` — it silently keeps serving v1.6.0. --pre is the
  # explicit opt-in that walks the release LIST instead, so ordinary users
  # stay on stable and testers can pull a beta on demand.
  local include_pre=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --pre|-p) include_pre=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) die "Unknown option for 'wearsic update': $1 (valid: --pre)" ;;
    esac
  done
  [ "$include_pre" = "1" ] && say "Including pre-releases (--pre)."

  repo="${WEARSIC_REPO:-Aeroflash-r1/wearsic}"
  # The EXIT trap below must outlive this function, so the path lives in a
  # GLOBAL: `work` is a local of THIS function, and by the time a normal-exit
  # trap runs it is out of scope — `${work:-}` expanded EMPTY, `rm -rf ""`
  # was a silent no-op, and every update leaked its staging dir (download +
  # unpacked tree, tens of MB) into $TMPDIR. (A bare "$work" also tripped
  # `set -u` with "work: unbound variable" after every successful update.)
  UPDATE_WORK="$(mktemp -d)" || die "could not create a temp dir"
  work="$UPDATE_WORK"
  # The global EXIT trap (installed at startup) removes the staging dir —
  # and restores the cursor — even when die() exits mid-update.

  say "${C_DIM}checking the latest release…${C_RESET}"
  local zip_url sha_url json tag
  zip_url="${WEARSIC_ZIP_URL:-}"
  sha_url="${WEARSIC_SHA_URL:-}"
  if [ -z "$zip_url" ] && [ "$include_pre" = "1" ]; then
    zip_url="$(resolve_pre_zip_url "$repo")"
    [ -n "$zip_url" ] || die "no release with a server package was found for ${repo} — check your internet connection"
    # Print the bare tag (e.g. "v1.6.2"), not the asset filename.
    local chosen="${zip_url##*/}"
    chosen="${chosen#wearsic-server-termux-}"; chosen="${chosen%.zip}"
    say "Newest release (incl. pre-releases): $chosen"
  fi
  if [ -z "$zip_url" ]; then
    json="$(curl -fsSL --retry 2 "https://api.github.com/repos/${repo}/releases/latest" 2>/dev/null || true)"
    zip_url="$(printf '%s' "$json" \
      | grep -o '"browser_download_url"[^"]*"[^"]*wearsic-server-termux[^"]*\.zip"' \
      | head -1 \
      | sed -E 's/.*"(https[^"]*)".*/\1/')"
    if [ -z "$zip_url" ]; then
      tag="$(printf '%s' "$json" | grep -o '"tag_name"[^"]*"[^"]*"' | head -1 | sed -E 's/.*"([^"]*)"$/\1/')"
      [ -n "$tag" ] && zip_url="https://github.com/${repo}/releases/latest/download/wearsic-server-termux-${tag}.zip"
    fi
    [ -n "$zip_url" ] || die "could not find a release for ${repo} — check your internet connection"
  fi
  [ -n "$sha_url" ] || sha_url="${zip_url}.sha256"
  ztag="$(printf '%s' "$zip_url" | sed -nE 's/.*wearsic-server-termux-([^/]+)\.zip$/\1/p' | head -1)"
  [ -n "$ztag" ] && say "newest release: ${C_ACC}${ztag}${C_RESET}"

  zip="$work/update.zip"
  sha="$work/update.zip.sha256"
  local zname; zname="$(basename "$zip_url")"
  shim_stage_begin "Download" "$zname"
  shim_fetch_start "$zip_url" "$zip" "Download  fetching $zname"
  SHIM_PROGRESS_HOOK=shim_fetch_progress
  shim_animate "$SHIM_FETCH_PID"
  local fetch_rc=0
  shim_fetch_wait || fetch_rc=$?
  if [ "$fetch_rc" != "0" ]; then
    SHIM_PROGRESS_HOOK=""
    if [ "$fetch_rc" = "124" ]; then
      shim_stage_end fail "the download stalled — nothing was changed"
      die "the download stalled (the connection stopped delivering data) — nothing was changed; retry when the network is steadier"
    fi
    shim_stage_end fail "the download failed — nothing was changed"
    die "download failed — nothing was changed"
  fi
  SHIM_PROGRESS_HOOK=""
  if [ ! -s "$zip" ]; then
    shim_stage_end fail "the downloaded file is empty"
    die "downloaded file is empty — nothing was changed"
  fi
  shim_stage_end ok "$zname"

  # Authenticity: refuse to install any release without a published checksum.
  shim_stage_begin "Verify" "checksum"
  if ! curl -fsSL --retry 2 -o "$sha" "$sha_url" 2>/dev/null || [ ! -s "$sha" ]; then
    shim_stage_end fail "no SHA-256 checksum"
    die "no SHA-256 checksum at $sha_url — refusing to install unverified code"
  fi
  expected="$(awk '{print $1; exit}' "$sha" | tr 'A-F' 'a-f')"
  if command -v sha256sum >/dev/null 2>&1; then
    actual="$(sha256sum "$zip" | awk '{print $1}')"
  else
    actual="$(shasum -a 256 "$zip" | awk '{print $1}')"
  fi
  if [ "$expected" != "$actual" ]; then
    shim_stage_end fail "SHA-256 mismatch"
    die "SHA-256 MISMATCH — the download is corrupt or tampered. Nothing was changed."
  fi
  shim_stage_end ok "SHA-256 verified"

  # Stage + validate BEFORE touching the active engine.
  stage="$work/stage"
  mkdir -p "$stage"
  shim_stage_begin "Install" "extracting"
  if ! unzip -t "$zip" >/dev/null 2>&1; then
    shim_stage_end fail "the downloaded file is not a valid ZIP"
    die "the downloaded file is not a valid ZIP — nothing was changed"
  fi
  if ! unzip -oq "$zip" -d "$stage"; then
    shim_stage_end fail "could not extract the update"
    die "could not extract the update — nothing was changed"
  fi
  src="$stage/wearsic-server"
  [ -d "$src" ] || src="$stage"
  [ -f "$src/bin/wearsic-server" ] && [ -n "$(ls -A "$src/lib" 2>/dev/null)" ] && [ -f "$src/run-termux.sh" ] \
    && [ -f "$src/wearsic-cloudflare-worker.js" ] \
    || die "the update package is incomplete (bin/lib/run-termux.sh/worker) — nothing was changed"
  ok "update package validated"

  # Was it running? Update should end with the server back up if it was.
  local was_running=0
  if server_running || supervisor_running; then was_running=1; fi
  [ "$was_running" = "1" ] && { say "Stopping the server for the swap…"; cmd_stop; }

  # Crash-safe swap: prepare COMPLETE copies first, keep the old engine as
  # bin.prev/lib.prev until the new one passes its health check.
  shim_stage_status "swapping the engine in"
  rm -rf "$DEST/bin.new" "$DEST/lib.new"
  cp -r "$src/bin" "$DEST/bin.new" && cp -r "$src/lib" "$DEST/lib.new" \
    || { rm -rf "$DEST/bin.new" "$DEST/lib.new"; die "could not stage the new engine (disk full?) — the current engine is untouched"; }
  rm -rf "$DEST/bin.prev" "$DEST/lib.prev"
  if [ -d "$DEST/bin" ]; then
    mv "$DEST/bin" "$DEST/bin.prev" && mv "$DEST/lib" "$DEST/lib.prev" \
      || { rm -rf "$DEST/bin.new" "$DEST/lib.new"; die "swap failed — the current engine is untouched"; }
  fi
  if ! mv "$DEST/bin.new" "$DEST/bin" || ! mv "$DEST/lib.new" "$DEST/lib" || [ ! -f "$DEST/bin/wearsic-server" ]; then
    # Half-swapped: restore the previous known-good engine immediately.
    rm -rf "$DEST/bin" "$DEST/lib"
    [ -d "$DEST/bin.prev" ] && mv "$DEST/bin.prev" "$DEST/bin"
    [ -d "$DEST/lib.prev" ] && mv "$DEST/lib.prev" "$DEST/lib"
    die "the swap did not complete — the previous engine was restored"
  fi
  # The tunnel binary is NOT part of the engine release (its bin/ ships the
  # engine only): a plain swap would delete cloudflared and every supervisor
  # launch afterwards would die on a missing binary while minting hostnames
  # (live outage 2026-10-22). Keep the old one when the new bin/ lacks it.
  if [ -x "$DEST/bin.prev/cloudflared" ] && [ ! -e "$DEST/bin/cloudflared" ]; then
    cp -f "$DEST/bin.prev/cloudflared" "$DEST/bin/cloudflared" 2>/dev/null \
      && chmod 0755 "$DEST/bin/cloudflared" 2>/dev/null \
      && dim "kept the tunnel binary (cloudflared) across the engine swap"
  fi
  for f in run-termux.sh .env.example README.md wearsic-cloudflare-worker.js; do
    [ -f "$src/$f" ] || continue
    if [ "$f" = "run-termux.sh" ]; then
      replace_file "$src/$f" "$DEST/$f"   # may be executing (supervisor)
    else
      cp "$src/$f" "$DEST/$f"             # plain data files
    fi
  done
  chmod +x "$DEST/run-termux.sh" "$DEST/bin/wearsic-server" 2>/dev/null || true
  # Fingerprint of the engine we just installed: after the restart we check
  # the ON-DISK engine still matches it, so an (auto)rollback by the
  # supervisor can never masquerade as a successful update.
  local new_hash
  new_hash="$(file_hash "$DEST/bin/wearsic-server")"

  # Refresh the CLI copy(s) — the code only, never config. replace_file:
  # one of these copies is usually the script THIS process is running
  # (invoked via PATH), and a plain `cp` over it truncates the file bash is
  # still reading — the "syntax error / unexpected EOF" users hit right
  # after "✓ update complete".
  local bindir
  for bindir in "${PREFIX:-/nonexistent}/bin" "$HOME/.local/bin" "$HOME/bin"; do
    if [ -f "$bindir/wearsic" ] && [ -f "$src/wearsic" ]; then
      replace_file "$src/wearsic" "$bindir/wearsic" && chmod +x "$bindir/wearsic"
    fi
  done
  [ -f "$src/wearsic" ] && replace_file "$src/wearsic" "$DEST/wearsic" && chmod +x "$DEST/wearsic" 2>/dev/null
  shim_stage_end ok "engine installed (the previous one is kept for rollback)"

  # Bring it up and PROVE it is healthy; otherwise roll back.
  local timeout i
  timeout="${WEARSIC_UPDATE_TIMEOUT:-60}"
  shim_stage_begin "Start" "the updated server"
  if [ "$was_running" = "1" ]; then
    shim_stage_status "starting the updated server"
  else
    shim_stage_status "the server was stopped — starting it briefly to validate the update"
  fi
  cmd_start >/dev/null 2>&1 || true
  shim_wait "Start  waiting for the updated server" "$timeout" "health_ok" || true

  if health_ok && [ "$(file_hash "$DEST/bin/wearsic-server")" = "$new_hash" ]; then
    rm -rf "$DEST/bin.prev" "$DEST/lib.prev"
    shim_stage_end ok "server healthy on port $(port)"
    printf '\n'
    box_begin "✓ updated" ok
    box_line ""
    [ -n "$ztag" ] && box_line "   ${C_DIM}release ${ztag}${C_RESET}"
    box_line "   ${C_DIM}the watch keeps playing — the engine switches${C_RESET}"
    box_line "   ${C_DIM}on its next request.${C_RESET}"
    box_line ""
    box_end
    [ "$was_running" = "1" ] || { cmd_stop >/dev/null 2>&1; say "Server stopped again (it was not running before the update)."; }
    return 0
  fi

  # Healthy but NOT the engine we installed: the supervisor's own
  # never-healthy rollback already restored the previous engine.
  if health_ok; then
    shim_stage_end fail "the new engine failed to start"
    warn "the new engine failed to start — the previous engine was restored automatically"
    warn "update rolled back — the server is running the previous version"
    return 1
  fi

  # New engine never became healthy — roll back to the previous one.
  # NOTE: the supervisor may have already rolled back by itself (its own
  # never-healthy rollback consumes bin.prev). Check BEFORE deleting
  # anything, so a restored good engine can never be destroyed here.
  shim_stage_end fail "the updated server did not become healthy"
  warn "the updated server did not become healthy — rolling back…"
  cmd_stop >/dev/null 2>&1 || true
  if [ -d "$DEST/bin.prev" ]; then
    rm -rf "$DEST/bin" "$DEST/lib"
    mv "$DEST/bin.prev" "$DEST/bin"
    mv "$DEST/lib.prev" "$DEST/lib"
    chmod +x "$DEST/bin/wearsic-server" 2>/dev/null
    ok "previous engine restored"
    cmd_start >/dev/null 2>&1 || true
    i=0
    while [ "$i" -lt "$timeout" ]; do
      health_ok && break
      i=$((i + 1))
      sleep 1
    done
    if health_ok; then
      warn "update rolled back — the server is running the previous version"
    else
      warn "rollback restored the files but the server is not healthy — see: wearsic logs"
    fi
  elif [ -f "$DEST/bin/wearsic-server" ]; then
    ok "the previous engine is already in place (supervisor rolled back)"
    cmd_start >/dev/null 2>&1 || true
  else
    warn "no rollback copy existed — run the installer again:"
    warn "  curl -fsSL https://raw.githubusercontent.com/Aeroflash-r1/wearsic/main/install.sh | bash"
  fi
  return 1
}

# ── watch app sideload ─────────────────────────────────────────────────────
# `wearsic sideload [tag]` downloads a RELEASED watch APK from GitHub and
# installs it with adb. Releases since 1.9.0 publish a .sha256 next to the
# APK; when it exists it MUST match — a corrupt download never reaches the
# watch. Older releases have no checksum: that warns and continues.
# `--apk FILE` installs a local build (no network), `--device SERIAL`
# picks the target when several adb devices are attached, and
# `--download-only` fetches the APK and stops before adb.
cmd_sideload() {
  local repo tag apk device download_only=0
  repo="${WEARSIC_REPO:-Aeroflash-r1/wearsic}"
  tag=""; apk=""; device=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --apk) [ -n "${2:-}" ] || die "--apk needs a file path"; apk="$2"; shift 2 ;;
      --device|-s) [ -n "${2:-}" ] || die "--device needs an adb serial (see: adb devices)"; device="$2"; shift 2 ;;
      --download-only) download_only=1; shift ;;
      -h|--help) usage; return 0 ;;
      v[0-9]*) tag="$1"; shift ;;
      *) die "Unknown option for 'wearsic sideload': $1 (try: wearsic sideload [vX.Y.Z] [--apk FILE] [--device SERIAL] [--download-only])" ;;
    esac
  done
  brand "sideload"
  section "Watch app"

  if [ -n "$apk" ]; then
    [ -f "$apk" ] || die "APK not found: $apk"
    say "Using the local build $(basename "$apk")"
  else
    if [ -z "$tag" ]; then
      local json
      say "Looking up the latest release…"
      json="$(curl -fsSL --retry 2 "https://api.github.com/repos/${repo}/releases/latest" 2>/dev/null || true)"
      tag="$(printf '%s' "$json" | grep -o '"tag_name"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed -E 's/.*"([^"]*)"$/\1/')"
      [ -n "$tag" ] || die "could not reach GitHub for ${repo} — check your internet connection"
    fi
    local base cache url sha_url sha_file expected actual
    base="https://github.com/${repo}/releases/download/${tag}"
    url="${base}/Wearsic-${tag}.apk"
    sha_url="${url}.sha256"
    cache="${WEARSIC_APK_CACHE:-$HOME/.cache/wearsic}"
    mkdir -p "$cache" || die "could not create $cache"
    apk="$cache/Wearsic-${tag}.apk"
    say "Release ${C_BOLD}${tag}${C_RESET}"
    if [ -s "$apk" ]; then
      say "Using the cached download (delete it to fetch again: rm \"$apk\")"
    else
      download_bar "$url" "$apk" "downloading Wearsic-${tag}.apk" \
        || { rm -f "$apk"; die "download failed — is ${tag} a Wearsic release?"; }
    fi
    # Published checksum. Missing (pre-1.9.0 releases): warn and continue.
    # Present: a mismatch deletes the file so a retry downloads it again.
    sha_file="$cache/Wearsic-${tag}.apk.sha256"
    [ -s "$sha_file" ] || curl -fsSL --retry 2 -o "$sha_file" "$sha_url" 2>/dev/null || rm -f "$sha_file"
    if [ -s "$sha_file" ]; then
      expected="$(awk 'NR==1 { print $1 }' "$sha_file")"
      actual="$(sha256sum "$apk" 2>/dev/null | awk '{ print $1 }')"
      if [ -z "$expected" ] || [ "$expected" != "$actual" ]; then
        rm -f "$apk" "$sha_file"
        die "checksum mismatch — the download is corrupt; run the command again"
      fi
      ok "APK checksum verified"
    else
      warn "this release ships no APK checksum — skipping verification"
    fi
  fi

  if [ "$download_only" = "1" ]; then
    ok "saved $(basename "$apk")"
    say "Install it later with: wearsic sideload --apk \"$apk\""
    return 0
  fi

  command -v adb >/dev/null 2>&1 \
    || die "adb is not installed — in Termux run: pkg install android-tools"
  local devices serial count model
  devices="$(adb devices 2>/dev/null | awk 'NR > 1 && $2 == "device" { print $1 }')"
  if [ -n "$device" ]; then
    serial="$device"
    printf '%s\n' "$devices" | grep -qx "$serial" \
      || die "adb device $serial is not connected (check: adb devices)"
  else
    count="$(printf '%s\n' "$devices" | grep -c .)"
    if [ "$count" = "1" ]; then
      serial="$devices"
    elif [ "$count" = "0" ]; then
      err "no watch is connected over adb"
      say "  1. On the watch: Settings → System → Developer options → Wireless debugging → ON"
      say "  2. Pair — a code appears on the watch:  adb pair <watch-ip>:<pair-port>"
      say "  3. Connect:                             adb connect <watch-ip>:<port>"
      say "  4. Run this command again."
      exit 1
    else
      err "several adb devices are connected:"
      printf '%s\n' "$devices" | sed 's/^/      /'
      say "Pick one: wearsic sideload --device <serial>"
      exit 1
    fi
  fi
  model="$(adb -s "$serial" shell getprop ro.product.model 2>/dev/null | tr -d '\r' | head -1)"
  [ -n "$model" ] && kv "device" "$model ($serial)"

  local out
  if out="$(adb -s "$serial" install -r "$apk" 2>&1)" && printf '%s' "$out" | grep -q "Success"; then
    ok "installed $(basename "$apk")"
  else
    case "$out" in
      *INSTALL_FAILED_UPDATE_INCOMPATIBLE*)
        err "signature mismatch — a different build (e.g. the debug APK) is installed on the watch"
        say "Remove it first (this clears watch-side app data):"
        say "  adb -s $serial uninstall com.wearsic.app"
        say "Then run this command again."
        exit 1 ;;
      *INSTALL_FAILED_VERSION_DOWNGRADE*)
        err "the watch already runs a newer build than ${tag:-this APK}"
        say "To force it anyway: adb -s $serial install -r -d \"$apk\""
        exit 1 ;;
      *)
        err "adb install failed:"
        printf '%s\n' "$out" | sed 's/^/      /'
        exit 1 ;;
    esac
  fi
  local onwatch
  onwatch="$(adb -s "$serial" shell dumpsys package com.wearsic.app 2>/dev/null \
    | awk -F= '/versionName=/ { print $2; exit }' | tr -d '\r')"
  [ -n "$onwatch" ] && kv "on watch" "$onwatch"
  return 0
}

# Send the server address + API key straight to the watch app over adb —
# no typing a 24-character address (and a secret) on a 1.4" keyboard.
#
# File contract with the watch app (imported on next launch, then deleted):
#   /sdcard/Android/data/com.wearsic.app/files/wearsic-pairing.env
#     WEARSIC_SERVER_URL=<url>
#     WEARSIC_API_KEY=<key>      (empty value clears the stored key)
#
# The address is probed (/health) BEFORE it reaches the watch: "can't
# connect" after pairing is nearly always a stopped server or a funnel that
# is not actually serving, and this command is the last moment the user is
# looking at a keyboard. --skip-check overrides.
cmd_pair() {
  installed
  local url="" mode="lan" device="" skip_check=0 restart=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --funnel) mode="funnel"; shift ;;
      --lan)    mode="lan"; shift ;;
      --device|-s) [ -n "${2:-}" ] || die "--device needs an adb serial (see: adb devices)"; device="$2"; shift 2 ;;
      --skip-check) skip_check=1; shift ;;
      --restart) restart=1; shift ;;
      -h|--help) usage; return 0 ;;
      http://*|https://*) url="$1"; shift ;;
      *) die "Unknown option for 'wearsic pair': $1 (try: wearsic pair [URL] [--funnel|--lan] [--device SERIAL])" ;;
    esac
  done
  brand "pair"
  section "Watch pairing"

  # 1. Which address will the watch get?
  if [ -z "$url" ]; then
    if [ "$mode" = "funnel" ]; then
      url="$(funnel_url)"
      if [ -z "$url" ]; then
        if ! command -v tailscale >/dev/null 2>&1; then
          die "Tailscale is not installed — set up the public URL first: wearsic funnel"
        fi
        die "Could not read the funnel URL (logged out?) — run: wearsic funnel"
      fi
    else
      url="$(server_url)"
      if [ -z "$url" ]; then
        err "couldn't detect this phone's Wi-Fi IP (Wi-Fi may still be on)"
        say "  1. save it once:                       wearsic ip 192.168.x.y"
        say "  2. pair through the internet instead:  wearsic pair --funnel"
        say "  3. or pass the address yourself:        wearsic pair http://<host>:<port>"
        exit 1
      fi
    fi
  fi
  url="${url%/}"
  case "$url" in
    *[[:space:]]*) die "the address must not contain spaces: $url" ;;
    http://[!/]*|https://[!/]*) : ;;
    *) die "the address must look like http://host:port — got: $url" ;;
  esac

  # 2. The key. A funnel address is public — same rule as cmd_funnel.
  local key; key="$(api_key)"
  if [ "$mode" = "funnel" ] && [ -z "$key" ]; then
    die "The funnel address is public — set an API key first:  wearsic api-key <your-key>"
  fi
  if [ -n "$key" ] && [ "${#key}" -lt 8 ]; then
    die "the watch app rejects API keys shorter than 8 characters — set a longer one: wearsic api-key <new>"
  fi

  # 3. adb first — fail fast before any network probing.
  command -v adb >/dev/null 2>&1 \
    || die "adb is not installed — in Termux run: pkg install android-tools"

  # 4. Prove the address answers from this phone BEFORE it reaches the watch.
  if [ "$skip_check" = "0" ]; then
    local probe_timeout=8
    case "$url" in https://*) probe_timeout=15 ;; esac
    say "Checking $url/health …"
    if curl -fsS -m "$probe_timeout" "$url/health" >/dev/null 2>&1; then
      ok "the server answers at $url"
    else
      err "no answer from $url/health"
      case "$url" in
        https://*)
          say "  ▸ is the server running?   wearsic start"
          say "  ▸ is the funnel enabled?   wearsic funnel"
          say "  ▸ HTTPS certs on for your tailnet?  login.tailscale.com/admin/dns" ;;
        *)
          say "  ▸ is the server running?   wearsic start" ;;
      esac
      say "Override the check with:  wearsic pair --skip-check"
      exit 1
    fi
  fi

  # 5. Pick the watch (same rules as sideload).
  local devices serial count model
  devices="$(adb devices 2>/dev/null | awk 'NR > 1 && $2 == "device" { print $1 }')"
  if [ -n "$device" ]; then
    serial="$device"
    printf '%s\n' "$devices" | grep -qx "$serial" \
      || die "adb device $serial is not connected (check: adb devices)"
  else
    count="$(printf '%s\n' "$devices" | grep -c .)"
    if [ "$count" = "1" ]; then
      serial="$devices"
    elif [ "$count" = "0" ]; then
      err "no watch is connected over adb"
      say "  1. On the watch: Settings → System → Developer options → Wireless debugging → ON"
      say "  2. Pair — a code appears on the watch:  adb pair <watch-ip>:<pair-port>"
      say "  3. Connect:                             adb connect <watch-ip>:<port>"
      say "  4. Run this command again."
      exit 1
    else
      err "several adb devices are connected:"
      printf '%s\n' "$devices" | sed 's/^/      /'
      say "Pick one: wearsic pair --device <serial>"
      exit 1
    fi
  fi
  model="$(adb -s "$serial" shell getprop ro.product.model 2>/dev/null | tr -d '\r' | head -1)"
  [ -n "$model" ] && kv "device" "$model ($serial)"

  # 6. Deliver the pairing file, then read it back: a silently truncated
  #    push must fail HERE, not on the watch.
  local dir="/sdcard/Android/data/com.wearsic.app/files"
  local pfile="$dir/wearsic-pairing.env" pw
  pw="$(mktemp)"
  printf 'WEARSIC_SERVER_URL=%s\nWEARSIC_API_KEY=%s\n' "$url" "$key" > "$pw"
  adb -s "$serial" shell mkdir -p "$dir" >/dev/null 2>&1
  if ! adb -s "$serial" push "$pw" "$pfile" >/dev/null 2>&1; then
    rm -f "$pw"
    err "adb push failed — is the watch still connected? (check: adb devices)"
    exit 1
  fi
  local back; back="$(adb -s "$serial" shell cat "$pfile" 2>/dev/null | tr -d '\r')"
  if [ "$back" != "$(tr -d '\r' < "$pw")" ]; then
    rm -f "$pw"
    err "the pushed file did not read back correctly — try again (watch storage full?)"
    exit 1
  fi
  rm -f "$pw"
  ok "address + key delivered to the watch"

  if [ "$restart" = "1" ]; then
    adb -s "$serial" shell am force-stop com.wearsic.app >/dev/null 2>&1
    say "closed Wearsic on the watch so the next open applies the pairing"
  fi

  # 7. Summary — the address yes, the key never (it stays in your .env and
  #    on the watch; `wearsic url` shows it when you need it).
  printf '\n'
  kv "server" "$url"
  if [ -n "$key" ]; then
    kv "api key" "delivered — the same one 'wearsic url' shows"
  else
    kv "api key" "${C_WARN}none set — anyone on your network can use this server${C_RESET}"
  fi
  printf '\n'
  box_begin "one step left"
  box_line ""
  box_line "   Open Wearsic on the watch — the address applies"
  box_line "   automatically and a toast confirms it."
  box_line ""
  box_line "   ${C_DIM}Nothing happened? Update the watch app: wearsic sideload${C_RESET}"
  box_end
  return 0
}

# Installed vs running engine version (from /health when available).
cmd_version() {
  installed
  brand "version"
  local ver
  http_get "http://127.0.0.1:$(port)/health" 3
  ver="$(jstr "$HTTP_BODY" version)"
  if [ -n "$ver" ]; then
    box_begin "engine" ok
    box_line ""
    box_line "   $(pill ok "v$ver")  ${C_DIM}running${C_RESET}"
    box_line "   ${C_DIM}server port${C_RESET}  $(port)"
    box_hr
    box_line "   ${C_ACC}wearsic update${C_RESET}  ${C_DIM}check for updates${C_RESET}"
    box_line "   ${C_ACC}wearsic status${C_RESET}  ${C_DIM}full health picture${C_RESET}"
    box_line "   ${C_ACC}wearsic cloudflare${C_RESET}  ${C_DIM}public workers.dev URL${C_RESET}"
    box_end
  else
    box_begin "engine" err
    box_line ""
    box_line "   $(pill err 'not running')"
    box_hr
    box_line "   ${C_ACC}wearsic start${C_RESET}  ${C_DIM}bring the engine up${C_RESET}"
    box_end
  fi
}

# /ready: can the server serve music RIGHT NOW?
cmd_ready() {
  installed
  local P; P="$(port)"
  if [ "${1:-}" = "--json" ]; then
    curl -sf -m 5 "http://127.0.0.1:$P/ready" \
      || die "No /ready response — is the server running? (wearsic start)"
    printf '\n'
    return 0
  fi
  brand "ready"
  http_get "http://127.0.0.1:$P/ready"
  [ "$HTTP_CODE" != "000" ] || die "No response — is the server running? (wearsic start)"
  local body rd db ex tc ver
  body="$HTTP_BODY"
  rd="$(jbool "$body" ready)"; db="$(jbool "$body" database)"
  ex="$(jbool "$body" extractor)"; tc="$(jbool "$body" transcoder)"
  ver="$(jstr "$body" engineVersion)"
  if [ "$rd" = "true" ]; then
    box_begin "readiness" ok
    box_line ""
    box_line "   $(pill ok ready)  ${C_DIM}the watch can play music${C_RESET}"
    box_line "   ${C_DIM}127.0.0.1:${P} · ${HTTP_MS:-?}ms · engine v${ver:-unknown}${C_RESET}"
    box_line ""
    box_check "database" "$db"
    box_check "music engine" "$ex"
    box_check "audio conversion" "$tc"
    box_line ""
    box_end
    return 0
  fi
  box_begin "readiness" err
  box_line ""
  box_line "   $(pill err 'not ready')  ${C_ERR}playback will fail${C_RESET}"
  box_line ""
  [ "$db" != "true" ] && box_line "   ${C_WARN}database${C_RESET}  check free storage and permissions"
  [ "$ex" != "true" ] && box_line "   ${C_WARN}music engine${C_RESET}  run wearsic update, then check the logs"
  [ "$tc" != "true" ] && box_line "   ${C_WARN}audio conversion${C_RESET}  pkg install ffmpeg"
  box_end
  return 1
}

# Some hosts need an LD_PRELOAD shim before the JVM can start at all: on
# Android-in-a-proot (Acode), HotSpot's startup probe tries to mprotect() a
# page to RWX, which SELinux refuses, so the VM aborts with "Failed to mark
# memory page as executable". The shim works around it. Probe for it once
# and export it for the rest of the process when a plain JVM cannot start.
JVM_SHIM=""
ensure_jvm_runnable() {
    java -version >/dev/null 2>&1 && return 0
    [ -n "$JVM_SHIM" ] && [ -f "$JVM_SHIM" ] || return 1
    LD_PRELOAD="$JVM_SHIM${LD_PRELOAD:+:$LD_PRELOAD}"
    export LD_PRELOAD
    java -version >/dev/null 2>&1
}

# Locate a shim when WEARSIC_JVM_SHIM is not set: the Acode dev root, then a
# user-local copy.
detect_jvm_shim() {
    if [ -n "${WEARSIC_JVM_SHIM:-}" ]; then
        [ -f "$WEARSIC_JVM_SHIM" ] && JVM_SHIM="$WEARSIC_JVM_SHIM"
        return
    fi
    local c
    for c in "/public/dev/android/toolchains/jvm-shim/libmprotect-shim.so" \
             "$HOME/.wearsic/libmprotect-shim.so"; do
        if [ -f "$c" ]; then
            JVM_SHIM="$c"
            return
        fi
    done
}

# End-to-end environment diagnostics. Prints only the PRESENCE of the API
# key, never its value; never prints cookies or other secrets.
# Exit codes: 0 = READY, 1 = problems found.
cmd_doctor() {
  local fails=0 warns=0
  brand "doctor"

  section "System" cyan
  if command -v java >/dev/null 2>&1; then
    # The detail is deliberately SHORT and constant-width: a long version
    # string (or an error message) shifts where the row wraps, and the
    # layout tests assert on the name column position.
    local jv
    jv="$(java -version 2>&1 | head -1 | tr -d '"' | sed 's/.*version "\([^"]*\)".*/\1/; s/ .*//')"
    if [ -n "$jv" ]; then
      doctor_row "java" ok "$jv"
    elif detect_jvm_shim && ensure_jvm_runnable; then
      jv="$(java -version 2>&1 | head -1 | tr -d '"' | sed 's/.*version "\([^"]*\)".*/\1/; s/ .*//')"
      doctor_row "java" ok "${jv:-ok} (shim)"
    else
      doctor_row "java" err "cannot start — needs an LD_PRELOAD shim"
      fails=$((fails+1))
    fi
  else
    doctor_row "java" err "missing — pkg install -y openjdk-17"; fails=$((fails+1))
  fi

  if command -v ffmpeg >/dev/null 2>&1; then
    doctor_row "ffmpeg" ok "present"
  else
    doctor_row "ffmpeg" warn "missing — rare Opus/WebM songs will 503 (pkg install ffmpeg)"; warns=$((warns+1))
  fi

  local avail; avail="$(df -k "$DEST" 2>/dev/null | awk 'NR==2 {print $4}')"
  case "$avail" in
    ''|*[!0-9]*) doctor_row "storage" warn "free space unknown"; warns=$((warns+1)) ;;
    *) if [ "$avail" -lt 102400 ]; then
         doctor_row "storage" warn "only $((avail / 1024))MB free — clean up $DEST"; warns=$((warns+1))
       elif [ "$avail" -ge 1048576 ]; then
         doctor_row "storage" ok "$((avail / 1024 / 1024))GB free"
       else
         doctor_row "storage" ok "$((avail / 1024))MB free"
       fi ;;
  esac

  if [ -n "${PREFIX:-}" ] && [ -d "${PREFIX:-/nonexistent}/bin" ]; then
    doctor_row "termux" ok "$PREFIX"
  else
    # Not Termux is a legitimate deployment (the engine also runs on any
    # Linux host with a JDK) — not a problem worth warning about.
    doctor_row "termux" off "not Termux (generic Linux host)"
  fi

  section "Server" green
  if [ -x "$DEST/bin/wearsic-server" ] && [ -n "$(ls -A "$DEST/lib" 2>/dev/null)" ]; then
    doctor_row "install" ok "$DEST"
  else
    doctor_row "install" err "not installed in $DEST"; fails=$((fails+1))
  fi

  if supervisor_running; then
    doctor_row "supervisor" ok "running"
  else
    doctor_row "supervisor" err "not running — wearsic start"; fails=$((fails+1))
  fi

  local pid; pid="$(server_pids | head -1)"
  if [ -n "$pid" ]; then
    local up; up="$(proc_uptime "$pid")"
    doctor_row "process" ok "pid $pid${up:+ · up $up}"
  else
    doctor_row "process" err "not running"; fails=$((fails+1))
  fi

  local P health ready_body hms rms
  P="$(port)"
  http_get "http://127.0.0.1:$P/health"
  health="$HTTP_BODY"; hms="$HTTP_MS"
  if [ "$HTTP_CODE" = "200" ]; then
    local v; v="$(jstr "$health" version)"
    doctor_row "health" ok "200 OK · ${hms:-?}ms · v${v:-unknown}"
  else
    health=""
    doctor_row "health" err "no response — wearsic start"; fails=$((fails+1))
  fi

  http_get "http://127.0.0.1:$P/ready"
  ready_body="$HTTP_BODY"; rms="$HTTP_MS"
  if printf '%s' "$ready_body" | grep -q '"ready"[[:space:]]*:[[:space:]]*true'; then
    doctor_row "readiness" ok "ready · ${rms:-?}ms"
  elif [ -n "$ready_body" ]; then
    doctor_row "readiness" err "not ready"; fails=$((fails+1))
    if printf '%s' "$ready_body" | grep -q '"database"[[:space:]]*:[[:space:]]*false'; then
      doctor_row "database probe" err "check free storage and database permissions"
    fi
    if printf '%s' "$ready_body" | grep -q '"extractor"[[:space:]]*:[[:space:]]*false'; then
      doctor_row "music engine" err "run wearsic update; inspect wearsic logs for upstream challenges"
    fi
  elif [ -n "$health" ]; then
    doctor_row "readiness" off "no /ready (engine older than 1.4.0)"; warns=$((warns+1))
  else
    doctor_row "readiness" err "no response"; fails=$((fails+1))
  fi

  # API key: presence only — the value is never printed.
  if [ -n "$(api_key)" ]; then
    doctor_row "api key" ok "set"
  else
    doctor_row "api key" warn "NOT set — server is OPEN on your network (fine for LAN, never public)"; warns=$((warns+1))
  fi

  if [ -f "$DEST/wearsic.db" ]; then
    doctor_row "database" ok "wearsic.db"
  else
    doctor_row "database" off "not created yet (appears on first start)"; warns=$((warns+1))
  fi

  section "Engine" lavender
  if [ -n "$health" ]; then
    local ver consec canary ex_obj ok_n fail_n rate
    ver="$(jstr "$health" version)"
    ex_obj="$(jobj "$health" extraction)"
    consec="$(jnum "$ex_obj" consecutiveFailures)"
    canary="$(jbool "$health" canaryHealthy)"
    doctor_row "version" ok "v${ver:-unknown}"

    ok_n="$(jnum "$ex_obj" successCount)"
    fail_n="$(jnum "$ex_obj" failureCount)"
    rate="$(jnum "$ex_obj" failureRatePercent)"
    doctor_row "extraction" ok "${ok_n:-0} ok · ${fail_n:-0} failed (${rate:-0}%)"

    if [ -n "$consec" ] && [ "$consec" -ge 6 ] 2>/dev/null; then
      doctor_row "extractor" err "$consec consecutive failures — engine broken? self-heal should be staging an update"; fails=$((fails+1))
    else
      doctor_row "extractor" ok "consecutive failures: ${consec:-0}"
    fi

    case "$canary" in
      true) doctor_row "canary" ok "healthy" ;;
      "")   doctor_row "canary" off "not reported" ;;
      *)    doctor_row "canary" off "$canary" ;;
    esac

    local upd; upd="$(jobj "$health" update)"
    case "$(jstr "$upd" status)" in
      staged) doctor_row "engine update" off "v$(jstr "$upd" stagedVersion) staged — applies on next restart" ;;
      "")     doctor_row "engine update" off "not reported" ;;
      *)      doctor_row "engine update" ok "$(jstr "$upd" status)" ;;
    esac

    if [ "$(jbool "$health" transcoderAvailable)" = "false" ]; then
      doctor_row "audio conversion" warn "unavailable — pkg install -y ffmpeg"; warns=$((warns+1))
    fi

    local crashes; crashes="$(jnum "$health" crashCount)"
    if [ -n "$crashes" ] && [ "$crashes" -gt 0 ] 2>/dev/null; then
      doctor_row "crashes" warn "$crashes recorded — see state/crashes + wearsic-server.log"; warns=$((warns+1))
    else
      doctor_row "crashes" ok "${crashes:-0}"
    fi

    local refusals; refusals="$(jnum "$health" upstreamRefusals)"
    if [ -n "$refusals" ] && [ "$refusals" -ge 10 ] 2>/dev/null; then
      doctor_row "cdn refusals" warn "$refusals refused ranges — throttled network, not a broken engine"; warns=$((warns+1))
    else
      doctor_row "cdn refusals" ok "${refusals:-0}"
    fi
  else
    doctor_row "engine" off "server not responding — wearsic start"
  fi

  section "Network" amber
  # Detect Tailscale/Funnel BEFORE the wifi verdict: a phone with no local
  # IP is fine when a public URL reaches the watch, and calling that "NOT
  # READY" sent users chasing a non-problem. (Same rule as the tailscale
  # rows below — warnings, never a hard failure scoped to the wrong thing.)
  local ts_st="" funnel_on=0
  if command -v tailscale >/dev/null 2>&1; then
    ts_st="$(ts_state)"
    tailscale funnel status 2>/dev/null | grep -qi 'https://' && funnel_on=1
  fi

  local ip; ip="$(lan_ip)"
  if [ -n "$ip" ]; then
    doctor_row "wifi" ok "$ip"
  elif [ "$funnel_on" = "1" ]; then
    doctor_row "wifi" warn "no local IP — fine, the public URL still works"; warns=$((warns+1))
  else
    doctor_row "wifi" err "no local IP detected (Wi-Fi may still be on) — save it: wearsic ip 192.168.x.y, or go public: wearsic funnel"; fails=$((fails+1))
  fi

  # Tailscale / Funnel: only ever reported ACTIVE when confirmed, and the
  # reason is always spelled out — "not active" alone gave no way to tell a
  # dead daemon from a logged-out phone.
  if command -v tailscale >/dev/null 2>&1; then
    case "$ts_st" in
      Running)    doctor_row "tailscale" ok "connected" ;;
      NeedsLogin) doctor_row "tailscale" warn "installed, not logged in — for a public URL run: tailscale up"; warns=$((warns+1)) ;;
      Stopped)    doctor_row "tailscale" warn "node stopped — for a public URL run: tailscale up"; warns=$((warns+1)) ;;
      Starting)   doctor_row "tailscale" off "starting up"; warns=$((warns+1)) ;;
      *)          doctor_row "tailscale" warn "daemon not responding — run: tailscaled-start"; warns=$((warns+1)) ;;
    esac
    # Tailscale is OPTIONAL: the server plays fine over LAN without it, so
    # all of the above stay warnings and never flip doctor's exit code.
    # Making a logged-out phone a hard failure would report "NOT READY" for
    # a server that is in fact serving music perfectly over WiFi.
    if [ "$funnel_on" = "1" ]; then
      doctor_row "funnel" ok "active"
    elif [ "$ts_st" != "Running" ]; then
      # Funnel cannot work until the node is connected — say THAT instead of
      # reporting a separate, confusing Funnel failure.
      doctor_row "funnel" off "blocked: Tailscale not connected"
    else
      doctor_row "funnel" off "not active — start with: wearsic funnel"
    fi
  else
    doctor_row "tailscale" off "not installed"
    doctor_row "funnel" off "not installed"
  fi

  # The Cloudflare front door is independent of Tailscale: it only needs
  # cloudflared, a Cloudflare API token and a free Cloudflare account.
  local cf_url cf_origin
  cf_url="$(cf_state_get url || true)"
  cf_origin="$(cf_state_get origin || true)"
  if [ -n "$cf_url" ]; then
    if [ -n "$(cf_pids)" ] && curl -fsS --max-time 15 "$cf_url/health" 2>/dev/null | grep -q '"status":"ok"'; then
      doctor_row "cloudflare" ok "live — $cf_url"
    else
      doctor_row "cloudflare" warn "not answering — $cf_url (restart: wearsic cloudflare)"
      warns=$((warns+1))
    fi
  elif command -v cloudflared >/dev/null 2>&1 || [ -x "$DEST/bin/cloudflared" ]; then
    doctor_row "cloudflare" off "not active — start with: wearsic cloudflare"
  else
    doctor_row "cloudflare" off "not installed (needs cloudflared + a Cloudflare account)"
  fi

  printf '\n'
  if [ "$fails" -eq 0 ]; then
    box_begin "checkup" ok
    box_line ""
    if [ "$warns" -gt 0 ]; then
      box_line "   $(pill ok ready)"
      box_line "   ${C_WARN}$warns warning(s)${C_RESET} ${C_DIM}— nothing blocking playback${C_RESET}"
    else
      box_line "   $(pill ok ready)"
      box_line "   ${C_DIM}everything checks out${C_RESET}"
    fi
    box_hr
    box_line "   ${C_ACC}wearsic url${C_RESET}   ${C_DIM}connect the watch${C_RESET}"
    box_line "   ${C_ACC}wearsic logs${C_RESET}  ${C_DIM}playback issues${C_RESET}"
    box_end
    return 0
  fi
  local warns_txt=""
  [ "$warns" -gt 0 ] && warns_txt=" · ${C_WARN}$warns warning(s)${C_RESET}"
  box_begin "checkup" err
  box_line ""
  box_line "   $(pill err 'not ready')"
  box_line "   ${C_ERR}$fails problem(s)${C_RESET}${warns_txt}"
  box_hr
  box_line "   ${C_DIM}fix the red rows above, then run${C_RESET} ${C_ACC}wearsic doctor${C_RESET}"
  box_end
  return 1
}

# ── setup: the one-command path for an existing install ───────────────────
# Everything a fresh install needs, in a few quiet stages: the API key is
# created when it is missing (an existing key is never replaced), the engine
# is started when it is stopped, the health endpoint is verified, and the
# watch values are shown together at the end.
#
#   wearsic setup [--update] [--cloudflare]
cmd_setup() {
  installed
  local do_update=0 do_cf=0 key_state vstate code pcode
  while [ $# -gt 0 ]; do
    case "$1" in
      --update) do_update=1; shift ;;
      --cloudflare) do_cf=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) die "Unknown option for 'wearsic setup': $1 (try --update or --cloudflare)" ;;
    esac
  done
  brand "setup"

  if [ "$do_update" = "1" ]; then
    say "updating the engine…"
    cmd_update || die "the update failed — the running engine is untouched"
    say ""
  fi

  # Configure — the key is created only when there is none.
  shim_stage_begin "Configure" "settings"
  if [ -n "$(api_key)" ]; then
    key_state="existing API key kept"
  else
    ensure_api_key >/dev/null || die "could not create an API key"
    key_state="API key created"
  fi
  shim_stage_end ok "$key_state"

  # Start — the supervisor brings the engine up and keeps it alive.
  shim_stage_begin "Start" "server"
  ensure_engine >/dev/null || { shim_stage_end fail "the server did not start"; die "the server did not start — check: wearsic logs"; }
  shim_stage_end ok "listening on port $(port)"

  # Verify — health AND the API key, because /health alone proves nothing.
  shim_stage_begin "Verify" "health"
  code="$(curl -s -o /dev/null -w '%{http_code}' -m 10 "http://127.0.0.1:$(port)/health" 2>/dev/null || echo 000)"
  if [ "$code" != "200" ]; then
    shim_stage_end fail "the engine did not answer /health"
    die "the engine did not answer /health (got ${code:-no response}) — check: wearsic logs"
  fi
  vstate="health ok"
  pcode="$(curl -s -o /dev/null -w '%{http_code}' -m 10 \
    -H "X-Wearsic-Key: $(api_key)" -H 'Range: bytes=0-9' \
    "http://127.0.0.1:$(port)$CF_PROBE_PATH" 2>/dev/null || echo 000)"
  case "$pcode" in
    200|206) vstate="health ok · api key accepted" ;;
    401|403) shim_stage_end fail "the engine rejected the API key"; die "the engine rejected the API key — set a new one: wearsic api-key <new-key>" ;;
    404)     vstate="health ok" ;;
    *)       vstate="health ok" ;;
  esac
  shim_stage_end ok "$vstate"

  # Ready — the watch values, together.
  say ""
  show_pairing
  if [ "$do_cf" = "1" ]; then
    say ""
    cmd_cloudflare start
  fi
  return 0
}

# ── dashboard: the live view ──────────────────────────────────────────────
# A compact picture of the running server: health, uptime, the LAN address,
# the Cloudflare front door, the API/stream health and what the engine is
# doing right now. The frame is redrawn IN PLACE (the terminal never fills
# with repeated output) and the cursor is restored on Ctrl+C.
DASH_LINES=0
dashboard_draw() { # $1 = frame
  local frame="$1" n line
  n="$(printf '%s\n' "$frame" | wc -l | tr -d ' ')"
  if [ "${DASH_LINES:-0}" -gt 0 ]; then
    printf '%s[%dA' "$ESC" "$DASH_LINES"
  fi
  while IFS= read -r line; do
    # The clear-line code is only needed on a terminal; piped output stays
    # plain, one line per row.
    if [ "$TTY_OUT" = "1" ]; then
      printf '\r%s[K%s\n' "$ESC" "$line"
    else
      printf '%s\n' "$line"
    fi
  done <<EOF
$frame
EOF
  DASH_LINES="$n"
}

# One dashboard row: label, value, optional state chip.
dash_row() { # $1 = label, $2 = value, $3 = state (ok|warn|err|off|empty)
  local label="$1" value="$2" state="${3:-}" chip="" plain w
  plain="$(vis "$value")"
  w=$(( COLS - 16 ))
  [ "$w" -lt 12 ] && w=12
  if [ ${#plain} -gt "$w" ]; then
    value="$(elide_mid "$value" "$w")"
  fi
  case "$state" in
    ok)   chip="$(pill ok ok)" ;;
    warn) chip="$(pill warn watch)" ;;
    err)  chip="$(pill err down)" ;;
    off)  chip="$(pill off off)" ;;
  esac
  if [ -n "$chip" ]; then
    printf '    %s%-10s%s  %s  %s\n' "$C_DIM" "$label" "$C_RESET" "$value" "$chip"
  else
    printf '    %s%-10s%s  %s\n' "$C_DIM" "$label" "$C_RESET" "$value"
  fi
}

dashboard_frame() {
  local P ver pid up lan cfurl cfst origin apiw act="" st="" chip="" v
  P="$(port)"
  ver=""; up=""
  if health_ok; then
    http_get "http://127.0.0.1:$P/health" 2
    ver="$(jstr "$HTTP_BODY" version)"
    pid="$(server_pids | head -1)"
    [ -n "$pid" ] && up="$(proc_uptime "$pid")"
    st="ok"; v="running"
  else
    st="err"; v="not answering"
  fi
  lan="$(server_url)"
  cfurl="$(cf_state_get url 2>/dev/null || true)"
  cfst="$(cf_state_get status 2>/dev/null || true)"
  origin="$(cf_state_get origin 2>/dev/null || true)"

  # The API/stream health: an authenticated Range request, locally.
  local key code
  key="$(api_key)"
  if [ -n "$key" ]; then
    code="$(curl -s -o /dev/null -w '%{http_code}' -m 8 \
      -H "X-Wearsic-Key: $key" -H 'Range: bytes=0-9' \
      "http://127.0.0.1:$P$CF_PROBE_PATH" 2>/dev/null || echo 000)"
    case "$code" in
      206) apiw="stream 206 ready" ;;
      200) apiw="stream ok" ;;
      401|403) apiw="the engine rejected the key" ;;
      404) apiw="no probe endpoint" ;;
      *) apiw="not answering" ;;
    esac
  else
    apiw="no API key"
  fi

  # What is happening right now: the tunnel state first, then the engine log.
  case "$cfst" in
    live)    act="front door live" ;;
    starting) act="front door starting" ;;
    error)   act="front door degraded: $(cf_state_get last_error 2>/dev/null | cut -c1-40)" ;;
    stopped) act="front door stopped" ;;
  esac
  if [ -z "$act" ] && [ -f "$LOG" ]; then
    act="$(tail -1 "$LOG" 2>/dev/null | sed -E 's/^[0-9]{2}:[0-9]{2}:[0-9]{2} +//; s/^(INFO|WARN|ERROR) +//' | cut -c1-48)"
  fi
  [ -n "$act" ] || act="idle"

  local head="  ${C_ACC}♪${C_RESET} ${C_BOLD}wearsic${C_RESET} ${C_DIM}·${C_RESET} ${C_BOLD}dashboard${C_RESET}"
  local right
  if [ "$st" = "ok" ]; then right="$(pill ok running)"; else right="$(pill err stopped)"; fi
  local lp rp gap
  lp="$(vis "$head")"; rp="$(vis "$right")"
  local top="$head"
  if [ $(( COLS - ${#lp} - ${#rp} )) -ge 2 ]; then
    gap=$(( COLS - ${#lp} - ${#rp} ))
    top="$head$(printf '%*s' "$gap" '')$right"
  else
    top="$head"
  fi

  local out="$top"
  out="$out
"
  if [ "$st" = "ok" ]; then
    out="$out$(dash_row "server" "v${ver:-?} · up ${up:-?} · port $P" "ok")
"
  else
    out="$out$(dash_row "server" "not answering on port $P" "err")
"
  fi
  if [ -n "$lan" ]; then
    out="$out$(dash_row "lan" "$lan" "$st")
"
  else
    out="$out$(dash_row "lan" "address not detected" "warn")
"
  fi
  if [ -n "$cfurl" ]; then
    case "$cfst" in
      live)    out="$out$(dash_row "cloudflare" "$cfurl" "ok")
" ;;
      starting) out="$out$(dash_row "cloudflare" "$cfurl" "warn")
" ;;
      *)       out="$out$(dash_row "cloudflare" "$cfurl" "err")
" ;;
    esac
    out="$out$(dash_row "tunnel" "${origin:-unknown}" "ok")
"
  else
    out="$out$(dash_row "cloudflare" "not configured — wearsic cloudflare" "off")
"
  fi
  out="$out$(dash_row "api" "$apiw" "")
"
  # An active state gets the same shimmer as the rest of the CLI.
  local act_line
  if [ "$cfst" = "starting" ] || [ "$st" != "ok" ]; then
    act_line="$(shim_render "$act" $(( ${#act} / 2 )) $(( ${#act} * SHIM_BAND_PCT / 100 / 2 )))"
  else
    act_line="${C_DIM}${act}${C_RESET}"
  fi
  out="$out$(printf '    %s%-10s%s  %s\n' "$C_DIM" "activity" "$C_RESET" "$act_line")
"
  out="$out
"
  out="$out$(printf '    %swearsic start · stop · restart · logs · doctor · cloudflare%s\n' "$C_DIM" "$C_RESET")"
  printf '%s' "$out"
}

cmd_dashboard() {
  installed
  local once=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --once) once=1; shift ;;
      -h|--help) usage; return 0 ;;
      *) die "Unknown option for 'wearsic dashboard': $1 (try --once)" ;;
    esac
  done
  # Piped output gets one frame (a dashboard that loops would never end).
  [ "$TTY_OUT" = "1" ] || once=1
  trap 'shim_cursor_show; printf "\n"; exit 0' INT
  while :; do
    dashboard_draw "$(dashboard_frame)"
    [ "$once" = "1" ] && break
    sleep 2
  done
  trap 'shim_clear_live; shim_cursor_show; shim_cleanup; exit 130' INT
  printf '\n'
  return 0
}

usage() {
  # Live status for the header: ONE fast local probe (1s cap) so bare
  # `wearsic` answers "is it running?" immediately — never a slow wait.
  local st="not installed" ver="" ICOL=9
  if [ -f "$RUN" ]; then
    http_get "http://127.0.0.1:$(port)/health" 1
    if [ "$HTTP_CODE" = "200" ]; then
      st="running"; ver="$(jstr "$HTTP_BODY" version)"
    else
      st="not running"
    fi
  fi
  local l r lp rp gap tw tag tag_mid
  tw="$(box_tw)"
  l="$(printf '%s♪%s %s' "$C_ACC" "$C_RESET" "$(grad_word 'wearsic')")"
  tag_mid=""
  if [ "$st" = "running" ]; then
    r="$(pill ok running)${ver:+ $(printf '%s v%s %s' "$C_DIM" "$ver" "$C_RESET")}"
    tag="music for your watch · v${ver:-?} · port $(port)"
    tag_mid="music for your watch · port $(port)"
  elif [ "$st" = "not running" ]; then
    r="$(pill off 'not running')"
    tag="music for your watch · port $(port)"
  else
    r="$(pill off 'not installed')"
    tag="music for your watch"
  fi
  # The subtitle shares the header rule's width. On a phone at 34/40 columns
  # the full "· v<ver> · port <n>" caption is wider than the rule and used to
  # print past the terminal edge, so drop the version first, then the port —
  # a one-line caption is part of the layout contract (ui-layout-test.sh).
  if [ ${#tag} -gt "$tw" ] && [ -n "$tag_mid" ]; then tag="$tag_mid"; fi
  if [ ${#tag} -gt "$tw" ]; then tag="music for your watch"; fi
  lp="$(vis "$l")"; rp="$(vis "$r")"
  printf '\n'
  if [ $(( tw - ${#lp} - ${#rp} )) -ge 3 ]; then
    gap=$(( tw - ${#lp} - ${#rp} ))
    printf '  %s' "$l"
    while [ "$gap" -gt 0 ]; do printf ' '; gap=$((gap - 1)); done
    printf '%s\n' "$r"
  else
    printf '  %s\n' "$l"
    printf '  %s\n' "$r"
  fi
  printf '  %s\n' "$(rule_line "$tw")"
  printf '  %s%s%s\n\n' "$C_DIM" "$tag" "$C_RESET"
  SECTION_FIRST=1

  section "Server" green
  item "start" "start the server" "start the server (self-healing supervisor)"
  item "stop" "stop the server" "stop the server"
  item "restart" "stop, then start" "stop, then start"
  item "status" "running? healthy? version?" "is it running? healthy? which version? (exit 0/3/4)"
  item "dashboard" "live view" "live dashboard: health, LAN, Cloudflare, API (Ctrl+C to exit)"
  item "logs" "follow live logs" "follow live logs (Ctrl+C to exit)"
  item "doctor" "full checkup (exit 0 = ready)" "full checkup — exit 0 means READY"
  item "setup" "one-command setup" "set up everything: key, server, health, watch values"
  item "port [n]" "show or set the server port" "show the port — or set a new one (1024–65535, restart to apply)"

  ICOL=16
  section "Watch pairing" cyan
  item "url" "server URL + key" "server URL + key to enter on the watch"
  item "ip" "this phone's WiFi IP" "this phone's WiFi IP — or save one: wearsic ip 192.168.x.y"
  item "api-key [new]" "show or set the API key" "show or set the API key"
  item "sideload [tag]" "install the watch app" "install the release app on the watch (adb)"
  item "pair [URL]" "send to the watch (adb)" "send address + key to the watch (adb, no typing)"

  ICOL=16
  section "Engine" lavender
  item "update [--pre]" "verified, rollback-safe" "update to the latest release (verified, rollback-safe)"
  item "version" "engine version" "installed + running engine version"
  item "health [--json]" "server snapshot" "server snapshot (--json for scripts)"
  item "ready [--json]" "can it play right now?" "can the server play music right now?"

  ICOL=16
  section "Remote access" amber
  item "funnel" "Tailscale Funnel URL" "public HTTPS URL (Tailscale Funnel)"
  item "cloudflare" "Cloudflare Workers URL" "permanent public HTTPS URL (free, no domain)"
  item "public" "other public recipes" "public URL recipes (Tailscale / Cloudflare)"
  item "cookies [cookie]" "fix bot-wall errors" "set the YouTube cookie (fixes bot-wall errors)"

  printf '\n'
  if [ "$COLS" -ge 52 ]; then
    printf '  %s%s%s\n' "$C_DIM" "the classic form works too: wearsic server start" "$C_RESET"
  else
    printf '  %s%s%s\n' "$C_DIM" "classic: wearsic server start" "$C_RESET"
  fi
  printf '\n'
}

# --- dispatch ---------------------------------------------------------
# Both forms work: flat (`wearsic start`) and classic nested
# (`wearsic server start`).
case "${1:-}" in
  server)
    case "${2:-}" in
      start)   cmd_start ;;
      stop)    cmd_stop ;;
      restart) cmd_restart ;;
      status)  cmd_status ;;
      logs)    cmd_logs ;;
      health)  shift 2; cmd_health "$@" ;;
      ready)   shift 2; cmd_ready "$@" ;;
      url)     cmd_url ;;
      ip)      shift 2; cmd_ip "$@" ;;
      version) cmd_version ;;
      update)  shift 2; cmd_update "$@" ;;
      sideload) shift 2; cmd_sideload "$@" ;;
      pair)     shift 2; cmd_pair "$@" ;;
      doctor)  cmd_doctor ;;
      api)
        case "${3:-}" in
          key) shift 3; cmd_api_key "$@" ;;
          *) usage; exit 2 ;;
        esac ;;
      api-key) shift 2; cmd_api_key "$@" ;;
      cookies) shift 2; cmd_cookies "$@" ;;
      setup) shift 2; cmd_setup "$@" ;;
      dashboard) shift 2; cmd_dashboard "$@" ;;
      funnel)  cmd_funnel ;;
      cloudflare) shift 2; cmd_cloudflare "$@" ;;
      public)  cmd_public ;;
      port)    shift 2; cmd_port "$@" ;;
      "") usage; exit 2 ;;
      *) die "Unknown command: wearsic server $2 — run 'wearsic' for the list" ;;
    esac ;;
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   cmd_restart ;;
  status)    cmd_status ;;
  logs)      cmd_logs ;;
  health)    shift; cmd_health "$@" ;;
  ready)     shift; cmd_ready "$@" ;;
  url)       cmd_url ;;
  ip)        shift; cmd_ip "$@" ;;
  version)   cmd_version ;;
  update)    shift; cmd_update "$@" ;;
  sideload)  shift; cmd_sideload "$@" ;;
  pair)      shift; cmd_pair "$@" ;;
  doctor)    cmd_doctor ;;
  api-key|apikey) shift; cmd_api_key "$@" ;;
  cookies)   shift; cmd_cookies "$@" ;;
  setup)     shift; cmd_setup "$@" ;;
  dashboard) shift; cmd_dashboard "$@" ;;
  funnel)    cmd_funnel ;;
  cloudflare) shift; cmd_cloudflare "$@" ;;
  public)    cmd_public ;;
  port)      shift; cmd_port "$@" ;;
  __cf_supervise) shift; cf_supervise "$@" ;;
  ""|help|-h|--help) usage ;;
  *) die "Unknown command: wearsic $1 — run 'wearsic' for the list" ;;
esac
