# White→green gradient for short titles (same ramp as install.sh).
grad_line() {
  local text="$1" len i=0 out="" shade ch
  len=${#text}
  if [ "$len" -le 0 ]; then printf ''; return 0; fi
  while [ "$i" -lt "$len" ]; do
    if [ "$len" -le 1 ]; then shade=114;
    else shade=$(( 255 - (255 - 114) * i / (len - 1) )); fi
    if [ "$shade" -gt 200 ]; then shade=255
    elif [ "$shade" -gt 170 ]; then shade=158
    elif [ "$shade" -gt 145 ]; then shade=120
    else shade=114; fi
    ch="$(printf '%s' "$text" | cut -c$((i + 1)))"
    out="${out}$(printf '\033[38;5;%sm%s' "$shade" "$ch")"
    i=$((i + 1))
  done
  printf '%s\033[0m' "$out"
}

# --- dispatch ---------------------------------------------------------
# Both forms work: flat (`wearsic start`) and classic nested
# (`wearsic server start`).
case "${1:-}" in
  server)
    case "${2:-}" in
      start)   cmd_start ;;
      stop)    cmd_stop ;;
      restart) cmd_restart ;;
      status)  cmd_status ;;
      logs)    cmd_logs ;;
      health)  cmd_health ;;
      ready)   cmd_ready ;;
      url)     cmd_url ;;
      ip)      cmd_ip ;;
      version) cmd_version ;;
      update)  shift 2; cmd_update "$@" ;;
      doctor)  cmd_doctor ;;
      api)
        case "${3:-}" in
          key) shift 3; cmd_api_key "$@" ;;
          *) usage; exit 2 ;;
        esac ;;
      api-key) shift 2; cmd_api_key "$@" ;;
      cookies) shift 2; cmd_cookies "$@" ;;
      funnel)  cmd_funnel ;;
      public)  cmd_public ;;
      "") usage; exit 2 ;;
      *) die "Unknown command: wearsic server $2 — run 'wearsic' for the list" ;;
    esac ;;
  start)     cmd_start ;;
  stop)      cmd_stop ;;
  restart)   cmd_restart ;;
  status)    cmd_status ;;
  logs)      cmd_logs ;;
  health)    cmd_health ;;
  ready)     cmd_ready ;;
